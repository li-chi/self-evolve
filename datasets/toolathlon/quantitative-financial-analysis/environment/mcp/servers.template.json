{
  "google_sheet": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/google-sheets-mock/server.py"
    ],
    "env": {
      "GSHEETS_MOCK_STATE_DIR": "/var/lib/mock-state/gsheets",
      "GDRIVE_MOCK_STATE_DIR": "/var/lib/mock-state/gdrive"
