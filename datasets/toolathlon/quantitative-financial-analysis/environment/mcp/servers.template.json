  },
  "notion": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/notion-mock/server.py"
    ],
    "env": {
      "NOTION_MOCK_STATE_DIR": "/var/lib/mock-state/notion"
    }
  }
}
