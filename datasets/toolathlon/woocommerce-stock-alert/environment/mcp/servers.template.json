{
  "woocommerce": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/woocommerce-mock/server.py"
    ],
    "env": {
      "WC_MOCK_STATE_DIR": "/var/lib/mock-state/woocommerce"
    }
  },
  "google_sheet": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/google-sheets-mock/server.py"
    ],
    "env": {
      "GSHEETS_MOCK_STATE_DIR": "/var/lib/mock-state/gsheets",
      "GDRIVE_MOCK_STATE_DIR": "/var/lib/mock-state/gdrive"
    }
  },
  "emails": {
    "command": "/opt/emails-mcp-venv/bin/emails-mcp",
    "args": [
      "--attachment_download_path",
      "/app/emails_download",
      "--attachment_upload_path",
      "/app",
      "--email_export_path",
      "/app/emails_export",
      "--config_file",
      "${token.emails_config_file}"
    ],
    "env": {
      "MAIL_MOCK_STATE_DIR": "/var/lib/mock-state/mail"
    }
  }
}
