{
  "woocommerce": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/woocommerce-mock/server.py"
    ],
    "env": {
      "WC_MOCK_STATE_DIR": "/var/lib/mock-state/woocommerce"
    }
  },
  "google-cloud": {
    "command": "/opt/toolathlon/.venv/bin/python",
    "args": [
      "/opt/mocks/google-cloud-mock/server.py",
      "--project-id",
      "mcp-bench0606",
      "--service-account-path",
      "/opt/toolathlon/configs/gcp-service_account.keys.json",
      "--allowed-buckets",
      "${token.google_cloud_allowed_buckets}",
      "--allowed-datasets",
      "${token.google_cloud_allowed_bigquery_datasets}",
      "--allowed-log-buckets",
      "${token.google_cloud_allowed_log_buckets}",
      "--allowed-instances",
      "${token.google_cloud_allowed_instances}"
    ],
    "env": {
      "GCP_MOCK_STATE_DIR": "/var/lib/mock-state/gcp",
      "GCP_MOCK_PROJECT_ID": "mcp-bench0606"
    }
  },
  "emails": {
    "command": "/opt/emails-mcp-venv/bin/emails-mcp",
    "args": [
      "--attachment_download_path",
      "/app/emails_download",
      "--attachment_upload_path",
      "/app",
      "--email_export_path",
      "/app/emails_export",
      "--config_file",
      "${token.emails_config_file}"
    ],
    "env": {
      "MAIL_MOCK_STATE_DIR": "/var/lib/mock-state/mail"
    }
  }
}
