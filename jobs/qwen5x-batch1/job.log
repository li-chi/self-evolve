line.startswith(\'注意\') or line.startswith(\'使用\') or line.startswith(\'计算\'):\n                continue\n            # Strip emoji prefix\n            chars_to_strip = [\'U+1F300\', \'U+1F301\', \'U+1F354\', \'U+1F373\', \'U+1F35A\', \'U+1F35E\']\n            for c in chars_to_strip:\n                if line.startswith(chr(int(c.replace(\'U+\', \'0x\'), 16))):\n                    line = line[1:].strip()\n                    break\n            m = re.match(r\'^(.+?)\' + chr(92) + \'s+(.*)\', line)\n            if m:\n                ing_name = clean_ingredient(m.group(1).strip())\n                amount = re.sub(r\'/per\', \'\', m.group(2).strip()).strip()\n                if amount and ing_name:\n                    quantities[ing_name] = amount\n    return {\'name\': name, \'ingredients\': ingredients, \'quantities\': quantities}\n\nprint(\'Processing\', len(dish_files), \'files\')\nall_recipes = []\nfailed = 0\nfor i, path in enumerate(dish_files):\n    content = fetch_recipe(path)\n    if content:\n        recipe = parse_recipe(content, path)\n        if recipe and recipe[\'ingredients\']:\n            all_recipes.append(recipe)\n        else:\n            failed += 1\n    else:\n        failed += 1\n    if (i+1) % 50 == 0:\n        print(\'  \', i+1, len(all_recipes), failed)\n    time.sleep(0.3)\n\nprint(\'Parsed\', len(all_recipes), \'recipes\')\n\nscored = []\nfor recipe in all_recipes:\n    matches = []\n    for ri in recipe[\'ingredients\']:\n        for ai in available_names:\n            if ai == ri or ai in ri or ri in ai:\n                matches.append(ri)\n                break\n    m = len(matches)\n    total = len(recipe[\'ingredients\'])\n    if total > 0:\n        scored.append({\'name\': recipe[\'name\'], \'ingredients\': recipe[\'ingredients\'], \'quantities\': recipe[\'quantities\'], \'matches\': m, \'total\': total, \'ratio\': m/total, \'matched\': matches, \'missing\': [i for i in recipe[\'ingredients\'] if i not in matches]})\n\nscored.sort(key=lambda x: (-x[\'ratio\'], -x[\'matches\']))\nprint(\'Found\', len(scored), \'dishes\')\nfor r in scored[:20]:\n    print(\' \', r[\'name\'], r[\'matches\'],\'/\',r[\'total\'], round(r[\'ratio\']*100), \'% have:\', r[\'matched\'], \'missing:\', r[\'missing\'])\n    print(\'   Q:\', json.dumps(r[\'quantities\'], ensure_ascii=False))\n\nsoup_kw = [\'汤\', \'粥\', \'羹\', \'炖\', \'煲\']\nsoup_list = [r for r in scored if any(kw in r[\'name\'] for kw in soup_kw)]\nnon_soup = [r for r in scored if r not in soup_list]\nselected = []\nif soup_list:\n    selected.append(soup_list[0])\nfor r in non_soup:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\nprint(\'\\\\nSelected:\')\nfor r in selected:\n    print(r[\'name\'], r[\'matches\'],\'/\',r[\'total\'], round(r[\'ratio\']*100), \'%\')\n    print(\'  Have:\', r[\'matched\'])\n    print(\'  Missing:\', r[\'missing\'])\n    print(\'  Quantities:\', json.dumps(r[\'quantities\'], ensure_ascii=False))\n\ncuisine = {\'recommended_dishes\': []}\nfor r in selected:\n    entry = {\'name\': r[\'name\'], \'ingredients\': []}\n    for ing in r[\'ingredients\']:\n        entry[\'ingredients\'].append({\'name\': ing, \'quantity\': r[\'quantities\'].get(ing, \'\')})\n    cuisine[\'recommended_dishes\'].append(entry)\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=2)\nprint(\'Saved cuisine.json\')\n\nshopping = []\nseen = set()\nfor r in selected:\n    for ing in r[\'missing\']:\n        if ing not in seen:\n            shopping.append({\'Name\': ing, \'Quantity\': r[\'quantities\'].get(ing, \'\')})\n            seen.add(ing)\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'Name,Quantity\' + chr(10))\n    for item in shopping:\n        f.write(item[\'Name\'] + \',\' + item[\'Quantity\'] + chr(10))\nprint(\'Saved shopping.csv\', len(shopping), \'items\')\n\'\'\'\nwith open(\'/app/solve2.py\', \'w\') as f:\n    f.write(script)\nprint(\'Script written\')\n"\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
