Sending keys: ['cat > /app/parse_schedule.py << \'PYEOF\'\nimport re\nimport os\n\n# Read the schedule file\nwith open(\'/app/schedule.txt\', \'r\', encoding=\'utf-8\') as f:\n    lines = f.readlines()\n\ndef extract_courses():\n    courses = []\n    current_section = None\n    \n    for i, line in enumerate(lines):\n        # Detect section headers\n        if \'通识教育核心课程——七大模块课程\' in line:\n            current_section = \'通识教育核心课程\'\n        elif \'通识教育核心课程——公共艺术课程\' in line:\n            current_section = \'通识教育核心课程\'\n        elif \'通识教育核心课程——思想政治理论课程A组\' in line:\n            current_section = \'思政A\'\n        elif \'通识教育核心课程——思想政治理论课程B组\' in line:\n            current_section = \'思政B\'\n        elif \'通识教育核心课程——形势与政策类课程\' in line:\n            current_section = \'形势与政策\'\n        \n        # Skip non-course lines\n        if not line.strip():\n            continue\n        if line.strip().startswith(\'选课须知\') or line.strip().startswith(\'课程说明\'):\n            continue\n        if \'开课院系\' in line and \'课程名称\' in line:\n            continue\n        if line.strip().startswith(\'模块\') and \'选课序号\' in line:\n            continue\n        if \'选课序号\' in line and \'课程名称\' in line and \'学分\' in line:\n            continue\n        if \'第\' in line and \'页\' in line:\n            continue\n        if \'开始周一\' in line:\n            continue\n        \n        # Try to match course lines\n        # Format: PTSS110080.01   中国共产党历史    2 薛小荣    副教授       一 11-12 [1-15]            邯郸校区     180 思政B                            开卷\n        # Match pattern: course ID, name, credits, teacher, title, time, campus, capacity, notes, exam_time, exam_type, department\n        \n        # Pattern for course entry\n        pat = r\'^([A-Z]+[0-9]+\\.\\d+)\\s+(.*?)\\s+(\\d+|[0-9]+)\\s+(.*?)\\s+(.*?)\\s+(.{1,3})\\s+([0-9]+\\-[0-9]+)\\s+(\\[.*?\\])\\s+(.*?)\\s+(邯郸校区|江湾校区|张江校区|枫林校区)\\s+(\\d+)\\s*(.*?)\\s*(思政[AB]|形势与政策|)\\s*(.*)\\s*(闭卷|开卷|论文|其他)\' \n        \n        m = re.search(pat, line)\n        if m:\n            cid = m.group(1)\n            name = m.group(2).strip()\n            credits = m.group(3)\n            teacher = m.group(4).strip()\n            title = m.group(5).strip()\n            weekday = m.group(6).strip()\n            time_range = m.group(7)\n            weeks = m.group(8).strip()\n            notes_part = m.group(9).strip()\n            campus = m.group(10).strip()\n            capacity = m.group(11)\n            # Check what comes after capacity - could be additional notes, category, exam info\n            rest = line[m.end():]\n            \n            category = \'\'\n            exam_type = m.group(14).strip()\n            department = \'\'\n            \n            # Parse the rest to get department\n            rest_trimmed = rest.strip()\n            # Try to find department name\n            dept_match = re.search(r\'\\s+(.+?)$\', rest_trimmed)\n            if dept_match:\n                department = dept_match.group(1).strip()\n            \n            # Get the full class time string\n            class_time = f"{weekday} {time_range} {weeks}"\n            \n            # Check for exam date/time on the line or next line\n            exam_info = \'\'\n            if i + 1 < len(lines):\n                next_line = lines[i + 1]\n                exam_date_match = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', next_line)\n                exam_time_match = re.search(r\'考试时间:\\s*(.+?)(?:\\s|$)\', next_line)\n                if exam_date_match:\n                    exam_info = exam_date_match.group(1)\n                    if exam_time_match:\n                        exam_info += \' \' + exam_time_match.group(1).strip()\n            \n            courses.append({\n                \'course_id\': cid,\n                \'course_name\': name,\n                \'credits\': credits,\n                \'teacher\': teacher,\n                \'title\': title,\n                \'weekday\': weekday,\n                \'class_time\': class_time,\n                \'campus\': campus,\n                \'capacity\': capacity,\n                \'category\': category,\n                \'exam_type\': exam_type,\n                \'exam_info\': exam_info,\n                \'department\': department,\n                \'section\': current_section\n            })\n    \n    return courses\n\ncourses = extract_courses()\nprint(f\'Total courses found: {len(courses)}\')\n\n# Print some sample courses\nfor c in courses[:10]:\n    print(f"  {c[\'course_id\']}: {c[\'course_name\']}, weekday={c[\'weekday\']}, time={c[\'class_time\']}, campus={c[\'campus\']}, exam={c[\'exam_type\']}, dept={c[\'department\']}")\n\n# Filter for 通识教育核心课程 on Monday with 开卷\nprint("\\n--- 通识教育核心课程 Monday 开卷 ---")\nfor c in courses:\n    if c[\'section\'] == \'通识教育核心课程\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\':\n        print(f"  {c[\'course_id\']}: {c[\'course_name\']}, time={c[\'class_time\']}, exam={c[\'exam_type\']}, dept={c[\'department\']}")\n\nPYEOF\npython3 /app/parse_schedule.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
