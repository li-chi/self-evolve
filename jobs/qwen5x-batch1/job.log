n\n            source_name = None\n            for mcol, sname in meth_sources:\n                if mcol == col:\n                    source_name = sname\n                    break\n            # Map to raw data column\n            raw_col = raw_col_lookup.get(source_name)\n            if raw_col is not None:\n                mappings.append((col, raw_col, weight))\n    segments.append((seg_name, mappings))\n\nprint("\\nSegments:")\nfor seg_name, mappings in segments:\n    print(f"  {seg_name}: {[(m[2], raw_col_lookup[m[1]]) for m in mappings]}")\n    for c, rc, w in mappings:\n        print(f"    col C={c} ({meth_sources[c-3][1]}) -> raw col {rc} ({raw_col_lookup[rc]}) weight={w}")\n\n# Read raw data by year\nyears_data = {}\nfor row in range(5, ws_raw.max_row + 1):\n    year = ws_raw.cell(row=row, column=1).value\n    if year is None:\n        continue\n    row_data = {}\n    for col in range(2, 17):\n        val = ws_raw.cell(row=row, column=col).value\n        source_name = raw_col_lookup.get(raw_col_lookup, None)\n        # Actually get source name from header\n        for rc, sname in raw_sources_clean:\n            if rc == col:\n                source_name = sname\n                break\n        row_data[source_name] = val\n    years_data[year] = row_data\n\nprint("\\nYears:", sorted(years_data.keys()))\n\n# Check specific values\nprint("\\nChecking Industry segment (Construction col K):")\nprint("  2015 Construction:", years_data.get(2015, {}).get(\'Construction\'))\nprint("  2015 Col K:", ws_raw.cell(row=6, column=11).value)\n\n# Calculate segment values\ntarget_years = list(range(2015, 2025))\nsegment_values = {}\nfor seg_name, mappings in segments:\n    segment_values[seg_name] = {}\n    for year in target_years:\n        total = 0.0\n        for mcol, raw_col, weight in mappings:\n            source_name = None\n            for rc, sname in raw_sources_clean:\n                if rc == raw_col:\n                    source_name = sname\n                    break\n            val = years_data.get(year, {}).get(source_name, None)\n            if val is None:\n                val = 0.0\n            else:\n                nv = parse_segment_value(val)\n                if nv is not None:\n                    val = nv\n                else:\n                    val = 0.0\n            total += val * weight\n        segment_values[seg_name][year] = total\n        print(f"{seg_name} {year}: {total}")\n\n# Calculate YoY growth rates\ngrowth_rates = {}\nfor seg_name in [s[0] for s in segments]:\n    growth_rates[seg_name] = {}\n    for i, year in enumerate(target_years):\n        if i == 0:\n            growth_rates[seg_name][year] = None\n        else:\n            prev_year = target_years[i - 1]\n            curr = segment_values[seg_name][year]\n            prev = segment_values[seg_name][prev_year]\n            if prev != 0 and prev is not None:\n                rate = round((curr - prev) / prev * 100, 1)\n            else:\n                rate = None\n            growth_rates[seg_name][year] = rate\n            print(f"{seg_name} YoY {year}: {rate}")\n\n# Write output\nwb_out = Workbook()\nws_out = wb_out.active\n\nheaders = [\'Year\'] + [s[0] for s in segments]\nws_out.append(headers)\n\nfor year in target_years:\n    row = [year]\n    for seg_name in [s[0] for s in segments]:\n        row.append(growth_rates[seg_name][year])\n    ws_out.append(row)\n\nwb_out.save(\'/app/segment_growth_rates.xlsx\')\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\n\n# Verify\nwb_v = openpyxl.load_workbook(\'/app/segment_growth_rates.xlsx\')\nws_v = wb_v.active\nfor row in ws_v.iter_rows(values_only=True):\n    print(row)\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
