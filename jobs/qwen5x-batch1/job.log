Sending keys: ['cat > /app/organize.py << \'PYEOF\'\nimport openpyxl\nimport os\nimport re\nimport shutil\n\n# Parse the college mapping\nwb = openpyxl.load_workbook(\'/app/CollegeNameID.xlsx\')\nmapping = {}\nfor ws in wb.worksheets:\n    for row in ws.iter_rows(values_only=True):\n        if row[0] == \'Name\':\n            continue\n        name, student_id, college = row[0], row[1], row[2]\n        mapping[name] = (college, student_id)\n\nprint(f"Loaded {len(mapping)} student mappings")\nfor name in sorted(mapping.keys()):\n    print(f"  {name}: {mapping[name]}")\n\n# Find all OS Assignment 3 files\n# Course: Operating Systems ("OperatingSystems" or "OS")\n# Assignment 3: Assignment3, HW3, Homework3 (NOT Lab3, NOT Project3)\nworkspace = \'/app\'\n\nos_hw3_files = []\nall_code_files = []\n\nfor f in os.listdir(workspace):\n    fp = os.path.join(workspace, f)\n    if not os.path.isfile(fp):\n        continue\n    # Skip non-code files (xlsx, tar.gz, the script itself)\n    if f in [\'CollegeNameID.xlsx\', \'files.tar.gz\', \'organize.py\']:\n        continue\n    \n    # This is a code file\n    all_code_files.append(f)\n    \n    # Check if it\'s OS course\n    is_os = (\'OperatingSystems\' in f or \'OS\' in f.split(\'-\')[0] or \n             \'OS\' in f.split(\'_\')[0])\n    \n    # Check if it\'s Assignment 3 (HW3, Homework3, or Assignment3)\n    # Must match Assignment3 (as a word), HW3, or Homework3\n    # NOT Lab3, NOT Project3, NOT single HW or others\n    is_hw3 = bool(re.search(r\'HW3\', f) or \n                  re.search(r\'Homework3\', f) or \n                  re.search(r\'Assignment3\', f))\n    \n    # Exclude Lab and Project\n    is_lab = bool(re.search(r\'Lab3\', f) or re.search(r\'Lab[0-9]\', f))\n    is_project = bool(re.search(r\'Project3\', f) or re.search(r\'Project[0-9]\', f))\n    \n    if is_os and is_hw3 and not is_lab and not is_project:\n        os_hw3_files.append(f)\n\nprint(f"\\nFound {len(os_hw3_files)} OS Assignment 3 files:")\nfor f in sorted(os_hw3_files):\n    print(f"  {f}")\n\nprint(f"\\nTotal code files: {len(all_code_files)}")\n\n# Now rename and organize\nfor orig_name in sorted(os_hw3_files):\n    # Extract name from filename\n    # File formats: Name-College/HW-OS-HW3.c\n    # or: Name_OS_Assignment3.py\n    \n    # Clean up the filename to get the student name\n    # Files can have hyphens or underscores separating name from rest\n    # Try to match known student names\n    \n    # Remove extension\n    base = orig_name.rsplit(\'.\', 1)[0] if \'.\' in orig_name else orig_name\n    ext = orig_name.rsplit(\'.\', 1)[1] if \'.\' in orig_name else \'\'\n    \n    # Try to extract student name by matching against known names\n    # The filename starts with the student\'s name, possibly followed by hyphen or underscore\n    student_name = None\n    for name in mapping.keys():\n        # Check if filename starts with the name (case-insensitive)\n        if base.lower().startswith(name.lower()) or \\\n           (base.lower().startswith(name.lower() + \'-\') and len(base) > len(name)) or \\\n           (base.lower().startswith(name.lower() + \'_\') and len(base) > len(name)):\n            # Make sure the name matches at word boundary (not partial match)\n            after_name = base[len(name):]\n            if not after_name or after_name.startswith(\'-\') or after_name.startswith(\'_\'):\n                student_name = name\n                break\n    \n    if student_name is None:\n        print(f"WARNING: Could not match name in {orig_name}")\n        continue\n    \n    college, student_id = mapping[student_name]\n    \n    # Create new filename: Name-College-StudentID-OS-HW3.ext\n    new_name = f"{student_name}-{college}-{student_id}-OS-HW3.{ext}"\n    \n    # Determine subdirectory based on extension\n    if ext in [\'c\', \'C\']:\n        subdir = \'C\'\n    elif ext in [\'rs\', \'RS\']:\n        subdir = \'Rust\'\n    elif ext in [\'py\', \'Py\', \'PY\']:\n        subdir = \'Python\'\n    else:\n        subdir = \'Other\'\n    \n    # Create directory structure\n    os.makedirs(os.path.join(workspace, \'os_hw3\', subdir), exist_ok=True)\n    \n    # Build destination path\n    dest_path = os.path.join(workspace, \'os_hw3\', subdir, new_name)\n    src_path = os.path.join(workspace, orig_name)\n    \n    # Copy file to destination\n    shutil.copy2(src_path, dest_path)\n    print(f"Moved: {orig_name} -> {subdir}/{new_name}")\n\n# Delete all original code files\nprint(f"\\nDeleting {len(all_code_files)} original code files...")\nfor f in all_code_files:\n    fp = os.path.join(workspace, f)\n    if os.path.exists(fp):\n        os.remove(fp)\n        print(f"  Deleted: {f}")\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
