Sending keys: ['cat > /tmp/parse_tongren.py << \'ENDSCRIPT\'\nimport re\n\nwith open(\'/tmp/schedule.txt\') as f:\n    lines = f.read().split(\'\\n\')\n\n# Find all 通识教育核心 section boundaries\ntarget_headers = [\n    \'通识教育核心课程——七大模块课程\',\n    \'通识教育核心课程——公共艺术课程\',\n    \'通识教育核心课程——形势与政策类课程\',\n    \'通识教育核心课程——思想政治理论课程A组\',\n]\n\n# Find section boundaries\nsections = []\nfor i, line in enumerate(lines):\n    for h in target_headers:\n        if h in line:\n            # Find the end (next section header)\n            end = i + 1\n            for j in range(i+1, len(lines)):\n                if any(h2 in lines[j] for h2 in target_headers):\n                    end = j\n                    break\n            if j == len(lines) - 1:\n                end = len(lines)\n            sections.append((i, end, line.strip()))\n            break\n\nprint(f\'Found {len(sections)} sections:\')\nfor s, e, h in sections:\n    print(f\'  Lines {s}-{e}: {h}\')\n\n# Parse courses from each section\nall_courses = []\nfor start, end, header in sections:\n    i = start\n    while i < end:\n        line = lines[i].strip()\n        \n        if not line:\n            i += 1\n            continue\n        \n        # Skip section headers, module tags, column headers\n        if line.startswith(\'通识教育核心\'):\n            i += 1\n            continue\n        if line in (\'模块\', \'选修/必修\'):\n            i += 1\n            continue\n        if line in (\'选课序号\', \'课程名称\', \'学分 教师\', \'学分\', \'教师\', \'职称\', \'时间\', \'教室\', \'人数\', \'备注\', \'考试时间\', \'考试类型 含A+ 开课院系 选课限制条件\', \'考试类型 含A+ 开课院系\'):\n            i += 1\n            continue\n        \n        # Course ID\n        m = re.match(r\'^[A-Z]{2,4}\\d{5,6}\\.\\d+$\', line)\n        if m:\n            cid = line\n            j = i + 1\n            \n            # Name (can be multi-line)\n            name = \'\'\n            while j < end and lines[j].strip():\n                nline = lines[j].strip()\n                # Stop if next ID pattern\n                if re.match(r\'^[A-Z]{2,4}\\d{5,6}\\.\\d+$\', nline):\n                    break\n                # Stop if it\'s a pure number (could be credits) or column header\n                if re.match(r\'^\\d+$\', nline) and not name:\n                    # Check if the next line has instructor\n                    if j + 1 < end and re.match(r\'^\\d\', lines[j+1].strip()):\n                        break\n                name = (name + \' \' if name else \'\') + nline\n                j += 1\n            \n            # Credits+Instructor (e.g., "2 侯体健 教授")\n            credits = \'\'\n            instructor = \'\'\n            title = \'\'\n            if j < end and lines[j].strip():\n                ci_line = lines[j].strip()\n                # Parse: "2 侯体健 教授" or "2 侯体健"\n                parts = ci_line.split()\n                if parts and re.match(r\'^\\d\', parts[0]):\n                    credits = parts[0]\n                    # Remaining is instructor + title\n                    rest = \' \'.join(parts[1:])\n                    # Check if title is at the end\n                    titles = [\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\', \'高级工程师\']\n                    if rest:\n                        # Last part might be title\n                        if rest.split()[-1] in titles:\n                            title = rest.split()[-1]\n                            instructor = \' \'.join(rest.split()[:-1])\n                        else:\n                            instructor = rest\n                j += 1\n            \n            # Time\n            time_str = \'\'\n            if j < end:\n                tm = re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[.*?\\]\', lines[j].strip())\n                if tm:\n                    time_str = lines[j].strip()\n                    j += 1\n            \n            # Campus\n            campus = \'\'\n            if j < end and lines[j].strip() in (\'邯郸校区\', \'江湾校区\', \'枫林校区\', \'张江校区\'):\n                campus = lines[j].strip()\n                j += 1\n            \n            # Enrollment + Notes (e.g., "120 复旦大学精品课程")\n            enrollment = \'\'\n            notes = \'\'\n            if j < end and lines[j].strip():\n                en_line = lines[j].strip()\n                parts = en_line.split()\n                if parts and re.match(r\'^\\d$\', parts[0]) and len(parts) > 1:\n                    enrollment = parts[0]\n                    notes = \' \'.join(parts[1:])\n                else:\n                    # Could be just notes\n                    if re.match(r\'^\\d+$\', parts[0]):\n                        enrollment = parts[0]\n                        notes = \' \'.join(parts[1:])\n                    else:\n                        notes = en_line\n                j += 1\n            \n            # Also check if enrollment is on a separate line before notes\n            if not enrollment and j < end and re.match(r\'^\\d+$\', lines[j].strip()):\n                enrollment = lines[j].strip()\n                j += 1\n            \n            # Notes might be on the next line(s)\n            while j < end and lines[j].strip():\n                nl = lines[j].strip()\n                if \'考试日期\' in nl:\n                    break\n                if notes:\n                    notes += \' \' + nl\n                else:\n                    notes = nl\n                j += 1\n            \n            # Exam date/time\n            exam_date = \'\'\n            exam_time = \'\'\n            while j < end and \'考试\' in lines[j]:\n                if \'考试日期\' in lines[j]:\n                    exam_date = lines[j].split(\':\', 1)[1].strip()\n                elif \'考试时间\' in lines[j]:\n                    exam_time = lines[j].split(\':\', 1)[1].strip()\n                j += 1\n            \n            # Assessment\n            assessment = \'\'\n            if j < end and lines[j].strip() in (\'开卷\', \'闭卷\', \'论文\', \'口试\', \'其他\', \'随堂考试\', \'报告\', \'论文/报告\'):\n                assessment = lines[j].strip()\n                j += 1\n            \n            # Has A+\n            has_a_plus = False\n            if j < end and lines[j].strip() == \'是\':\n                has_a_plus = True\n                j += 1\n            \n            # Department\n            dept = \'\'\n            while j < end and re.match(r\'^[\\u4e00-\\u9fa5]{2,6}$\', lines[j].strip()):\n                dept += lines[j].strip()\n                j += 1\n            \n            # Restrictions\n            restriction = \'\'\n            while j < end and not re.match(r\'^[A-Z]{2,4}\\d{5,6}\\.\\d+$\', lines[j].strip()) and lines[j].strip() and not lines[j].strip().startswith(\'通识教育核心\'):\n                if restriction:\n                    restriction += \' \' + lines[j].strip()\n                else:\n                    restriction = lines[j].strip()\n                j += 1\n            \n            if name:\n                all_courses.append({\n                    \'id\': cid, \'name\': name, \'credits\': credits,\n                    \'instructor\': instructor, \'title\': title, \'time\': time_str,\n                    \'campus\': campus, \'enrollment\': enrollment, \'notes\': notes,\n                    \'exam_date\': exam_date, \'exam_time\': exam_time,\n                    \'assessment\': assessment, \'has_a_plus\': has_a_plus,\n                    \'department\': dept, \'restriction\': restriction\n                })\n            i = j\n            continue\n        \n        i += 1\n\nprint(f\'\\nTotal courses: {len(all_courses)}\')\n\n# Find Monday + open-book\nmonday_open = [c for c in all_courses if c[\'time\'] and c[\'time\'].startswith(\'一\') and c[\'assessment\'] == \'开卷\']\nprint(f\'\\nMonday + 开卷 courses ({len(monday_open)}):\')\nfor c in monday_open:\n    print(f"  {c[\'id\']}: {c[\'name\']} Time={c[\'time\']} Assess={c[\'assessment\']} Credits={c[\'credits\']} Dept={c[\'department\']}")\n\n# Show all Monday courses\nmonday_all = [c for c in all_courses if c[\'time\'] and c[\'time\'].startswith(\'一\')]\nprint(f\'\\nAll Monday courses ({len(monday_all)}):\')\nfor c in monday_all:\n    print(f"  {c[\'id\']}: {c[\'name\']} Time={c[\'time\']} Assess={c[\'assessment\']}")\nENDSCRIPT\npython3 /tmp/parse_tongren.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
