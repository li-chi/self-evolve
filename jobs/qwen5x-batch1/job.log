dk in line:\n            di = line.rfind(dk)\n            department = line[di:].strip()\n            break\n    \n    # Exam info\n    exam_info = \'\'\n    for j in range(i+1, min(i+5, len(lines))):\n        nline = lines[j].rstrip()\n        ed = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', nline)\n        et = re.search(r\'考试时间:\\s*([^\\n]+)\', nline)\n        if ed:\n            exam_info += ed.group(1)\n        if et:\n            exam_info += \' \' + et.group(1).strip()\n    exam_info = exam_info.strip()\n    \n    # Campus info\n    class_time = f"{weekday} {time_range} {weeks}" if weekday else \'\'\n    \n    sec = section_map.get(i, \'未知\')\n    \n    all_courses.append({\n        \'course_id\': cid,\n        \'course_name\': name,\n        \'credits\': credits,\n        \'teacher\': teacher,\n        \'weekday\': weekday,\n        \'class_time\': class_time,\n        \'campus\': campus,\n        \'exam_type\': exam_type,\n        \'exam_info\': exam_info,\n        \'department\': department,\n        \'section\': sec\n    })\n\n# Filter for required courses\nrequired = []\nfor c in all_courses:\n    if c[\'course_name\'] == \'自然语言处理\':\n        required.append(c)\n        print(f"Found: {c[\'course_id\']} {c[\'course_name\']}")\n    if c[\'course_name\'] == \'软件体系结构\':\n        required.append(c)\n        print(f"Found: {c[\'course_id\']} {c[\'course_name\']}")\n\n# Filter for 通识核心 Monday 开卷\ntongshi_list = []\nfor c in all_courses:\n    if c[\'section\'] == \'通识核心\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\':\n        tongshi_list.append(c)\n        print(f"通识核心: {c[\'course_id\']} {c[\'course_name\']} {c[\'weekday\']}{c[\'class_time\']} {c[\'exam_type\']} {c[\'department\']}")\n\nprint(f"Total 通识核心 Monday 开卷: {len(tongshi_list)}")\n\n# Filter for 思政B Monday 开卷\nsizhengB_list = []\nfor c in all_courses:\n    if c[\'section\'] == \'思政B\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\':\n        sizhengB_list.append(c)\n        print(f"思政B: {c[\'course_id\']} {c[\'course_name\']} {c[\'weekday\']}{c[\'class_time\']} {c[\'exam_type\']} {c[\'department\']}")\n\nprint(f"Total 思政B Monday 开卷: {len(sizhengB_list)}")\n\n# Save for next step\nimport json\nwith open(\'/app/all_courses.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(all_courses, f, ensure_ascii=False, default=str)\nprint(\'\\nSaved all_courses.json\')\n\n# Show the reference format columns\nprint(\'\\nReference format columns:\')\nref = pd.read_excel(\'/app/reference_format.xlsx\')\nprint(list(ref.columns))\nPYEOF\npython3 /app/solve.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
