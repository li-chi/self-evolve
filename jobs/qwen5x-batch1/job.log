st = line.strip()[len(code):].strip()\n        parts = rest.split()\n        time_pos = -1\n        for j, p in enumerate(parts):\n            if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n                if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                    time_pos = j\n                    break\n        if time_pos <= 0:\n            continue\n        before = parts[:time_pos]\n        instructor_pos = find_title_pos(before)\n        if instructor_pos <= 0:\n            continue\n        instructor = before[instructor_pos]\n        title = before[instructor_pos+1] if instructor_pos+1 < len(before) else \'\'\n        credits = \'\'\n        credits_pos = -1\n        for j in range(instructor_pos-1, 0, -1):\n            if before[j].isdigit() and int(before[j]) <= 5:\n                credits_pos = j\n                credits = before[j]\n                break\n        course_name = \' \'.join(before[1:credits_pos]) if credits_pos > 1 else \'\'\n        if not course_name and code in code_names:\n            course_name = code_names[code]\n        elif course_name and code in code_names and len(course_name) < 3:\n            course_name = code_names.get(code, course_name)\n        after_parts = parts[time_pos:]\n        class_time = \' \'.join(after_parts[:3])\n        campus = \'\'\n        for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n            if c in rest:\n                campus = c\n                break\n        enrollment = \'\'\n        cm = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n        if cm:\n            enrollment = cm.group(1)\n        assessment = \'\'\n        for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n            if a in rest:\n                assessment = a\n                break\n        exam_time = \'\'\n        em = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n        if em:\n            exam_time = em.group(1)\n        restrictions = \'\'\n        after_rest = rest\n        for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n            if a in after_rest:\n                idx2 = after_rest.find(a)\n                after_rest = after_rest[idx2+len(a):]\n                break\n        restrictions = after_rest.strip()\n        entries.append({\n            \'Course name\': course_name, \'Course ID\': code,\n            \'Instructor\': instructor, \'Campus\': campus,\n            \'Class Time\': class_time, \'Enrollment\': enrollment,\n            \'Credits\': credits, \'Assessment Method\': assessment,\n            \'Exam Time\': exam_time, \'Course Selection Restrictions\': restrictions,\n            \'_day\': parts[time_pos], \'_time\': parts[time_pos+1], \'_pg\': pg_idx+1\n        })\n    return entries\n\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    all_entries = []\n    for pg_idx in range(len(pdf.pages)):\n        all_entries.extend(parse_entry_from_pdf(pdf, pg_idx))\n\n    # Fix fixed course names\n    for e in all_entries:\n        code = e[\'Course ID\']\n        if code == \'COMP130141.01\': e[\'Course name\'] = \'自然语言处理\'\n        elif code == \'COMP130025.01\': e[\'Course name\'] = \'软件体系结构\'\n        elif code == \'PTSS110080.01\': e[\'Course name\'] = \'中国共产党历史\'\n\n    fixed = [e for e in all_entries if e[\'Course ID\'] in [\'COMP130141.01\',\'COMP130025.01\',\'PTSS110080.01\']]\n\n    # Find tongren courses\n    tongren = []\n    for e in all_entries:\n        code = e[\'Course ID\']\n        if e[\'Assessment Method\'] != \'开卷\': continue\n        if e[\'_day\'] != \'一\': continue\n        if code.startswith(\'PTSS\'): continue\n        pg = e.get(\'_pg\', 0)\n        if 10 <= pg <= 164:\n            tongren.append(e)\n\n    # Fix names\n    for t in tongren:\n        code = t[\'Course ID\']\n        if code in code_names:\n            t[\'Course name\'] = code_names[code]\n\n    # Remove 半开卷\n    tongren = [t for t in tongren if t[\'Assessment Method\'] == \'