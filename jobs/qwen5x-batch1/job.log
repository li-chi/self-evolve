Sending keys: ['cat << \'PYEOF\' > /app/calculate.py\nimport openpyxl\nimport math\n\n# Load nutrition data\nwb = openpyxl.load_workbook(\'/app/Nutrition.xlsx\')\nws = wb[\'Sheet1\']\nnutrition = {}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    name = row[0]\n    carbs = row[1]\n    protein = row[2]\n    if name:\n        nutrition[name] = {\'carbs\': carbs if carbs else 0, \'protein\': protein if protein else 0}\n\ndef nut(ingredient, grams):\n    """Return (carbs_g, protein_g) for given grams of ingredient"""\n    d = nutrition.get(ingredient)\n    if d is None:\n        print(f"WARNING: ingredient \'{ingredient}\' not found in nutrition table")\n        return 0.0, 0.0\n    return d[\'carbs\'] * grams / 100.0, d[\'protein\'] * grams / 100.0\n\n# ============================================================\n# Dish 1: 西红柿炒鸡蛋 (1 portion)\n# ============================================================\ndish1 = []\n# 西红柿 1个 (约180g)\ndish1.append((\'西红柿\', 180))\n# 鸡蛋 1.5个 * 1, 向上取整 = 2个 (每个约50g)\ndish1.append((\'鸡蛋\', 2 * 50))\n# 食用油 4ml * 2个 = 8ml (8 * 0.92g)\ndish1.append((\'食用油\', 8 * 0.92))\n# 盐 1.5-2g * 1 = 平均1.75g\ndish1.append((\'盐\', 1.75))\n# 糖(白砂糖) 0-2g * 1 = 平均1g\ndish1.append((\'白砂糖\', 1))\n# 葱花 0-10g * 1 = 平均5g\ndish1.append((\'葱花\', 5))\n\n# ============================================================\n# Dish 2: 荔枝肉 (1 portion)\n# ============================================================\ndish2 = []\n# 鲜香菇 2朵 (每朵约15g) = 30g\ndish2.append((\'鲜香菇\', 30))\n# 蟹味菇 30g\ndish2.append((\'蟹味菇\', 30))\n# 瘦肉 150g\ndish2.append((\'瘦肉（猪肉）\', 150))\n# 凤梨 100g\ndish2.append((\'凤梨（菠萝）\', 100))\n# 鸡蛋 1个 = 50g\ndish2.append((\'鸡蛋\', 50))\n# 食用油 500ml = 500 * 0.92g\ndish2.append((\'食用油\', 500 * 0.92))\n# 白砂糖 5g\ndish2.append((\'白砂糖\', 5))\n# 淀粉 100g\ndish2.append((\'淀粉\', 100))\n# 生抽 5ml = 5 * 1.15g\ndish2.append((\'生抽\', 5 * 1.15))\n# 鸡精 5g\ndish2.append((\'鸡精\', 5))\n# 姜末 5g\ndish2.append((\'姜\', 5))\n# 芝麻 2g\ndish2.append((\'芝麻\', 2))\n# 番茄酱 20g\ndish2.append((\'番茄酱\', 20))\n# 香醋 2ml = 2 * 1.05g\ndish2.append((\'香醋\', 2 * 1.05))\n\n# ============================================================\n# Dish 3: 葱油桂鱼 (1 portion, recipe for 2 portions)\n# ============================================================\ndish3 = []\n# 桂鱼 500g / 2 = 250g\ndish3.append((\'桂鱼\', 250))\n# 小葱 1根 (约10g) / 2 = 5g\ndish3.append((\'小葱\', 5))\n# 小米辣 2个 / 2 = 1个 (每个约3g) = 3g\ndish3.append((\'小米辣\', 3))\n# 姜 50g / 2 = 25g\ndish3.append((\'姜\', 25))\n# 料酒 25g / 2 = 12.5g\ndish3.append((\'料酒\', 12.5))\n# 植物油 15g / 2 = 7.5g\ndish3.append((\'植物油\', 7.5))\n# 盐 8g / 2 = 4g\ndish3.append((\'盐\', 4))\n# 蒸鱼豉油 10g / 2 = 5g\ndish3.append((\'蒸鱼豉油\', 5))\n\nall_dishes = {\'西红柿炒鸡蛋\': dish1, \'荔枝肉\': dish2, \'葱油桂鱼\': dish3}\n\ntotal_carbs = 0\ntotal_protein = 0\n\nfor dish_name, ingredients in all_dishes.items():\n    print(f"\\n=== {dish_name} ===")\n    dish_carbs = 0\n    dish_protein = 0\n    for ing_name, grams in ingredients:\n        c, p = nut(ing_name, grams)\n        dish_carbs += c\n        dish_protein += p\n        print(f"  {ing_name}: {grams:.1f}g -> carbs={c:.2f}g, protein={p:.2f}g")\n    print(f"  Subtotal: carbs={dish_carbs:.2f}g, protein={dish_protein:.2f}g")\n    total_carbs += dish_carbs\n    total_protein += dish_protein\n\nprint(f"\\n=== GRAND TOTALS ===")\nprint(f"Total Carbohydrates: {total_carbs:.2f}g")\nprint(f"Total Protein: {total_protein:.2f}g")\n\n# ============================================================\n# Determine expected values\n# ============================================================\nweight = 65  # kg\nheight = 152  # cm\nbmi = weight / (height/100)**2\nprint(f"\\nBMI: {bmi:.2f} (>28 = large-bodied obese)")\n\n# Male, fat loss initial, rest day, BMI > 28\n# From health_guide: Male (Initial) Fat Loss: carbs 2.4-2.7 g/kg, protein 1.2 g/kg\n# Rest day: reduce carbs by 0.5g -> 1.9-2.2 g/kg\n# Large-bodied (BMI > 28): carbs 2.4-2.7 -> rest day 1.9-2.2, protein 1.2\n\ncarbs_low = 1.9 * weight  # 123.5\ncarbs_high = 2.2 * weight  # 143.0\nprotein_expected = 1.2 * weight  # 78.0\n\nprint(f"\\n=== EXPECTED VALUES ===")\nprint(f"Carbs: {carbs_low}g - {carbs_high}g")\nprint(f"Protein: {protein_expected}g")\n\n# ============================================================\n# Assessments\n# ============================================================\n# Carbs: below if < 95% of lower, excessive if > 105% of upper\n# Protein: below if < 95% of target, excessive if > 105% of target\n\ncarbs_actual = total_carbs\nprotein_actual = total_protein\n\n# Carbs assessment\ncarbs_below_threshold = carbs_low * 0.95\ncarbs_excessive_threshold = carbs_high * 1.05\nif carbs_actual < carbs_below_threshold:\n    carbs_assessment = "Below expectations"\nelif carbs_actual > carbs_excessive_threshold:\n    carbs_assessment = "Excessive intake"\nelse:\n    carbs_assessment = "Meets expectations"\n\n# Protein assessment\nprotein_below_threshold = protein_expected * 0.95\nprotein_excessive_threshold = protein_expected * 1.05\nif protein_actual < protein_below_threshold:\n    protein_assessment = "Below expectations"\nelif protein_actual > protein_excessive_threshold:\n    protein_assessment = "Excessive intake"\nelse:\n    protein_assessment = "Meets expectations"\n\nprint(f"\\n=== ASSESSMENT ===")\nprint(f"Carbs: {carbs_assessment} (below={carbs_below_threshold}, excessive={carbs_excessive_threshold}, actual={carbs_actual:.1f})")\nprint(f"Protein: {protein_assessment} (below={protein_below_threshold}, excessive={protein_excessive_threshold}, actual={protein_actual:.1f})")\n\n# ============================================================\n# Format output\n# ============================================================\n# Format expected carbs as range: "123.5g-143.0g"\n# Format protein as single value: "78.0g"\n# Format actual values: one decimal place\n\ncarbs_expected_str = f"{carbs_low}g-{carbs_high}g"\nprotein_expected_str = f"{protein_expected}g"\ncarbs_actual_str = f"{carbs_actual:.1f}g"\nprotein_actual_str = f"{protein_actual:.1f}g"\n\noutput = f"""# Today\'s Meal Nutritional Analysis\n\n- **Carbohydrates**: {carbs_assessment}. Expected: {carbs_expected_str} | Actual: {carbs_actual_str}\n\n- **Protein**: {protein_assessment}. Expected: {protein_expected_str} | Actual: {protein_actual_str}\n"""\n\nprint(f"\\n=== OUTPUT ===")\nprint(output)\n\nwith open(\'/app/analysis.md\', \'w\') as f:\n    f.write(output)\n\nprint("Written to /app/analysis.md")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
