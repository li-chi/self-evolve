Sending keys: ['cat > /app/generate_reports.py << \'SCRIPTEOF\'\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.oxml.ns import qn, nsdecls\nfrom docx.oxml import parse_xml\nimport re\n\n# ============================================================\n# 1. Parse Resume Data\n# ============================================================\ndef parse_resumes(filepath):\n    d = Document(filepath)\n    full_text = "\\n".join(p.text for p in d.paragraphs)\n    candidates = {}\n    blocks = re.split(r\'(?=Candidate \\d+:)\', full_text)\n    for block in blocks:\n        block = block.strip()\n        if not block or \'Resumes of the candidates\' in block:\n            continue\n        lines = block.split(\'\\n\')\n        name = None\n        info_lines = []\n        for line in lines:\n            line = line.strip()\n            if line.startswith(\'Name:\'):\n                name = line.split(\':\', 1)[1].strip()\n            elif line.startswith(\'Candidate\'):\n                continue\n            else:\n                info_lines.append(line)\n        if name:\n            cleaned = [l for l in info_lines if l.strip()]\n            candidates[name] = \'\\n\'.join(cleaned)\n    return candidates\n\n# ============================================================\n# 2. Parse Interviewer Evaluation Data\n# ============================================================\ndef parse_evaluations(filepath):\n    d = Document(filepath)\n    full_text = "\\n".join(p.text for p in d.paragraphs)\n    candidates = {}\n    blocks = re.split(r\'(?=Candidate \\d+ Name:)\', full_text)\n    for block in blocks:\n        block = block.strip()\n        if not block:\n            continue\n        match = re.search(r\'Candidate \\d+ Name:\\s*(.+)\', block)\n        if not match:\n            continue\n        raw_name = match.group(1).strip()\n        name = raw_name.replace(\'_\', \' \')\n        # Extract everything after "Interviewer Evaluation:"\n        eval_start = block.index(\'Interviewer Evaluation:\')\n        eval_text = block[eval_start:]\n        # Strip the leading "Interviewer Evaluation:" line\n        eval_text = re.sub(r\'^Interviewer Evaluation:\\s*\\n?\', \'\', eval_text)\n        cleaned = \'\\n\'.join(l for l in eval_text.split(\'\\n\') if l.strip())\n        candidates[name] = cleaned\n    return candidates\n\n# ============================================================\n# 3. Evaluate Candidate Against Requirements\n# ============================================================\ndef evaluate_candidate(name, resume_text, eval_text):\n    reqs = [\n        ("Minimum Experience: 4+ years", False),\n        ("Education: Master degree or higher", False),\n        ("Top-tier University", False),\n        ("FAANG Experience", False),\n        ("Leadership Experience", False),\n        ("High-impact Projects", False),\n        ("Advanced Technical Skills: 3+ areas", False),\n        ("Recommendation Level: Exceptional/Outstanding", False),\n        ("Excellence Rating: 2+ mentions", False),\n        ("Salary Budget: Under $150K", False),\n    ]\n\n    # 1. Experience >= 4 years\n    exp_match = re.search(r\'(\\d+)\\s*years\', resume_text, re.IGNORECASE)\n    if exp_match and int(exp_match.group(1)) >= 4:\n        reqs[0] = (reqs[0][0], True)\n\n    # 2. Education: Master\'s or higher\n    if re.search(r\'master|phd|doctorate\', resume_text, re.IGNORECASE):\n        reqs[1] = (reqs[1][0], True)\n\n    # 3. Top-tier university\n    top_unis = [\'stanford\', \'mit\', \'cmu\', \'peking\', \'tsinghua\']\n    edu_match = re.search(r\'Education:\\s*(.+?)(?:\\n|$)\', resume_text, re.IGNORECASE)\n    if edu_match:\n        for uni in top_unis:\n            if uni in edu_match.group(1).lower():\n                reqs[2] = (reqs[2][0], True)\n                break\n\n    # 4. FAANG experience\n    faang = [\'google\', \'facebook\', \'amazon\', \'apple\', \'netflix\', \'meta\']\n    work_match = re.search(r\'Work Experience:\\s*(.+?)(?:\\n|$)\', resume_text, re.IGNORECASE)\n    if work_match:\n        for company in faang:\n            if company in work_match.group(1).lower():\n                reqs[3] = (reqs[3][0], True)\n                break\n\n    # 5. Leadership experience\n    if re.search(r\'led|leader|leadership|managed\', resume_text, re.IGNORECASE):\n        reqs[4] = (reqs[4][0], True)\n\n    # 6. High-impact projects (has numbers with + or %)\n    if \'+\' in resume_text or \'%\' in resume_text:\n        reqs[5] = (reqs[5][0], True)\n\n    # 7. Advanced Technical Skills: 3+ areas\n    skills_match = re.search(r\'Technical Skills:\\s*(.+?)(?:\\n|$)\', resume_text, re.IGNORECASE)\n    if skills_match:\n        skills = [s.strip() for s in skills_match.group(1).split(\',\')]\n        if len(skills) >= 3:\n            reqs[6] = (reqs[6][0], True)\n\n    # 8. Recommendation Level: Exceptional/Outstanding\n    if re.search(r\'excellent|outstanding\', eval_text, re.IGNORECASE):\n        reqs[7] = (reqs[7][0], True)\n\n    # 9. Excellence Rating: 2+ excellence mentions\n    excellent_count = len(re.findall(r\'excellent\', eval_text, re.IGNORECASE))\n    if excellent_count >= 2:\n        reqs[8] = (reqs[8][0], True)\n\n    # 10. Salary Budget: Under $150K\n    sal_match = re.search(r\'(?:Expected Salary:\\s*\\$?\\s*?(\\d+))\', resume_text, re.IGNORECASE)\n    if sal_match:\n        if int(sal_match.group(1)) < 150:\n            reqs[9] = (reqs[9][0], True)\n\n    met_count = sum(1 for _, v in reqs if v)\n    return reqs, met_count\n\n# ============================================================\n# 4. Create formatted Word document for a candidate\n# ============================================================\ndef set_cell_shading(cell, color_hex):\n    shading = parse_xml(f\'<w:shd {nsdecls("w")} w:fill="{color_hex}"/>\')\n    cell._tc.get_or_add_tcPr().append(shading)\n\ndef set_cell_font(cell, text, font_name=\'Cambria\', font_size=11, bold=False, alignment=None):\n    # Clear existing runs\n    for p in cell.paragraphs:\n        for r in p.runs:\n            r.text = \'\'\n    paragraph = cell.paragraphs[0]\n    paragraph.clear()\n    run = paragraph.add_run(text)\n    run.font.name = font_name\n    run.font.size = Pt(font_size)\n    run.bold = bold\n    if alignment:\n        paragraph.alignment = alignment\n    else:\n        paragraph.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    return run\n\ndef create_candidate_report(name, resume_text, eval_text, met_count, total_reqs, is_best=False):\n    doc = Document()\n\n    # === HEADING ===\n    heading = doc.add_paragraph()\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = heading.add_run(\'Candidate Interview Assessment Report\')\n    run.font.name = \'Calibri\'\n    run.font.size = Pt(14)\n    run.bold = True\n\n    # === CANDIDATE NAME ===\n    name_para = doc.add_paragraph()\n    run = name_para.add_run(f\'Candidate Name: {name}\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n\n    # === SECTION 1: Candidate Information ===\n    section1_title = doc.add_paragraph()\n    run = section1_title.add_run(\'Candidate Information:\')\n    run.bold = True\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n\n    resume_lines = resume_text.strip().split(\'\\n\')\n    for line in resume_lines:\n        if line.strip():\n            para = doc.add_paragraph()\n            run = para.add_run(line.strip())\n            run.font.name = \'Cambria\'\n            run.font.size = Pt(11)\n\n    # === SECTION 2: Interviewer Evaluation ===\n    section2_title = doc.add_paragraph()\n    run = section2_title.add_run(\'Interviewer Evaluation:\')\n    run.bold = True\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n\n    eval_lines = eval_text.strip().split(\'\\n\')\n    for line in eval_lines:\n        if line.strip():\n            para = doc.add_paragraph()\n            run = para.add_run(line.strip())\n            run.font.name = \'Cambria\'\n            run.font.size = Pt(11)\n\n    # === SECTION 3: Evaluation Conclusion ===\n    section3_title = doc.add_paragraph()\n    run = section3_title.add_run(\'Evaluation Conclusion:\')\n    run.bold = True\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n\n    # Create 2x2 table\n    table = doc.add_table(rows=2, cols=2)\n    table.style = \'Table Grid\'\n    table.alignment = WD_ALIGN_PARAGRAPH.CENTER\n\n    # Header row with D9D9D9\n    hc0 = table.rows[0].cells[0]\n    hc1 = table.rows[0].cells[1]\n    set_cell_shading(hc0, \'D9D9D9\')\n    set_cell_shading(hc1, \'D9D9D9\')\n    set_cell_font(hc0, \'Overall Assessment\', alignment=WD_ALIGN_PARAGRAPH.CENTER)\n    set_cell_font(hc1, \'Recommendation\', alignment=WD_ALIGN_PARAGRAPH.CENTER)\n\n    # Data row with DAEEF3\n    dc0 = table.rows[1].cells[0]\n    dc1 = table.rows[1].cells[1]\n    set_cell_shading(dc0, \'DAEEF3\')\n    set_cell_shading(dc1, \'DAEEF3\')\n\n    percentage = f\'{met_count * 10}%\'\n    if is_best:\n        recommendation = name\n    else:\n        recommendation = \'Not recommended\'\n\n    set_cell_font(dc0, percentage, alignment=WD_ALIGN_PARAGRAPH.CENTER)\n    set_cell_font(dc1, recommendation, alignment=WD_ALIGN_PARAGRAPH.CENTER)\n\n    filename = f\'Interview_Assessment_Report_{name.replace(" ", "_")}.docx\'\n    doc.save(filename)\n    print(f\'  Created: {filename}\')\n    return filename\n\n# ============================================================\n# MAIN\n# ============================================================\nprint(\'Parsing resumes...\')\nresumes = parse_resumes(\'/app/Candidates_resumes.docx\')\nprint(f\'  Found {len(resumes)} candidates: {list(resumes.keys())}\')\n\nprint(\'Parsing evaluations...\')\nevals = parse_evaluations(\'/app/Interviewer_evaluation.docx\')\nprint(f\'  Found {len(evals)} evaluations: {list(evals.keys())}\')\n\n# Evaluate all candidates\ncandidates_eval = []\nfor name in resumes:\n    resume_text = resumes[name]\n    eval_text = evals.get(name, \'No evaluation available.\')\n    reqs, met_count = evaluate_candidate(name, resume_text, eval_text)\n    total_reqs = len(reqs)\n    print(f\'\\n{name}: {met_count}/{total_reqs} requirements met\')\n    for i, (req, met) in enumerate(reqs):\n        status = \'YES\' if met else \'NO\'\n        print(f\'  {i+1}. {req}: {status}\')\n    candidates_eval.append((name, met_count, total_reqs, resume_text, eval_text, reqs))\n\n# Find best candidate\nbest = max(candidates_eval, key=lambda x: x[1])\nbest_name = best[0]\nprint(f\'\\nBest candidate: {best_name} ({best[1]}/{best[2]} requirements)\')\n\n# Create documents\nprint(\'\\nCreating assessment reports...\')\nfor name, met_count, total_reqs, resume_text, eval_text, reqs in candidates_eval:\n    is_best = (name == best_name)\n    create_candidate_report(name, resume_text, eval_text, met_count, total_reqs, is_best)\n\n# Write recommend.txt\nwith open(\'/app/recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f\'\\nrecommend.txt: {best_name}\')\nprint(\'Done!\')\nSCRIPTEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
