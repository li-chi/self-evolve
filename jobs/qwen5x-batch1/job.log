es):\n    # Get file extension\n    ext = f[f.rfind(\'.\'):]  # e.g. .c, .rs, .py\n    \n    # Extract student name from filename\n    # Filenames can be: "Name OS-...", "Name_OS-...", "Name OperatingSystems-...", "Name_OperatingSystems_..."\n    # The name is everything before the first OS/OperatingSystems keyword\n    fname_lower = f.lower()\n    \n    # Find where OS course identifier starts\n    match_os = None\n    for pattern in [\'operatingsystems-\', \'operatingsystems_\', \'os-\', \'os_\']:\n        idx = fname_lower.find(pattern)\n        if idx >= 0:\n            match_os = idx\n            break\n    \n    if match_os is None:\n        print(f"WARNING: Could not parse name from {f}")\n        continue\n    \n    # The name portion is before the OS keyword\n    # Use original filename to preserve case\n    name_part = f[:f[match_os:].lower().find(\'operatingsystems\' if \'operatingsystems\' in fname_lower else \'os\')]\n    # But we need the actual lowercase match position\n    name_part = f[:fname_lower.index(pattern)]\n    \n    # Strip trailing separator (space, hyphen, underscore)\n    name_part = name_part.rstrip(\' -_\')\n    \n    print(f"  Original: {f}")\n    print(f"  Name part: \'{name_part}\'")\n    \n    # Look up in mapping\n    if name_part in mapping:\n        student_id, college = mapping[name_part]\n    else:\n        print(f"  WARNING: No mapping for \'{name_part}\'")\n        continue\n    \n    # New filename: Name-College-StudentID-OS-HW3.ext\n    new_name = f"{name_part}-{college}-{student_id}-OS-HW3{ext}"\n    print(f"  New name: {new_name}")\n    \n    # Determine target directory\n    if ext == \'.c\':\n        target_dir = \'os_hw3/C\'\n    elif ext == \'.rs\':\n        target_dir = \'os_hw3/Rust\'\n    elif ext == \'.py\':\n        target_dir = \'os_hw3/Python\'\n    else:\n        print(f"  WARNING: Unknown extension {ext}")\n        continue\n    \n    # Rename and move\n    shutil.move(f, os.path.join(target_dir, new_name))\n\nprint("\\n=== Done renaming and organizing ===")\n\n# Now list remaining code files (to be deleted)\nremaining = []\nfor f in os.listdir(\'.\'):\n    fpath = os.path.join(\'.\', f)\n    if not os.path.isfile(fpath):\n        continue\n    if f.endswith(\'.tar.gz\') or f.endswith(\'.xlsx\'):\n        continue\n    if any(f.endswith(ext) for ext in [\'.c\', \'.rs\', \'.py\']):\n        remaining.append(f)\n\nprint(f"Remaining code files to delete: {len(remaining)}")\nfor f in sorted(remaining):\n    print(f"  {f}")\n\n# Delete remaining code files\nfor f in remaining:\n    os.remove(os.path.join(\'.\', f))\n    print(f"  Deleted: {f}")\n\nprint("\\n=== Cleanup complete ===")\nPYEOF\npython3 /tmp/process.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
