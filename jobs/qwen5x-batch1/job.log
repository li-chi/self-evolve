ped.split(\'考试\')\n            if parts and parts[0].strip():\n                name_parts.append(parts[0].strip())\n            break\n        if re.search(r\'[一二三四五六]\\s+\\d+-\\d+\', stripped):\n            break\n        # Check for Chinese text\n        cn = re.findall(r\'[一-龥]\', stripped)\n        if len(cn) >= 1:\n            # Skip lines that are pure teacher info\n            if \'副教授\' in stripped and \'教授\' not in stripped.split(\'副教授\')[0]:\n                continue\n            if \'讲师\' in stripped and \'教授\' not in stripped.split(\'讲师\')[0]:\n                continue\n            if re.search(r\'[一二三四五六]\\s+\\d+-\\d+\', stripped):\n                continue\n            name_parts.append(stripped)\n    \n    if name_parts:\n        name = \'\'.join(name_parts)\n        name = re.sub(r\'\\s+\', \' \', name).strip()\n        cn_count = len(re.findall(r\'[一-龥]\', name))\n        if cn_count >= 2:\n            return name\n    return None\n\ndef parse_course(block):\n    first = block[\'lines\'][0]\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+\', first)\n    if not m:\n        return None\n    cid = m.group(1)\n    name_part = first[m.end():]\n    cred_m = re.search(r\'\\s(\\d+)\\s\', name_part)\n    if not cred_m:\n        return None\n    \n    name = name_part[:cred_m.start()].strip()\n    credits = cred_m.group(1)\n    \n    cn_count = len(re.findall(r\'[一-龥]\', name))\n    if cn_count < 2:\n        # Name is on continuation lines\n        name = extract_name_from_continuation(block)\n        if not name or len(re.findall(r\'[一-龥]\', name)) < 2:\n            return None\n    else:\n        cn_match = re.search(r\'([一-龥]+(?:[一-龥]+))*[一-龥]{2,}\', name)\n        if cn_match:\n            name = cn_match.group(0).strip()\n        name = re.sub(r\'\\s+\', \' \', name).strip()\n    \n    wm = re.search(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', first)\n    weekday = wm.group(1) if wm else \'\'\n    time_range = wm.group(2) if wm else \'\'\n    weeks = wm.group(3) if wm else \'\'\n    class_time = f"{weekday} {time_range} {weeks}" if weekday else \'\'\n    \n    campus_m = re.search(r\'(邯郸校区|江湾校区|张江校区|枫林校区)\', first)\n    campus = campus_m.group(1) if campus_m else \'\'\n    \n    exam_type = \'\'\n    for t in [\'半开卷\', \'开卷\', \'闭卷\', \'论文\', \'其他\', \'口试\']:\n        if t in first:\n            exam_type = t\n            break\n    \n    t_m = re.search(r\'(教授|副教授|讲师|研究员|副研究员|高级工程师|青年研究员|助理研究员)\', first)\n    teacher = \'\'\n    if t_m:\n        teacher = first[:t_m.start()].strip()\n        teacher = re.sub(r\'^[A-Z]{2,6}\\d{6}\\.\\d+\\s+\', \'\', teacher)\n        teacher = re.sub(r\'\\s+\\d+\\s+\', \' \', teacher).strip()\n    \n    dept_kw = [\'马克思主义学院\', \'哲学学院\', \'中国语言文学系\', \'文学院\',\n               \'历史学系\', \'文物与博物馆学系\', \'国际文化交流学院\',\n               \'计算机科学技术学院\', \'软件学院\', \'信息科学与工程学院\', \'航空航天系\',\n               \'法学院\', \'艺术学院\', \'管理学院\', \'生命科学学院\',\n               \'环境科学\', \'物理学系\', \'化学系\', \'数学科学\', \'大气\', \'相辉\',\n               \'新闻\', \'社会发展\', \'社会学\', \'公共管理\', \'外国语言\',\n               \'艺术教育中心\', \'体育学院\', \'心理咨询\', \'大学外语\',\n               \'环境科学与工程系\', \'国际关系与\', \'传播学\', \'中外法律\',\n               \'管理科学\', \'留学生\', \'文物与考古\', \'文学系\', \'经济\',\n               \'政治学\', \'音乐\', \'舞蹈\', \'戏剧\', \'公共事务学\']\n    department = \'\'\n    for dk in dept_kw:\n        if dk in first:\n            di = first.rfind(dk)\n            department = first[di:].strip()\n            break\n    \n    exam_info = \'\'\n    for l in block[\'lines\']:\n        ed = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', l)\n        et = re.search(r\'考试时间:\\s*([^\\n]+)\', l)\n        if ed:\n            exam_info += ed.group(1) + \' \'\n        if et:\n            exam_info += et.group(1).strip() + \' \'\n    exam_info = exam_info.strip()\n    \n    sec = section_map.get(block[\'line\'], \'未知\')\n    \n    return {\n        \'course_id\': cid, \'course_name\': name, \'credits\': credits,\n        \'teacher\': teacher, \'weekday\': weekday, \'class_time\': class_time,\n        \'campus\': campus, \'exam_type\': exam_type, \'exam_info\': exam_info,\n        \'department\': department, \'section\': sec\n    }\n\ncourses = []\nfor block in course_blocks:\n    c = parse_course(block)\n    if c and c[\'course_name\']:\n        courses.append(c)\n\nprint(f"Total courses: {len(courses)}")\n\n# Required courses\nnatlang = [c for c in courses if c[\'course_name\'] == \'自然语言处理\'][0]\nsoftarch = [c for c in courses if c[\'course_name\'] == \'软件体系结构\'][0]\nprint(f"自然语言处理: {natlang[\'course_id\']}, {natlang[\'course_name\']}, {natlang[\'teacher\']}, {natlang[\'class_time\']}, {natlang[\'campus\']}, {natlang[\'exam_type\']}")\nprint(f"软件体系结构: {softarch[\'course_id\']}, {softarch[\'course_name\']}, {softarch[\'teacher\']}, {softarch[\'class_time\']}, {softarch[\'campus\']}, {softarch[\'exam_type\']}")\n\n# 通识核心 Monday 开卷\ntongshi_mon_kj = [c for c in courses if c[\'section\'] == \'通识核心\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\']\nfor c in tongshi_mon_kj:\n    print(f"通识核心: {c[\'course_id\']}, {c[\'course_name\']}, {c[\'credits\']}, {c[\'teacher\']}, {c[\'class_time\']}, {c[\'campus\']}, {c[\'exam_type\']}, {c[\'department\']}")\nprint(f"Total: {len(tongshi_mon_kj)}")\n\n# 思政B Monday 开卷\nsizhengB_mon_kj = [c for c in courses if c[\'section\'] == \'思政B\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\']\nfor c in sizhengB_mon_kj:\n    print(f"思政B: {c[\'course_id\']}, {c[\'course_name\']}, {c[\'credits\']}, {c[\'teacher\']}, {c[\'class_time\']}, {c[\'campus\']}, {c[\'exam_type\']}, {c[\'department\']}")\nprint(f"Total: {len(sizhengB_mon_kj)}")\n\n# Generate Excel files\nref_cols = [\'Course name\', \'Course ID\', \'Instructor\', \'Campus\', \'Class Time\',\n            \'Enrollment\', \'Credits\', \'Assessment Method\', \'Exam Time\', \'Course Selection Restrictions\']\n\nfor idx, tongshi in enumerate(tongshi_mon_kj):\n    data = []\n    for c in [natlang, softarch, sizhengB_mon_kj[0], tongshi]:\n        data.append({\n            \'Course name\': c[\'course_name\'],\n            \'Course ID\': c[\'course_id\'],\n            \'Instructor\': c[\'teacher\'],\n            \'Campus\': c[\'campus\'],\n            \'Class Time\': c[\'class_time\'],\n            \'Enrollment\': c[\'department\'],\n            \'Credits\': c[\'credits\'],\n            \'Assessment Method\': c[\'exam_type\'],\n            \'Exam Time\': c[\'exam_info\'],\n            \'Course Selection Restrictions\': \'\'\n        })\n    df = pd.DataFrame(data)\n    fname = f"/app/选课方案_{idx+1}.xlsx"\n    df.to_excel(fname, index=False, engine=\'openpyxl\')\n    print(f"Saved: {fname}")\n\n# Clean up temp files\nfor f in [\'schedule.txt\', \'schedule_nolayout.txt\', \'page21.txt\', \'tmp_pg.txt\',\n          \'parse_final.py\', \'final_gen.py\', \'final_gen2.py\', \'gen_final.py\',\n          \'gen_output.py\', \'solve.py\', \'parse_schedule.py\', \'parse_schedule2.py\',\n          \'parse_v3.py\', \'find_tongshi.py\', \'all_courses.json\', \'gen_final3.py\',\n          \'/app/reference_format.xlsx\']:\n    try:\n        os.remove(f)\n        print(f"Deleted: {f}")\n    except FileNotFoundError:\n        pass\n\nprint(f"\\nDone! {len(tongshi_mon_kj)} Excel files generated.")\nPYEOF\npython3 /app/gen_final3.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
