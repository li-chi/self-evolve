Sending keys: ['cat > /tmp/generate_docs.py << \'PYEOF\'\nimport re\nfrom docx import Document\nfrom docx.shared import Pt, Inches, Cm, RGBColor\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.oxml.ns import qn, nsdecls\nfrom docx.oxml import parse_xml\n\ndef normalize_name(n):\n    return n.strip().replace(\'_\', \' \').strip()\n\ndef parse_resumes():\n    doc = Document(\'/app/Candidates_resumes.docx\')\n    full_text = \'\\n\'.join(p.text for p in doc.paragraphs)\n    blocks = re.split(r\'(?=Candidate\\s+\\d+:)\', full_text)\n    candidates = {}\n    for block in blocks:\n        block = block.strip()\n        if not block:\n            continue\n        name_match = re.search(r\'Name:\\s*([^\\n]+)\', block)\n        if not name_match:\n            continue\n        name = name_match.group(1).strip()\n        gender_m = re.search(r\'Gender:\\s*([^\\n]+)\', block)\n        age_m = re.search(r\'Age:\\s*([^\\n]+)\', block)\n        edu_m = re.search(r\'Education:\\s*([^\\n]+)\', block)\n        work_m = re.search(r\'Work Experience:\\s*([^\\n]+)\', block)\n        skills_m = re.search(r\'Technical Skills:\\s*([^\\n]+)\', block)\n        proj_match = re.search(r\'Project Experience:\\s*\\n((?:[-].*\\n?)+)\', block)\n        proj = proj_match.group(1).strip() if proj_match else \'\'\n        contact_m = re.search(r\'Contact:\\s*([^\\n]+)\', block)\n        salary_m = re.search(r\'Expected Salary:\\s*([^\\n]+)\', block)\n        norm = normalize_name(name)\n        candidates[norm] = {\n            \'name\': name,\n            \'gender\': gender_m.group(1).strip() if gender_m else \'\',\n            \'age\': age_m.group(1).strip() if age_m else \'\',\n            \'education\': edu_m.group(1).strip() if edu_m else \'\',\n            \'work_experience\': work_m.group(1).strip() if work_m else \'\',\n            \'technical_skills\': skills_m.group(1).strip() if skills_m else \'\',\n            \'project_experience\': proj,\n            \'contact\': contact_m.group(1).strip() if contact_m else \'\',\n            \'expected_salary\': salary_m.group(1).strip() if salary_m else \'\'\n        }\n    return candidates\n\ndef parse_evaluations():\n    doc = Document(\'/app/Interviewer_evaluation.docx\')\n    blocks = []\n    current_block = []\n    for p in doc.paragraphs:\n        text = p.text.strip()\n        if text.startswith(\'Candidate \') and \'Name:\' in text:\n            if current_block:\n                blocks.append(\'\\n\'.join(current_block))\n            current_block = [text]\n        elif text:\n            current_block.append(text)\n    if current_block:\n        blocks.append(\'\\n\'.join(current_block))\n    evaluations = {}\n    for block in blocks:\n        m = re.search(r\'Name:\\s*(.+)\', block)\n        if m:\n            name = normalize_name(m.group(1).strip())\n            evaluations[name] = block\n    return evaluations\n\nresumes = parse_resumes()\nevaluations = parse_evaluations()\n\nprint("Resume names (normalized):", list(resumes.keys()))\nprint("Eval names (normalized):", list(evaluations.keys()))\n\n# ============ Evaluate candidates ============\ntop_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\nFAANG = [\'google\', \'meta\', \'amazon\', \'netflix\', \'apple\', \'microsoft\', \'youtube\', \'instagram\']\n\nALL_CRITERIA = [\n    \'experience_4plus\', \'education_master_or_higher\', \'top_tier_university\',\n    \'faang_experience\', \'leadership_experience\', \'high_impact_projects\',\n    \'advanced_tech_skills_3plus\', \'recommendation_exceptional_outstanding\',\n    \'excellence_2plus\', \'salary_under_150k\'\n]\n\ndef check_candidate(name, resume, eval_text):\n    if not resume:\n        return {c: False for c in ALL_CRITERIA}, 0, 0\n    e = eval_text.lower() if eval_text else \'\'\n    proj = resume.get(\'project_experience\', \'\').lower()\n    work = resume.get(\'work_experience\', \'\').lower()\n    edu = resume.get(\'education\', \'\')\n    edu_lower = edu.lower()\n    skills = [s.strip() for s in resume.get(\'technical_skills\', \'\').split(\',\') if s.strip()]\n    salary_str = resume.get(\'expected_salary\', \'\')\n    exp = re.search(r\'(\\d+)\\s+years\', resume.get(\'work_experience\', \'\'))\n    c1 = int(exp.group(1)) >= 4 if exp else False\n    c2 = \'master\' in edu_lower or \'phd\' in edu_lower or \'doctor\' in edu_lower\n    c3 = any(u in edu for u in top_universities)\n    companies = re.findall(r\'(?:previously\\s+(?:at|worked\\s+at)|currently\\s+at)\\s+([A-Za-z]+)\', resume.get(\'work_experience\', \'\'), re.IGNORECASE)\n    c4 = any(any(f in c.lower() for f in FAANG) for c in companies)\n    c5 = bool(re.search(r\'lead\', proj)) or bool(re.search(r\'lead\', e))\n    c6 = bool(re.search(r\'\\d+\\+|\\d+%\', proj)) or \'million\' in proj or \'billion\' in proj\n    c7 = len(skills) >= 3\n    c8 = \'exceptional\' in e or \'outstanding\' in e\n    c9 = (e.count(\'exceptional\') + e.count(\'outstanding\')) >= 2\n    sal = re.search(r\'\\$(\\d+)[Kk]\', salary_str)\n    c10 = int(sal.group(1)) < 150 if sal else True\n    results = [c1, c2, c3, c4, c5, c6, c7, c8, c9, c10]\n    score = sum(results)\n    pct = int(round(score / len(results) * 100))\n    return dict(zip(ALL_CRITERIA, results)), pct, score\n\nall_scores = {}\nfor name in resumes:\n    r = resumes[name]\n    ev = evaluations.get(name, \'\')\n    res, pct, score = check_candidate(name, r, ev)\n    all_scores[name] = {\'score\': score, \'pct\': pct, \'results\': res}\n    met = [k for k, v in res.items() if v]\n    not_met = [k for k, v in res.items() if not v]\n    status = "NO EVAL" if not ev else "ok"\n    print(f"{name}: {score}/{len(ALL_CRITERIA)} ({pct}%) eval={status} met={met}")\n    if not_met:\n        print(f"  Not met: {not_met}")\n\nbest_name = max(all_scores.keys(), key=lambda n: all_scores[n][\'score\'])\nprint(f"\\n=== BEST CANDIDATE: {best_name} ===")\n\n# ============ Generate documents ============\ndef add_run(paragraph, text, font_name=\'Cambria\', font_size=11, bold=False, italic=False, alignment=None):\n    run = paragraph.add_run(text)\n    run.font.name = font_name\n    run.font.size = Pt(font_size)\n    run.bold = bold\n    run.italic = italic\n    if alignment is not None:\n        paragraph.alignment = alignment\n    rPr = run._element.get_or_add_rPr()\n    rFonts = parse_xml(f\'<w:rFonts {nsdecls("w")} w:ascii="{font_name}" w:hAnsi="{font_name}" w:eastAsia="{font_name}" w:cs="{font_name}"/>\')\n    rPr.append(rFonts)\n    return run\n\ndef set_cell_shading(cell, color_hex):\n    shading_elm = parse_xml(f\'<w:shd {nsdecls("w")} w:fill="{color_hex}"/>\')\n    cell._tc.get_or_add_tcPr().append(shading_elm)\n\ndef set_cell_alignment(cell, h_align=WD_ALIGN_PARAGRAPH.CENTER):\n    cell.paragraphs[0].alignment = h_align\n    tc = cell._tc\n    tcPr = tc.get_or_add_tcPr()\n    tcPr.set(qn(\'w:vAlign\'), \'top\')\n\nfor name in sorted(resumes.keys()):\n    r = resumes[name]\n    ev = evaluations.get(name, \'\')\n    pct = all_scores[name][\'pct\']\n    \n    doc = Document()\n    \n    # ---- Heading ----\n    heading = doc.add_paragraph()\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    add_run(heading, \'Candidate Interview Assessment Report\',\n            font_name=\'Calibri\', font_size=14, bold=True, alignment=WD_ALIGN_PARAGRAPH.CENTER)\n    \n    # ---- Candidate Name ----\n    name_para = doc.add_paragraph()\n    name_para.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    add_run(name_para, f"Candidate Name: {name}", font_name=\'Cambria\', font_size=11)\n    \n    # ---- Section 1: Candidate Information ----\n    section1_title = doc.add_paragraph()\n    section1_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    add_run(section1_title, \'Candidate Information:\', font_name=\'Cambria\', font_size=11, bold=True)\n    \n    info_lines = []\n    for key in [\'gender\', \'age\', \'education\', \'work_experience\', \'technical_skills\']:\n        if r.get(key):\n            info_lines.append(f"{key.replace(\'_\', \' \').title()}: {r[key]}")\n    if r.get(\'project_experience\'):\n        info_lines.append(f"Project Experience:\\n{r[\'project_experience\']}")\n    if r.get(\'contact\'):\n        info_lines.append(f"Contact: {r[\'contact\']}")\n    if r.get(\'expected_salary\'):\n        info_lines.append(f"Expected Salary: {r[\'expected_salary\']}")\n    \n    info_text = \'\\n\'.join(info_lines)\n    info_para = doc.add_paragraph()\n    add_run(info_para, info_text, font_name=\'Cambria\', font_size=11)\n    \n    # ---- Section 2: Interviewer Evaluation ----\n    section2_title = doc.add_paragraph()\n    section2_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    add_run(section2_title, \'Interviewer Evaluation:\', font_name=\'Cambria\', font_size=11, bold=True)\n    \n    if ev:\n        clean_eval = re.sub(r\'^Candidate\\s+\\d+\\s+Name:\\s*[^\\n]+\\n?\', \'\', ev)\n        eval_para = doc.add_paragraph()\n        add_run(eval_para, clean_eval, font_name=\'Cambria\', font_size=11)\n    else:\n        no_eval = doc.add_paragraph()\n        add_run(no_eval, \'No evaluation available.\', font_name=\'Cambria\', font_size=11)\n    \n    # ---- Section 3: Evaluation Conclusion ----\n    section3_title = doc.add_paragraph()\n    section3_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    add_run(section3_title, \'Evaluation Conclusion:\', font_name=\'Cambria\', font_size=11, bold=True)\n    \n    # 2x2 table\n    table = doc.add_table(rows=2, cols=2)\n    table.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    \n    tbl = table._tbl\n    tblPr = tbl.tblPr if tbl.tblPr is not None else parse_xml(f\'<w:tblPr {nsdecls("w")}/>\')\n    borders = parse_xml(\n        f\'<w:tblBorders {nsdecls("w")}>\'\n        \'  <w:top w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:left w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:bottom w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:right w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideH w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideV w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'</w:tblBorders>\'\n    )\n    tblPr.append(borders)\n    \n    # Header row\n    for col_idx, cell_text in enumerate([\'Overall Assessment\', \'Recommendation\']):\n        cell = table.cell(0, col_idx)\n        cell.text = \'\'\n        p = cell.paragraphs[0]\n        add_run(p, cell_text, font_name=\'Cambria\', font_size=11, bold=True)\n        set_cell_alignment(cell, WD_ALIGN_PARAGRAPH.CENTER)\n        set_cell_shading(cell, \'D9D9D9\')\n    \n    # Data row\n    recommendation = best_name if name == best_name else \'Not recommended\'\n    for col_idx, cell_text in enumerate([f"{pct}%", recommendation]):\n        cell = table.cell(1, col_idx)\n        cell.text = \'\'\n        p = cell.paragraphs[0]\n        add_run(p, cell_text, font_name=\'Cambria\', font_size=11)\n        set_cell_alignment(cell, WD_ALIGN_PARAGRAPH.CENTER)\n        set_cell_shading(cell, \'DAEEF3\')\n    \n    safe_name = name.replace(\' \', \'_\')\n    filename = f\'/app/Interview_Assessment_Report_{safe_name}.docx\'\n    doc.save(filename)\n    print(f"Created: {filename}")\n\n# Write recommend.txt\nwith open(\'/app/recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f"\\nWrote recommend.txt: {best_name}")\nPYEOF\npython3 /tmp/generate_docs.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
