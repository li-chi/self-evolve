Sending keys: ['python3 << \'EOF\'\nimport openpyxl\nfrom openpyxl import Workbook\n\nwb = openpyxl.load_workbook(\'/app/Market_Data.xlsx\')\n\n# Parse Methodology sheet\nws_meth = wb[\'Methodology\']\n\n# Source names from Methodology row 2, cols C-Q\nmeth_col_names = {}\nfor col in range(3, 18):\n    val = ws_meth.cell(row=2, column=col).value\n    if val is not None:\n        meth_col_names[col] = val\n\nprint("Methodology sources:", meth_col_names)\n\n# Raw data\nws_raw = wb[\'RawData\']\nraw_col_names = {}\nfor col in range(2, 17):\n    val = ws_raw.cell(row=4, column=col).value\n    if val is not None:\n        raw_col_names[col] = val\n\nprint("Raw data sources:", raw_col_names)\n\n# Map methodology source -> raw data column\n# By matching source names\nsrc_to_raw_col = {}\nfor mcol, msrc in meth_col_names.items():\n    for rcol, rsrc in raw_col_names.items():\n        if msrc == rsrc:\n            src_to_raw_col[mcol] = rcol\n            break\n\nprint("Source mapping:", src_to_raw_col)\n\n# Parse segments (rows 4-13, col B)\ndef to_float(v):\n    if v is None:\n        return None\n    try:\n        return float(v)\n    except (ValueError, TypeError):\n        return None\n\nsegments = []\nfor row in range(4, 14):\n    seg_name = ws_meth.cell(row=row, column=2).value\n    if seg_name is None or seg_name == \'Total\':\n        continue\n    mappings = []\n    for mcol in range(3, 18):\n        w = to_float(ws_meth.cell(row=row, column=mcol).value)\n        if w is not None:\n            if mcol in src_to_raw_col:\n                mappings.append((src_to_raw_col[mcol], w))\n    segments.append((seg_name, mappings))\n\nprint("\\nSegments parsed:")\nfor sn, ms in segments:\n    parts = []\n    for rc, w in ms:\n        parts.append(f"{raw_col_names[rc]}={w}")\n    print(f"  {sn}: {parts}")\n\n# Read raw data by year\nyears_data = {}\nfor row in range(5, ws_raw.max_row + 1):\n    year = ws_raw.cell(row=row, column=1).value\n    if year is None:\n        continue\n    rd = {}\n    for col in range(2, 17):\n        rd[col] = ws_raw.cell(row=row, column=col).value\n    years_data[year] = rd\n\nprint("\\nYears:", sorted(years_data.keys()))\n\n# Verify a specific value\nprint("\\nVerification - Auto OEM (Electric=col 7) 2015:")\nprint("  Raw Electric 2015:", to_float(years_data[2015][7]))\nprint("  Row 6 col H:", ws_raw.cell(row=6, column=8).value)\n\n# Calculate segment values\ntarget_years = list(range(2015, 2025))\nseg_vals = {}\nfor sn, ms in segments:\n    seg_vals[sn] = {}\n    for year in target_years:\n        total = 0.0\n        for rcol, w in ms:\n            v = to_float(years_data[year].get(rcol))\n            if v is None:\n                v = 0.0\n            total += v * w\n        seg_vals[sn][year] = total\n        print(f"  {sn} {year}: {total}")\n\n# YoY growth\ngrowth = {}\nfor sn in [s[0] for s in segments]:\n    growth[sn] = {}\n    for i, year in enumerate(target_years):\n        if i == 0:\n            growth[sn][year] = None\n        else:\n            prev = seg_vals[sn][target_years[i-1]]\n            curr = seg_vals[sn][year]\n            if prev and prev != 0:\n                growth[sn][year] = round((curr - prev) / prev * 100, 1)\n            else:\n                growth[sn][year] = None\n        print(f"  {sn} YoY {year}: {growth[sn][year]}")\n\n# Write output\nwb_out = Workbook()\nws_out = wb_out.active\nheaders = [\'Year\'] + [s[0] for s in segments]\nws_out.append(headers)\nfor year in target_years:\n    row = [year]\n    for sn in [s[0] for s in segments]:\n        row.append(growth[sn][year])\n    ws_out.append(row)\n\nwb_out.save(\'/app/segment_growth_rates.xlsx\')\nprint("\\nSaved successfully!")\n\n# Verify output\nwb2 = openpyxl.load_workbook(\'/app/segment_growth_rates.xlsx\')\nws2 = wb2.active\nfor r in ws2.iter_rows(values_only=True):\n    print(r)\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
