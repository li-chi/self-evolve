Sending keys: ['cat > /tmp/generate.py << \'PYEOF\'\nimport pdfplumber\nimport openpyxl\nfrom openpyxl import Workbook\n\n# Helper to extract time info from a course section in text\ndef parse_course_section(text, course_name):\n    """Parse a section of text for a specific course and return its details"""\n    lines = text.split(\'\\n\')\n    # Find the course line\n    result = []\n    i = 0\n    while i < len(lines):\n        line = lines[i]\n        if course_name in line:\n            # Start parsing from this line\n            # Course data spans multiple lines, collect until next course or empty\n            block_lines = []\n            while i < len(lines):\n                curr = lines[i]\n                block_lines.append(curr)\n                # Check if next line starts a new course\n                if i + 1 < len(lines):\n                    next_line = lines[i+1]\n                    if next_line.strip().startswith(\'考试日期\') and not curr.strip().startswith(\'考试\'):\n                        break\n                    if \'.0\' in next_line.split()[0] if next_line.split() else False:\n                        if course_name not in next_line:\n                            break\n                i += 1\n                if i < len(lines) and lines[i].strip().startswith(\'考试日期\'):\n                    if \'.0\' not in lines[i]:\n                        break\n            \n            full_text = \'\\n\'.join(block_lines)\n            \n            # Extract fields\n            info = {}\n            # Course number\n            parts = full_text.split()\n            for p in parts:\n                if p.startswith(\'COMP\') or p.startswith(\'PTSS\') or p.startswith(\'PHIL\') or \\\n                   p.startswith(\'FORE\') or p.startswith(\'BIOL\') or p.startswith(\'HIST\') or \\\n                   p.startswith(\'ECON\') or p.startswith(\'SOCI\') or p.startswith(\'INFO\') or \\\n                   p.startswith(\'MACR\') or p.startswith(\'NDEC\') or p.startswith(\'FINE\'):\n                    if \'.0\' in p:\n                        info[\'id\'] = p\n                        break\n            \n            # Course name - find after course ID\n            idx = full_text.find(course_name)\n            if idx > 0:\n                name_text = full_text[idx:idx+len(course_name)]\n                info[\'name\'] = name_text\n            \n            # Check for Monday (一) and 开卷\n            if \'一\' in full_text and \'开卷\' in full_text:\n                info[\'monday_ok\'] = True\n            \n            # Time extraction - find pattern like 一 2-3 [1-16]\n            import re\n            # Pattern: 一 X-X [Y] or 二 X-X [Y] etc.\n            time_match = re.search(r\'([一二三四五六])\\s+(\\d+)-(\\d+)\\s+\\[(\\d[\\d,-]*)\\]\', full_text)\n            if time_match:\n                day = {\'一\':\'Mon\',\'二\':\'Tue\',\'三\':\'Wed\',\'四\':\'Thu\',\'五\':\'Fri\',\'六\':\'Sat\'}[time_match.group(1)]\n                start = int(time_match.group(2))\n                end = int(time_match.group(3))\n                info[\'day\'] = day\n                info[\'time\'] = f"周{day[0]} 第{start}-{end}节"\n                info[\'time_slots\'] = (start, end)\n            \n            # Instructor\n            # Look for Chinese name followed by title\n            name_title_patterns = [\n                (r\'([\\u4e00-\\u9fa5]+?)\\s*(?:教授|副教授|讲师|研究员|助理研究员|青年研究员|高级工程师)\', full_text)\n            ]\n            for pattern, txt in name_title_patterns:\n                nm = re.search(pattern, txt)\n                if nm:\n                    info[\'instructor\'] = nm.group(1)\n                    break\n            \n            # Campus\n            if \'邯郸校区\' in full_text:\n                info[\'campus\'] = \'邯郸校区\'\n            elif \'枫林校区\' in full_text:\n                info[\'campus\'] = \'枫林校区\'\n            elif \'江湾校区\' in full_text:\n                info[\'campus\'] = \'江湾校区\'\n            elif \'张江校区\' in full_text:\n                info[\'campus\'] = \'张江校区\'\n            \n            # Credits\n            cred_match = re.search(r\'\\n\\s*(\\d+)\\s+\', full_text)\n            if cred_match:\n                info[\'credits\'] = int(cred_match.group(1))\n            \n            # Exam type\n            info[\'exam_type\'] = \'开卷\' if \'开卷\' in full_text else \'闭卷\' if \'闭卷\' in full_text else \'论文\' if \'论文\' in full_text else \'其他\'\n            \n            # Exam time\n            exam_time_match = re.search(r\'考试时间:\\s*(.+?)\\n\', full_text)\n            if exam_time_match:\n                info[\'exam_time\'] = exam_time_match.group(1).strip()\n            \n            result.append(info)\n            continue\n        i += 1\n    return result\n\n# Let me take a different approach - parse each target page more carefully\npages_data = {}\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    for p in [29, 30, 32, 33, 34, 35, 51, 52, 54]:  # pages 30, 31, 33, 34, 35, 52, 53, 55\n        text = pdf.pages[p].extract_text()\n        pages_data[p+1] = text\n\n# Now parse the specific courses\nall_courses = []\n\ndef parse_single_course_block(text, course_name):\n    """Find and extract a complete course block"""\n    idx = text.find(course_name)\n    if idx < 0:\n        return None\n    \n    # Go back to find the course ID\n    start = idx\n    # Look backward for the course ID pattern\n    search_start = max(0, idx - 100)\n    pre_text = text[search_start:idx]\n    \n    # The course block: look forward until the next course block\n    end = min(len(text), idx + 2000)\n    block = text[start:end]\n    \n    # Find all time slots in this block\n    import re\n    \n    # Extract exam type\n    exam_type = \'其他\'\n    if \'开卷\' in block:\n        exam_type = \'开卷\'\n    elif \'闭卷\' in block:\n        exam_type = \'闭卷\'\n    elif \'论文\' in block:\n        exam_type = \'论文\'\n    \n    # Extract exam time\n    exam_time_match = re.search(r\'考试时间:\\s*(.+?)$\', block, re.MULTILINE)\n    exam_time = exam_time_match.group(1).strip() if exam_time_match else \'\'\n    \n    # Extract exam date\n    exam_date_match = re.search(r\'考试日期:\\s*(\\S+)\', block)\n    exam_date = exam_date_match.group(1) if exam_date_match else \'\'\n    \n    # Extract campus\n    campus = \'邯郸校区\'\n    if \'枫林校区\' in block:\n        campus = \'枫林校区\'\n    elif \'江湾校区\' in block:\n        campus = \'江湾校区\'\n    elif \'张江校区\' in block:\n        campus = \'张江校区\'\n    \n    # Extract day and time\n    times = []\n    day_map = {\'一\':\'一\',\'二\':\'二\',\'三\':\'三\',\'四\':\'四\',\'五\':\'五\',\'六\':\'六\'}\n    for m in re.finditer(r\'([一二三四五六])\\s+(\\d+)-(\\d+)\\s+\\[(.+?)\\]\', block):\n        times.append({\n            \'day\': m.group(1),\n            \'start\': int(m.group(2)),\n            \'end\': int(m.group(3)),\n            \'weeks\': m.group(4)\n        })\n    \n    # Extract instructor and title\n    instructor = \'\'\n    title = \'\'\n    for m in re.finditer(r\'([\\u4e00-\\u9fa5]+?)\\s*(教授|副教授|讲师|研究员|助理研究员|青年副研究员|青年研究员|高级工程师|教授\\(教)\', block):\n        if not instructor:  # First match is instructor\n            instructor = m.group(1)\n            raw_title = m.group(2)\n            title = raw_title.replace(\'(教学\', \'\').replace(\'为主型)\', \'\').replace(\'为主型\', \'\')\n            # Fix title\n            if title in [\'教授\', \'副教授\', \'讲师\', \'研究员\', \'助理研究员\', \'青年研究员\', \'高级工程师\']:\n                pass\n            elif \'教授\' in raw_title:\n                title = \'教授(教学为主型)\'\n            elif \'副教授\' in raw_title:\n                title = \'副教授(教学为主型)\'\n            break\n    \n    # Find course ID\n    course_id = \'\'\n    for m in re.finditer(r\'(COMP\\d+|PTSS\\d+|PHIL\\d+|FORE\\d+|BIOL\\d+|HIST\\d+|ECON\\d+|SOCI\\d+|INFO\\d+|MACR\\d+|NDEC\\d+|FINE\\d+)\\.\', block):\n        course_id = m.group(1)\n        break\n    \n    # Find credits - look for number near course info\n    # Search in the header area before the course name\n    pre_idx = idx - 50\n    pre_section = text[max(0, pre_idx):idx]\n    credit = 0\n    for m in re.finditer(r\'(?:^|\\n)\\s*(\\d+)\\s*[\\u4e00-\\u9fa5]\', pre_section):\n        val = int(m.group(1))\n        if 0 < val <= 10:  # reasonable credit range\n            credit = val\n            break\n    \n    # Enrollment\n    enroll_match = re.search(r\'\\n\\s*(\\d{2,3})\\s+(?:思政|开卷|闭卷|论文)\', block)\n    # or after campus\n    if not enroll_match:\n        enroll_match = re.search(r\'\\n\\s*(\\d{2,3})\\s+(?:[\\u4e00-\\u9fa5].*[\\u4e00-\\u9fa5])\', block)\n    enroll = 0\n    for m in re.finditer(r\'校区\\s+(\\d+)\', block):\n        val = int(m.group(1))\n        if 10 <= val <= 300:  # reasonable enrollment\n            enroll = val\n            break\n    \n    return {\n        \'id\': course_id,\n        \'name\': course_name,\n        \'instructor\': instructor,\n        \'title\': title,\n        \'campus\': campus,\n        \'times\': times,\n        \'exam_type\': exam_type,\n        \'exam_time\': exam_time,\n        \'exam_date\': exam_date,\n        \'credit\': credit,\n        \'enrollment\': enroll\n    }\n\n# Parse all target courses\ncourses_to_find = [\n    \'自然语言处理\',\n    \'软件体系结构\',\n    \'中国共产党历史\',  # 思政B 开卷 Mon\n]\n\nfor course_name in courses_to_find:\n    for page_num, text in pages_data.items():\n        course = parse_single_course_block(text, course_name)\n        if course:\n            print(f"Found: {course[\'name\']} (ID: {course[\'id\']})")\n            print(f"  Instructor: {course[\'instructor\']}, Campus: {course[\'campus\']}")\n            for t in course[\'times\']:\n                print(f"  Time: 周{t[\'day\']} 第{t[\'start\']}-{t[\'end\']}节 [{t[\'weeks\']}]")\n            print(f"  Exam: {course[\'exam_type\']}, {course[\'exam_time\']}")\n            print(f"  Credits: {course[\'credit\']}, Enrollment: {course[\'enrollment\']}")\n            all_courses.append(course)\n\n# Now find 通识教育核心课程 开卷 on Monday\nprint("\\n=== Looking for 通识教育核心课程 Monday 开卷 ===")\ngencore_candidates = [\n    (\'PHIL119059.01\', \'《功利主义》研读\'),\n    (\'FORE119008.01\', \'英国经典小说与19世纪社会\'),\n    (\'BIOL119008.01\', \'微生物与人类健康\'),\n]\n\nfor cid, name in gencore_candidates:\n    for page_num, text in pages_data.items():\n        if name in text and cid in text:\n            course = parse_single_course_block(text, name)\n            if course and course.get(\'times\'):\n                # Check if Monday and 开卷\n                monday_slots = [t for t in course[\'times\'] if t[\'day\'] == \'一\']\n                if monday_slots and course[\'exam_type\'] == \'开卷\':\n                    print(f"Found: {course[\'name\']} (ID: {course[\'id\']})")\n                    print(f"  Instructor: {course[\'instructor\']}, Campus: {course[\'campus\']}")\n                    for t in monday_slots:\n                        print(f"  Time: 周{t[\'day\']} 第{t[\'start\']}-{t[\'end\']}节 [{t[\'weeks\']}]")\n                    print(f"  Exam: {course[\'exam_type\']}, {course[\'exam_time\']}")\n                    print(f"  Credits: {course[\'credit\']}, Enrollment: {course[\'enrollment\']}")\n                    all_courses.append(course)\n\nprint(f"\\nTotal courses found: {len(all_courses)}")\nPYEOF\npython3 /tmp/generate.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
