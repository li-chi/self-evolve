se 0\n        results.append({\n            \'name\': r[\'name\'],\n            \'path\': r[\'path\'],\n            \'matched_types\': matched_types,\n            \'match_count\': len(matched_types),\n            \'total_types\': len(total_types),\n            \'ratio\': ratio,\n            \'match_details\': match_details,\n            \'all_ingredients\': ing_names,\n            \'all_ingredient_details\': [(i[0], i[1]) for i in ing_list]\n        })\n\n# Sort by ratio descending, then by match count\nresults.sort(key=lambda x: (-x[\'ratio\'], -x[\'match_count\'], -x[\'total_types\']))\n\nprint(\'Dishes matching our ingredients (ratio >= 0.2):\')\nprint(\'=\'*80)\nfor i, r in enumerate(results):\n    if r[\'ratio\'] < 0.2:\n        break\n    print(f"\\n#{i+1} {r[\'name\']} (matched {r[\'match_count\']}/{r[\'total_types\']} = {r[\'ratio\']*100:.0f}%)")\n    for ours, name, amt in r[\'match_details\']:\n        amt_str = amt if amt else \'适量\'\n        print(f\'  [OUR] {ours} -> recipe: {name} ({amt_str})\')\n    # Show missing ingredients\n    our_set = set(our_exact)\n    # We need at least 50% from stock - that means our ingredients should be >= half\n    # Actually re-read: "at least half of the ingredient types coming from our existing stock"\n    # So our matched types / total types >= 0.5\n\nprint(\'\\n\\n=== ALL dishes sorted by ratio ===\')\nfor r in results:\n    print(f"  {r[\'name\']}: {r[\'match_count\']}/{r[\'total_types\']} = {r[\'ratio\']*100:.0f}%")\nPYEOF\npython3 /app/select_dishes.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
