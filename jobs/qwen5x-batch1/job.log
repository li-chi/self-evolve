Sending keys: ['cat > /app/gen_output.py << \'PYEOF\'\nimport re\nimport pandas as pd\nimport json\nfrom itertools import product\nimport os\n\nwith open(\'/app/schedule.txt\', \'r\', encoding=\'utf-8\') as f:\n    lines = f.readlines()\n\n# Build section map\ncurrent_sec = \'未知\'\nsection_map = {}\nfor i, line in enumerate(lines):\n    raw = line.strip()\n    if \'通识教育核心课程——七大模块课程\' in raw and \'第 页\' not in raw:\n        current_sec = \'通识核心\'\n    elif \'通识教育核心课程——公共艺术课程\' in raw:\n        current_sec = \'通识核心\'\n    elif \'通识教育核心课程——思想政治理论课程B组\' in raw:\n        current_sec = \'思政B\'\n    elif \'基础课程和专业课程\' in raw:\n        current_sec = \'专业\'\n    for j in range(i, min(i+5, len(lines))):\n        section_map[j] = current_sec\n\nfor i in range(len(lines)):\n    if i not in section_map and i > 0:\n        for j in range(i-1, -1, -1):\n            if j in section_map:\n                section_map[i] = section_map[j]\n                break\n\n# Collect course entries as blocks (from course ID line to next course ID line)\ncourse_blocks = []\ncurrent_block = None\nfor i, line in enumerate(lines):\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+\', line)\n    if m:\n        if current_block:\n            course_blocks.append(current_block)\n        current_block = {\'line\': i, \'lines\': [line]}\n    elif current_block:\n        current_block[\'lines\'].append(line)\nif current_block:\n    course_blocks.append(current_block)\n\ndef parse_block(block):\n    first_line = block[\'lines\'][0]\n    \n    # Course ID\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+\', first_line)\n    if not m:\n        return None\n    cid = m.group(1)\n    \n    # Merge all lines\n    merged = \'\'.join(l for l in block[\'lines\'])\n    \n    # Extract name - between CID and credits on first line\n    name_m = re.match(r\'^\\s*[A-Z]{2,6}\\d{6}\\.\\d+\\s+(.+?)\\s+(\\d+)\\s\', first_line)\n    if not name_m:\n        return None\n    \n    # The name is between CID and credits\n    # Try to get name from first line\n    name = \'\'\n    # Get text after CID on first line, before credits\n    rest = first_line[m.end():]\n    # Credits is a number before whitespace\n    cm = re.search(r\'\\s(\\d+)\\s\', rest)\n    if cm:\n        before_credits = rest[:cm.start()].strip()\n        name = before_credits\n        credits = cm.group(1)\n    else:\n        return None\n    \n    # Check continuation lines for name parts\n    for l in block[\'lines\'][1:]:\n        stripped = l.strip()\n        if \'考试\' in stripped and \'考试\' not in \'考试时间\':\n            continue\n        # Name continuation - lines with Chinese text that aren\'t exam info\n        if re.match(r\'^\\s+[一-龟].{2,}\', stripped) and \'考试\' not in stripped:\n            name += stripped\n        elif re.match(r\'^\\s+.{2,}$\', stripped) and \'考试\' not in stripped and \'考试时间\' not in stripped and \'考试日期\' not in stripped:\n            # Check if it\'s not a time info line\n            if not re.search(r\'[一二三四五六]\\s+\\d\', stripped):\n                name += stripped\n    \n    name = re.sub(r\'\\s+\', \' \', name).strip()\n    name = re.sub(r\'^\\s*[\\d\\-\\s]+\', \'\', name).strip()  # Remove leading numbers/dashes\n    name = re.sub(r\'\\s+\', \' \', name).strip()\n    \n    # Time info\n    wm = re.search(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', first_line)\n    weekday = wm.group(1) if wm else \'\'\n    time_range = wm.group(2) if wm else \'\'\n    weeks = wm.group(3) if wm else \'\'\n    \n    # Also get sub-entries (multiple weekday/time combos)\n    sub_entries = []\n    all_wm = re.findall(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', merged)\n    for sw, st, swk in all_wm:\n        if (sw, st, swk) != (weekday, time_range, weeks):\n            sub_entries.append(f"{sw} {st} {swk}")\n    \n    if sub_entries:\n        class_time = f"{weekday} {time_range} {weeks} (含{sub_entries[0]})"\n        if len(sub_entries) > 1:\n            class_time += f", {sub_entries[1]}"\n    else:\n        class_time = f"{weekday} {time_range} {weeks}" if weekday else \'\'\n    \n    campus_m = re.search(r\'(邯郸校区|江湾校区|张江校区|枫林校区)\', first_line)\n    campus = campus_m.group(1) if campus_m else \'\'\n    \n    # Exam type\n    exam_type = \'\'\n    for t in [\'开卷\', \'闭卷\', \'论文\', \'其他\', \'半开卷\']:\n        if t in first_line:\n            exam_type = t\n            break\n    \n    # Teacher\n    t_m = re.search(r\'(教授|副教授|讲师|研究员|副研究员|高级工程师|青年研究员|助理研究员)\', first_line)\n    teacher = \'\'\n    if t_m:\n        teacher = first_line[:t_m.start()].strip()\n        teacher = re.sub(r\'^[A-Z]{2,6}\\d{6}\\.\\d+\\s+\', \'\', teacher)\n        teacher = re.sub(r\'\\s+\\d+\\s+\', \' \', teacher).strip()\n    \n    # Department\n    dept_kw = [\'马克思主义学院\', \'哲学学院\', \'中国语言文学系\', \'文学院\',\n               \'历史学系\', \'文物与博物馆学系\', \'国际文化交流学院\',\n               \'计算机科学技术学院\', \'软件学院\', \'信息科学与工程学院\', \'航空航天系\',\n               \'法学院\', \'艺术学院\', \'管理学院\', \'生命科学学院\',\n               \'环境科学\', \'物理学系\', \'化学系\', \'数学科学\', \'大气\', \'相辉\',\n               \'新闻\', \'社会发展\', \'社会学\', \'公共管理\', \'外国语言\',\n               \'艺术教育中心\', \'体育学院\', \'心理咨询\', \'大学外语\',\n               \'环境科学与工程系\', \'国际关系与\', \'传播学\', \'中外法律\',\n               \'管理科学\', \'留学生\', \'文物与考古\', \'文学系\', \'经济\',\n               \'政治学\', \'音乐\', \'舞蹈\', \'戏剧\', \'公共事务学\']\n    department = \'\'\n    for dk in dept_kw:\n        if dk in first_line:\n            di = first_line.rfind(dk)\n            department = first_line[di:].strip()\n            break\n    \n    # Exam info\n    exam_info = \'\'\n    for l in block[\'lines\']:\n        ed = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', l)\n        et = re.search(r\'考试时间:\\s*([^\\n]+)\', l)\n        if ed:\n            exam_info += ed.group(1) + \' \'\n        if et:\n            exam_info += et.group(1).strip() + \' \'\n    exam_info = exam_info.strip()\n    \n    sec = section_map.get(block[\'line\'], \'未知\')\n    \n    return {\n        \'course_id\': cid, \'course_name\': name, \'credits\': credits,\n        \'teacher\': teacher, \'weekday\': weekday, \'class_time\': class_time,\n        \'campus\': campus, \'exam_type\': exam_type, \'exam_info\': exam_info,\n        \'department\': department, \'section\': sec\n    }\n\ncourses = []\nfor block in course_blocks:\n    c = parse_block(block)\n    if c:\n        courses.append(c)\n\nprint(f"Total courses: {len(courses)}")\n\n# Required courses\nnatlang = [c for c in courses if c[\'course_name\'] == \'自然语言处理\'][0]\nsoftarch = [c for c in courses if c[\'course_name\'] == \'软件体系结构\'][0]\nprint(f"自然语言处理: {natlang[\'course_id\']}, {natlang[\'course_name\']}, {natlang[\'teacher\']}, {natlang[\'class_time\']}, {natlang[\'campus\']}, {natlang[\'exam_type\']}, {natlang[\'exam_info\']}, {natlang[\'department\']}")\nprint(f"软件体系结构: {softarch[\'course_id\']}, {softarch[\'course_name\']}, {softarch[\'teacher\']}, {softarch[\'class_time\']}, {softarch[\'campus\']}, {softarch[\'exam_type\']}, {softarch[\'exam_info\']}, {softarch[\'department\']}")\n\n# 通识核心 Monday 开卷\ntongshi_mon_kj = [c for c in courses if c[\'section\'] == \'通识核心\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\']\nfor c in tongshi_mon_kj:\n    print(f"通识核心 Mon 开卷: {c[\'course_id\']}, {c[\'course_name\']}, {c[\'credits\']}学分, {c[\'teacher\']}, {c[\'class_time\']}, {c[\'campus\']}, {c[\'exam_type\']}, {c[\'exam_info\']}, {c[\'department\']}")\nprint(f"Total 通识核心 Mon 开卷: {len(tongshi_mon_kj)}")\n\n# 思政B Monday 开卷\nsizhengB_mon_kj = [c for c in courses if c[\'section\'] == \'思政B\' and c[\'weekday\'] == \'一\' and c[\'exam_type\'] == \'开卷\']\nfor c in sizhengB_mon_kj:\n    print(f"思政B Mon 开卷: {c[\'course_id\']}, {c[\'course_name\']}, {c[\'credits\']}学分, {c[\'teacher\']}, {c[\'class_time\']}, {c[\'campus\']}, {c[\'exam_type\']}, {c[\'exam_info\']}, {c[\'department\']}")\nprint(f"Total 思政B Mon 开卷: {len(sizhengB_mon_kj)}")\n\n# Generate Excel files\n# Each combination: 自然语言处理 + 软件体系结构 + 1 思政B Mon 开卷 + 1 通识核心 Mon 开卷\n# = 1 * 4 = 4 combinations\n\nref_cols = [\'Course name\', \'Course ID\', \'Instructor\', \'Campus\', \'Class Time\', \n            \'Enrollment\', \'Credits\', \'Assessment Method\', \'Exam Time\', \'Course Selection Restrictions\']\n\nall_options = []\nfor tongshi in tongshi_mon_kj:\n    for sizheng in sizhengB_mon_kj:\n        all_options.append([\n            [natlang, softarch, sizheng, tongshi]\n        ])\n\nprint(f"\\nTotal combinations: {len(all_options)}")\n\nfor idx, option in enumerate(all_options):\n    fname = f"/app/course_selection_{idx+1}.xlsx"\n    df = pd.DataFrame(option, columns=ref_cols)\n    df.to_excel(fname, index=False, engine=\'openpyxl\')\n    print(f"Saved: {fname}")\n\n# Clean up temporary files\nfor f in [\'schedule.txt\', \'parse_schedule.py\', \'parse_schedule2.py\', \'parse_final.py\', \'parse_v3.py\', \'find_tongshi.py\', \'solve.py\', \'all_courses.json\', \'/app/reference_format.xlsx\']:\n    try:\n        os.remove(f)\n        print(f"Deleted: {f}")\n    except:\n        pass\n\nprint("\\nDone!")\nPYEOF\npython3 /app/gen_output.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
