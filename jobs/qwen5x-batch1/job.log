Sending keys: ['python3 -c "\nwith open(\'/app/NOTE.md\', \'w\') as f:\n    f.write(\'# Compiler Principles - Lecture Notes\\n\')\n    f.write(\'## Chapter 5: Semantic Analysis (Symbol Tables)\\n\\n\')\n    f.write(\'---\\n\\n\')\n    f.write(\'## 1. Symbol Table Overview\\n\\n\')\n    f.write(\'### What is Semantic Analysis?\\n\')\n    f.write(\'The semantic analysis phase of a compiler does three things:\\n\')\n    f.write(\'1. **Connects variable definitions to their uses** - resolves which declaration an identifier refers to.\\n\')\n    f.write(\'2. **Checks that each expression has a correct type** - type checking.\\n\')\n    f.write(\'3. **Translates the abstract syntax into a simpler representation** suitable for generating machine code.\\n\\n\')\nprint(\'Part 1 done\')\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
