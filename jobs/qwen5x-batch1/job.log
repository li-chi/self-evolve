Sending keys: ["cat > /app/solve.py << 'PYEOF'\nimport openpyxl\nimport pandas as pd\n\nwb = openpyxl.load_workbook('/app/Market_Data.xlsx', data_only=True)\nmethod_ws = wb['Methodology']\nraw_ws = wb['RawData']\n\nsource_names = []\nfor col in range(3, 18):\n    source_names.append(method_ws.cell(row=2, column=col).value)\nprint('Source names:', source_names)\n\nsegments = []\nfor row in range(4, 15):\n    seg_name = method_ws.cell(row=row, column=2).value\n    if seg_name is None or seg_name == 'Total':\n        continue\n    components = {}\n    for col in range(3, 18):\n        val = method_ws.cell(row=row, column=col).value\n        if val is not None and isinstance(val, (int, float)) and val != 0:\n            src_name = source_names[col - 3]\n            components[src_name] = val\n    segments.append((seg_name, components))\n    print('Segment:', seg_name, components)\n\nprint('Segment order:', [s[0] for s in segments])\n\nraw_headers = []\nfor col in range(2, 17):\n    raw_headers.append(raw_ws.cell(row=4, column=col).value)\nprint('RawData headers:', raw_headers)\n\nyear_lookup = dict()\nfor row in range(5, 30):\n    year = raw_ws.cell(row=row, column=1).value\n    if year is None:\n        continue\n    values = dict()\n    for ci, header in enumerate(raw_headers):\n        val = raw_ws.cell(row=row, column=ci + 2).value\n        values[header] = val\n    year_lookup[year] = values\n\ntarget_years = list(range(2015, 2025))\n\nsource_growth = dict()\nfor year in target_years:\n    prev_year = year - 1\n    source_growth[year] = dict()\n    for src in raw_headers:\n        curr_val = year_lookup.get(year, dict()).get(src)\n        prev_val = year_lookup.get(prev_year, dict()).get(src)\n        if curr_val is not None and prev_val is not None and prev_val != 0:\n            gr = (curr_val - prev_val) / prev_val * 100\n            source_growth[year][src] = gr\n        else:\n            source_growth[year][src] = None\n\nresults = []\nfor year in target_years:\n    row = {'Year': year}\n    for seg_name, components in segments:\n        weighted_sum = 0.0\n        can_calc = True\n        for src, weight in components.items():\n            gr = source_growth[year].get(src)\n            if gr is None:\n                can_calc = False\n                break\n            weighted_sum += gr * weight\n        if can_calc:\n            row[seg_name] = round(weighted_sum, 1)\n        else:\n            row[seg_name] = 'N/A'\n    results.append(row)\n\nfor r in results:\n    print(r)\n\nout_columns = ['Year'] + [s[0] for s in segments]\ndf = pd.DataFrame(results)\ndf = df[out_columns]\ndf.to_excel('/app/segment_growth_rates.xlsx', index=False)\nprint('Saved to /app/segment_growth_rates.xlsx')\nPYEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
