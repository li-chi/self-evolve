Sending keys: ['cat > generate_reports.py << \'PYEOF\'\nfrom docx import Document\nfrom docx.shared import Pt, Inches, RGBColor, Cm\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\nimport re\n\n# ---- Parse Candidates ----\ndef parse_candidates():\n    doc = Document(\'Candidates_resumes.docx\')\n    text = "\\n".join(p.text for p in doc.paragraphs)\n    \n    candidates = {}\n    # Split by "Candidate N:" patterns\n    entries = re.split(r\'\\nCandidate \\d+:\', text)\n    entries = [e for e in entries if \'Name:\' in e]\n    \n    for entry in entries:\n        lines = entry.strip().split(\'\\n\')\n        name = None\n        for line in lines:\n            line = line.strip()\n            if line.startswith(\'Name:\'):\n                name = line.replace(\'Name:\', \'\').strip()\n                break\n        if name:\n            candidates[name] = \'\\n\'.join(lines)\n    return candidates\n\n# ---- Parse Interviewer Evaluations ----\ndef parse_evaluations():\n    doc = Document(\'Interviewer_evaluation.docx\')\n    paragraphs = doc.paragraphs\n    \n    evaluations = {}\n    current_name = None\n    current_eval = ""\n    \n    for para in paragraphs:\n        text = para.text.strip()\n        # Detect candidate name\n        m = re.match(r\'Candidate \\d+ Name:\\s*(\\S+)\', text)\n        if m:\n            if current_name and current_eval:\n                evaluations[current_name] = current_eval\n            # Convert underscore to space and title case\n            name = m.group(1).replace(\'_\', \' \')\n            current_name = name\n            current_eval = ""\n        elif current_name:\n            current_eval += text + "\\n"\n    \n    if current_name and current_eval:\n        evaluations[current_name] = current_eval\n    return evaluations\n\n# ---- Evaluate Candidates ----\ndef evaluate_candidate(candidates):\n    criterion = {\n        \'min_experience\': False,\n        \'education\': False,\n        \'top_university\': False,\n        \'faang\': False,\n        \'leadership\': False,\n        \'high_impact\': False,\n        \'tech_skills\': False,\n        \'recommendation\': False,\n        \'excellence\': False,\n        \'salary\': False,\n    }\n    \n    # Build evaluation text for checking\n    eval_text = ""\n    \n    for name, resume in candidates.items():\n        eval_text = evaluations.get(name, "")\n        \n        # 1. Minimum Experience: 4+ years\n        m = re.search(r\'Work Experience:\\s*(\\d+)\', resume)\n        if m:\n            years = int(m.group(1))\n            if years >= 4:\n                criterion[\'min_experience\'] = True\n        \n        # 2. Education: Master degree or higher\n        edu = ""\n        for line in resume.split(\'\\n\'):\n            if line.startswith(\'Education:\'):\n                edu = line.replace(\'Education:\', \'\').strip()\n                break\n        if \'Master\' in edu or \'PhD\' in edu or \'Doctor\' in edu:\n            criterion[\'education\'] = True\n        \n        # 3. Top-tier University\n        top_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\n        for uni in top_universities:\n            if uni in edu:\n                criterion[\'top_university\'] = True\n                break\n        \n        # 4. FAANG Experience\n        faang_companies = [\'Google\', \'Meta\', \'Apple\', \'Netflix\', \'Amazon\', \'Facebook\']\n        for line in resume.split(\'\\n\'):\n            if \'Work Experience:\' in line or \'previously\' in line.lower():\n                pass\n        work_line = ""\n        for line in resume.split(\'\\n\'):\n            if \'Work Experience:\' in line:\n                work_line = line\n                break\n        for line in resume.split(\'\\n\'):\n            work_line += " " + line\n        for company in faang_companies:\n            if company in work_line:\n                criterion[\'faang\'] = True\n                break\n        \n        # 5. Leadership Experience\n        leadership_words = [\'led\', \'lead\', \'leadership\', \'led development\', \'managed\']\n        for line in resume.split(\'\\n\'):\n            if any(w in line.lower() for w in leadership_words):\n                criterion[\'leadership\'] = True\n                break\n        if eval_text:\n            for line in eval_text.split(\'\\n\'):\n                if any(w in line.lower() for w in [\'leadership\', \'led team\', \'led research\']):\n                    criterion[\'leadership\'] = True\n        \n        # 6. High-impact Projects\n        impact_words = [\'vulnerabilities\', \'zero-trust\', \'threat detection\', \'CI/CD\',\n                        \'deployment\', \'millions\', \'users\', \'uptime\', \'download\',\n                        \'latency\', \'revenue\', \'accuracy\', \'conversion\']\n        project_lines = []\n        in_projects = False\n        for line in resume.split(\'\\n\'):\n            if \'Project Experience:\' in line:\n                in_projects = True\n                continue\n            if in_projects:\n                if line.strip().startswith(\'-\'):\n                    project_lines.append(line)\n                elif line.strip() == \'\':\n                    if len(project_lines) > 0:\n                        break\n        project_text = \'\\n\'.join(project_lines)\n        for word in impact_words:\n            if word in project_text.lower():\n                criterion[\'high_impact\'] = True\n                break\n        \n        # 7. Advanced Technical Skills: 3+ areas\n        skills = []\n        in_skills = False\n        for line in resume.split(\'\\n\'):\n            if \'Technical Skills:\' in line:\n                in_skills = True\n                skills_text = line.replace(\'Technical Skills:\', \'\').strip()\n                if skills_text:\n                    for s in skills_text.split(\',\'):\n                        s = s.strip()\n                        if s:\n                            skills.append(s)\n                continue\n            if in_skills:\n                if line.strip().startswith(\'-\'):\n                    break\n                if line.strip() == \'\':\n                    break\n                for s in line.split(\',\'):\n                    s = s.strip()\n                    if s:\n                        skills.append(s)\n        if len(skills) >= 3:\n            criterion[\'tech_skills\'] = True\n        \n        # 8. Recommendation Level: Exceptional/Outstanding only\n        if eval_text:\n            eval_lower = eval_text.lower()\n            if \'exceptional\' in eval_lower or \'outstanding\' in eval_lower:\n                criterion[\'recommendation\'] = True\n        \n        # 9. Excellence Rating: 2+ excellence mentions\n        if eval_text:\n            exc_count = eval_text.lower().count(\'excellent\') + eval_text.lower().count(\'exceptional\')\n            if exc_count >= 2:\n                criterion[\'excellence\'] = True\n        \n        # 10. Salary Budget: Under $150K\n        salary_match = re.search(r\'(\\$\\d+K)\', work_line)\n        if not salary_match:\n            # Try other lines\n            for line in resume.split(\'\\n\'):\n                m = re.search(r\'(\\$\\d+K)\', line)\n                if m:\n                    salary_match = m\n                    break\n        if salary_match:\n            salary_str = salary_match.group(1).replace(\'$\', \'\')\n            salary_num = int(salary_str.replace(\'K\', \'\'))\n            if salary_num < 150:\n                criterion[\'salary\'] = True\n        else:\n            # Check for CNY range\n            salary_match2 = re.search(r\'(\\d+K-\\d+K)\', work_line)\n            if not salary_match2:\n                for line in resume.split(\'\\n\'):\n                    m = re.search(r\'(\\d+K-\\d+K)\', line)\n                    if m:\n                        salary_match2 = m\n                        break\n            if salary_match2:\n                # CNY salary - very low compared to USD threshold\n                criterion[\'salary\'] = True\n    \n    return criterion\n\ndef evaluate_single_candidate(name, resume):\n    criterion = {\n        \'min_experience\': False,\n        \'education\': False,\n        \'top_university\': False,\n        \'faang\': False,\n        \'leadership\': False,\n        \'high_impact\': False,\n        \'tech_skills\': False,\n        \'recommendation\': False,\n        \'excellence\': False,\n        \'salary\': False,\n    }\n    \n    eval_text = evaluations.get(name, "")\n    \n    # 1. Minimum Experience: 4+ years\n    m = re.search(r\'Work Experience:\\s*(\\d+)\', resume)\n    if m:\n        years = int(m.group(1))\n        if years >= 4:\n            criterion[\'min_experience\'] = True\n    \n    # 2. Education: Master degree or higher\n    edu = ""\n    for line in resume.split(\'\\n\'):\n        if line.startswith(\'Education:\'):\n            edu = line.replace(\'Education:\', \'\').strip()\n            break\n    if \'Master\' in edu or \'PhD\' in edu or \'Doctor\' in edu:\n        criterion[\'education\'] = True\n    \n    # 3. Top-tier University\n    top_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\n    for uni in top_universities:\n        if uni in edu:\n            criterion[\'top_university\'] = True\n            break\n    \n    # 4. FAANG Experience\n    faang_companies = [\'Google\', \'Meta\', \'Apple\', \'Netflix\', \'Amazon\', \'Facebook\']\n    work_line = ""\n    for line in resume.split(\'\\n\'):\n        work_line += " " + line\n    for company in faang_companies:\n        if company in work_line:\n            criterion[\'faang\'] = True\n            break\n    \n    # 5. Leadership Experience\n    leadership_words = [\'led\', \'lead\', \'leadership\', \'led development\', \'led\']\n    for line in resume.split(\'\\n\'):\n        if any(w in line.lower() for w in [\'led \', \'lead \']):\n            criterion[\'leadership\'] = True\n            break\n    if eval_text:\n        for line in eval_text.split(\'\\n\'):\n            if \'leadership\' in line.lower() or \'led team\' in line.lower():\n                criterion[\'leadership\'] = True\n    \n    # 6. High-impact Projects\n    project_lines = []\n    in_projects = False\n    for line in resume.split(\'\\n\'):\n        if \'Project Experience:\' in line:\n            in_projects = True\n            continue\n        if in_projects:\n            if line.strip().startswith(\'-\'):\n                project_lines.append(line)\n            elif line.strip() == \'\' and project_lines:\n                break\n    project_text = \'\\n\'.join(project_lines)\n    impact_keywords = [\'vulnerabilities\', \'zero-trust\', \'threat detection\', \'CI/CD\',\n                       \'deployment\', \'million\', \'millions\', \'users\', \'uptime\',\n                       \'download\', \'latency\', \'revenue\', \'accuracy\', \'conversion\',\n                       \'optimization\', \'improving\']\n    for kw in impact_keywords:\n        if kw in project_text.lower():\n            criterion[\'high_impact\'] = True\n            break\n    \n    # 7. Advanced Technical Skills: 3+ areas\n    skills = []\n    in_skills = False\n    for line in resume.split(\'\\n\'):\n        if \'Technical Skills:\' in line:\n            in_skills = True\n            skills_text = line.replace(\'Technical Skills:\', \'\').strip()\n            if skills_text:\n                for s in skills_text.split(\',\'):\n                    s = s.strip()\n                    if s:\n                        skills.append(s)\n            continue\n        if in_skills:\n            if line.strip().startswith(\'-\'):\n                break\n            if line.strip() == \'\':\n                break\n            for s in line.split(\',\'):\n                s = s.strip()\n                if s:\n                    skills.append(s)\n    if len(skills) >= 3:\n        criterion[\'tech_skills\'] = True\n    \n    # 8. Recommendation Level: Exceptional/Outstanding\n    if eval_text:\n        eval_lower = eval_text.lower()\n        if \'exceptional\' in eval_lower or \'outstanding\' in eval_lower:\n            criterion[\'recommendation\'] = True\n    \n    # 9. Excellence Rating: 2+ excellence mentions\n    if eval_text:\n        exc_count = eval_text.lower().count(\'excellent\') + eval_text.lower().count(\'exceptional\')\n        if exc_count >= 2:\n            criterion[\'excellence\'] = True\n    \n    # 10. Salary Budget: Under $150K\n    salary_text = ""\n    for line in resume.split(\'\\n\'):\n        if \'Expected Salary\' in line or \'Salary:\' in line:\n            salary_text = line\n            break\n    if not salary_text:\n        for line in resume.split(\'\\n\'):\n            if \'Expected\' in line:\n                salary_text = line\n                break\n    \n    usd_match = re.search(r\'(\\$)(\\d+)K\', salary_text)\n    if usd_match:\n        salary_num = int(usd_match.group(2))\n        if salary_num < 150:\n            criterion[\'salary\'] = True\n    else:\n        # CNY or other - check if under 150K in the original currency\n        # Any non-USD or very low salary in local currency is under $150K\n        criterion[\'salary\'] = True\n    \n    return criterion\n\n# ---- Format text for resume (remove section headers) ----\ndef clean_resume_text(name, resume):\n    # Remove "Candidate N:" prefix\n    lines = resume.split(\'\\n\')\n    result = []\n    in_skip = False\n    for line in lines:\n        if re.match(r\'^Candidate \\d+:\', line):\n            in_skip = True\n            continue\n        if in_skip:\n            in_skip = False\n            continue\n        result.append(line)\n    return \'\\n\'.join(result)\n\n# ---- Format text for evaluation ----\ndef clean_eval_text(name, eval_text):\n    # Remove "Candidate N Name: X" prefix\n    lines = eval_text.split(\'\\n\')\n    result = []\n    in_skip = False\n    for line in lines:\n        if re.match(r\'^Candidate \\d+ Name:\', line):\n            in_skip = True\n            continue\n        if in_skip:\n            in_skip = False\n            continue\n        result.append(line)\n    return \'\\n\'.join(result).strip()\n\n# ---- Set cell shading ----\ndef set_cell_shading(cell, color_hex):\n    shading_elm = cell._element.get_or_add_tcPr()\n    shading = cell._element.makeelement(qn(\'w:shd\'), {\n        qn(\'w:fill\'): color_hex,\n        qn(\'w:val\'): \'clear\',\n    })\n    shading_elm.append(shading)\n\n# ---- Create formatted Word document ----\ndef create_report(name, resume, eval_text, criteria):\n    doc = Document()\n    \n    # 1. First-Level Heading: "Candidate Interview Assessment Report"\n    heading = doc.add_paragraph()\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = heading.add_run(\'Candidate Interview Assessment Report\')\n    run.font.name = \'Calibri\'\n    run.font.size = Pt(14)\n    run.bold = True\n    \n    # 2. Candidate Name\n    name_para = doc.add_paragraph()\n    name_para.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = name_para.add_run(f\'Candidate Name: {name}\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    \n    # 3. Section 1: Candidate Information\n    section1_title = doc.add_paragraph()\n    section1_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = section1_title.add_run(\'Candidate Information:\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    run.bold = True\n    \n    section1_body = doc.add_paragraph()\n    section1_body.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = section1_body.add_run(clean_resume_text(name, resume))\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    \n    # 4. Section 2: Interviewer Evaluation\n    section2_title = doc.add_paragraph()\n    section2_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = section2_title.add_run(\'Interviewer Evaluation:\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    run.bold = True\n    \n    section2_body = doc.add_paragraph()\n    section2_body.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = section2_body.add_run(clean_eval_text(name, eval_text))\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    \n    # 5. Section 3: Evaluation Conclusion with table\n    section3_title = doc.add_paragraph()\n    section3_title.alignment = WD_ALIGN_PARAGRAPH.LEFT\n    run = section3_title.add_run(\'Evaluation Conclusion:\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    run.bold = True\n    \n    # Calculate percentage\n    total = len(criteria)\n    met = sum(1 for v in criteria.values() if v)\n    percentage = int(round(met / total * 100))\n    \n    # Determine recommendation\n    is_best = (met == total)  # All 10 criteria met\n    \n    # Create 2x2 table\n    table = doc.add_table(rows=2, cols=2)\n    table.style = \'Table Grid\'\n    table.alignment = WD_TABLE_ALIGNMENT.CENTER\n    \n    # Header Row: D9D9D9\n    header0 = table.cell(0, 0)\n    header0_text = header0.paragraphs[0]\n    header0_text.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = header0_text.add_run(\'Overall Assessment\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    set_cell_shading(header0, \'D9D9D9\')\n    # Top alignment\n    for paragraph in header0_text.runs:\n        paragraph._element.get_or_add_pPr()\n    \n    header1 = table.cell(0, 1)\n    header1_text = header1.paragraphs[0]\n    header1_text.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = header1_text.add_run(\'Recommendation\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    set_cell_shading(header1, \'D9D9D9\')\n    \n    # Data Row: DAEEF3\n    data0 = table.cell(1, 0)\n    data0_text = data0.paragraphs[0]\n    data0_text.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = data0_text.add_run(f\'{percentage}%\')\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    set_cell_shading(data0, \'DAEEF3\')\n    \n    data1 = table.cell(1, 1)\n    data1_text = data1.paragraphs[0]\n    data1_text.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    if is_best:\n        rec_text = \'Best match\'\n    else:\n        rec_text = \'Not recommended\'\n    run = data1_text.add_run(rec_text)\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    set_cell_shading(data1, \'DAEEF3\')\n    \n    # Set vertical alignment (top) for all cells\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    \n    filename = f\'Interview_Assessment_Report_{name.replace(" ", "_")}.docx\'\n    doc.save(filename)\n    print(f\'  Created: {filename} ({met}/{total} criteria, {percentage}%)\')\n    return is_best, met, percentage\n\n# ---- Main ----\ncandidates = parse_candidates()\nevaluations = parse_evaluations()\n\nprint(f\'Found {len(candidates)} candidates and {len(evaluations)} evaluations\')\nprint()\n\nbest_name = None\nbest_score = -1\n\nfor name in sorted(candidates.keys()):\n    resume = candidates[name]\n    eval_text = evaluations.get(name, \'\')\n    criteria = evaluate_single_candidate(name, resume)\n    met = sum(1 for v in criteria.values() if v)\n    total = len(criteria)\n    percentage = int(round(met / total * 100))\n    \n    print(f\'{name}: {met}/{total} criteria met\')\n    for k, v in criteria.items():\n        status = \'✓\' if v else \'✗\'\n        print(f\'  {status} {k}\')\n    \n    if met > best_score:\n        best_score = met\n        best_name = name\n    \n    # Also save criteria for report generation\n    name + \'_criteria\'  # just reference\n\nprint(f\'\\nBest candidate so far: {best_name} ({best_score}/{len(criteria)})\')\n\n# Now check if best candidate meets ALL criteria\nbest_criteria = evaluate_single_candidate(best_name, candidates[best_name])\nall_met = sum(1 for v in best_criteria.values() if v) == len(best_criteria)\nprint(f\'Best candidate {best_name} meets all criteria: {all_met}\')\n\nprint(\'\\n--- Generating Reports ---\')\n\nfor name in sorted(candidates.keys()):\n    resume = candidates[name]\n    eval_text = evaluations.get(name, \'\')\n    criteria = evaluate_single_candidate(name, resume)\n    is_best, met, percentage = create_report(name, resume, eval_text, criteria)\n\n# Write recommend.txt\nwith open(\'recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f\'\\nWrote recommend.txt: {best_name}\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
