current_entry['campus'] = text\n                    continue\n                \n                # Exam info\n                if '考试日期' in text:\n                    current_entry['exam_date'] = text.split(':', 1)[-1].strip()\n                    continue\n                if '考试时间' in text:\n                    current_entry['exam_time'] = text.split(':', 1)[-1].strip()\n                    continue\n                \n                # Assessment\n                if text in ('开卷', '闭卷', '论文', '口试', '其他', '论文/报告', '报告', '随堂考试'):\n                    current_entry['assessment'] = text\n                    continue\n                \n                # 含A+\n                if text == '是' and current_entry.get('assessment'):\n                    current_entry['has_a_plus'] = True\n                    continue\n                \n                # Dept keywords\n                dept_kw = ['学院', '系', '研究中心', '研究所']\n                if any(kw in text for kw in dept_kw):\n                    dept = current_entry.get('department', '')\n                    if dept:\n                        current_entry['department'] = dept + ' ' + text\n                    else:\n                        current_entry['department'] = text\n                    continue\n                \n                if in_entry:\n                    # Try to assign based on what's available\n                    if not current_entry.get('credits') and re.match(r'^\\d+\\.?\\d*$', text) and len(text) <= 3:\n                        # Could be credits\n                        # Check if next item or context suggests it's credits\n                        current_entry['credits'] = text\n                        continue\n                    \n                    if not current_entry.get('enrollment') and re.match(r'^\\d+$', text):\n                        # Check if it's followed by a section tag\n                        current_entry['enrollment'] = text\n                        continue\n                    \n                    # Instructor name\n                    if not current_entry.get('instructor') and re.match(r'^[\\u4e00-\\u9fa5]{2,4}$', text):\n                        if text not in ('教授', '副教授', '讲师', '助理研究员', '副研究员', '研究员', '青年副研究员', '是'):\n                            current_entry['instructor'] = text\n                            continue\n                    \n                    # Notes\n                    if text not in ('考试日期', '考试时间', '考试类型', '开课院系', '授课院系') and len(text) > 1:\n                        notes = current_entry.get('notes', '')\n                        if notes:\n                            current_entry['notes'] = notes + ' ' + text\n                        else:\n                            current_entry['notes'] = text\n                        continue\n                \n                # Section header\n                if '通识教育核心课程——' in text:\n                    if current_entry.get('id'):\n                        all_entries.append(current_entry)\n                        current_entry = {}\n                        in_entry = False\n                    continue\n            \n            # End of a line - check if we should save entry\n            # If we have id and next y-row is far away\n    \n    if current_entry.get('id'):\n        all_entries.append(current_entry)\n    \n    return all_entries\n\n# Extract from relevant pages\nall_courses = extract_courses_from_pages(pdf, list(range(7, 17)) + [228, 229, 230, 231, 232])\n\nprint(f'Total: {len(all_courses)}')\n\nnlp = [c for c in all_courses if '自然语言处理' in c.get('name', '')]\nprint(f'\\nNLP: {len(nlp)}')\nfor c in nlp:\n    print(f'  {c}')\n\nsa = [c for c in all_courses if '软件体系结构' in c.get('name', '')]\nprint(f'\\nSA: {len(sa)}')\nfor c in sa:\n    print(f'  {c}')\n\nb = [c for c in all_courses if c.get('section') == '思政B']\nprint(f'\\n思政B: {len(b)}')\nfor c in b:\n    print(f'  {c}')\n\nmon_open = [c for c in all_courses if c.get('time') and c['time'].startswith('一') and c.get('assessment') == '开卷']\nprint(f'\\nMonday+Open: {len(mon_open)}')\nfor c in mon_open:\n    print(f'  {c}')\n\npdf.close()\nPYEOF\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
