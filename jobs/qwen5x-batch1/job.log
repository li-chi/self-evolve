Sending keys: ['cat > /app/generate3.py << \'PYEOF\'\nimport re\nimport openpyxl\nfrom openpyxl import Workbook\nimport os\n\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    text = f.read()\n\ntext_lines = text.split(\'\\n\')\n\ndef parse_course_line(line, prev_lines=None):\n    """Parse a course line, optionally looking at previous lines for course name."""\n    line = line.strip()\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', line)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    \n    parts = rest.split()\n    \n    # Find time position\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\', \'二\', \'三\', \'四\', \'五\', \'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    \n    if time_pos <= 0:\n        return {\'Course ID\': code}\n    \n    # Parse before time\n    before_time = parts[:time_pos]\n    course_name = \' \'.join(before_time)\n    \n    # If no course name in the line, look at previous lines\n    if not course_name and prev_lines:\n        # Look for name in previous non-empty lines (skip exam date/time lines)\n        for pl in reversed(prev_lines):\n            pl = pl.strip()\n            if pl and \'考试\' not in pl and \'第\' not in pl or re.match(r\'[A-Z]\', pl):\n                # This might be part of the course name\n                course_name = pl\n                break\n    \n    credits = \'\'\n    instructor = \'\'\n    title = \'\'\n    \n    credit_idx = -1\n    for k in range(len(before_time)-1, 0, -1):\n        if before_time[k].isdigit() and int(before_time[k]) <= 5:\n            credit_idx = k\n            break\n    \n    if credit_idx > 0:\n        course_name = \' \'.join(before_time[:credit_idx])\n        credits = before_time[credit_idx]\n        instructor_parts = before_time[credit_idx+1:]\n        if len(instructor_parts) >= 2:\n            instructor = instructor_parts[0]\n            title = \' \'.join(instructor_parts[1:])\n        elif len(instructor_parts) == 1:\n            instructor = instructor_parts[0]\n    \n    # Parse after time\n    after_time_parts = parts[time_pos:]\n    class_time = \' \'.join(after_time_parts[:3])\n    \n    # Extract campus\n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    # Find enrollment\n    enrollment = \'\'\n    campus_match = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n    if campus_match:\n        enrollment = campus_match.group(1)\n    \n    # Find assessment method\n    assessment = \'\'\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in rest:\n            assessment = a\n            break\n    \n    # Find exam time\n    exam_time = \'\'\n    exam_match = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n    if exam_match:\n        exam_time = exam_match.group(1)\n    \n    # Find restrictions\n    restrictions = \'\'\n    after_assess = rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_assess:\n            idx = after_assess.find(a)\n            after_assess = after_assess[idx+len(a):]\n            break\n    restrictions = after_assess.strip()\n    \n    return {\n        \'Course name\': course_name,\n        \'Course ID\': code,\n        \'Instructor\': instructor,\n        \'Campus\': campus,\n        \'Class Time\': class_time,\n        \'Enrollment\': enrollment,\n        \'Credits\': credits,\n        \'Assessment Method\': assessment,\n        \'Exam Time\': exam_time,\n        \'Course Selection Restrictions\': restrictions,\n        \'_day\': parts[time_pos] if time_pos < len(parts) else \'\',\n        \'_time\': parts[time_pos+1] if time_pos+1 < len(parts) else \'\'\n    }\n\n# Fixed courses\nfixed = [\n    parse_course_line(\'COMP130141.01 自然语言处理 2 黄萱菁 教授 一 2-3 [1-16] 邯郸校区 60 闭卷 大数据与人工智能(2023)\'),\n    parse_course_line(\'COMP130025.01 软件体系结构 2 陈彤兵 讲师 一 4-5 [1-16] 邯郸校区 50 闭卷 23 22 计算机科学与技术\'),\n    parse_course_line(\'PTSS110080.01 中国共产党历史 2 薛小荣 副教授 一 11-12 [1-15] 邯郸校区 180 思政B 开卷 是\'),\n]\n\n# Extract tongren courses - need to handle multi-line entries\n# Strategy: when a code line has no name, look at previous line\ntongren_entries = []\nin_tongren = False\nprev_lines = []\n\nfor i, line in enumerate(text_lines):\n    line_num = i + 1\n    \n    if line_num >= 1059:\n        in_tongren = True\n    if line_num >= 6038:\n        in_tongren = False\n    \n    if not in_tongren:\n        prev_lines.append(line)\n        continue\n    \n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n    if m:\n        parsed = parse_course_line(line, prev_lines[-3:])\n        if parsed and parsed.get(\'Class Time\'):\n            day_match = re.search(r\'(一)\\s+(\\d+-\\d+)\\s+\\[\', line)\n            if day_match and \'开卷\' in line and \'思政\' not in line and \'半开卷\' not in line:\n                tongren_entries.append(parsed)\n    \n    prev_lines.append(line)\n    if len(prev_lines) > 5:\n        prev_lines = prev_lines[-5:]\n\nprint(f"Fixed courses: {len(fixed)}")\nfor f in fixed:\n    print(f"  {f[\'Course name\']} [{f[\'Course ID\']}] - {f[\'Class Time\']}")\n\nprint(f"\\nTongren options: {len(tongren_entries)}")\nfor i, t in enumerate(tongren_entries):\n    print(f"  {i+1}. {t[\'Course name\']} [{t[\'Course ID\']}] - {t[\'Class Time\']}")\n\n# Check conflicts\nfixed_times = [(f[\'_day\'], f[\'_time\']) for f in fixed]\n\ndef has_time_conflict(day1, time1, day2, time2):\n    if day1 != day2:\n        return False\n    m1 = re.match(r\'(\\d+)-(\\d+)\', time1)\n    m2 = re.match(r\'(\\d+)-(\\d+)\', time2)\n    if m1 and m2:\n        s1, e1 = int(m1.group(1)), int(m1.group(2))\n        s2, e2 = int(m2.group(1)), int(m2.group(2))\n        return s1 <= e2 and s2 <= e1\n    return False\n\nvalid_options = []\nfor opt in tongren_entries:\n    conflict = False\n    for day, time in fixed_times:\n        if has_time_conflict(opt[\'_day\'], opt[\'_time\'], day, time):\n            conflict = True\n            break\n    if not conflict:\n        valid_options.append(opt)\n\nprint(f"\\nValid options: {len(valid_options)}")\nfor i, opt in enumerate(valid_options):\n    print(f"  {i+1}. {opt[\'Course name\']} [{opt[\'Course ID\']}] - {opt[\'Class Time\']}")\n\n# Create Excel files\nfields = [\'Course name\', \'Course ID\', \'Instructor\', \'Campus\', \'Class Time\', \n          \'Enrollment\', \'Credits\', \'Assessment Method\', \'Exam Time\', \'Course Selection Restrictions\']\n\nfor idx, opt in enumerate(valid_options):\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'Sheet1\'\n    \n    for col_idx, field in enumerate(fields, start=1):\n        ws.cell(row=1, column=col_idx, value=field)\n    \n    all_courses = fixed + [opt]\n    for row_idx, course in enumerate(all_courses, start=2):\n        for col_idx, field in enumerate(fields, start=1):\n            val = course.get(field, \'\')\n            if val is None:\n                val = \'\'\n            ws.cell(row=row_idx, column=col_idx, value=val)\n    \n    filename = f\'/app/scheme_{idx+1}.xlsx\'\n    wb.save(filename)\n    print(f"Saved: {filename}")\n\n# Cleanup\ncleanup_files = [\'/app/pdf_text.txt\', \'/app/search_nlp.txt\', \'/app/extract.py\', \'/app/generate.py\', \'/app/generate2.py\', \'/app/generate3.py\']\nfor f in cleanup_files:\n    if os.path.exists(f):\n        os.remove(f)\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
