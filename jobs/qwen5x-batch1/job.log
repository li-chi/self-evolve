Sending keys: ['cat > /tmp/final.py << \'PYEOF\'\nimport os, re, json, csv\n\nour_ings = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\', \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\',\n}\n\n# Map from recipe ingredient names to our ingredient names\ning_map = {\n    \'纯瘦肉\': \'瘦猪肉片\',\n    \'瘦肉\': \'瘦猪肉片\',\n    \'猪肉\': None,  # ambiguous - could be either\n    \'肉\': None,\n    \'蒜\': \'蒜苗\',  # close enough\n    \'大蒜\': None,  # different from 蒜苗\n    \'大虾\': None,\n    \'小葱\': None,\n    \'葱\': None,\n    \'姜\': None,\n    \'辣椒\': \'干辣椒\',\n    \'青辣椒\': None,\n    \'青椒\': None,\n    \'小米椒\': None,\n    \'蒜苗\': \'蒜苗\',\n}\n\ndef extract_name(content, filepath):\n    m = re.search(r\'^# (.+?)\\s*做法\', content, re.MULTILINE)\n    if m:\n        name = m.group(1)\n        # Remove trailing \'的\' if present\n        if name.endswith(\'的\'):\n            name = name[:-1]\n        return name.strip()\n    m = re.search(r\'^# (.+?)(?:\\.md)?$\', content, re.MULTILINE)\n    if m:\n        return m.group(1).strip().replace(\'.md\',\'\')\n    return os.path.basename(os.path.dirname(filepath))\n\ndef clean_amount(amount):\n    """Clean up amount string."""\n    # Remove trailing notes after * or newline\n    amount = re.sub(r\'\\*.*$\', \'\', amount).strip()\n    # Remove parenthetical notes\n    amount = re.sub(r\'\\(.*?\\)\', \'\', amount).strip()\n    amount = re.sub(r\'（.*?）\', \'\', amount).strip()\n    # Remove unit markers at end\n    amount = re.sub(r\'[^\\d\\d\\.\\-mlg]$\', \'\', amount).strip()\n    return amount\n\ndef parse_calc(content):\n    """Parse 计算 section into list of (ingredient_name, amount)."""\n    match = re.search(r\'## 计算\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not match:\n        return []\n    block = match.group(1)\n    results = []\n    \n    for line in block.split(\'\\n\'):\n        orig = line\n        # Strip list markers: - , * , + \n        line = line.strip()\n        if not line:\n            continue\n        if not (line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \')):\n            continue\n        line = line[2:].strip()\n        # Remove emoji prefixes\n        line = re.sub(r\'^[^\\u4e00-\\u9fff]+\', \'\', line).strip()\n        if not line:\n            continue\n        \n        # Skip meta lines\n        if re.match(r\'^(每次|总量|每份|使用上述|此)\', line):\n            continue\n        \n        # Format: 名称 = 表达式\n        m = re.match(r\'^(.+?)\\s*=\\s*(.+)$\', line)\n        if m:\n            raw_name = m.group(1).strip()\n            raw_amt = m.group(2).strip()\n            raw_amt = clean_amount(raw_amt)\n            \n            # Handle "茄子的数量 = 份数 * 1 个" -> name=茄子, amount=1 个\n            name_m = re.match(r\'^(.+?)的(数量|用量)?\\s*$\', raw_name)\n            if name_m:\n                name = name_m.group(1).strip()\n            else:\n                name = raw_name\n            \n            # Handle "肉量 = 份数 * 180 克" -> name=肉, amount=180 克\n            amt_m = re.match(r\'^(?:份数\\s*\\*\\s*)?(.+)$\', raw_amt)\n            if amt_m:\n                amount = amt_m.group(1).strip()\n            else:\n                amount = raw_amt\n            amount = clean_amount(amount)\n            \n            if name and amount:\n                results.append((name, amount))\n            continue\n        \n        # Format: 名称用量为 表达式\n        m = re.match(r\'^(.+?)的用量为\\s*(.+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            amount = clean_amount(amount)\n            if name and amount:\n                results.append((name, amount))\n            continue\n        \n        # Format: ingredient amount (space separated)\n        m = re.match(r\'^([\\u4e00-\\u9fff\\w\\-]+?)\\s+(.+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            amount = clean_amount(amount)\n            if name and amount and amount[0].isdigit():\n                results.append((name, amount))\n                continue\n        \n        # Format: 鸡蛋（best）2个 - name with parenthetical note\n        m = re.match(r\'^([\\u4e00-\\u9fff\\w\\-]+?)（.+?）\\s+(.+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            amount = clean_amount(amount)\n            if name and amount:\n                results.append((name, amount))\n                continue\n    \n    return results\n\ndef parse_tools_section(content):\n    """Parse 必备原料和工具 section."""\n    match = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not match:\n        return []\n    block = match.group(1)\n    results = []\n    for line in block.split(\'\\n\'):\n        if line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \'):\n            name = line[2:].strip()\n            if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n                results.append((name, \'\'))\n    return results\n\n# Collect all recipes\nrecipe_dir = \'/tmp/HowToCook/dishes\'\nall_recipes = []\n\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if not f.endswith(\'.md\'):\n            continue\n        fp = os.path.join(root, f)\n        with open(fp, \'r\', encoding=\'utf-8\') as fh:\n            content = fh.read()\n        \n        name = extract_name(content, fp)\n        if not name:\n            continue\n        \n        ings = parse_calc(content)\n        if not ings:\n            ings = parse_tools_section(content)\n        if not ings:\n            continue\n        \n        cat = os.path.relpath(fp, recipe_dir).split(\'/\')[0]\n        all_recipes.append({\'name\': name, \'ings\': ings, \'cat\': cat, \'fp\': fp})\n\nprint(f"Parsed {len(all_recipes)} recipes")\n\n# Debug sample\nfor sn in [\'回锅肉\', \'瘦肉土豆片\', \'茄子炖土豆\']:\n    for r in all_recipes:\n        if r[\'name\'] == sn:\n            print(f"\\n{sn}:")\n            for n,a in r[\'ings\']:\n                print(f"  \'{n}\' = \'{a}\'")\n            break\n\n# Score recipes\ndef get_our_ing(ing_name, amt):\n    """Find our ingredient that matches, return (our_name, our_amt) or None."""\n    name = ing_name.strip()\n    if name in our_ings:\n        return (name, our_ings[name])\n    for our_name in our_ings:\n        if our_name in name:\n            return (our_name, our_ings[our_name])\n        if name in our_name:\n            return (our_name, our_ings[our_name])\n    # Check mapping\n    if name in ing_map and ing_map[name] is not None:\n        mapped = ing_map[name]\n        if mapped in our_ings:\n            return (mapped, our_ings[mapped])\n    return None\n\nresults = []\nfor recipe in all_recipes:\n    matched = []  # (recipe_name, recipe_amt, our_name, our_amt)\n    unmatched = []\n    \n    for ing_name, ing_amt in recipe[\'ings\']:\n        our = get_our_ing(ing_name, ing_amt)\n        if our:\n            our_name, our_amt = our\n            matched.append((ing_name, ing_amt, our_name, our_amt))\n        else:\n            unmatched.append((ing_name, ing_amt))\n    \n    total = len(matched) + len(unmatched)\n    if total == 0:\n        continue\n    \n    matched_types = set(m[2] for m in matched)  # unique our_ingredient names\n    ratio = len(matched_types) / total\n    \n    if ratio < 0.5:\n        continue\n    \n    results.append({\n        \'name\': recipe[\'name\'],\n        \'cat\': recipe[\'cat\'],\n        \'score\': len(matched_types),\n        \'ratio\': ratio,\n        \'matched\': matched,\n        \'unmatched\': unmatched,\n    })\n\nresults.sort(key=lambda x: (-x[\'score\'], -x[\'ratio\']))\n\nprint(f"\\n=== Qualifying recipes (>=50% of ingredient types match) ===")\nfor i, r in enumerate(results[:25]):\n    print(f"{i+1}. {r[\'name\']} [{r[\'cat\']}] types={r[\'score\']} ratio={r[\'ratio\']:.2f}")\n    for m in r[\'matched\']:\n        print(f"    MATCH: \'{m[0]}\' -> our=\'{m[2]}\' (avail={m[3]}, recipe={m[1]})")\n    for u in r[\'unmatched\']:\n        print(f"    MISS: \'{u[0]}\' ({u[1]})")\n\n# Select top 3 - try to get variety including soup\nselected = []\nhas_soup = False\nfor r in results:\n    if len(selected) >= 3:\n        break\n    # Prefer diversity: pick soup if available, else first 3\n    if r[\'cat\'] == \'soup\' and not has_soup:\n        has_soup = True\n        selected.append(r)\n    elif len(selected) < 3:\n        # Avoid duplicate categories if possible, but allow it\n        selected.append(r)\n\nprint("\\n=== SELECTED DISHES ===")\nmissing_list = []\nfor r in selected:\n    soup_tag = " [SOUP]" if r[\'cat\'] == \'soup\' else ""\n    print(f"\\n--- {r[\'name\']}{soup_tag} --- ({r[\'cat\']})")\n    for m in r[\'matched\']:\n        print(f"  [HAVE] {m[2]}: recipe=\'{m[1]}\', available=\'{m[3]}\'")\n    print(f"  Missing:")\n    for u in r[\'unmatched\']:\n        clean = re.sub(r\'\\(.*?\\)\', \'\', u[0]).strip()\n        clean = re.sub(r\'\\*.*$\', \'\', clean).strip()\n        missing_list.append((clean, u[1]))\n        print(f"    {u[0]}: need \'{u[1]}\'")\n\nprint(f"\\n=== Shopping List ===")\nfor name, qty in missing_list:\n    print(f"  {name}: {qty}")\n\n# Write cuisine.json\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    data = {"recommended_dishes": [{"name": r[\'name\']} for r in selected]}\n    json.dump(data, f, ensure_ascii=False, indent=4)\nprint("\\nSaved /app/cuisine.json")\n\n# Write shopping.csv\nseen = {}\nfor name, qty in missing_list:\n    if name in seen:\n        seen[name].append(qty)\n    else:\n        seen[name] = [qty]\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    w = csv.writer(f)\n    w.writerow([\'Name\', \'Quantity\'])\n    for name, qtys in seen.items():\n        w.writerow([name, \', \'.join(qtys)])\nprint("Saved /app/shopping.csv")\nPYEOF\npython3 /tmp/final.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
