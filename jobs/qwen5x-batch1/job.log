es/vegetable_dish/包菜炒鸡蛋粉丝.md",\n    "dishes/vegetable_dish/地三鲜.md",\n    "dishes/vegetable_dish/手撕包菜.md",\n    "dishes/vegetable_dish/拔丝土豆.md",\n    "dishes/vegetable_dish/烤茄子.md",\n    "dishes/vegetable_dish/糖拌西红柿.md",\n    "dishes/vegetable_dish/红烧冬瓜.md",\n    "dishes/vegetable_dish/菠菜炒鸡蛋.md",\n    "dishes/vegetable_dish/蒜蓉炒芹菜.md",\n    "dishes/vegetable_dish/虎皮青椒.md",\n    "dishes/vegetable_dish/西红柿豆腐汤羹.md",\n    "dishes/vegetable_dish/西葫芦炒鸡蛋.md",\n    "dishes/vegetable_dish/话梅煮毛豆.md",\n    "dishes/vegetable_dish/韭菜炒蛋.md",\n    "dishes/vegetable_dish/鸡蛋羹.md",\n    "dishes/vegetable_dish/鸡蛋花.md",\n    "dishes/vegetable_dish/洋葱炒鸡蛋.md",\n    "dishes/vegetable_dish/炒滑蛋.md",\n    "dishes/soup/勾芡香菇汤.md",\n    "dishes/soup/排骨山药玉米汤.md",\n    "dishes/soup/排骨苦瓜汤.md",\n    "dishes/soup/朱雀汤.md",\n    "dishes/soup/玉米排骨汤.md",\n    "dishes/soup/羊肉汤.md",\n    "dishes/soup/银耳莲子粥.md",\n    "dishes/soup/陈皮排骨汤.md",\n    "dishes/soup/昂刺鱼豆腐汤.md",\n    "dishes/soup/菌菇炖乳鸽.md",\n    "dishes/soup/冬瓜酿肉.md",\n]\n\ndef fetch_recipe(path):\n    encoded = urllib.parse.quote(path, safe=\'/\')\n    url = f\'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/{encoded}\'\n    try:\n        req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0 (X11; Linux)\'})\n        resp = urllib.request.urlopen(req, timeout=15)\n        return resp.read().decode(\'utf-8\', errors=\'replace\')\n    except Exception:\n        return None\n\ndef parse_recipe(content, path):\n    if not content or \'404\' in content or len(content) < 50:\n        return None\n    title_match = re.search(r\'^# (.+)\', content, re.MULTILINE)\n    name = title_match.group(1).strip() if title_match else path.split(\'/\')[-1].replace(\'.md\', \'\')\n    \n    # Extract ingredients\n    ingredients = []\n    ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |$)\', content, re.DOTALL)\n    if ing_match:\n        for line in ing_match.group(1).split(\'\\n\'):\n            line = line.strip().lstrip(\'- \').strip()\n            if line and not line.startswith(\'#\') and not line.startswith(\'总\'):\n                item = re.split(r\'[（(]\\s*别称[^)]*[）)]\\s*\', line)[0].strip()\n                item = re.split(r\'（推介[^)]*）\\s*\', item)[0].strip()\n                if item:\n                    ingredients.append(item)\n    \n    # Extract quantities - find content between 计算 header and next ## header\n    quantities = {}\n    calc_match = re.search(r\'## 计算\\n(.*?)(?=\\n## |$)\', content, re.DOTALL)\n    if calc_match:\n        for line in calc_match.group(1).split(\'\\n\'):\n            line = line.strip().lstrip(\'- \')\n            if line and \'*\' in line:\n                parts = line.split(\'*\')\n                ing_name = parts[0].strip()\n                amount = parts[-1].strip()\n                ing_name = re.split(r\'[（(]\\s*别称[^)]*[）)]\\s*\', ing_name)[0].strip()\n                ing_name = re.split(r\'（推介[^)]*）\\s*\', ing_name)[0].strip()\n                quantities[ing_name] = amount\n    \n    return {\'name\': name, \'ingredients\': ingredients, \'quantities\': quantities}\n\ndef match_score(recipe_ingredients):\n    matches = []\n    for ri in recipe_ingredients:\n        for ai in available_names:\n            if ai in ri or ri in ai:\n                matches.append(ri)\n                break\n    return len(matches), recipe_ingredients, matches\n\nprint(f"Fetching {len(dish_files)} recipes...")\nall_recipes = []\nfor i, path in enumerate(dish_files):\n    content = fetch_recipe(path)\n    if content:\n        recipe = parse_recipe(content, path)\n        if recipe and recipe[\'ingredients\']:\n            all_recipes.append(recipe)\n    if (i + 1) % 30 == 0:\n        print(f"  {i+1}/{len(dish_files)}, parsed: {len(all_recipes)}")\n    time.sleep(0.3)\n\nprint(f"Parsed {len(all_recipes)} recipes")\n\nscored = []\nfor recipe in all_recipes:\n    m, all_i, matched = match_score(recipe[\'ingredients\'])\n    total = len(recipe[\'ingredients\'])\n    if total > 0 and (m / total) >= 0.4:\n        scored.append({\n            \'name\': recipe[\'name\'],\n            \'ingredients\': recipe[\'ingredients\'],\n            \'quantities\': recipe[\'quantities\'],\n            \'matches\': m, \'total\': total,\n            \'ratio\': m / total,\n            \'matched_names\': matched,\n            \'missing_names\': [ing for ing in recipe[\'ingredients\'] if ing not in matched]\n        })\n\nscored.sort(key=lambda x: (-x[\'ratio\'], -x[\'matches\']))\nprint(f"Found {len(scored)} dishes with >= 40% match")\nfor r in scored[:25]:\n    print(f"  {r[\'name\']}: {r[\'matches\']}/{r[\'total\']} ({r[\'ratio\']*100:.0f}%) - have:{r[\'matched_names\']} missing:{r[\'missing_names\']}")\n\nsoup_kw = [\'汤\', \'粥\', \'羹\', \'煮\', \'炖\', \'煲\']\nsoup_list = [r for r in scored if any(kw in r[\'name\'] for kw in soup_kw)]\nother = [r for r in scored if r not in soup_list]\n\nselected = []\nif soup_list:\n    selected.append(soup_list[0])\nfor r in other:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\nprint("\\n=== Selected ===")\nfor r in selected:\n    print(f"  {r[\'name\']}: {r[\'matches\']}/{r[\'total\']} ({r[\'ratio\']*100:.0f}%)")\n    print(f"    Have: {r[\'matched_names\']}")\n    print(f"    Missing: {r[\'missing_names\']}")\n    print(f"    Quantities: {json.dumps(r[\'quantities\'], ensure_ascii=False)}")\n\ncuisine = {"recommended_dishes": []}\nfor r in selected:\n    entry = {"name": r[\'name\'], "ingredients": []}\n    for ing in r[\'ingredients\']:\n        entry[\'ingredients\'].append({"name": ing, "quantity": r[\'quantities\'].get(ing, \'\')})\n    cuisine[\'recommended_dishes\'].append(entry)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=2)\nprint("\\nSaved cuisine.json")\n\nshopping = []\nseen = set()\nfor r in selected:\n    for ing in r[\'missing_names\']:\n        if ing not in seen:\n            shopping.append({\'Name\': ing, \'Quantity\': r[\'quantities\'].get(ing, \'\')})\n            seen.add(ing)\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'Name,Quantity\\n\')\n    for item in shopping:\n        f.write(f"{item[\'Name\']},{item[\'Quantity\']}\\n")\nprint(f"Saved shopping.csv: {len(shopping)} items")\nfor s in shopping:\n    print(f"  {s[\'Name\']}: {s[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
