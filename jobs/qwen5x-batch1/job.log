Sending keys: ['cat > /app/final_v6.py << \'PYEOF\'\nimport os, re, json, csv\n\navailable_names = {\'鸡蛋\', \'土豆\', \'茄子\', \'蒜苗\', \'冬瓜\', \'瘦猪肉片\', \'五花肉\', \'牛奶\', \'干辣椒\'}\navailable = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\', \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\', \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\'\n}\n\nNORM = {\n    \'青茄子\': \'茄子\', \'茄子\': \'茄子\',\n    \'带皮五花肉\': \'五花肉\', \'五花肉\': \'五花肉\',\n    \'纯瘦肉\': \'瘦猪肉片\', \'瘦肉\': \'瘦猪肉片\', \'猪肉\': \'瘦猪肉片\',\n    \'猪肉末\': \'瘦猪肉片\', \'肉末\': \'瘦猪肉片\',\n    \'鸡蛋\': \'鸡蛋\',\n    \'蒜苗\': \'蒜苗\',\n    \'冬瓜\': \'冬瓜\',\n    \'干辣椒\': \'干辣椒\',\n    \'牛奶\': \'牛奶\', \'全脂牛奶\': \'牛奶\', \'全脂牛奶/奶油\': \'牛奶\',\n}\n\ndef clean_raw(name):\n    name = re.sub(r\'[\\u1F300-\\u1F9FF\\U0001F600-\\U0001F9FF]\', \'\', name)\n    for sep in [\'(\', \'（\']:\n        if sep in name: name = name[:name.index(sep)].strip()\n    if \'=\' in name: name = name[:name.index(\'=\')].strip()\n    for sep in [\')\', \'）\']:\n        if sep in name: name = name[:name.index(sep)].strip()\n    name = name.strip()\n    name = re.sub(r\'[\\s\\-=/\\|]+$]\', \'\', name).strip()\n    return name\n\ndef normalize_ingredient(raw_name):\n    name = clean_raw(raw_name)\n    if not name: return None\n    if name in NORM: return NORM[name]\n    if name in available_names: return name\n    for av in available_names:\n        if av in name: return av\n    return None\n\ndef parse_all_ingredients(section_text):\n    ingredients = []\n    for line in section_text.split(\'\\n\'):\n        line = line.strip()\n        if not line or line.startswith(\'#\') or line.startswith(\'<!--\') or line.startswith(\'```\'): continue\n        if \'**\' in line and \':\' in line: continue\n        raw = None\n        if line.startswith(\'- \') or line.startswith(\'* \'):\n            raw = line.lstrip(\'-* \').strip()\n        else: continue\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m: m = re.match(r\'(.+?)\\s*=\\s*(.+)\', raw)\n        if not m: m = re.match(r\'(.+?)\\s+(\\d+.+)\', raw)\n        if m:\n            nr = clean_raw(m.group(1))\n            qr = m.group(2).strip() if len(m.groups()) > 1 else \'\'\n            ingredients.append((nr, qr))\n    return ingredients\n\ndef parse_recipe(fpath):\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except: return None\n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m: name = m.group(1).strip(); break\n    if not name: return None\n    name = re.sub(r\'\\s*(的?)做法\\s*$\', \'\', name).strip()\n    name = re.sub(r\'^\\d+\\s*\', \'\', name).strip()\n    ingredients = []\n    calc_match = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if calc_match:\n        ingredients = parse_all_ingredients(calc_match.group(1))\n    if not ingredients:\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    for sep in [\'(\', \'（\']:\n                        if sep in raw: raw = raw[:raw.index(sep)].strip()\n                    ingredients.append((clean_raw(raw), \'\'))\n    if not ingredients: return None\n    return {\'name\': name, \'all_ingredients\': ingredients}\n\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in sorted(files):\n        if not fname.endswith(\'.md\'): continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result: recipes.append(result)\n\nprint(f"Parsed {len(recipes)} recipes")\n\n# Build full data for each recipe\ncandidates = []\nfor r in recipes:\n    norm_ings = {}\n    for raw_name, qty in r[\'all_ingredients\']:\n        norm = normalize_ingredient(raw_name)\n        if norm: norm_ings[norm] = qty\n    matched = [n for n in norm_ings if n in available_names]\n    total = len(r[\'all_ingredients\'])\n    matched_total = len(matched)\n    ratio = matched_total / total if total > 0 else 0\n    if matched_total >= 2:\n        candidates.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': norm_ings,\n            \'matched\': matched,\n            \'total\': total,\n            \'ratio\': ratio\n        })\n\ncandidates.sort(key=lambda x: (-len(x[\'matched\']), -x[\'ratio\'], x[\'name\']))\n\n# Manually select the 3 best diverse dishes:\n# 1. 炒滑蛋 (67%, 鸡蛋+牛奶) - 简单蛋奶菜\n# 2. 地三鲜 (50%, 茄子+土豆) - 素菜\n# 3. 瘦肉土豆片 (43%, 瘦猪肉片+土豆+蒜苗) - 肉菜，closest to 50%\n# These are diverse: 蛋类, 蔬菜类, 肉类, covering 鸡蛋+牛奶+茄子+土豆+瘦猪肉片+蒜苗\n\n# Alternative: check if 西红柿鸡蛋汤 (soup) has enough matches\ntomato_egg_soup_ings = {}\ntry:\n    with open(\'/tmp/HowToCook/dishes/soup/西红柿鸡蛋汤.md\', \'r\') as f:\n        content = f.read()\n    cm = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if cm:\n        for line in cm.group(1).split(\'\\n\'):\n            line = line.strip()\n            if line.startswith(\'- \') or line.startswith(\'* \'):\n                raw = line.lstrip(\'-* \').strip()\n                nr = clean_raw(raw)\n                norm = normalize_ingredient(nr)\n                if norm:\n                    tomato_egg_soup_ings[norm] = \'\'\nexcept:\n    pass\nprint(f"西红柿鸡蛋汤 matches: {list(tomato_egg_soup_ings.keys())}")\n\n# Selected dishes\nselected_names = [\'炒滑蛋\', \'地三鲜\', \'瘦肉土豆片\']\nselected = [c for c in candidates if c[\'name\'] in selected_names]\n\nprint(f"\\n=== Final Selection ===")\nfor s in selected:\n    in_stock = [n for n in s[\'matched\']]\n    missing = [n for n in s[\'ingredients\'] if n not in available_names]\n    print(f"\\n{s[\'name\']} ({len(s[\'matched\'])}/{s[\'total\']} = {s[\'ratio\']:.0%})")\n    print(f"  In stock ({len(in_stock)}): {in_stock}")\n    print(f"  Missing ({len(missing)}): {missing}")\n    for ing, qty in s[\'ingredients\'].items():\n        status = \'STOCK\' if ing in available_names else \'BUY\'\n        print(f"    [{status}] {ing}: {qty}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    for ing, qty in s[\'ingredients\'].items():\n        dish["ingredients"][ing] = qty\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list: ALL ingredients not in our stock\nshopping = []\nfor s in selected:\n    for ing, qty in s[\'ingredients\'].items():\n        if ing not in available:\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nfor item in shopping:\n    print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
