Sending keys: ["cat > /tmp/gen_excel.py << 'PYEOF'\nimport pdfplumber\nimport re\nimport os\nfrom openpyxl import Workbook\n\n# Read reference format\nwb_ref = openpyxl.load_workbook('/app/reference_format.xlsx')\nws_ref = wb_ref.active\nheaders = []\nfor col in range(1, ws_ref.max_column + 1):\n    val = ws_ref.cell(row=1, column=col).value\n    headers.append(val)\nprint('Headers:', headers)\n\npdf = pdfplumber.open('/app/25-26学年第一学期课程表.pdf')\n\n# Function to extract a course entry from a page text\ndef parse_course_entry(text, course_id):\n    lines = text.split('\\n')\n    entry = {}\n    for i, line in enumerate(lines):\n        if course_id in line:\n            # Extract the full line and surrounding lines\n            full_line = ' '.join([l.strip() for l in lines[max(0,i-1):min(len(lines),i+10)] if l.strip()])\n            \n            # Parse the format: ID Name Credits Instructor Title Time Campus Enrollment Notes ExamDate ExamTime Assessment HasA Dept Restriction\n            entry['id'] = course_id\n            \n            # Find components\n            parts = line.split()\n            if len(parts) > 1:\n                # Format: COMP130025.01 软件体系结构 2 陈彤兵 讲师 一 4-5 [1-16] 邯郸校区 50 闭卷 23 22 计算机科学与技术\n                # But the name could be multi-word\n                after_id = line.replace(course_id, '').strip()\n                # Split remaining\n                tokens = after_id.split()\n                print(f'  Course {course_id} tokens: {tokens}')\n            break\n    return entry\n\n# Extract all courses from pages\nall_text = {}\nfor p in [30, 251, 252, 254, 32, 33, 34, 35, 36, 37]:\n    page = pdf.pages[p-1]\n    text = page.extract_text() or ''\n    all_text[p] = text\n    \n    # Find all course IDs on this page\n    for m in re.finditer(r'([A-Z]{2,4}\\d{5,6}\\.\\d+)', text):\n        cid = m.group(1)\n        # Find the full line containing this course ID\n        line_start = text[:m.start()].rfind('\\n') + 1\n        line_end = text.