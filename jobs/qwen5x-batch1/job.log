Sending keys: ['cat > /app/fetch_recipes.py << \'PYEOF\'\nimport urllib.request\nimport json\nimport re\nimport csv\nfrom collections import defaultdict\n\n# Available ingredients from our stock\navailable = {\n    \'鸡蛋\': \'2个\',\n    \'土豆\': \'100g\',\n    \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\',\n    \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\',\n    \'牛奶\': \'30ml\',\n    \'干辣椒\': \'50g\'\n}\n\ndef fetch_dir(path):\n    """Recursively fetch all .md files from a GitHub directory."""\n    url = f\'https://api.github.com/repos/Anduin2017/HowToCook/contents/{path}\'\n    req = urllib.request.Request(url, headers={\'User-Agent\': \'Python\'})\n    with urllib.request.urlopen(req) as resp:\n        items = json.loads(resp.read())\n    md_files = []\n    dirs = []\n    for item in items:\n        if item[\'type\'] == \'file\' and item[\'name\'].endswith(\'.md\'):\n            md_files.append(item)\n        elif item[\'type\'] == \'dir\':\n            dirs.append(item)\n    for d in dirs:\n        md_files.extend(fetch_dir(d[\'path\']))\n    return md_files\n\ndef parse_ingredients(content):\n    """Parse ingredients from a recipe markdown file."""\n    ingredients = {}\n    # Look for ingredient sections\n    # Common patterns in the recipes\n    lines = content.split(\'\\n\')\n    in_ingredients = False\n    for line in lines:\n        line = line.strip()\n        # Match ingredient lines like "- 鸡蛋 2个" or "- 土豆 100g"\n        m = re.match(r\'^[-•\\*]\\s+(.+?)\\s+(\\d+\\s*(?:个|g|kg|ml|l|片|颗|瓣|根|条|块|片|勺|大勺|小勺|汤匙|茶匙|滴|段|粒|条|根|个|片|块|瓣|头|只|颗|枚|条|截|杯|碗|盘|碟|勺|撮|份))\', line)\n        if m:\n            name = m.group(1).strip()\n            qty = m.group(2).strip()\n            ingredients[name] = qty\n        # Stop at recipe instructions section\n        if \'## 制作步骤\' in line or \'## 做法\' in line or \'## 步骤\' in line or \'### 制作步骤\' in line:\n            break\n    return ingredients\n\ndef get_dish_name(content):\n    """Extract dish name from markdown header."""\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            return m.group(1).strip()\n    return None\n\n# Fetch all recipes\nprint("Fetching recipe list...")\nmd_files = fetch_dir(\'dishes\')\nprint(f"Found {len(md_files)} recipe files")\n\n# Parse each recipe\nrecipes = []\nfor i, f in enumerate(md_files):\n    url = f[\'download_url\']\n    req = urllib.request.Request(url, headers={\'User-Agent\': \'Python\'})\n    try:\n        with urllib.request.urlopen(req) as resp:\n            content = resp.read().decode(\'utf-8\')\n        name = get_dish_name(content)\n        ingredients = parse_ingredients(content)\n        if name and ingredients:\n            # Calculate match score\n            matched = 0\n            matched_ingredients = []\n            for ing in ingredients:\n                # Direct match\n                if ing in available:\n                    matched += 1\n                    matched_ingredients.append(ing)\n                else:\n                    # Try fuzzy match - check if any available ingredient is contained in recipe ingredient or vice versa\n                    for av in available:\n                        if av in ing or ing in av:\n                            matched += 1\n                            matched_ingredients.append(ing)\n                            break\n            total_ingredients = len(ingredients)\n            match_ratio = matched / total_ingredients if total_ingredients > 0 else 0\n            recipes.append({\n                \'name\': name,\n                \'ingredients\': ingredients,\n                \'matched\': matched,\n                \'total\': total_ingredients,\n                \'ratio\': match_ratio,\n                \'matched_list\': matched_ingredients\n            })\n    except Exception as e:\n        print(f"Error parsing {f[\'name\']}: {e}")\n    if (i+1) % 50 == 0:\n        print(f"  Processed {i+1}/{len(md_files)}")\n\nprint(f"\\nParsed {len(recipes)} recipes")\n\n# Sort by match quality: prioritize higher match count AND higher ratio\n# At least half of ingredient types must come from our stock\ncandidates = []\nfor r in recipes:\n    if r[\'ratio\'] >= 0.5 and r[\'matched\'] >= 2:  # at least 2 matches and half covered\n        candidates.append(r)\n\ncandidates.sort(key=lambda x: (-x[\'matched\'], -x[\'ratio\']))\n\nprint(f"\\nCandidates with >= 50% coverage and >= 2 matches: {len(candidates)}")\nfor c in candidates[:20]:\n    print(f"  {c[\'name\']}: {c[\'matched\']}/{c[\'total\']} ({c[\'ratio\']:.0%}) - matched: {c[\'matched_list\']}")\n\n# Select top 3 diverse dishes\nselected = []\nused_keywords = set()\n\nfor r in candidates:\n    if len(selected) >= 3:\n        break\n    # Check diversity - try to pick dishes from different categories\n    keywords = [kw for kw in r[\'matched_list\'] if kw not in used_keywords]\n    if keywords or len(selected) < 3:\n        selected.append(r)\n        used_keywords.update(r[\'matched_list\'])\n\nprint(f"\\nSelected {len(selected)} dishes:")\nfor s in selected:\n    print(f"  {s[\'name\']}")\n    for ing, qty in s[\'ingredients\'].items():\n        status = \'✓\' if ing in available else \'✗\'\n        print(f"    {status} {ing}: {qty}")\n\n# Save cuisine.json\ncuisine = {\n    "recommended_dishes": []\n}\nfor s in selected:\n    dish = {\n        "name": s[\'name\'],\n        "ingredients": {}\n    }\n    for ing, qty in s[\'ingredients\'].items():\n        dish["ingredients"][ing] = qty\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\n\nprint("\\nSaved cuisine.json")\n\n# Generate shopping list - missing ingredients\nshopping = []\nfor s in selected:\n    for ing, qty in s[\'ingredients\'].items():\n        if ing not in available:\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n        elif ing in available and available[ing] != qty:\n            # Partially matched - list shortfall if we can compute\n            pass\n\nif shopping:\n    with open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n        writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n        writer.writeheader()\n        writer.writerows(shopping)\n    print(f"Saved shopping.csv with {len(shopping)} items")\nelse:\n    with open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n        writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n        writer.writeheader()\n    print("Shopping list is empty - all ingredients available")\n\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
