c_grow_col in appliance_cols:\n        cur = ws.cell(row=row_num, column=cur_col).value\n        acc = ws.cell(row=row_num, column=acc_col).value\n        yoy = ws.cell(row=row_num, column=yoy_col).value\n        acc_grow = ws.cell(row=row_num, column=acc_grow_col).value\n        if yoy is not None:\n            yoy = yoy * 100\n        if acc_grow is not None:\n            acc_grow = acc_grow * 100\n        records.append((time_val, time_str, name, cur, acc, yoy, acc_grow))\n\n# Filter: only months where at least one appliance has some data\nfrom collections import defaultdict\nmonth_has_data = defaultdict(bool)\nfor time_val, time_str, name, cur, acc, yoy, acc_grow in records:\n    if cur is not None or acc is not None or yoy is not None or acc_grow is not None:\n        month_has_data[time_str] = True\n\nfiltered = [r for r in records if month_has_data[r[1]]]\n\n# Sort reverse chronologically\nfiltered.sort(key=lambda x: x[0], reverse=True)\n\n# Write output\nwb_out = openpyxl.Workbook()\nws_out = wb_out.active\nws_out.title = 'Sheet1'\n\n# Header\nws_out.append(['Time', 'Appliance types', 'Current Period Sales(Ten Thousand Units)', 'Accumulated Sales (Ten Thousand Units)', 'Year-on-Year Growth (%)', 'Accumulated Growth (%)'])\n\nfor time_val, time_str, name, cur, acc, yoy, acc_grow in filtered:\n    ws_out.append([time_str, name, cur, acc, yoy, acc_grow])\n\nwb_out.save('/app/Processed.xlsx')\nprint(f'Total records written: {len(filtered)}')\nprint('First 10 records:')\nfor r in filtered[:10]:\n    print(r)\nprint('...')\nprint('Last 5 records:')\nfor r in filtered[-5:]:\n    print(r)\nPYEOF\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
