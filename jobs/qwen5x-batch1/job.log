Sending keys: ['cat > /tmp/final2.py << \'PYEOF\'\nimport os, re, json, csv\n\nour_ings = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\', \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\',\n}\n\n# Map recipe ingredient names to our ingredients\ning_mapping = {\n    \'纯瘦肉\': \'瘦猪肉片\',\n    \'瘦肉\': \'瘦猪肉片\',\n    \'肉末\': \'瘦猪肉片\',\n    \'猪肉\': None,\n    \'肉\': None,\n    \'辣椒\': \'干辣椒\',\n    \'蒜\': \'蒜苗\',\n    \'小葱\': None,\n    \'葱\': None,\n    \'姜\': None,\n    \'大蒜\': None,\n    \'大虾\': None,\n}\n\ndef extract_name(content, filepath):\n    m = re.search(r\'^# (.+?)\\s*做法\', content, re.MULTILINE)\n    if m:\n        name = m.group(1)\n        if name.endswith(\'的\'):\n            name = name[:-1]\n        return name.strip()\n    return os.path.basename(os.path.dirname(filepath))\n\ndef clean_amt(amount):\n    amount = re.sub(r\'\\*.*$\', \'\', amount).strip()\n    amount = re.sub(r\'\\(.*?\\)\', \'\', amount).strip()\n    amount = re.sub(r\'（.*?）\', \'\', amount).strip()\n    return amount\n\ndef parse_calc(content):\n    m = re.search(r\'## 计算\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not m:\n        return []\n    results = []\n    for line in m.group(1).split(\'\\n\'):\n        line = line.strip()\n        if not (line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \')):\n            continue\n        line = line[2:].strip()\n        line = re.sub(r\'^[^\\u4e00-\\u9fff]+\', \'\', line).strip()\n        if not line:\n            continue\n        if re.match(r\'^(每次|总量|每份|使用上述|此|注意|份数|注：)\', line):\n            continue\n        \n        # "名称用量为" format\n        km = re.match(r\'^(.+?)的用量为\\s*(.+)$\', line)\n        if km:\n            results.append((km.group(1).strip(), clean_amt(km.group(2))))\n            continue\n        \n        # "名称 = 表达式" format\n        em = re.match(r\'^(.+?)\\s*=\\s*(.+)$\', line)\n        if em:\n            raw_n = em.group(1).strip()\n            raw_a = em.group(2).strip()\n            # Extract ingredient name from formula\n            nm = re.match(r\'^(.+?)的(数量|用量)?$\', raw_n)\n            name = nm.group(1).strip() if nm else raw_n\n            am = re.match(r\'^(?:份数\\s*\\*\\s*)?(.+)$\', raw_a)\n            amount = am.group(1).strip() if am else raw_a\n            amount = clean_amt(amount)\n            if name and amount:\n                results.append((name, amount))\n            continue\n        \n        # "鸡蛋 1-2 个" or "小葱 2 棵" format\n        sm = re.match(r\'^([\\u4e00-\\u9fff\\w\\-]+?)\\s+(.+)$\', line)\n        if sm:\n            name = sm.group(1).strip()\n            amount = sm.group(2).strip()\n            amount = clean_amt(amount)\n            if name and amount:\n                # Only accept if amount starts with digit or unit\n                if amount and (amount[0].isdigit() or amount[0] in \'十百千万\'):\n                    results.append((name, amount))\n                    continue\n        \n        # "一个鸡蛋" format (amount first)\n        fm = re.match(r\'^(一个|两个|三个|四个|五个|六个|七个|八个|九个|十个)\\s*(.+)$\', line)\n        if fm:\n            results.append((fm.group(2).strip(), fm.group(1).strip()))\n            continue\n    \n    return results\n\ndef parse_tools(content):\n    m = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not m:\n        return []\n    results = []\n    for line in m.group(1).split(\'\\n\'):\n        if line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \'):\n            name = line[2:].strip()\n            if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n                results.append((name, \'\'))\n    return results\n\nrecipe_dir = \'/tmp/HowToCook/dishes\'\nall_recipes = []\n\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if not f.endswith(\'.md\'):\n            continue\n        fp = os.path.join(root, f)\n        with open(fp, \'r\', encoding=\'utf-8\') as fh:\n            content = fh.read()\n        name = extract_name(content, fp)\n        if not name:\n            continue\n        ings = parse_calc(content)\n        if not ings:\n            ings = parse_tools(content)\n        if not ings:\n            continue\n        cat = os.path.relpath(fp, recipe_dir).split(\'/\')[0]\n        all_recipes.append({\'name\': name, \'ings\': ings, \'cat\': cat})\n\nprint(f"Parsed {len(all_recipes)} recipes")\n\n# Debug: show recipes with 计算 section\ncount_with_calc = sum(1 for r in all_recipes if len(r[\'ings\']) >= 3)\nprint(f"Recipes with >=3 ingredients: {count_with_calc}")\n\n# Score recipes\ndef get_our_ing(ing_name):\n    name = ing_name.strip()\n    # Check direct match\n    if name in our_ings:\n        return (name, our_ings[name])\n    # Check mapping\n    if name in ing_mapping and ing_mapping[name]:\n        mapped = ing_mapping[name]\n        if mapped in our_ings:\n            return (mapped, our_ings[mapped])\n    # Substring match (our name in recipe name)\n    for our_name in our_ings:\n        if our_name in name:\n            return (our_name, our_ings[our_name])\n        if name in our_name:\n            return (our_name, our_ings[our_name])\n    return None\n\nresults = []\nfor recipe in all_recipes:\n    matched = []  # (recipe_name, recipe_amt, our_name)\n    unmatched = []\n    \n    for ing_name, ing_amt in recipe[\'ings\']:\n        our = get_our_ing(ing_name)\n        if our:\n            our_name, our_amt = our\n            matched.append((ing_name, ing_amt, our_name, our_amt))\n        else:\n            unmatched.append((ing_name, ing_amt))\n    \n    total = len(matched) + len(unmatched)\n    if total == 0:\n        continue\n    \n    matched_types = set(m[2] for m in matched)\n    ratio = len(matched_types) / total\n    \n    if ratio < 0.5:\n        continue\n    \n    results.append({\n        \'name\': recipe[\'name\'],\n        \'cat\': recipe[\'cat\'],\n        \'score\': len(matched_types),\n        \'ratio\': ratio,\n        \'matched\': matched,\n        \'unmatched\': unmatched,\n    })\n\nresults.sort(key=lambda x: (-x[\'score\'], -x[\'ratio\']))\n\nprint(f"\\nRecipes with >=50% match: {len(results)}")\nfor i, r in enumerate(results[:30]):\n    print(f"{i+1}. {r[\'name\']} [{r[\'cat\']}] types={r[\'score\']} ratio={r[\'ratio\']:.2f}")\n    for m in r[\'matched\']:\n        print(f"    MATCH: \'{m[0]}\' -> our=\'{m[2]}\' (avail={m[3]}, recipe={m[1]})")\n    for u in r[\'unmatched\']:\n        print(f"    MISS: \'{u[0]}\' ({u[1]})")\n\n# Select 3: try to include soup\nselected = []\nfor r in results:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\nprint("\\n=== SELECTED DISHES ===")\nmissing_list = []\nfor r in selected:\n    soup_tag = " (SOUP)" if r[\'cat\'] == \'soup\' else ""\n    print(f"\\n--- {r[\'name\']}{soup_tag} --- [{r[\'cat\']}]")\n    for m in r[\'matched\']:\n        print(f"  [HAVE] {m[2]}: recipe=\'{m[1]}\', available=\'{m[3]}\'")\n    print("  Missing:")\n    for u in r[\'unmatched\']:\n        clean = re.sub(r\'\\(.*?\\)\', \'\', u[0]).strip()\n        clean = re.sub(r\'\\*.*$\', \'\', clean).strip()\n        missing_list.append((clean, u[1]))\n        print(f"    {u[0]}: need \'{u[1]}\'")\n\nprint(f"\\n=== SHOPPING LIST ===")\nfor name, qty in missing_list:\n    print(f"  {name}: {qty}")\n\n# Write cuisine.json\ncuisine = {"recommended_dishes": [{"name": r[\'name\']} for r in selected]}\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved /app/cuisine.json")\nprint(json.dumps(cuisine, ensure_ascii=False, indent=4))\n\n# Write shopping.csv\nseen = {}\nfor name, qty in missing_list:\n    if name in seen:\n        seen[name].append(qty)\n    else:\n        seen[name] = [qty]\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    w = csv.writer(f)\n    w.writerow([\'Name\', \'Quantity\'])\n    for name, qtys in seen.items():\n        w.writerow([name, \', \'.join(qtys)])\nprint("Saved /app/shopping.csv")\nprint("\\n" + open(\'/app/shopping.csv\').read())\nPYEOF\npython3 /tmp/final2.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
