Sending keys: ['cat > /app/get_names.py << \'PYEOF\'\nimport pdfplumber\nimport re\n\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    # Get page text for all pages with our target courses\n    target_pages = {10, 11, 14, 30, 39, 41, 88, 89, 91, 97, 104, 110, 123, 126, 127, 129, 147, 148, 152, 156, 162, 163, 251, 252}\n    \n    # Build code->name mapping from page text\n    code_names = {}\n    \n    for pg_idx in target_pages:\n        if pg_idx >= len(pdf.pages):\n            continue\n        page = pdf.pages[pg_idx]\n        text = page.extract_text() or \'\'\n        \n        # Extract all course entries from this page\n        lines = text.split(\'\\n\')\n        \n        # Process: when we see a code line, also check the previous line for name continuation\n        # Pattern: [prev_line_text] [exam_info] [CODE [name] [credits] [instructor] [time]...\n        # or the name might be split across lines before the code\n        \n        for li, line in enumerate(lines):\n            m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n            if not m:\n                continue\n            code = m.group(1)\n            \n            # Look backward for course name in nearby lines\n            name_found = False\n            for back in range(1, 6):\n                if li - back < 0:\n                    break\n                prev = lines[li-back].strip()\n                if not prev:\n                    continue\n                if prev.startswith(\'=== PAGE\'):\n                    continue\n                # Check if this is a non-exam-info line with Chinese text\n                if \'考试\' in prev or prev.startswith(\'考试\'):\n                    # Check for trailing Chinese text after the exam-related content\n                    # Example: "《功利主义》研 考试日期: 2025-12-22"\n                    m_trail = re.search(r\'([\\u4e00-\\u9fff][\\u4e00-\\u9fff\\d\\（）《》，。！？、·-]*)\\s+考试\', prev)\n                    if m_trail:\n                        code_names[code] = m_trail.group(1)\n                        name_found = True\n                        break\n                elif re.match(r\'^[A-Z]{2,4}[0-9]+\', prev):\n                    # Previous line is another course code\n                    break\n                elif prev:\n                    # Could be name continuation\n                    if re.search(r\'[\\u4e00-\\u9fff]\', prev):\n                        m_trail2 = re.search(r\'([\\u4e00-\\u9fff][\\u4e00-\\u9fff\\d\\（）《》，。！？、·-]*)$\', prev)\n                        if m_trail2:\n                            code_names[code] = m_trail2.group(1)\n                            name_found = True\n                            break\n            \n            if not name_found:\n                # Look at same line - maybe the name is already on the same line\n                # Skip if code line starts directly with the code\n                pass\n    \n    # Print results\n    all_codes = sorted(code_names.keys())\n    print("Course name mapping:")\n    for code in all_codes:\n        print(f"  {code}: {code_names[code]}")\n    \n    # Also check for specific known courses\n    print("\\nKnown courses:")\n    for code in [\'PHIL119059.01\', \'FORE119008.01\', \'BIOL119008.01\', \'CHIN110038.01\', \'ICES110024.01\',\n                 \'ECON110017.01\', \'BIOL110035.01\', \'AIS210009.01\', \'CHIN130139.01\', \'HIST130305.01\',\n                 \'MUSE120002.01\', \'MUSE130068.01\', \'MUSE130085.01\', \'MUSE130096.01\', \'PHIL130034.01\']:\n        print(f"  {code}: {code_names.get(code, \'(not found)\')}")\n\nPYEOF\npython3 /app/get_names.py 2>&1 | tail -50\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
