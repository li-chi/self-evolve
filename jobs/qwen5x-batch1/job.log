     continue\n    y = int(yc)\n    for col in range(2, raw_ws.max_column + 1):\n        s = source_col_names[col - 2]\n        v = raw_ws.cell(row=row, column=col).value\n        if v is None or isinstance(v, str):\n            v = None\n        else:\n            try:\n                v = float(v)\n            except (ValueError, TypeError):\n                v = None\n        source_data[s][y] = v\n\n# Calculate YoY growth for each source\ngrowth_rates = {}\nfor src in source_col_names:\n    growth_rates[src] = {}\n    yrs = sorted(source_data[src].keys())\n    for i in range(1, len(yrs)):\n        c, p = yrs[i], yrs[i-1]\n        cv, pv = source_data[src][c], source_data[src][p]\n        if cv is not None and pv is not None and pv != 0:\n            growth_rates[src][c] = (cv - pv) / pv * 100\n\n# Verify source data for year 2024 for sources needing it\nprint("\\nSteel Production 2023-2024:")\nprint(f"  2023: {source_data[\'Steel Production\'].get(2023)}")\nprint(f"  2024: {source_data[\'Steel Production\'].get(2024)}")\nprint("\\nMRO 2023-2024:")\nprint(f"  2023: {source_data[\'MRO\'].get(2023)}")\nprint(f"  2024: {source_data[\'MRO\'].get(2024)}")\n\n# Calculate segment growth rates 2015-2024\nyears = list(range(2015, 2025))\nseg_order = list(segments.keys())\nresults = {\'Year\': years}\n\nfor seg in seg_order:\n    results[seg] = []\n    for year in years:\n        valid = True\n        weighted_sum = 0\n        for src, weight in segments[seg].items():\n            if year not in growth_rates[src]:\n                valid = False\n                break\n            weighted_sum += weight * growth_rates[src][year]\n        results[seg].append(round(weighted_sum, 1) if valid else \'N/A\')\n\nprint("\\n\\nFinal Results:")\ncols = [\'Year\'] + seg_order\nprint(\' | \'.join(cols))\nfor i, year in enumerate(years):\n    vals = [str(year)]\n    for seg in seg_order:\n        vals.append(str(results[seg][i]))\n    print(\' | \'.join(vals))\n\ndf = pd.DataFrame(results)\ndf.to_excel(\'/app/segment_growth_rates.xlsx\', index=False)\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
