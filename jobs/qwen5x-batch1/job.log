Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport openpyxl\nimport pandas as pd\n\n# Load workbook with formulas evaluated\nwb = openpyxl.load_workbook(\'/app/Market_Data.xlsx\', data_only=True)\n\n# --- Parse RawData sheet ---\nraw = wb[\'RawData\']\n# Row 4 (index 3) is headers\nheader_row = [c.value for c in raw[4]]\nyear_col = header_row[0]  # \'YY\'\nsources = header_row[1:]  # list of source names\n\n# Read data rows (year, source_values)\nraw_data = {}\nfor row in raw.iter_rows(min_row=5, values_only=True):\n    year = row[0]\n    if year is None:\n        continue\n    vals = {}\n    for i, src in enumerate(sources):\n        vals[src] = row[i + 1]\n    raw_data[int(year)] = vals\n\nprint("Sources:", sources)\nprint("Years:", sorted(raw_data.keys()))\nprint("Raw sample 2020:", raw_data.get(2020))\nprint("Raw sample 2024:", raw_data.get(2024))\n\n# --- Parse Methodology sheet ---\nmeth = wb[\'Methodology\']\n# Row 2 (index 1) has segment/source header + source names\nmeth_header = [c.value for c in meth[2]]  # col1=\'Segment/Source\', cols 2+=source names\nmeth_sources = [s for s in meth_header[1:] if s is not None]\n\nprint("\\nMethodology sources:", meth_sources)\n\n# Rows 4-13 (index 3-12) are segment definitions\nsegments = []  # (segment_name, {source: weight})\nfor row_idx in range(4, 14):  # rows 4 through 13 (0-indexed: 3..12)\n    row_vals = [c.value for c in meth[row_idx]]\n    seg_name = row_vals[1]  # column B (index 1)\n    if seg_name is None:\n        continue\n    if seg_name == \'Total\':\n        continue\n    weights = {}\n    for j, src in enumerate(meth_sources):\n        val = row_vals[j + 2]  # column C onwards (index 2+)\n        if val is not None:\n            weights[src] = float(val)\n    segments.append((seg_name, weights))\n\nprint("\\nSegments:")\nfor name, w in segments:\n    print(f"  {name}: {w}")\n\n# --- Calculate YoY growth rates for sources ---\nyears_sorted = sorted(raw_data.keys())\nsource_growth = {}  # {year: {source: growth_rate}}\nfor year in years_sorted:\n    if year == years_sorted[0]:\n        continue  # no previous year\n    prev_year = year - 1\n    source_growth[year] = {}\n    for src in sources:\n        curr = raw_data[year].get(src)\n        prev = raw_data[prev_year].get(src)\n        if curr is not None and prev is not None:\n            source_growth[year][src] = (curr - prev) / prev * 100.0\n        else:\n            source_growth[year][src] = None\n\n# --- Calculate segment growth rates ---\noutput_rows = []\nsegment_names = [s[0] for s in segments]\n\nfor year in range(2015, 2025):\n    row = {\'Year\': year}\n    for seg_name, weights in segments:\n        # Check each source growth rate\n        all_available = True\n        weighted_sum = 0.0\n        for src, w in weights.items():\n            gr = source_growth.get(year, {}).get(src)\n            if gr is None:\n                all_available = False\n                break\n            weighted_sum += gr * w\n        if all_available:\n            row[seg_name] = round(weighted_sum, 1)\n        else:\n            row[seg_name] = \'N/A\'\n    output_rows.append(row)\n\n# --- Save to Excel ---\ndf = pd.DataFrame(output_rows, columns=[\'Year\'] + segment_names)\nprint("\\nOutput DataFrame:")\nprint(df.to_string(index=False))\n\ndf.to_excel(\'/app/segment_growth_rates.xlsx\', index=False)\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
