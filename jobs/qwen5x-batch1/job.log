ept:\n        return []\n    \n    entries = []\n    lines = text.split(\'\\n\')\n    \n    for li, line in enumerate(lines):\n        m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n        if not m:\n            continue\n        code = m.group(1)\n        rest = line.strip()[len(code):].strip()\n        parts = rest.split()\n        \n        time_pos = -1\n        for j, p in enumerate(parts):\n            if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n                if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                    time_pos = j\n                    break\n        if time_pos <= 0:\n            continue\n        \n        before = parts[:time_pos]\n        instructor_pos = find_title_pos(before)\n        if instructor_pos <= 0:\n            continue\n        \n        instructor = before[instructor_pos]\n        title = before[instructor_pos+1] if instructor_pos+1 < len(before) else \'\'\n        \n        credits = \'\'\n        credits_pos = -1\n        for j in range(instructor_pos-1, 0, -1):\n            if before[j].isdigit() and int(before[j]) <= 5:\n                credits_pos = j\n                credits = before[j]\n                break\n        \n        course_name = \' \'.join(before[1:credits_pos]) if credits_pos > 1 else \'\'\n        \n        # Use pre-extracted name from PDF text\n        if not course_name and code in code_names:\n            course_name = code_names[code]\n        elif course_name and code in code_names:\n            # Prefer extracted name if the parsed one looks wrong\n            # Check if parsed name is just a fragment\n            if len(course_name) < 3:\n                course_name = code_names.get(code, course_name)\n        \n        after_parts = parts[time_pos:]\n        class_time = \' \'.join(after_parts[:3])\n        \n        campus = \'\'\n        for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n            if c in rest:\n                campus = c\n                break\n        \n        enrollment = \'\'\n        cm = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n        if cm:\n            enrollment = cm.group(1)\n        \n        assessment = \'\'\n        for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n            if a in rest:\n                assessment = a\n                break\n        \n        exam_time = \'\'\n        em = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n        if em:\n            exam_time = em.group(1)\n        \n        restrictions = \'\'\n        after_rest = rest\n        for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n            if a in after_rest:\n                idx = after_rest.find(a)\n                after_rest = after_rest[idx+len(a):]\n                break\n        restrictions = after_rest.strip()\n        \n        entries.append({\n            \'Course name\': course_name,\n            \'Course ID\': code,\n            \'Instructor\': instructor,\n            \'Campus\': campus,\n            \'Class Time\': class_time,\n            \'Enrollment\': enrollment,\n            \'Credits\': credits,\n            \'Assessment Method\': assessment,\n            \'Exam Time\': exam_time,\n            \'Course Selection Restrictions\': restrictions,\n            \'_day\': parts[time_pos],\n            \'_time\': parts[time_pos+1],\n            \'_pg\': pg_idx+1\n        })\n    \n    return entries\n\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    # Extract all entries\n    all_entries = []\n    for pg_idx in range(len(pdf.pages)):\n        all_entries.extend(parse_entry_from_pdf(pdf, pg_idx))\n    \n    print(f"Total entries: {len(all_entries)}")\n    \n    # Verify fixed courses\n    for e in all_entries:\n        code = e.get(\'Course ID\', \'\')\n        if code == \'COMP130141.01\':\n            e[\'Course name\'] = \'自然语言处理\'\n        elif code == \'COMP130025.01\':\n            e[\'Course name\'] = \'软件体系结构\'\n        elif code == \'PTSS110080.01\':\n            e[\'Course name\'] = \'中国共产党历史\'\n    \n    fixed = [e for e in all_entries if e.get(\'Course ID\') in [\'COMP130141.01\', \'COMP130025.01\', \'PTSS110080.01\']]\n    print(f"Fixed: {len(fixed)}")\n    for f in fixed:\n        print(f"  {f[\'Course name\']} [{f[\'Course ID\']}] - {f[\'Class Time\']}")\n    \n    # Find tongren Monday 开卷 courses (pages 10-164)\n    tongren = []\n    for e in all_entries:\n        code = e.get(\'Course ID\', \'\')\n        if e.get(\'Assessment Method\') != \'开卷\':\n            continue\n        if e.get(\'_day\') != \'一\':\n            continue\n        if code.startswith(\'PTSS\'):\n            continue\n        pg = e.get(\'_pg\', 0)\n        if pg >= 10 and pg <= 164:\n            tongren.append(e)\n    \n    # Apply pre-extracted names for tongren courses\n    for t in tongren:\n        code = t.get(\'Course ID\', \'\')\n        if code in code_names:\n            t[\'Course name\'] = code_names[code]\n    \n    print(f"\\nTongren Monday 开卷 on pages 10-164: {len(tongren)}")\n    for i, t in enumerate(tongren):\n        print(f"  {i+1}. {t[\'Course name\']} [{t[\'Course ID\']}] - {t[\'Class Time\']}")\n    \n    # Check conflicts\n    fixed_times = [(f[\'_day\'], f[\'_time\']) for f in fixed]\n    def has_conflict(d1, t1, d2, t2):\n        if d1 != d2:\n            return False\n        m1 = re.match(r\'(\\d+)-(\\d+)\', t1)\n        m2 = re.match(r\'(\\d+)-(\\d+)\', t2)\n        if m1 and m2:\n            return int(m1.group(1)) <= int(m2.group(2)) and int(m2.group(1)) <= int(m1.group(2))\n        return False\n    \n    valid = [o for o in tongren if not any(has_conflict(o[\'_day\'], o[\'_time\'], d, t) for d, t in fixed_times)]\n    print(f"\\nValid options (no time conflict): {len(valid)}")\n    for i, v in enumerate(valid):\n        print(f"  {i+1}. {v[\'Course name\']} [{v[\'Course ID\']}] - {v[\'Class Time\']}")\n    \n    # Create Excel files\n    fields = [\'Course name\',\'Course ID\',\'Instructor\',\'Campus\',\'Class Time\',\n              \'Enrollment\',\'Credits\',\'Assessment Method\',\'Exam Time\',\'Course Selection Restrictions\']\n    \n    for idx, opt in enumerate(valid):\n        wb = Workbook()\n        ws = wb.active\n        ws.title = \'Sheet1\'\n        \n        for ci, field in enumerate(fields, 1):\n            ws.cell(row=1, column=ci, value=field)\n        \n        for ri, course in enumerate(fixed + [opt], 2):\n            for ci, field in enumerate(fields, 1):\n                val = course.get(field, \'\')\n                ws.cell(row=ri, column=ci, value=val if val is not None else \'\')\n        \n        wb.save(f\'/app/scheme_{idx+1}.xlsx\')\n        print(f"Saved scheme_{idx+1}.xlsx: {opt[\'Course name\']}")\n    \n    # Cleanup other files\n    for f in [\'/app/extract_courses.py\', \'/app/extract2.py\', \'/app/get_names.py\', \'/app/final_gen.py\',\n              \'/app/pdf_text.txt\', \'/app/search_nlp.txt\']:\n        if os.path.exists(f):\n            os.remove(f)\n\nprint("\\nDone! Cleaned up temp files.")\nPYEOF\npython3 /app/final.py\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
