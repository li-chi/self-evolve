Sending keys: ['cat > /app/final_v3.py << \'PYEOF\'\nimport os, re, json, csv\n\navailable_names = {\'鸡蛋\', \'土豆\', \'茄子\', \'蒜苗\', \'冬瓜\', \'瘦猪肉片\', \'五花肉\', \'牛奶\', \'干辣椒\'}\navailable = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\', \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\', \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\'\n}\n\nNORM = {\n    \'青茄子\': \'茄子\', \'茄子\': \'茄子\',\n    \'带皮五花肉\': \'五花肉\', \'五花肉\': \'五花肉\', \'五花肉条\': \'五花肉\', \'肥肉\': \'五花肉\',\n    \'纯瘦肉\': \'瘦猪肉片\', \'瘦肉\': \'瘦猪肉片\', \'猪肉\': \'瘦猪肉片\',\n    \'猪肉末\': \'瘦猪肉片\', \'肉末\': \'瘦猪肉片\', \'瘦猪肉\': \'瘦猪肉片\',\n    \'鸡蛋\': \'鸡蛋\',\n    \'蒜苗\': \'蒜苗\',\n    \'冬瓜\': \'冬瓜\',\n    \'干辣椒\': \'干辣椒\', \'干辣椒（或者二荆条）\': \'干辣椒\',\n    \'牛奶\': \'牛奶\', \'全脂牛奶\': \'牛奶\', \'全脂牛奶/奶油\': \'牛奶\',\n}\n\ndef clean_raw(name):\n    name = re.sub(r\'[\\u1F300-\\u1F9FF\\U0001F600-\\U0001F9FF]\', \'\', name)\n    for sep in [\'(\', \'（\']:\n        if sep in name:\n            name = name[:name.index(sep)].strip()\n    if \'=\' in name:\n        name = name[:name.index(\'=\')].strip()\n    for sep in [\')\', \'）\']:\n        if sep in name:\n            name = name[:name.index(sep)].strip()\n    name = name.strip()\n    name = re.sub(r\'[\\s\\-=/]+$]\', \'\', name).strip()\n    return name\n\ndef normalize_ingredient(raw_name):\n    name = clean_raw(raw_name)\n    if not name:\n        return None\n    if name in NORM:\n        return NORM[name]\n    if name in available_names:\n        return name\n    for av in available_names:\n        if len(av) >= 2 and av in name:\n            return av\n    return None\n\ndef parse_all_ingredients(section_text):\n    """Parse ALL ingredients from 计算 section."""\n    ingredients = []\n    for line in section_text.split(\'\\n\'):\n        line = line.strip()\n        if not line:\n            continue\n        if line.startswith(\'#\') or line.startswith(\'<!--\') or line.startswith(\'```\'):\n            continue\n        if \'**\' in line and \':\' in line:\n            continue\n        raw = None\n        if line.startswith(\'- \') or line.startswith(\'* \'):\n            raw = line.lstrip(\'-* \').strip()\n        else:\n            continue\n        # Match name and quantity\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s*(.*)\', raw)\n        if m:\n            name_raw = m.group(1).strip()\n            qty_raw = m.group(2).strip() if len(m.groups()) > 1 else \'\'\n            ingredients.append((clean_raw(name_raw), qty_raw))\n    \n    # Also try table format\n    for line in section_text.split(\'\\n\'):\n        if line.strip().startswith(\'|\') and \'原料\' not in line and \'数量\' not in line:\n            parts = [p.strip() for p in line.strip().split(\'|\')]\n            parts = [p for p in parts if p.strip()]\n            if len(parts) >= 2:\n                name_raw = clean_raw(parts[0])\n                qty_raw = parts[1]\n                if name_raw and name_raw not in (\'原料\', \'名称\', \'材料\', \'\'):\n                    ingredients.append((name_raw, qty_raw))\n    \n    return ingredients\n\ndef parse_recipe(fpath):\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except:\n        return None\n    \n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            name = m.group(1).strip()\n            break\n    if not name:\n        return None\n    # Clean name\n    name = re.sub(r\'\\s*(的?)做法\\s*$\', \'\', name).strip()\n    name = re.sub(r\'^\\d+\\s*\', \'\', name).strip()\n    \n    ingredients = []\n    calc_match = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if calc_match:\n        ingredients = parse_all_ingredients(calc_match.group(1))\n    \n    if not ingredients:\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    for sep in [\'(\', \'（\']:\n                        if sep in raw:\n                            raw = raw[:raw.index(sep)].strip()\n                    ingredients.append((clean_raw(raw), \'\'))\n    \n    if not ingredients:\n        return None\n    \n    return {\'name\': name, \'all_ingredients\': ingredients}\n\n# Parse all recipes\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in sorted(files):\n        if not fname.endswith(\'.md\'):\n            continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result:\n            recipes.append(result)\n\nprint(f"Parsed {len(recipes)} recipes")\n\n# Build normalized data\ncandidates = []\nfor r in recipes:\n    norm_ings = {}\n    for raw_name, qty in r[\'all_ingredients\']:\n        norm = normalize_ingredient(raw_name)\n        if norm:\n            norm_ings[norm] = qty\n    \n    matched = [n for n in norm_ings if n in available_names]\n    total_all = len(r[\'all_ingredients\'])\n    matched_names = [n for n in norm_ings if n in available_names]\n    matched_total = len(matched_names)\n    ratio = matched_total / total_all if total_all > 0 else 0\n    \n    if ratio >= 0.5 and matched_total >= 2:\n        candidates.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': norm_ings,\n            \'matched\': matched_names,\n            \'total\': total_all,\n            \'ratio\': ratio\n        })\n\ncandidates.sort(key=lambda x: (-len(x[\'matched\']), -x[\'ratio\'], x[\'name\']))\n\nprint(f"\\nCandidates (>=50% coverage, >=2 matches): {len(candidates)}")\nfor i, c in enumerate(candidates[:30]):\n    missing = {n: q for n, q in c[\'ingredients\'].items() if n not in available_names}\n    print(f"  {i+1}. {c[\'name\']}: {len(c[\'matched\'])}/{c[\'total\']} ({c[\'ratio\']:.0%}) - avail:{c[\'matched\']} missing:{list(missing.keys())}")\n\n# Select 3 diverse dishes including soup\nselected = []\nused_matched = set()\n\n# Pick soup first\nfor c in candidates:\n    if \'汤\' in c[\'name\'] or \'粥\' in c[\'name\'] or \'羹\' in c[\'name\']:\n        selected.append(c)\n        used_matched.update(c[\'matched\'])\n        print(f"\\n>>> Selected soup: {c[\'name\']}")\n        break\n\n# Pick next 2 with most new coverage\nfor c in candidates:\n    if len(selected) >= 3:\n        break\n    if c[\'name\'] in [s[\'name\'] for s in selected]:\n        continue\n    new_cov = [m for m in c[\'matched\'] if m not in used_matched]\n    # Prefer dishes with high new coverage\n    selected.append(c)\n    used_matched.update(c[\'matched\'])\n    print(f">>> Selected: {c[\'name\']} (new coverage: {new_cov})")\n\nprint(f"\\n=== Final Selection ===")\nfor s in selected:\n    missing = {n: q for n, q in s[\'ingredients\'].items() if n not in available_names}\n    print(f"\\n{s[\'name\']} ({len(s[\'matched\'])}/{s[\'total\']})")\n    for ing, qty in s[\'ingredients\'].items():\n        status = \'IN_STOCK\' if ing in available_names else \'NEED\'\n        print(f"  [{status}] {ing}: {qty}")\n    if missing:\n        print(f"  Need to buy: {list(missing.keys())}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    for ing, qty in s[\'ingredients\'].items():\n        dish["ingredients"][ing] = qty\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list\nshopping = []\nfor s in selected:\n    for ing, qty in s[\'ingredients\'].items():\n        if ing not in available:\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nfor item in shopping:\n    print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
