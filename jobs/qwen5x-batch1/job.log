artswith(\'=\'):\n                results.append((name, amount))\n                continue\n        \n        # Format 2: ingredient = amount (with = sign)\n        # e.g., "茄子的数量 = 份数 * 1 个"\n        m = re.match(r\'^(.+?)\\s*=\\s*(.+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            amount = re.sub(r\'\\(.*?\\)\', \'\', amount).strip()\n            amount = re.sub(r\'\\s*（.*?）\\s*$\', \'\', amount).strip()\n            # Remove formula prefixes like "份数 * "\n            amount = re.sub(r\'^份数\\s*\\*\\s*\', \'\', amount).strip()\n            if amount and len(amount) > 0:\n                results.append((name, amount))\n                continue\n        \n        # Format 3: ingredient with inline notes\n        # e.g., "蒜苗 1 把"\n        m = re.match(r\'^(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\w]+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            results.append((name, amount))\n            continue\n        \n        # Format 4: amount then name (rare)\n        m = re.match(r\'^(\\d[\\d\\w\\s%]+?)\\s+([\\u4e00-\\u9fff].+)$\', line)\n        if m:\n            amount = m.group(1).strip()\n            name = m.group(2).strip()\n            results.append((name, amount))\n            continue\n    \n    return results\n\ndef parse_simple_section(content, section_name):\n    """Parse a section with simple list items."""\n    match = re.search(rf\'## {section_name}\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not match:\n        return []\n    block = match.group(1)\n    results = []\n    for line in block.split(\'\\n\'):\n        if line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \'):\n            name = line[2:].strip()\n            if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n                results.append((name, \'\'))\n    return results\n\n# Collect all recipes\nrecipe_dir = \'/tmp/HowToCook/dishes\'\nall_recipes = []\n\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if not f.endswith(\'.md\'):\n            continue\n        filepath = os.path.join(root, f)\n        with open(filepath, \'r\', encoding=\'utf-8\') as fh:\n            content = fh.read()\n        \n        dish_name = extract_dish_name(content, filepath)\n        if not dish_name:\n            continue\n        \n        # Try 计算 section first, fallback to 必备原料和工具\n        calc_ings = parse_calc_section(content)\n        if not calc_ings:\n            calc_ings = parse_simple_section(content, \'必备原料和工具\')\n        \n        if not calc_ings:\n            continue\n        \n        all_recipes.append({\n            \'name\': dish_name,\n            \'ingredients\': calc_ings,\n            \'filepath\': filepath,\n            \'category\': os.path.relpath(filepath, recipe_dir).split(\'/\')[0],\n        })\n\nprint(f"Total recipes parsed: {len(all_recipes)}")\n\n# Show a few samples\nfor name in [\'瘦肉土豆片\', \'回锅肉\', \'茄子炖土豆\', \'西红柿炒鸡蛋\']:\n    for r in all_recipes:\n        if name in r[\'name\']:\n            print(f"\\n{name}: {r[\'name\']}")\n            for ing in r[\'ingredients\'][:8]:\n                print(f"  \'{ing[0]}\' -> \'{ing[1]}\'")\n            break\n\n# Match recipes against our ingredients\nresults = []\nfor recipe in all_recipes:\n    matched = []\n    unmatched = []\n    \n    for ing_name, amount in recipe[\'ingredients\']:\n        found = False\n        for our_name in our_ings:\n            norm_our = our_name.strip()\n            norm_ing = ing_name.strip()\n            \n            if norm_our == norm_ing:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n            if our_name in ing_name:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n            if ing_name in our_name:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n        \n        if not found:\n            unmatched.append((ing_name, amount))\n    \n    total = len(matched) + len(unmatched)\n    if total == 0:\n        continue\n    \n    # Count unique matched types (by our_ingredient name)\n    matched_types = set()\n    for m in matched:\n        for our_name in our_ings:\n            norm_our = our_name.strip()\n            norm_ing = m[0].strip()\n            if norm_our == norm_ing or our_name in ing_name or ing_name in our_name:\n                matched_types.add(our_name)\n                break\n    \n    ratio = len(matched_types) / total\n    if ratio < 0.5:\n        continue\n    \n    results.append({\n        \'name\': recipe[\'name\'],\n        \'category\': recipe[\'category\'],\n        \'score\': len(matched_types),\n        \'ratio\': ratio,\n        \'matched\': matched,\n        \'unmatched\': unmatched,\n        \'filepath\': recipe[\'filepath\'],\n    })\n\nresults.sort(key=lambda x: (-x[\'score\'], -x[\'ratio\']))\n\nprint(f"\\n=== All qualifying recipes (>=50% match) ===")\nfor i, r in enumerate(results[:30]):\n    print(f"{i+1}. {r[\'name\']} [{r[\'category\']}] matched_types={r[\'score\']} ratio={r[\'ratio\']:.2f}")\n\n# Select top 3, trying to get a soup\nselected = []\nfor r in results:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\nprint("\\n=== FINAL SELECTED DISHES ===")\nall_missing = []\nfor r in selected:\n    print(f"\\n--- {r[\'name\']} ---")\n    print(f"Category: {r[\'category\']}")\n    print("HAVE:")\n    for m in r[\'matched\']:\n        print(f"  {m[0]}: recipe={m[1]}, available={m[2]}")\n    print("MISSING:")\n    for u in r[\'unmatched\']:\n        clean_name = re.sub(r\'\\(.*?\\)\', \'\', u[0]).strip()\n        clean_name = re.sub(r\'\\*.*$\', \'\', clean_name).strip()\n        all_missing.append((clean_name, u[1]))\n        print(f"  {u[0]}: need {u[1]}")\n\nprint("\\n=== SHOPPING LIST ===")\nfor name, qty in all_missing:\n    print(f"  {name}: {qty}")\n\n# Save cuisine.json\ncuisine = {\n    "recommended_dishes": []\n}\nfor r in selected:\n    dish = {"name": r[\'name\']}\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Save shopping list\nseen = {}\nfor name, qty in all_missing:\n    if name in seen:\n        seen[name].append(qty)\n    else:\n        seen[name] = [qty]\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'Name\', \'Quantity\'])\n    for name, quantities in seen.items():\n        combined = \', \'.join(quantities)\n        writer.writerow([name, combined])\nprint("Saved shopping.csv")\nPYEOF\npython3 /tmp/solve2.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
