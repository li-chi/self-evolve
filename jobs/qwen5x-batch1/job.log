tio\']:.2f}, matches={r[\'match_count\']}/{r[\'total_ingredients\']}, matched={r[\'matched\']}")\n\nprint("\\nAll recipes (sorted):")\nfor i, r in enumerate(recipes[:30]):\n    dir_name = os.path.basename(os.path.dirname(r[\'path\']))\n    print(f"  {i+1}. [{dir_name}] {r[\'name\']} - ratio={r[\'ratio\']:.2f}, matches={r[\'match_count\']}/{r[\'total_ingredients\']}, matched={r[\'matched\']}")\n    print(f"      ingredients: {r[\'ingredients\'][:10]}")\nPYEOF\npython3 /app/analyze.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
