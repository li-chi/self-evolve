Sending keys: ["cat > /app/get_amounts.py << 'ENDSCRIPT'\nimport json, re, urllib.request, urllib.parse\n\nwith open('/app/recipes.json') as f:\n    recipes = json.load(f)\n\n# Find specific dishes and fetch their raw content\nRAW = 'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/'\n\ndishes_to_fetch = [\n    '红烧鲤鱼',\n    '美式炒蛋', \n    '燕麦鸡蛋饼',\n    '牛奶燕麦',\n    '冬瓜茶',\n]\n\nfor target in dishes_to_fetch:\n    found = None\n    for r in recipes:\n        if r['name'] == target:\n            found = r\n            break\n    if found:\n        path = found['path']\n        raw = RAW + urllib.parse.quote(path, safe='/')\n        try:\n            with urllib.request.urlopen(raw) as r:\n                txt = r.read().decode('utf-8', errors='replace')\n            print('=== ' + target + ' (from ' + path + ') ===')\n            # Parse quantities\n            calc = re.search(r'(## 计算.*?)((?:## )|$)', txt, re.S | re.I)\n            if calc:\n                sec = calc.group(1)\n                print('--- QUANTITIES ---')\n                for line in sec.split('\\n'):\n                    line = line.strip()\n                    if line.startswith('-'):\n                        print('  ' + line)\n            else:\n                print('--- NO CALC SECTION ---')\n                # Try to find ingredient amounts from 必备原料部分\n                ing = re.search(r'(## 必备原料和工具.*?)((?:## )|$)', txt, re.S | re.I)\n                if ing:\n                    print('--- INGREDIENT SECTION ---')\n                    for line in ing.group(1).split('\\n'):\n                        line = line.strip()\n                        if line.startswith('-'):\n                            print('  ' + line)\n            print()\n        except Exception as e:\n            print('Error fetching ' + path + ': ' + str(e))\n    else:\n        print('NOT FOUND in recipes.json: ' + target)\nENDSCRIPT\npython3 /app/get_amounts.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
