 = re.search(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', line)\n    weekday = wm.group(1) if wm else \'\'\n    time_range = wm.group(2) if wm else \'\'\n    weeks = wm.group(3) if wm else \'\'\n    \n    campus_m = re.search(r\'(邯郸校区|江湾校区|张江校区|枫林校区)\', line)\n    campus = campus_m.group(1) if campus_m else \'\'\n    \n    exam_type = \'\'\n    for t in [\'开卷\', \'闭卷\', \'论文\', \'其他\']:\n        if t in line:\n            exam_type = t\n            break\n    \n    # Teacher\n    t_m = re.search(r\'(教授|副教授|讲师|研究员|副研究员|高级工程师|青年研究员|助理研究员)\', line)\n    teacher = \'\'\n    if t_m:\n        teacher = line[:t_m.start()].strip()\n        teacher = re.sub(r\'^[A-Z]{2,6}\\d{6}\\.\\d+\\s+\', \'\', teacher)\n        teacher = re.sub(r\'\\s+\\d+\\s+\', \' \', teacher).strip()\n    \n    # Department\n    dept_keywords = [\'马克思主义学院\', \'哲学学院\', \'中国语言文学系\', \'文学院\',\n                     \'历史学系\', \'文物与博物馆学系\', \'国际文化交流学院\',\n                     \'计算机科学技术学院\', \'软件学院\', \'信息科学与工程学院\', \'航空航天系\',\n                     \'政治学\', \'法学院\', \'艺术学院\', \'经济\', \'管理学院\',\n                     \'生命科学学院\', \'环境科学\', \'物理学系\', \'化学系\', \'数学科学\',\n                     \'大气\', \'相辉\', \'新闻\', \'社会发展\', \'社会学\', \'公共管理\',\n                     \'外国语言\', \'艺术教育中心\', \'体育学院\', \'心理咨询\', \'大学外语\',\n                     \'环境科学与工程系\', \'音乐\', \'舞蹈\', \'戏剧\', \'书法\']\n    department = \'\'\n    for dk in dept_keywords:\n        if dk in line:\n            di = line.rfind(dk)\n            department = line[di:].strip()\n            break\n    \n    # Exam info\n    exam_info = \'\'\n    for j in range(i+1, min(i+4, len(lines))):\n        nline = lines[j].rstrip()\n        ed = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', nline)\n        et = re.search(r\'考试时间:\\s*([^\\n]+)\', nline)\n        if ed:\n            exam_info += ed.group(1) + \' \'\n        if et:\n            exam_info += et.group(1).strip()\n    exam_info = exam_info.strip()\n    \n    return {\n        \'cid\': cid, \'name\': name, \'credits\': credits, \'teacher\': teacher,\n        \'weekday\': weekday, \'time\': time_range, \'weeks\': weeks,\n        \'campus\': campus, \'exam_type\': exam_type, \'exam_info\': exam_info,\n        \'department\': department\n    }\n\nprint(\'\\n=== 通识核心 Monday 开卷 ===\')\ntongshi_list = []\nfor line_num, sec, cid, line in course_lines:\n    if sec == \'通识核心\':\n        fields = get_course_fields(line)\n        if fields and fields[\'weekday\'] == \'一\' and fields[\'exam_type\'] == \'开卷\':\n            fields[\'section\'] = sec\n            print(f"  {fields[\'cid\']}: {fields[\'name\']}, {fields[\'credits\']}学分, {fields[\'teacher\']}, {fields[\'weekday\']}{fields[\'time\']} {fields[\'weeks\']}, {fields[\'campus\']}, {fields[\'exam_type\']}, 考试:{fields[\'exam_info\']}, {fields[\'department\']}")\n            tongshi_list.append(fields)\n\nprint(f\'\\nTotal 通识核心 Monday 开卷: {len(tongshi_list)}\')\n\nprint(\'\\n=== 思政B Monday 开卷 ===\')\nsizhengB_list = []\nfor line_num, sec, cid, line in course_lines:\n    if sec == \'思政B\':\n        fields = get_course_fields(line)\n        if fields and fields[\'weekday\'] == \'一\' and fields[\'exam_type\'] == \'开卷\':\n            fields[\'section\'] = sec\n            print(f"  {fields[\'cid\']}: {fields[\'name\']}, {fields[\'credits\']}学分, {fields[\'teacher\']}, {fields[\'weekday\']}{fields[\'time\']} {fields[\'weeks\']}, {fields[\'campus\']}, {fields[\'exam_type\']}, 考试:{fields[\'exam_info\']}, {fields[\'department\']}")\n            sizhengB_list.append(fields)\n\nprint(f\'\\nTotal 思政B Monday 开卷: {len(sizhengB_list)}\')\n\nPYEOF\npython3 /app/parse_v3.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
