Sending keys: ['cat > /app/solve_mcp.py << \'PYEOF\'\nimport json\nimport subprocess\nimport sys\nimport os\n\n# Test the MCP server by running npx directly\nprint("Testing MCP server connection...")\nenv = os.environ.copy()\nenv[\'HOME\'] = \'/root\'\n\n# First, let\'s list available tools\ntask = {\n    "jsonrpc": "2.0",\n    "id": 1,\n    "method": "tools/list",\n    "params": {}\n}\n\n# Send initialize first\ntask_init = {\n    "jsonrpc": "2.0",\n    "id": 0,\n    "method": "initialize",\n    "params": {\n        "protocolVersion": "2024-11-05",\n        "capabilities": {},\n        "clientInfo": {"name": "test", "version": "1.0"}\n    }\n}\n\nproc = subprocess.Popen(\n    ["npx", "-y", "howtocook-mcp"],\n    stdin=subprocess.PIPE,\n    stdout=subprocess.PIPE,\n    stderr=subprocess.PIPE,\n    cwd="/app",\n    env=env\n)\n\nimport time\n\n# Initialize\nproc.stdin.write((json.dumps(task_init) + "\\n").encode())\nproc.stdin.flush()\ntime.sleep(2)\n\n# Send initialized notification\ninit_notif = {"jsonrpc": "2.0", "method": "notifications/initialized", "params": {}}\nproc.stdin.write((json.dumps(init_notif) + "\\n").encode())\nproc.stdin.flush()\ntime.sleep(1)\n\n# List tools\nproc.stdin.write((json.dumps(task) + "\\n").encode())\nproc.stdin.flush()\ntime.sleep(3)\n\noutput = b""\nwhile proc.poll() is None:\n    try:\n        chunk = proc.stdout.read(1)\n        output += chunk\n        if b\'}\' in output:\n            break\n    except:\n        break\n\nprint("Raw output:", output[:2000].decode(\'utf-8\', errors=\'replace\'))\n\n# Check stderr\nstderr = proc.stderr.read().decode(\'utf-8\', errors=\'replace\')\nif stderr:\n    print("Stderr:", stderr[:1000])\n\n# Read remaining stdout\nremaining = proc.stdout.read().decode(\'utf-8\', errors=\'replace\')\nif remaining:\n    print("Remaining output:", remaining[:2000])\n\nproc.terminate()\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
