Sending keys: ['cat > /tmp/gen.py << \'XYZEOF\'\nimport csv\n\nwith open(\'/app/ingredients.csv\') as f:\n    reader = csv.DictReader(f)\n    avail = [row[\'Ingredient Name\'] for row in reader]\n\nscript = []\nscript.append(\'import json, urllib.request, urllib.parse, re, time, csv\')\nscript.append(\'\')\nscript.append(\'avail = \' + repr(avail))\nscript.append(\'\')\nscript.append(\'with open("/tmp/dish_files.txt") as f:\')\nscript.append(\'    dish_files = [line.strip() for line in f if line.strip()]\')\nscript.append(\'\')\nscript.append(\'def fetch_recipe(path):\')\nscript.append(\'    encoded = urllib.parse.quote(path, safe="/ ")\')\nscript.append(\'    url = "https://raw.githubusercontent.com/Anduin2017/HowToCook/master/" + encoded\')\nscript.append(\'    try:\')\nscript.append(\'        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})\')\nscript.append(\'        resp = urllib.request.urlopen(req, timeout=15)\')\nscript.append(\'        return resp.read().decode("utf-8", errors="replace")\')\nscript.append(\'    except Exception:\')\nscript.append(\'        return None\')\nscript.append(\'\')\nscript.append(\'def clean_ing(name):\')\nscript.append(\'    name = name.strip()\')\nscript.append(\'    name = re.split(r"[（(][^）)]*[）)]", name)[0].strip()\')\nscript.append(\'    return name\')\nscript.append(\'\')\nscript.append(\'def split_ingredients(raw):\')\nscript.append(\'    results = []\')\nscript.append(\'    for line in raw:\')\nscript.append(\'        parts = [p.strip() for p in line.split("、")]\')\nscript.append(\'        results.extend(parts)\')\nscript.append(\'    all_parts = []\')\nscript.append(\'    for p in results:\')\nscript.append(\'        sub = [s.strip() for s in p.split(",")]\')\nscript.append(\'        all_parts.extend([s for s in sub if s])\')\nscript.append(\'    return all_parts\')\nscript.append(\'\')\nscript.append(\'def parse_recipe(content, path):\')\nscript.append(\'    if not content or "404" in content or len(content) < 30:\')\nscript.append(\'        return None\')\nscript.append(\'    title_m = re.search(r"^# (.+)", content, re.MULTILINE)\')\nscript.append(\'    if title_m:\')\nscript.append(\'        name = title_m.group(1).strip()\')\nscript.append(\'        name = re.sub(r"的做法$", "", name)\')\nscript.append(\'    else:\')\nscript.append(\'        name = path.split("/")[-1].replace(".md", "")\')\nscript.append(\'    ingredients = []\')\nscript.append(\'    ing_m = re.search(r"## 必备原料和工具[\\\\n](.*?)[\\\\n]## |$", content, re.DOTALL)\')\nscript.append(\'    if ing_m:\')\nscript.append(\'        for line in ing_m.group(1).split("\\\\n"):\')\nscript.append(\'            line = line.strip()\')\nscript.append(\'            if line.startswith("- "):\')\nscript.append(\'                item = clean_ing(line[2:])\')\nscript.append(\'                if item:\')\nscript.append(\'                    ingredients.append(item)\')\nscript.append(\'    ingredients = split_ingredients(ingredients)\')\nscript.append(\'    quantities = {}\')\nscript.append(\'    qty_m = re.search(r"## 计算[\\\\n](.*?)(?:[\\\\n]## |$)", content, re.DOTALL)\')\nscript.append(\'    if qty_m:\')\nscript.append(\'        qty_text = qty_m.group(1)\')\nscript.append(\'        per_match = re.search(r"每份[：:]([\\\\s\\\\S]*?)(?:[\\\\n]## |$)", qty_text)\')\nscript.append(\'        formula_match = re.search(r"总量[：:]([\\\\s\\\\S]*?)(?:[\\\\n]## |$)", qty_text)\')\nscript.append(\'        if per_match:\')\nscript.append(\'            for line in per_match.group(1).split("\\\\n"):\')\nscript.append(\'                line = line.strip()\')\nscript.append(\'                if line.startswith("- "): line = line[2:].strip()\')\nscript.append(\'                m2 = re.match(r"^(.+?)\\\\s+(\\\\d+[^\\\\n]*)$", line)\')\nscript.append(\'                if m2:\')\nscript.append(\'                    iname = clean_ing(m2.group(1).strip())\')\nscript.append(\'                    qty = m2.group(2).strip().replace("每份", "").strip()\')\nscript.append(\'                    if iname and qty: quantities[iname] = qty\')\nscript.append(\'        elif formula_match:\')\nscript.append(\'            for line in formula_match.group(1).split("\\\\n"):\')\nscript.append(\'                line = line.strip()\')\nscript.append(\'                if line.startswith("- "): line = line[2:].strip()\')\nscript.append(\'                m2 = re.match(r"^(.+?)[=:](.*)$", line)\')\nscript.append(\'                if m2:\')\nscript.append(\'                    bname = clean_ing(m2.group(1).strip())\')\nscript.append(\'                    qm = re.search(r"(\\\\d+[^\\\\n]+)", m2.group(2).strip())\')\nscript.append(\'                    qty = qm.group(1).strip() if qm else m2.group(2).strip()\')\nscript.append(\'                    qty = re.sub(r"（[^）]*）", "", qty).strip()\')\nscript.append(\'                    if bname and qty: quantities[bname] = qty\')\nscript.append(\'    return {"name": name, "ingredients": ingredients, "quantities": quantities}\')\nscript.append(\'\')\nscript.append(\'print("Processing", len(dish_files), "files")\')\nscript.append(\'all_r = []\')\nscript.append(\'for i, path in enumerate(dish_files):\')\nscript.append(\'    c = fetch_recipe(path)\')\nscript.append(\'    if c:\')\nscript.append(\'        r = parse_recipe(c, path)\')\nscript.append(\'        if r and r["ingredients"]: all_r.append(r)\')\nscript.append(\'    if (i+1) % 50 == 0: print("  ", i+1, len(all_r))\')\nscript.append(\'    time.sleep(0.3)\')\nscript.append(\'print("Parsed", len(all_r), "recipes")\')\nscript.append(\'scored = []\')\nscript.append(\'for r in all_r:\')\nscript.append(\'    mt = []\')\nscript.append(\'    for ri in r["ingredients"]:\')\nscript.append(\'        for ai in avail:\')\nscript.append(\'            if ai == ri or ai in ri or ri in ai: mt.append(ri); break\')\nscript.append(\'    m = len(mt); t = len(r["ingredients"])\')\nscript.append(\'    if t > 0:\')\nscript.append(\'        scored.append({"name": r["name"], "ingredients": r["ingredients"], "quantities": r["quantities"], "matches": m, "total": t, "ratio": m/t, "matched": mt, "missing": [x for x in r["ingredients"] if x not in mt]})\')\nscript.append(\'scored.sort(key=lambda x: (-x["ratio"], -x["matches"]))\')\nscript.append(\'print("Found", len(scored), "dishes")\')\nscript.append(\'for r in scored[:25]:\')\nscript.append(\'    print(" ", r["name"], r["matches"], "/", r["total"], round(r["ratio"]*100), "%")\')\nscript.append(\'    print("   Have:", r["matched"])\')\nscript.append(\'    print("   Missing:", r["missing"])\')\nscript.append(\'    print("   Qty:", json.dumps(r["quantities"], ensure_ascii=False))\')\nscript.append(\'    print()\')\nscript.append(\'soup_kw = ["汤", "粥", "羹", "炖", "煲"]\')\nscript.append(\'soup_l = [r for r in scored if any(kw in r["name"] for kw in soup_kw)]\')\nscript.append(\'other_l = [r for r in scored if r not in soup_l]\')\nscript.append(\'selected = []\')\nscript.append(\'if soup_l: selected.append(soup_l[0])\')\nscript.append(\'for r in other_l:\')\nscript.append(\'    if len(selected) >= 3: break\')\nscript.append(\'    selected.append(r)\')\nscript.append(\'print("Selected:")\')\nscript.append(\'for r in selected:\')\nscript.append(\'    print(r["name"], r["matches"], "/", r["total"], round(r["ratio"]*100), "%")\')\nscript.append(\'    print("  Have:", r["matched"])\')\nscript.append(\'    print("  Missing:", r["missing"])\')\nscript.append(\'    print("  Qty:", json.dumps(r["quantities"], ensure_ascii=False))\')\nscript.append(\'cuisine = {"recommended_dishes": []}\')\nscript.append(\'for r in selected:\')\nscript.append(\'    e = {"name": r["name"], "ingredients": []}\')\nscript.append(\'    for ing in r["ingredients"]:\')\nscript.append(\'        e["ingredients"].append({"name": ing, "quantity": r["quantities"].get(ing, "")})\')\nscript.append(\'    cuisine["recommended_dishes"].append(e)\')\nscript.append(\'with open("/app/cuisine.json", "w", encoding="utf-8") as f:\')\nscript.append(\'    json.dump(cuisine, f, ensure_ascii=False, indent=2)\')\nscript.append(\'print("Saved cuisine.json")\')\nscript.append(\'shopping = []\')\nscript.append(\'seen = set()\')\nscript.append(\'for r in selected:\')\nscript.append(\'    for ing in r["missing"]:\')\nscript.append(\'        if ing not in seen:\')\nscript.append(\'            shopping.append({"Name": ing, "Quantity": r["quantities"].get(ing, "")})\')\nscript.append(\'            seen.add(ing)\')\nscript.append(\'with open("/app/shopping.csv", "w", encoding="utf-8") as f:\')\nscript.append(\'    f.write("Name,Quantity\\\\n")\')\nscript.append(\'    for item in shopping:\')\nscript.append(\'        f.write(item["Name"] + "," + item["Quantity"] + "\\\\n")\')\nscript.append(\'print("Saved shopping.csv", len(shopping), "items")\')\n\nwith open(\'/app/solve_final.py\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'\\n\'.join(script) + \'\\n\')\nprint(\'Script written to /app/solve_final.py\')\nXYZEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
