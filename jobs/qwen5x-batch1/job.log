trip()\n            i += 1\n        \n        # Credits\n        credits = \'\'\n        if i < end and re.match(r\'^\\d+\\.?\\d*$\', lines[i].strip()):\n            credits = lines[i].strip()\n            i += 1\n        \n        # Instructor (can have multiple instructors, on separate lines)\n        instructors = []\n        while i < end and re.match(r\'^[\\u4e00-\\u9fa5]{2,4}$\', lines[i].strip()) and lines[i].strip() not in (\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\'):\n            instructors.append(lines[i].strip())\n            i += 1\n        \n        # Title\n        title = \'\'\n        if i < end and lines[i].strip() in (\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\'):\n            title = lines[i].strip()\n            i += 1\n        \n        # Time\n        time_str = \'\'\n        time_pattern = re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[.*\\]$\', lines[i].strip())\n        if time_pattern:\n            time_str = lines[i].strip()\n            i += 1\n        \n        # Assessment\n        assessment = \'\'\n        if i < end and lines[i].strip() in (\'开卷\', \'闭卷\', \'论文\', \'口试\', \'其他\', \'报告\', \'随堂考试\'):\n            assessment = lines[i].strip()\n            i += 1\n        \n        # Department (may be multi-line)\n        dept = \'\'\n        while i < end and re.match(r\'^[\\u4e00-\\u9fa5]{2,6}$\', lines[i].strip()):\n            dept += lines[i].strip()\n            i += 1\n        \n        if name:\n            print(f"ID={course_id} Name={name} Credits={credits} Instructor={\',\'.join(instructors)} Title={title} Time={time_str} Assess={assessment}")\n        else:\n            i += 1\n        continue\n    \n    i += 1\n\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
