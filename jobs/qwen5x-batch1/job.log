if name in synonyms:\n        return synonyms[name]\n    return None\n\ndef parse_calculations(section):\n    """Parse ingredient list from 计算 section text."""\n    ingredients = {}\n    for line in section.split(\'\\n\'):\n        line = line.strip()\n        if not line or line.startswith(\'#\') or line.startswith(\'*\') and line.startswith(\'**\'):\n            continue\n        # Skip pure notes, empty lines, structural elements\n        if line.startswith(\'- \') or line.startswith(\'* \'):\n            raw = line.lstrip(\'-*\').strip()\n        elif \'=\' in line and (line.startswith(\'- \') or line.startswith(\'* \')):\n            raw = line.lstrip(\'-*\').strip()\n        else:\n            continue\n        # Try to extract: name and quantity\n        # Patterns: "- 鸡蛋 2个", "- 鸡蛋 1 个", "- 土豆 200g"\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s*=\\s*(.+)\', raw)\n        if m:\n            name = clean_name(m.group(1).strip())\n            qty = m.group(2).strip()\n            if not name or len(name) < 1:\n                continue\n            # Skip if it looks like a note/category\n            skip = [\'每份\', \'总量\', \'主料\', \'调料\', \'香料包\', \'丸\', \'酱\', \'操作\',\n                    \'必须配料\', \'进阶配料\', \'可选配料\', \'用量\', \'每份：\']\n            if any(s in name for s in skip):\n                continue\n            ingredients[name] = qty\n    return ingredients\n\ndef parse_recipe(fpath):\n    """Parse a recipe markdown file and return (name, ingredients_dict)."""\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except:\n        return None\n\n    # Get dish name\n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            name = m.group(1).strip()\n            # Remove .做法 suffix\n            name = name.replace(\'.做法\', \'\').strip()\n            break\n    if not name:\n        return None\n\n    ingredients = {}\n\n    # Try 计算 section\n    calc_match = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if calc_match:\n        ingredients = parse_calculations(calc_match.group(1))\n\n    # Also try table format\n    if not ingredients:\n        table_matches = re.findall(r\'\\|([^|]+)\\s*\\|\\s*([^|]+)\\s*\\|\\s*([^|]*)\\|\', calc_match.group(1))\n        for row in table_matches:\n            tn, tq = row[0].strip(), row[1].strip()\n            if tn not in (\'原料\', \'数量\', \'单位\') and tn and tq:\n                ingredients[tn] = tq\n\n    if not ingredients:\n        # Try 必备原料 section\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    if \'(\' in raw:\n                        raw = raw[:raw.index(\'(\')].strip()\n                    if raw and len(raw) > 1:\n                        ingredients[raw] = \'\'\n\n    if not ingredients:\n        return None\n\n    # Normalize names\n    norm = {}\n    for k, v in ingredients.items():\n        n = normalize(k)\n        if n:\n            norm[n] = v\n\n    return {\'name\': name, \'ingredients\': norm}\n\n# Parse all recipes\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in files:\n        if not fname.endswith(\'.md\'):\n            continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result:\n            recipes.append(result)\n\nprint(f"Parsed {len(recipes)} recipes")\n\n# Score each recipe\ncandidates = []\nfor r in recipes:\n    matched = [n for n in r[\'ingredients\'] if n in available_names]\n    total = len(r[\'