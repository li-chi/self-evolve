Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport openpyxl\nfrom openpyxl import Workbook\n\n# Load workbook\nwb = openpyxl.load_workbook(\'/app/Market_Data.xlsx\')\n\n# Parse Methodology sheet\nws_meth = wb[\'Methodology\']\n\n# Source names from row 2, columns C-Q (index 2-16)\nsource_names = []\nfor col in range(3, 18):  # C to Q\n    val = ws_meth.cell(row=2, column=col).value\n    if val is not None:\n        source_names.append(val)\n\nprint("Sources:", source_names)\n\n# Segment definitions: rows 4-13, column B with weights in columns C-Q\nsegments = []  # list of (name, {source_index: weight})\nfor row in range(4, 14):  # rows 4-13\n    seg_name = ws_meth.cell(row=row, column=2).value  # col B\n    if seg_name is None or seg_name == \'Total\':\n        continue\n    weights = {}\n    for col in range(3, 18):  # C to Q\n        weight = ws_meth.cell(row=row, column=col).value\n        if weight is not None and weight != 0:\n            # Map column to source index\n            source_idx = col - 3  # C=0, D=1, etc.\n            weights[source_idx] = weight\n    segments.append((seg_name, weights))\n\nprint("Segments:", [(s[0], s[1]) for s in segments])\n\n# Parse RawData sheet\nws_raw = wb[\'RawData\']\n\n# Raw data headers from row 4 (B-P)\nraw_sources = []\nfor col in range(2, 17):  # B to P\n    val = ws_raw.cell(row=4, column=col).value\n    if val is not None:\n        raw_sources.append(val)\n\nprint("Raw sources:", raw_sources)\nprint(f"Raw sources count: {len(raw_sources)}")\n\n# Build a map from source name to column index\ndef find_raw_col(source_name):\n    for i, s in enumerate(raw_sources):\n        if s == source_name:\n            return i\n    return None\n\n# Build map from methodology source column index to raw data column\n# Methodology source columns C-Q map to raw data columns B-P\n# Both have same order of sources\nfor col in range(3, 18):\n    meth_source = ws_meth.cell(row=2, column=col).value\n    raw_col_idx = find_raw_col(meth_source)\n    print(f"  Methodology col {col} ({meth_source}) -> RawData col {raw_col_idx}")\n\n# Build mapping: for each source in methodology (col index 0-14), find raw data column\ndef get_raw_col_from_meth_col(meth_col):\n    """meth_col is 0-indexed relative to col C (which is col 3)\n       It maps to raw data column index: col-3 (since raw starts at B=col 2, col C is col 3, B is col 2)\n       Actually methodology cols C(3)-Q(17) map to raw data cols B(2)-P(16)\n       So methodology col c maps to raw_data_col = c-1\n    """\n    return meth_col - 1\n\n# Read raw data by year\nyears_data = {}  # year -> {raw_source_name: value}\nfor row in range(5, ws_raw.max_row + 1):\n    year = ws_raw.cell(row=row, column=1).value\n    if year is None:\n        continue\n    row_data = {}\n    for col in range(2, 17):  # B to P\n        val = ws_raw.cell(row=row, column=col).value\n        row_data[raw_sources[col - 2]] = val\n    years_data[year] = row_data\n\nprint("Years in raw data:", sorted(years_data.keys()))\n\n# Calculate segment values for years 2015-2024\ntarget_years = list(range(2015, 2025))\n\nsegment_values = {}  # segment_name -> {year: value}\nfor seg_name, weights in segments:\n    segment_values[seg_name] = {}\n    for year in target_years:\n        total = 0.0\n        has_data = True\n        for meth_col_idx, weight in weights.items():\n            raw_col = get_raw_col_from_meth_col(meth_col_idx)\n            source_name = raw_sources[raw_col]\n            val = years_data.get(year, {}).get(source_name, None)\n            if val is None:\n                has_data = False\n                break\n            total += val * weight\n        segment_values[seg_name][year] = total\n        print(f"  {seg_name} ({year}): {total}")\n\n# Calculate YoY growth rates\ngrowth_rates = {}  # segment_name -> {year: rate}\nfor seg_name in segments:\n    seg_name = seg_name[0]\n    growth_rates[seg_name] = {}\n    for i, year in enumerate(target_years):\n        if i == 0:\n            # No previous year for 2015\n            growth_rates[seg_name][year] = None\n        else:\n            prev_year = target_years[i - 1]\n            curr = segment_values[seg_name][year]\n            prev = segment_values[seg_name][prev_year]\n            if prev != 0:\n                rate = (curr - prev) / prev * 100\n                growth_rates[seg_name][year] = round(rate, 1)\n            else:\n                growth_rates[seg_name][year] = None\n        print(f"  {seg_name} ({year}): {growth_rates[seg_name][year]}")\n\n# Create output workbook\nwb_out = Workbook()\nws_out = wb_out.active\nws_out.title = \'Sheet\'\n\n# Write header: Year, then segment names in order\nheaders = [\'Year\'] + [s[0] for s in segments]\nws_out.append(headers)\n\n# Write data rows\nfor year in target_years:\n    row = [year]\n    for seg_name in [s[0] for s in segments]:\n        row.append(growth_rates[seg_name][year])\n    ws_out.append(row)\n\nwb_out.save(\'/app/segment_growth_rates.xlsx\')\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\n\n# Verify\nwb_verify = openpyxl.load_workbook(\'/app/segment_growth_rates.xlsx\')\nws_v = wb_verify.active\nfor row in ws_v.iter_rows(values_only=True):\n    print(row)\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
