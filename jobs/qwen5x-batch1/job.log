Sending keys: ["cat > /app/convert.py << 'EOF'\nimport openpyxl\nfrom datetime import datetime\n\nwb_in = openpyxl.load_workbook('/app/Household_Appliances.xlsx')\nws_in = wb_in.active\n\nrows_data = []\nfor r in range(3, ws_in.max_row + 1):\n    time_val = ws_in.cell(row=r, column=1).value\n    if time_val is None:\n        continue\n    if isinstance(time_val, datetime):\n        time_str = time_val.strftime('%Y-%m')\n    else:\n        time_str = str(time_val)[:7]\n    refr = {\n        'cur': ws_in.cell(row=r, column=2).value,\n        'acc': ws_in.cell(row=r, column=3).value,\n        'yoy': ws_in.cell(row=r, column=4).value,\n        'acgr': ws_in.cell(row=r, column=5).value,\n    }\n    ac = {\n        'cur': ws_in.cell(row=r, column=6).value,\n        'acc': ws_in.cell(row=r, column=7).value,\n        'yoy': ws_in.cell(row=r, column=8).value,\n        'acgr': ws_in.cell(row=r, column=9).value,\n    }\n    wm = {\n        'cur': ws_in.cell(row=r, column=10).value,\n        'acc': ws_in.cell(row=r, column=11).value,\n        'yoy': ws_in.cell(row=r, column=12).value,\n        'acgr': ws_in.cell(row=r, column=13).value,\n    }\n    rows_data.append((time_str, time_val, refr, ac, wm))\n\nresults = []\nfor time_str, time_val, refr, ac, wm in rows_data:\n    year, month = int(time_str[:4]), int(time_str[5:7])\n    if (year, month) > (2024, 12):\n        continue\n    has_data = False\n    for data in [refr, ac, wm]:\n        if any(v is not None for v in data.values()):\n            has_data = True\n            break\n    if not has_data:\n        continue\n    results.append((time_str, time_val, refr, ac, wm))\n\nresults.sort(key=lambda x: x[1], reverse=True)\n\nwb_out = openpyxl.Workbook()\nws_out = wb_out.active\nws_out.title = 'Sheet'\nheaders = ['Time', 'Appliance types', 'Current Period Sales(Ten Thousand Units)', 'Accumulated Sales (Ten Thousand Units)', 'Year-on-Year Growth (%)', 'Accumulated Growth (%)']\nfor c, h in enumerate(headers, 1):\n    ws_out.cell(row=1, column=c, value=h)\n\nrow_num = 2\nappliances = [\n    ('Household Refrigerators', refr),\n    ('Air Conditioners', ac),\n    ('Household Washing Machines', wm),\n]\nfor time_str, time_val, refr, ac, wm in results:\n    for name, data in appliances:\n        ws_out.cell(row=row_num, column=1, value=time_str)\n        ws_out.cell(row=row_num, column=2, value=name)\n        ws_out.cell(row=row_num, column=3, value=data['cur'])\n        ws_out.cell(row=row_num, column=4, value=data['acc'])\n        ws_out.cell(row=row_num, column=5, value=data['yoy'] * 100 if data['yoy'] is not None else None)\n        ws_out.cell(row=row_num, column=6, value=data['acgr'] * 100 if data['acgr'] is not None else None)\n        row_num += 1\n\nwb_out.save('/app/Processed.xlsx')\nprint('Done! Wrote', row_num - 2, 'data rows + 1 header')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
