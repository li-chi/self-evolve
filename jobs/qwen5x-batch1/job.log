Sending keys: ["cat > /tmp/check_refs.py << 'PYEOF'\nimport re, os\n\n# Read bib keys\nbib_keys = set()\nwith open('/app/my_paper/colm2024_conference.bib') as f:\n    for line in f:\n        m = re.match(r'@\\w+\\{([^,]+)', line)\n        if m:\n            bib_keys.add(m.group(1).strip())\nprint('BIB KEYS:', sorted(bib_keys))\nprint()\n\n# Find all tex files\ntex_files = []\nfor root, dirs, files in os.walk('/app/my_paper'):\n    for fn in files:\n        if fn.endswith('.tex'):\n            tex_files.append(os.path.join(root, fn))\n\ncite_refs = []\nall_labels = set()\nall_refs = set()\nall_autoref = set()\n\nfor tf in tex_files:\n    with open(tf) as f:\n        for i, line in enumerate(f, 1):\n            cl = line.lstrip()\n            if cl.startswith('%'):\n                continue\n            # Find citex commands\n            for m in re.finditer(r'\\\\cite[tp]?\\{([^}]*)\\}', line):\n                raw = m.group(1)\n                for k in raw.split(','):\n                    cite_refs.append((tf, i, 'cite', k.strip()))\n            # Find labels\n            for m in re.finditer(r'\\\\label\\{([^}]+)\\}', line):\n                all_labels.add(m.group(1))\n            # Find refs\n            for m in re.finditer(r'\\\\ref\\{([^}]+)\\}', line):\n                all_refs.add(m.group(1))\n            # Find autoref\n            for m in re.finditer(r'\\\\autoref\\{([^}]+)\\}', line):\n                all_autoref.add(m.group(1))\n\nprint('=== CITE REFERENCES ===')\nfor f, i, cmd, key in cite_refs:\n    status = 'OK' if key in bib_keys else 'MISSING/BROKEN'\n    print('  %s:%d %s{%s} -> %s' % (f, i, cmd, key, status))\n\nprint()\nprint('=== LABEL REFERENCES (ref/autoref) ===')\nfor r in sorted(all_refs | all_autoref):\n    if r not in all_labels:\n        print('  %s -> NOT DEFINED' % r)\n    else:\n        print('  %s -> OK' % r)\nPYEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
