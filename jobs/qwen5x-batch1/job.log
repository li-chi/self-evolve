Sending keys: ["cat > /tmp/parse_b2.py << 'ENDSCRIPT'\nimport re\n\nwith open('/tmp/b_section.txt') as f:\n    lines = f.read().split('\\n')\n\n# Let me look at each course entry in detail\n# Course IDs at lines: 47, 61, 93, 114, 128, 142, 156, 170, 211, 225\n\ncourse_ranges = [\n    (0, 47, 'PTSS110080.02'),\n    (47, 61, 'PTSS110084.01'),\n    (61, 93, 'PTSS110084.02'),\n    (93, 114, 'PTSS110085.01'),\n    (114, 128, 'PTSS110085.02'),\n    (128, 142, 'PTSS110085.03'),\n    (142, 156, 'PTSS110085.04'),\n    (156, 170, 'PTSS110086.01'),\n    (170, 211, 'PTSS110080.01'),\n    (211, 225, 'PTSS110086.02'),\n    (225, 249, 'PTSS110086.02'),\n]\n\n# Actually, each course block starts after the previous ID line\n# and contains data for the course whose ID is at the END of the block\n# Wait, looking at the data:\n# Line 47 = PTSS110080.02 ID, line 61 = PTSS110084.01 ID\n# Lines 48-60 contain data for PTSS110080.02\n# Lines 62-92 contain data for PTSS110084.01\n# Etc.\n\n# So for course at ID line idx, its data is from (prev_id_line+1) to idx-1 for name/campus/etc\n# and from idx+1 to (next_id_line-1) for exam/assessment/dept\n\nall_course_ids = []\nfor i, line in enumerate(lines):\n    m = re.match(r'^PTSS\\d{6}\\.\\d+$', line.strip())\n    if m:\n        all_course_ids.append(i)\n\nfor ci, idx in enumerate(all_course_ids):\n    cid = lines[idx].strip()\n    start = 0 if ci == 0 else all_course_ids[ci-1] + 1\n    nxt = all_course_ids[ci+1] if ci < len(all_course_ids)-1 else len(lines)\n    \n    print(f'\\n=== {cid} (lines {start}-{nxt}) ===')\n    for i in range(start, nxt):\n        if lines[i].strip():\n            print(f'  {i}: [{lines[i].strip()}]')\nENDSCRIPT\npython3 /tmp/parse_b2.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
