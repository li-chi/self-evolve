Sending keys: ['cat > /app/generate_reports.py << \'PYEOF\'\nimport re\nfrom docx import Document\nfrom docx.shared import Pt, RGBColor, Inches, Cm, Emu\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn, nsdecls\nfrom docx.oxml import parse_xml\n\n###############################################\n# 1. PARSE CANDIDATE RESUMES\n###############################################\ndef parse_resumes():\n    doc = Document(\'/app/Candidates_resumes.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    candidates = {}\n    \n    # Split by candidate markers\n    parts = re.split(r\'Candidate \\d+:\', full_text)\n    for i, part in enumerate(parts[1:], 1):  # skip first part ("Resumes of the candidates")\n        lines = part.strip().split(\'\\n\')\n        name = None\n        data = {}\n        for line in lines:\n            line = line.strip()\n            if not line:\n                continue\n            if line.startswith(\'Name:\'):\n                name = line[5:].strip()\n            elif line.startswith(\'Gender:\'):\n                data[\'Gender\'] = line[7:].strip()\n            elif line.startswith(\'Age:\'):\n                data[\'Age\'] = line[4:].strip()\n            elif line.startswith(\'Education:\'):\n                data[\'Education\'] = line[10:].strip()\n            elif line.startswith(\'Work Experience:\'):\n                data[\'Work Experience\'] = line[18:].strip()\n            elif line.startswith(\'Technical Skills:\'):\n                data[\'Technical Skills\'] = line[17:].strip()\n            elif line.startswith(\'Project Experience:\'):\n                data[\'Project Experience\'] = line[19:].strip()\n                # Collect project bullet points\n                projects = []\n                for j in range(i, min(i+20, len(part.strip().split(\'\\n\')))):\n                    pline = part.strip().split(\'\\n\')[j].strip()\n                    if pline.startswith(\'- \'):\n                        projects.append(pline[2:])\n                    elif pline and not pline.startswith(\'Contact:\'):\n                        continue\n                    elif pline.startswith(\'Contact:\'):\n                        data[\'Contact\'] = pline[8:].strip()\n                        break\n                data[\'Projects\'] = \'\\n\'.join(projects)\n            elif line.startswith(\'Contact:\'):\n                data[\'Contact\'] = line[8:].strip()\n            elif line.startswith(\'Expected Salary:\'):\n                data[\'Expected Salary\'] = line[16:].strip()\n        if name:\n            candidates[name] = data\n    \n    return candidates\n\n###############################################\n# 2. PARSE INTERVIEW EVALUATIONS\n###############################################\ndef parse_evaluations():\n    doc = Document(\'/app/Interviewer_evaluation.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    evals = {}\n    \n    # Split by candidate markers\n    parts = re.split(r\'Candidate \\d+ Name:\\s*\', full_text)\n    for part in parts[1:]:\n        lines = part.strip().split(\'\\n\')\n        name = lines[0].strip()\n        data = {}\n        in_key = None\n        value_lines = []\n        \n        for line in lines:\n            line_stripped = line.strip()\n            if not line_stripped:\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                    value_lines = []\n                    in_key = None\n                continue\n            \n            if line_stripped.startswith(\'Interviewer Evaluation:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = None\n                continue\n            elif line_stripped.startswith(\'Interviewer:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Interviewer\'\n                value_lines = [line_stripped[10:].strip()]\n                continue\n            elif line_stripped.startswith(\'Interview Time:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Interview Time\'\n                value_lines = [line_stripped[13:].strip()]\n                continue\n            elif line_stripped.startswith(\'Position:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Position\'\n                value_lines = [line_stripped[9:].strip()]\n                continue\n            elif line_stripped.startswith(\'Technical Assessment:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Technical Assessment\'\n                value_lines = []\n                continue\n            elif line_stripped.startswith(\'Soft Skills Assessment:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Soft Skills Assessment\'\n                value_lines = []\n                continue\n            elif line_stripped.startswith(\'Overall Impression:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Overall Impression\'\n                value_lines = []\n                continue\n            else:\n                if in_key:\n                    value_lines.append(line_stripped)\n        \n        if in_key and value_lines:\n            data[in_key] = \'\\n\'.join(value_lines)\n        \n        evals[name] = data\n    \n    return evals\n\n###############################################\n# 3. EVALUATE CANDIDATES\n###############################################\ndef evaluate_candidate(name, resume, interview):\n    criteria = []\n    \n    # 1. Minimum Experience: 4+ years\n    exp_text = resume.get(\'Work Experience\', \'\').lower()\n    exp_match = re.search(r\'(\\d+)\\s*years?\', exp_text)\n    exp_years = int(exp_match.group(1)) if exp_match else 0\n    meets1 = exp_years >= 4\n    criteria.append(meets1)\n    \n    # 2. Education: Master degree or higher\n    edu = resume.get(\'Education\', \'\').lower()\n    meets2 = \'master\' in edu or \'phd\' in edu or \'doctor\' in edu\n    criteria.append(meets2)\n    \n    # 3. Top-tier University\n    edu_text = resume.get(\'Education\', \'\')\n    top_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\n    meets3 = any(tu in edu_text for tu in top_universities)\n    criteria.append(meets3)\n    \n    # 4. FAANG Experience\n    work = resume.get(\'Work Experience\', \'\')\n    faang = [\'Google\', \'Meta\', \'Amazon\', \'Apple\', \'Netflix\', \'Microsoft\']\n    meets4 = any(f in work for f in faang)\n    criteria.append(meets4)\n    \n    # 5. Leadership Experience\n    resume_full = resume.get(\'Project Experience\', \'\') + \' \' + resume.get(\'Work Experience\', \'\')\n    meets5 = bool(re.search(r\'led|managed|led development|led security|led research|led cloud|led UI\', resume_full, re.IGNORECASE))\n    criteria.append(meets5)\n    \n    # 6. High-impact Projects\n    projects = resume.get(\'Project Experience\', \'\')\n    meets6 = \'vulnerabilities\' in projects.lower() or \'millions\' in projects.lower() or \'100M\' in projects or \'99.9\' in projects or \'100M\' in projects or \'impact\' in projects.lower() or \'billion\' in projects.lower() or \'revenue\' in projects.lower() or \'reducing\' in projects.lower() or \'increasing\' in projects.lower() or \'optimization\' in projects.lower() or \'architecture\' in projects.lower()\n    criteria.append(meets6)\n    \n    # 7. Advanced Technical Skills: 3+ areas\n    skills_text = resume.get(\'Technical Skills\', \'\')\n    skills = [s.strip() for s in skills_text.split(\',\') if s.strip()]\n    meets7 = len(skills) >= 3\n    criteria.append(meets7)\n    \n    # 8. Recommendation Level: Exceptional/Outstanding only\n    if interview:\n        eval_text = str(interview).lower()\n        meets8 = \'exceptional\' in eval_text or \'outstanding\' in eval_text\n    else:\n        meets8 = False\n    criteria.append(meets8)\n    \n    # 9. Excellence Rating: 2+ excellence mentions\n    if interview:\n        eval_text = str(interview).lower()\n        excellence_count = eval_text.count(\'excell\')\n        meets9 = excellence_count >= 2\n    else:\n        meets9 = False\n    criteria.append(meets9)\n    \n    # 10. Salary Budget: Under $150K\n    salary = resume.get(\'Expected Salary\', \'\')\n    usd_match = re.search(r\'(\\d+)K-\\$(\\d+)K\', salary)\n    if usd_match:\n        low = int(usd_match.group(1))\n        high = int(usd_match.group(2))\n        meets10 = high < 150\n    elif \'CNY\' in salary or \'Yuan\' in salary:\n        meets10 = True  # CNY is well under $150K\n    elif \'K\' in salary:\n        amt = int(re.search(r\'(\\d+)K\', salary).group(1))\n        meets10 = amt < 150\n    else:\n        meets10 = True\n    criteria.append(meets10)\n    \n    total = sum(criteria)\n    return total, criteria\n\n###############################################\n# 4. CREATE FORMATTED WORD DOCUMENT\n###############################################\ndef set_cell_shading(cell, color_hex):\n    """Set cell background color"""\n    shading_elm = parse_xml(f\'<w:shd {nsdecls("w")} w:fill="{color_hex}"/>\')\n    cell._tc.get_or_add_tcPr().append(shading_elm)\n\ndef set_cell_alignment(cell):\n    """Set cell alignment: horizontal center, vertical top"""\n    tc = cell._tc\n    tcPr = tc.get_or_add_tcPr()\n    tcPr.set(\'w:anchor\', \'top\')\n    \n    tcMar = parse_xml(f\'<w:tcMar {nsdecls("w")}><w:top w:w="50" w:type="dxa"/><w:bottom w:w="50" w:type="dxa"/></w:tcMar>\')\n    tcPr.append(tcMar)\n\ndef set_run_font(run, font_name=\'Cambria\', size=11, bold=False, alignment=None):\n    """Set font properties on a run"""\n    run.font.name = font_name\n    run.font.size = Pt(size)\n    if font_name == \'Cambria\':\n        run._element.rPr.rFonts.set(qn(\'w:eastAsia\'), font_name)\n    if bold:\n        run.bold = True\n    if alignment:\n        paragraph_format = run.paragraph.paragraph_format\n        paragraph_format.alignment = alignment\n\ndef create_candidate_report(name, resume, interview, score, criteria):\n    doc = Document()\n    \n    # Set default body font\n    style = doc.styles[\'Normal\']\n    style.font.name = \'Cambria\'\n    style.font.size = Pt(11)\n    \n    # 1. First-Level Heading: "Candidate Interview Assessment Report"\n    heading = doc.add_paragraph()\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = heading.add_run(\'Candidate Interview Assessment Report\')\n    run.font.name = \'Calibri\'\n    run.font.size = Pt(14)\n    run.bold = True\n    run._element.rPr.rFonts.set(qn(\'w:eastAsia\'), \'Calibri\')\n    \n    # 2. Candidate Name paragraph\n    name_para = doc.add_paragraph()\n    run = name_para.add_run(f\'Candidate Name: {name}\')\n    set_run_font(run, \'Cambria\', 11)\n    \n    # 3. Section: Candidate Information:\n    info_title = doc.add_paragraph()\n    run = info_title.add_run(\'Candidate Information:\')\n    set_run_font(run, \'Cambria\', 11, bold=True)\n    \n    # Resume content\n    info_content = []\n    for key in [\'Gender\', \'Age\', \'Education\', \'Work Experience\', \'Technical Skills\', \'Contact\', \'Expected Salary\']:\n        if resume.get(key):\n            info_content.append(f\'{key}: {resume[key]}\')\n    if resume.get(\'Projects\'):\n        for proj in resume[\'Projects\'].split(\'\\n\'):\n            if proj.strip():\n                info_content.append(proj.strip())\n    \n    info_para = doc.add_paragraph()\n    set_run_font(info_para.add_run(\'\\n\'.join(info_content)), \'Cambria\', 11)\n    \n    # 4. Section: Interviewer Evaluation:\n    eval_title = doc.add_paragraph()\n    run = eval_title.add_run(\'Interviewer Evaluation:\')\n    set_run_font(run, \'Cambria\', 11, bold=True)\n    \n    if interview:\n        eval_lines = []\n        for key in [\'Interviewer\', \'Interview Time\', \'Position\', \'Technical Assessment\', \'Soft Skills Assessment\', \'Overall Impression\']:\n            if interview.get(key):\n                eval_lines.append(f\'{key}: {interview[key]}\')\n        eval_para = doc.add_paragraph()\n        set_run_font(eval_para.add_run(\'\\n\'.join(eval_lines)), \'Cambria\', 11)\n    else:\n        no_eval = doc.add_paragraph()\n        set_run_font(no_eval.add_run(\'No interview evaluation available.\'), \'Cambria\', 11)\n    \n    # 5. Section: Evaluation Conclusion:\n    conclusion_title = doc.add_paragraph()\n    run = conclusion_title.add_run(\'Evaluation Conclusion:\')\n    set_run_font(run, \'Cambria\', 11, bold=True)\n    \n    # Create 2x2 table\n    table = doc.add_table(rows=2, cols=2)\n    table.alignment = WD_TABLE_ALIGNMENT.CENTER\n    \n    # Set borders for the entire table\n    tbl = table._tbl\n    tblPr = tbl.tblPr if tbl.tblPr is not None else parse_xml(f\'<w:tblPr {nsdecls("w")}/>\')\n    borders = parse_xml(\n        f\'<w:tblBorders {nsdecls("w")}>\'\n        \'  <w:top w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:left w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:bottom w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:right w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideH w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideV w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'</w:tblBorders>\'\n    )\n    tblPr.append(borders)\n    \n    # Fill table content\n    table.cell(0, 0).text = \'Overall Assessment\'\n    table.cell(0, 1).text = \'Recommendation\'\n    \n    percentage = f\'{score[0]*10}%\'  # score is total/10\n    if score[0] == max(s[0] for s in all_scores.values()):\n        recommendation = \'Recommended\'\n    else:\n        recommendation = \'Not recommended\'\n    \n    table.cell(1, 0).text = percentage\n    table.cell(1, 1).text = recommendation\n    \n    # Set header row color (D9D9D9)\n    set_cell_shading(table.cell(0, 0), \'D9D9D9\')\n    set_cell_shading(table.cell(0, 1), \'D9D9D9\')\n    \n    # Set data row color (DAEEF3)\n    set_cell_shading(table.cell(1, 0), \'DAEEF3\')\n    set_cell_shading(table.cell(1, 1), \'DAEEF3\')\n    \n    # Set cell alignment (horizontal center, vertical top) and font\n    for row in table.rows:\n        for cell in row.cells:\n            set_cell_alignment(cell)\n            for paragraph in cell.paragraphs:\n                paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                paragraph.paragraph_format.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                for run in paragraph.runs:\n                    set_run_font(run, \'Cambria\', 11)\n    \n    # Save document\n    safe_name = name.replace(\' \', \'_\')\n    filename = f\'Interview_Assessment_Report_{safe_name}.docx\'\n    doc.save(f\'/app/{filename}\')\n    print(f\'  Created: {filename}\')\n    return filename\n\n###############################################\n# MAIN EXECUTION\n###############################################\nprint(\'Parsing resumes...\')\nresumes = parse_resumes()\nprint(f\'Found {len(resumes)} candidates in resumes\')\n\nprint(\'Parsing evaluations...\')\nevaluations = parse_evaluations()\nprint(f\'Found {len(evaluations)} evaluations\')\n\n# Evaluate all candidates\nprint(\'\\nEvaluating candidates...\')\nall_scores = {}\nfor name, resume in resumes.items():\n    interview = evaluations.get(name, None)\n    score, criteria = evaluate_candidate(name, resume, interview)\n    all_scores[name] = (score, criteria)\n    passed = sum(criteria)\n    total = len(criteria)\n    print(f\'  {name}: {passed}/{total} ({passed*10}%)\')\n    for i, (crit, met) in enumerate(zip(\n        [\'Experience>=4yrs\',\'Master+\',\'Top-tier Uni\',\'FAANG\',\'Leadership\',\n         \'High-impact\',\'3+Skills\',\'Exceptional\',\'2+Excellence\',\'Under$150K\'],\n        criteria\n    )):\n        status = \'PASS\' if met else \'FAIL\'\n        print(f\'    {i+1}. {crit}: {status}\')\n\n# Find best candidate\nbest_name = max(all_scores, key=lambda n: all_scores[n][0])\nbest_score = all_scores[best_name][0]\nprint(f\'\\nBest candidate: {best_name} ({best_score}/10)\')\n\n# Create documents\nprint(\'\\nCreating Word documents...\')\nfor name, (score, criteria) in all_scores.items():\n    resume = resumes[name]\n    interview = evaluations.get(name, None)\n    create_candidate_report(name, resume, interview, (score, criteria))\n\n# Write recommend.txt\nwith open(\'/app/recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f\'\\nWrote recommend.txt with: {best_name}\')\nprint(\'Done!\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
