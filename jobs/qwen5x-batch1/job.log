Sending keys: ["python3 << 'PYEOF'\nimport re\n\nwith open('/tmp/b_section.txt') as f:\n    content = f.read()\n\n# Split into tokens by newlines\nlines = content.split('\\n')\n\n# Collect all course IDs and their line positions\ncourse_ids = []\nfor i, line in enumerate(lines):\n    m = re.match(r'^PTSS\\d{6}\\.\\d+$', line.strip())\n    if m:\n        course_ids.append((i, m.group(1)))\n\nprint(f'Found {len(course_ids)} course IDs:')\nfor idx, cid in course_ids:\n    print(f'  Line {idx}: {cid}')\n\n# Now for each course ID, find the associated time and assessment\n# The pattern is: between two consecutive IDs (or start and first ID)\n# the data belongs to the PREVIOUS course\n\n# Actually, looking at the data structure:\n# After the 思政课B header, data starts with: name, credits+instr, title, time, campus, enrollment, ID\n# Then exam info, assessment, department follow\n# Then next course's name...\n\n# So for each ID line, the data BEFORE it (name through enrollment) belongs to that course\n# And the exam/assessment/dept AFTER the ID belongs to that course too\n\n# But pdftotext output order within a row is: name, credits, title, time, campus, enrollment\n# The ID comes at the end of the row (after enrollment)\n# Then exam date/time, assessment, dept\n\n# Let me trace each course entry by finding the block between this ID and the next ID\nfor ci, (idx, cid) in enumerate(course_ids):\n    # Find the block for this course: from the line before the previous ID (or start)\n    if ci == 0:\n        start_line = 0\n    else:\n        start_line = course_ids[ci-1][0] + 1\n    \n    # The data for this course starts after the enrollment line (which has 思政B tag)\n    # and ends before the exam info of the NEXT course\n    # But we also need the exam info which comes after this ID\n    \n    end_idx = course_ids[ci+1][0] if ci < len(course_ids)-1 else len(lines)\n    \n    # Collect lines for this course\n    block = lines[idx:end_idx]  # From ID to next course\n    block_before = lines[start_line:idx]  # Lines before this ID\n    \n    # From block_before: find name, credits, title, time, campus, enrollment\n    name = ''\n    credits = ''\n    instructor = ''\n    title = ''\n    times = []\n    campus = ''\n    enrollment = ''\n    \n    for bl in block_before:\n        bl = bl.strip()\n        if not bl:\n            continue\n        if bl in ('邯郸校区', '江湾校区'):\n            campus = bl\n            continue\n        if re.match(r'^\\d+ 思政B$', bl):\n            enrollment = bl\n            continue\n        \n        if not name and re.match(r'^[\\u4e00-\\u9fa5]+$', bl) and len(bl) <= 12:\n            name = bl\n            continue\n        \n        if not credits and re.match(r'^\\d+\\.?\\d*\\s+[\\u4e00-\\u9fa5]', bl):\n            parts = bl.split(None, 1)\n            credits = parts[0]\n            instructor = parts[1] if len(parts) > 1 else ''\n            continue\n        \n        if bl in ('教授', '副教授', '讲师', '助理研究员', '副研究员', '研究员', '青年副研究员'):\n            title = bl\n            continue\n        \n        if re.match(r'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[', bl):\n            times.append(bl)\n            continue\n    \n    # Now find assessment from the block after ID\n    assessment = ''\n    dept = ''\n    for bl in block:\n        bl = bl.strip()\n        if not bl:\n            continue\n        if bl in ('开卷', '闭卷', '论文', '口试', '其他', '随堂考试'):\n            assessment = bl\n            continue\n        if re.match(r'^[\\u4e00-\\u9fa5]{2,6}$', bl) and '马克思主义' not in bl:\n            dept += bl\n            continue\n        if '马克思主义' in bl:\n            dept += bl\n            continue\n        if bl == '是':\n            continue\n        if '考试日期' in bl or '考试时间' in bl:\n            continue\n        if bl in ('邯郸校区', '江湾校区'):\n            continue\n        if re.match(r'^\\d+$', bl):\n            continue\n    \n    time_str = ' '.join(times) if times else ''\n    print(f'{cid}: Name={name} Time={time_str} Assess={assessment} Dept={dept}')\n\nPYEOF\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
