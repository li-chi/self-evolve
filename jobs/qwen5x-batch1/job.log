t) > 0:\n                    ingredients_with_amounts.append((name, amount))\n                    ingredients_list.append(name)\n    \n    # Extract ingredients from \'## 必备原料和工具\' section\n    if not ingredients_with_amounts:\n        tools_match = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n        if tools_match:\n            tools_content = tools_match.group(1)\n            for line in tools_content.split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \'):\n                    name = line[2:].strip()\n                    if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n                        ingredients_with_amounts.append((name, \'\'))\n                        ingredients_list.append(name)\n    \n    return {\n        \'name\': dish_name,\n        \'ingredients_with_amounts\': ingredients_with_amounts,\n        \'ingredients_list\': ingredients_list,\n        \'filepath\': filepath,\n    }\n\ndef match_ingredients(recipe, our_ings):\n    """Count how many of the recipe\'s ingredients match our stock."""\n    matched = []\n    unmatched = []\n    \n    for ing_name, amount in recipe[\'ingredients_with_amounts\']:\n        # Check if ingredient name matches any of our ingredients\n        found = False\n        for our_name in our_ings:\n            if ing_name == our_name or ing_name in our_name or our_name in ing_name:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n        if not found:\n            unmatched.append((ing_name, amount))\n    \n    return matched, unmatched\n\ndef score_recipe(recipe, our_ings):\n    """Score a recipe: higher is better. At least half must be matched."""\n    matched, unmatched = match_ingredients(recipe, our_ings)\n    total = len(matched) + len(unmatched)\n    if total == 0:\n        return 0, [], []\n    match_ratio = len(matched) / total\n    if match_ratio < 0.5:\n        retur