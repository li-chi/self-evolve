Sending keys: ['python3 << \'PYEOF\'\nimport re\n\ndef fix_course_name(code_line, prev_lines):\n    """If course_name is empty/numeric, try to find it from previous lines."""\n    parts = code_line.split()\n    \n    # If we already have a name, skip\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    \n    if time_pos <= 0:\n        return code_line, None\n    \n    before = parts[:time_pos]\n    # Check if this is just credits + instructor\n    has_name = False\n    for p in before[:-1]:  # exclude last element (credits)\n        if re.search(r\'[\\u4e00-\\u9fff]\', p):\n            has_name = True\n            break\n    \n    if has_name:\n        return code_line, None\n    \n    # No name found in the line - look at previous lines for continuation\n    for pl in prev_lines[-3:]:\n        pl = pl.strip()\n        if not pl:\n            continue\n        # Skip lines that are purely exam info\n        if \'考试日期\' in pl and \'考试时间\' not in pl:\n            continue\n        if pl.startswith(\'考试日期:\'):\n            continue\n        # Look for trailing Chinese text (course name continuation)\n        # Pattern: text at end of line that\'s Chinese characters (possibly with numbers/punctuation)\n        m = re.search(r\'(\\u4e00-\\u9fff[\\u4e00-\\u9fff\\d\\（）《》，。！？、·-]*)\\s*(?:考试时间|考试日期|系|学院|部)$\', pl)\n        if m:\n            name_part = m.group(1)\n            return name_part, pl\n        # Also check simpler pattern: trailing Chinese chars\n        m2 = re.search(r\'([\\u4e00-\\u9fff]+)$\', pl)\n        if m2:\n            name_part = m2.group(1)\n            return name_part, pl\n    \n    return None, None\n\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    lines = f.readlines()\n\n# Test with all target codes\nfor code in [\'PHIL119059\', \'FORE119008\', \'BIOL119008\', \'ECON110017\', \'BIOL110035\', \'CHIN110038\', \'ICES110024\', \'PHIL119054\', \'FINE110037\', \'FINE110001\', \'MANA110057\', \'MANA110058\', \'MANA110064\', \'BIOL110013\', \'MUSE110002\', \'ECON110015\']:\n    found = False\n    for i, line in enumerate(lines):\n        if code in line and line.startswith((\'PHIL\',\'FORE\',\'BIOL\',\'ECON\',\'CHIN\',\'ICES\',\'FINE\',\'MANA\',\'MUSE\')):\n            found = True\n            name_part, source = fix_course_name(line, lines[max(0,i-6):i])\n            if name_part:\n                print(f"{code}: name=\'{name_part}\' (from line {lines.index(source)+1 if source else \'?\'})")\n            else:\n                print(f"{code}: NO NAME PART FOUND")\n                # Show context\n                for j in range(max(0,i-5), min(len(lines), i+2)):\n                    print(f"  Line {j+1}: {lines[j].rstrip()[:150]}")\n            break\n    if not found:\n        print(f"{code}: NOT FOUND")\nPYEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
