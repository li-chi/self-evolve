ame = f"{found_name}-{college}-{student_id}-OS-HW3{ext}"\n    if ext == \'.c\':\n        target_dir = \'/app/os_hw3/C\'\n    elif ext == \'.rs\':\n        target_dir = \'/app/os_hw3/Rust\'\n    elif ext == \'.py\':\n        target_dir = \'/app/os_hw3/Python\'\n    else:\n        continue\n    src = os.path.join(\'/app\', filename)\n    dst = os.path.join(target_dir, new_filename)\n    os.rename(src, dst)\n    print(f"RENAMED: {filename} -> {os.path.basename(target_dir)}/{new_filename}")\n\nprint("\\nDeleting remaining code files...")\nremaining = []\nfor filename in sorted(os.listdir(\'/app\')):\n    filepath = os.path.join(\'/app\', filename)\n    if os.path.isfile(filepath) and any(filename.endswith(ext) for ext in code_extensions):\n        remaining.append(filename)\n        print(f"  Found remaining: {filename}")\nfor f in remaining:\n    os.remove(os.path.join(\'/app\', f))\n    print(f"  Deleted: {f}")\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
