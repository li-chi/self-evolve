Sending keys: ['cat > /app/extract2.py << \'PYEOF\'\nimport pdfplumber\nimport re\nimport openpyxl\nfrom openpyxl import Workbook\nimport os\n\ntitles_list = [\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'青年研究员\', \'青年副研究员\',\n               \'研究员\', \'副研究员\', \'高级工程师\', \'工程师\', \'主管技师\',\n               \'主任医师\', \'副主任医师\', \'教授(教学为主型)\', \'副教授(教学为主型)\', \'实验师\']\n\ndef find_title_pos(parts):\n    for j in range(len(parts)-1, 0, -1):\n        if parts[j] in titles_list:\n            return j\n    return -1\n\ndef parse_entry(entry_text):\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', entry_text)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    parts = rest.split()\n    \n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    if time_pos <= 0:\n        return {\'Course ID\': code}\n    \n    before_time = parts[:time_pos]\n    instructor_pos = find_title_pos(before_time)\n    if instructor_pos <= 0:\n        return {\'Course ID\': code}\n    \n    instructor = before_time[instructor_pos]\n    title = before_time[instructor_pos+1] if instructor_pos+1 < len(before_time) else \'\'\n    \n    credits = \'\'\n    credits_pos = -1\n    for j in range(instructor_pos-1, 0, -1):\n        if before_time[j].isdigit() and int(before_time[j]) <= 5:\n            credits_pos = j\n            credits = before_time[j]\n            break\n    \n    course_name = \' \'.join(before_time[1:credits_pos]) if credits_pos > 1 else \'\'\n    \n    after_parts = parts[time_pos:]\n    class_time = \' \'.join(after_parts[:3])\n    \n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    enrollment = \'\'\n    cm = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n    if cm:\n        enrollment = cm.group(1)\n    \n    assessment = \'\'\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in rest:\n            assessment = a\n            break\n    \n    exam_time = \'\'\n    em = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n    if em:\n        exam_time = em.group(1)\n    \n    restrictions = \'\'\n    after_rest = rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_rest:\n            idx = after_rest.find(a)\n            after_rest = after_rest[idx+len(a):]\n            break\n    restrictions = after_rest.strip()\n    \n    return {\n        \'Course name\': course_name,\n        \'Course ID\': code,\n        \'Instructor\': instructor,\n        \'Campus\': campus,\n        \'Class Time\': class_time,\n        \'Enrollment\': enrollment,\n        \'Credits\': credits,\n        \'Assessment Method\': assessment,\n        \'Exam Time\': exam_time,\n        \'Course Selection Restrictions\': restrictions,\n        \'_day\': parts[time_pos],\n        \'_time\': parts[time_pos+1]\n    }\n\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    # Build a map: for each PDF page, get lines and process them\n    course_entries = []  # list of (code, full_entry_text, pdf_page_num, line_before_code)\n    \n    for pg_idx, page in enumerate(pdf.pages):\n        try:\n            text = page.extract_text() or \'\'\n        except:\n            continue\n        \n        raw_lines = text.split(\'\\n\')\n        \n        for line_idx, line in enumerate(raw_lines):\n            line = line.strip()\n            m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n            if not m:\n                continue\n            \n            code = m.group(1)\n            line_text = line\n            \n            # Look at immediately preceding line for name continuation\n            if line_idx > 0:\n                prev_line = raw_lines