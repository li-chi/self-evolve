Sending keys: ['python3 << \'END_BOOT\'\nimport csv\n\nwith open(\'/app/ingredients.csv\') as f:\n    reader = csv.DictReader(f)\n    avail = [row[\'Ingredient Name\'] for row in reader]\n\nscript = r"""import json, urllib.request, urllib.parse, re, time, csv, io\n\navail = """ + repr(avail) + r"""\n\nwith open(\'/tmp/dish_files.txt\') as f:\n    dish_files = [line.strip() for line in f if line.strip()]\n\ndef fetch_recipe(path):\n    encoded = urllib.parse.quote(path, safe=\'/\')\n    url = \'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/\' + encoded\n    try:\n        req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\n        resp = urllib.request.urlopen(req, timeout=15)\n        return resp.read().decode(\'utf-8\', errors=\'replace\')\n    except Exception:\n        return None\n\ndef clean_ing(name):\n    name = name.strip()\n    name = re.split(r\'[（(][^）)]*[）)]\', name)[0].strip()\n    return name\n\ndef split_ingredients(raw):\n    """Split ingredients that might be on one line with Chinese commas"""\n    results = []\n    for line in raw:\n        parts = [p.strip() for p in line.split(\'、\')]\n        results.extend(parts)\n    # Also split on comma\n    all_parts = []\n    for p in results:\n        sub = [s.strip() for s in p.split(\',\')]\n        all_parts.extend([s for s in sub if s])\n    return all_parts\n\ndef parse_recipe(content, path):\n    if not content or \'404\' in content or len(content) < 30:\n        return None\n    title_m = re.search(r\'^# (.+)\', content, re.MULTILINE)\n    if title_m:\n        name = title_m.group(1).strip()\n        name = re.sub(r\'的做法$\', \'\', name)\n    else:\n        name = path.split(\'/\')[-1].replace(\'.md\', \'\')\n    ingredients = []\n    ing_m = re.search(r\'## 必备原料和工具[\\n](.*?)[\\n]## |$\', content, re.DOTALL)\n    if ing_m:\n        for line in ing_m.group(1).split(\'\\n\'):\n            line = line.strip()\n            if line.startswith(\'- \'):\n                item = clean_ing(line[2:])\n                if item:\n                    ingredients.append(item)\n    # Split combined ingredients\n    ingredients = split_ingredients(ingredients)\n    quantities = {}\n    # Try to find quantity info - look for lines with quantity markers\n    # Format varies: 每次制作前... 总量： then formula lines\n    # Or: 每份： then name amount format\n    qty_m = re.search(r\'## 计算[\\n](.*?)(?:[\\n]## |$)\', content, re.DOTALL)\n    if qty_m:\n        qty_text = qty_m.group(1)\n        # Check for per-portion format: 每份： or just lines with name + amount\n        # Pattern: 每份： followed by - name amount lines\n        per_match = re.search(r\'每份[：:]([\\s\\S]*?)(?:[\\n]## |$)\', qty_text)\n        formula_match = re.search(r\'总量[：:]([\\s\\S]*?)(?:[\\n]## |$)\', qty_text)\n        \n        # Try per portion first\n        if per_match:\n            for line in per_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \'): line = line[2:].strip()\n                m = re.match(r\'^(.+?)\\s+(\\d+[^\\n]*)$\', line)\n                if m:\n                    ing_name = clean_ing(m.group(1).strip())\n                    qty = m.group(2).strip().replace(\'每份\', \'\').strip()\n                    if ing_name and qty:\n                        quantities[ing_name] = qty\n        elif formula_match:\n            for line in formula_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \'): line = line[2:].strip()\n                # Pattern: 茄子数量 = 份数 * 1 个 (每个茄子约 150g)\n                m = re.match(r\'^(.+?)[=:](.*)$\', line)\n                if m:\n                    base_name = clean_ing(m.group(1).strip())\n                    # Extract the numeric part and unit\n                    qty_m2 = re.search(r\'(\\d+[^\\n]+)\', m.group(2).strip())\n                    qty = qty_m2.group(1).strip() if qty_m2 else m.group(2).strip()\n                    # Remove weight notes\n                    qty = re.sub(r\'（[^）]*）\', \'\', qty).strip()\n                    if base_name and qty:\n                        quantities[base_name] = qty\n    return {\'name\': name, \'ingredients\': ingredients, \'quantities\': quantities}\n\nprint(\'Processing\', len(dish_files), \'files\')\nall_r = []\nfor i, path in enumerate(dish_files):\n    c = fetch_recipe(path)\n    if c:\n        r = parse_recipe(c, path)\n        if r and r[\'ingredients\']:\n            all_r.append(r)\n    if (i+1) % 50 == 0:\n        print(\'  \', i+1, len(all_r))\n    time.sleep(0.3)\n\nprint(\'Parsed\', len(all_r), \'recipes\')\n\nscored = []\nfor r in all_r:\n    mt = []\n    for ri in r[\'ingredients\']:\n        for ai in avail:\n            if ai == ri or ai in ri or ri in ai:\n                mt.append(ri)\n                break\n    m = len(mt)\n    t = len(r[\'ingredients\'])\n    if t > 0:\n        scored.append({\'name\': r[\'name\'], \'ingredients\': r[\'ingredients\'], \'quantities\': r[\'quantities\'], \'matches\': m, \'total\': t, \'ratio\': m/t, \'matched\': mt, \'missing\': [x for x in r[\'ingredients\'] if x not in mt]})\n\nscored.sort(key=lambda x: (-x[\'ratio\'], -x[\'matches\']))\nprint(\'Found\', len(scored), \'dishes\')\nfor r in scored[:25]:\n    print(\' \', r[\'name\'], r[\'matches\'],\'/\',r[\'total\'], round(r[\'ratio\']*100), \'%\')\n    print(\'   Have:\', r[\'matched\'])\n    print(\'   Missing:\', r[\'missing\'])\n    print(\'   Qty:\', json.dumps(r[\'quantities\'], ensure_ascii=False))\n    print()\n\nsoup_kw = [\'汤\', \'粥\', \'羹\', \'炖\', \'煲\']\nsoup_l = [r for r in scored if any(kw in r[\'name\'] for kw in soup_kw)]\nother_l = [r for r in scored if r not in soup_l]\nselected = []\nif soup_l:\n    selected.append(soup_l[0])\nfor r in other_l:\n    if len(selected) >= 3: break\n    selected.append(r)\n\nprint(\'Selected:\')\nfor r in selected:\n    print(r[\'name\'], r[\'matches\'],\'/\',r[\'total\'], round(r[\'ratio\']*100), \'%\')\n    print(\'  Have:\', r[\'matched\'])\n    print(\'  Missing:\', r[\'missing\'])\n    print(\'  Qty:\', json.dumps(r[\'quantities\'], ensure_ascii=False))\n\ncuisine = {\'recommended_dishes\': []}\nfor r in selected:\n    e = {\'name\': r[\'name\'], \'ingredients\': []}\n    for ing in r[\'ingredients\']:\n        e[\'ingredients\'].append({\'name\': ing, \'quantity\': r[\'quantities\'].get(ing, \'\')})\n    cuisine[\'recommended_dishes\'].append(e)\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=2)\nprint(\'Saved cuisine.json\')\n\nshopping = []\nseen = set()\nfor r in selected:\n    for ing in r[\'missing\']:\n        if ing not in seen:\n            shopping.append({\'Name\': ing, \'Quantity\': r[\'quantities\'].get(ing, \'\')})\n            seen.add(ing)\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'Name,Quantity\\n\')\n    for item in shopping:\n        f.write(item[\'Name\'] + \',\' + item[\'Quantity\'] + \'\\n\')\nprint(\'Saved shopping.csv\', len(shopping), \'items\')\n"""\n\nwith open(\'/app/solve4.py\', \'w\', encoding=\'utf-8\') as f:\n    f.write(script)\nprint(\'Script written\')\nEND_BOOT\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
