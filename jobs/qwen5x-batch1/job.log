Sending keys: ["cat > /app/solve.py << 'PYEOF'\nimport openpyxl\nimport pandas as pd\nfrom collections import OrderedDict\n\nwb = openpyxl.load_workbook('/app/Market_Data.xlsx')\nmethod_ws = wb['Methodology']\nraw_ws = wb['RawData']\n\nmethod_source_names = []\nfor col in range(3, method_ws.max_column + 1):\n    val = method_ws.cell(row=2, column=col).value\n    if val is not None:\n        method_source_names.append(val)\nprint('Sources:', method_source_names)\n\nVALID_SEGMENTS = {'Auto OEM', 'Auto Components', 'Coil', 'Industry', 'ACE', 'Appliance', 'AlFi', 'CF', 'Food', 'Aero'}\n\nsegments = OrderedDict()\nfor row in range(4, method_ws.max_row + 1):\n    seg_name = method_ws.cell(row=row, column=2).value\n    if seg_name is None or seg_name == '' or seg_name == 'Total':\n        continue\n    if seg_name not in VALID_SEGMENTS:\n        continue\n    if seg_name not in segments:\n        segments[seg_name] = {}\n    for col in range(3, method_ws.max_column + 1):\n        weight = method_ws.cell(row=row, column=col).value\n        if weight is not None and weight != 0:\n            src = method_source_names[col - 3]\n            segments[seg_name][src] = float(weight)\n\nprint('\\nSegments:')\nfor seg, srcs in segments.items():\n    print('  ' + seg + ': ' + str(srcs))\n\nsource_col_names = []\ndata_start_row = None\nfor row in range(1, raw_ws.max_row + 1):\n    if raw_ws.cell(row=row, column=1).value == 'YY':\n        data_start_row = row\n        for col in range(2, raw_ws.max_column + 1):\n            val = raw_ws.cell(row=row, column=col).value\n            source_col_names.append(val)\n        break\nprint('\\nRawData sources: ' + str(len(source_col_names)))\n\nsource_data = {s: {} for s in source_col_names}\nfor row in range(data_start_row + 1, raw_ws.max_row + 1):\n    yc = raw_ws.cell(row=row, column=1).value\n    if yc is None or not isinstance(yc, (int, float)):\n        continue\n    y = int(yc)\n    for col in range(2, raw_ws.max_column + 1):\n        s = source_col_names[col - 2]\n        v = raw_ws.cell(row=row, column=col).value\n        if v is None or isinstance(v, str):\n            v = None\n        else:\n            try:\n                v = float(v)\n            except (ValueError, TypeError):\n                v = None\n        source_data[s][y] = v\n\ngrowth_rates = {}\nfor src in source_col_names:\n    growth_rates[src] = {}\n    yrs = sorted(source_data[src].keys())\n    for i in range(1, len(yrs)):\n        c, p = yrs[i], yrs[i-1]\n        cv, pv = source_data[src][c], source_data[src][p]\n        if cv is not None and pv is not None and pv != 0:\n            growth_rates[src][c] = (cv - pv) / pv * 100\n\nyears = list(range(2015, 2025))\nseg_order = list(segments.keys())\nresults = {'Year': years}\n\nfor seg in seg_order:\n    results[seg] = []\n    for year in years:\n        valid = True\n        weighted_sum = 0\n        for src, weight in segments[seg].items():\n            if year not in growth_rates[src]:\n                valid = False\n                break\n            weighted_sum += weight * growth_rates[src][year]\n        results[seg].append(round(weighted_sum, 1) if valid else 'N/A')\n\nprint('\\nFinal Results:')\ncols = ['Year'] + seg_order\nprint(' | '.join(cols))\nfor i, year in enumerate(years):\n    vals = [str(year)]\n    for seg in seg_order:\n        vals.append(str(results[seg][i]))\n    print(' | '.join(vals))\n\ndf = pd.DataFrame(results)\ndf.to_excel('/app/segment_growth_rates.xlsx', index=False)\nprint('\\nSaved to /app/segment_growth_rates.xlsx')\nPYEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
