 next_id_idx = None\n        for k in range(j, min(j+200, 4265)):\n            if re.match(r'^PTSS\\d{6}\\.\\d+$', lines[k].strip()):\n                next_id_idx = k\n                break\n        \n        if next_id_idx is None:\n            next_id_idx = 4265\n        \n        block = lines[i+1:next_id_idx]\n        block_stripped = [l.strip() for l in block if l.strip()]\n        \n        # In the block: name, credits+instructor, title, time(s), campus, enrollment, name(next course)..., ID\n        # But we need to look backwards from ID too\n        \n        # Actually, let me look at lines BEFORE the current ID too\n        # The full entry is from previous ID+1 to current ID\n        # But the ID itself is at the START of what we see here\n        \n        # Let me find the block BEFORE this ID\n        prev_id_idx = None\n        for k in range(i-1, max(i-200, 4017), -1):\n            if re.match(r'^PTSS\\d{6}\\.\\d+$', lines[k].strip()):\n                prev_id_idx = k\n                break\n        \n        if prev_id_idx is None:\n            prev_id_idx = 4017\n        \n        block_before_id = lines[prev_id_idx+1:i]\n        block_before = [l.strip() for l in block_before_id if l.strip()]\n        \n        # The block_before contains the data for course with this ID\n        # Structure: name, credits+instructor, title, time(s), campus, enrollment\n        \n        name = ''\n        credits = ''\n        instructor = ''\n        title = ''\n        times = []\n        campus = ''\n        enrollment = ''\n        \n        for bl in block_before:\n            if bl in ('邯郸校区', '江湾校区', '枫林校区'):\n                campus = bl\n                continue\n            if re.match(r'^\\d+ 思政B$', bl):\n                enrollment = bl.split()[0]\n                continue\n            if '考试' in bl or '马克思主义' in bl or '院' in bl:\n                break\n            \n            # Name check\n            if not name and re.match(r'^[\\u4e00-\\u9fa5]+$'