Sending keys: ['cat > /app/generate_reports.py << \'ENDOFSCRIPT\'\nimport docx\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.oxml.ns import qn\nimport re\nimport os\n\ndef parse_all_candidate_data():\n    """Parse resumes and evaluations to get all candidate info."""\n    \n    # Parse resumes\n    doc = docx.Document(\'/app/Candidates_resumes.docx\')\n    resume_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    # Split by candidate sections\n    sections = re.split(r\'(?=Candidate \\d+:)\', resume_text)\n    \n    resumes = {}  # name -> resume text\n    for section in sections:\n        section = section.strip()\n        m = re.search(r\'Name:\\s*(.+?)(?:\\n|$)\', section)\n        if not m:\n            continue\n        name = m.group(1).strip()\n        # Find end of this section (next "Name:" or end)\n        m2 = re.search(r\'Name:\\s*(?!\' + re.escape(name) + r\')\', section[1:])\n        if m2:\n            text = section[:m2.start() + 1 + m.start()]\n        else:\n            text = section[m.start():]\n        resumes[name] = text.strip()\n    \n    # Parse evaluations - handle both underscore and space name formats\n    doc = docx.Document(\'/app/Interviewer_evaluation.docx\')\n    eval_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    eval_sections = re.split(r\'(?=Candidate \\d+ Name:)\', eval_text)\n    \n    evals = {}  # name -> eval text\n    for section in eval_sections:\n        section = section.strip()\n        m = re.search(r\'Candidate \\d+ Name:\\s*(.+)\', section)\n        if not m:\n            continue\n        raw_name = m.group(1).strip()\n        # Normalize name: replace underscores with spaces for lookup\n        norm_name = raw_name.replace(\'_\', \' \')\n        evals[norm_name] = section[len(m.group(0)):].strip()\n    \n    # Build candidate list\n    candidates = []\n    for name, rtext in resumes.items():\n        # Find matching eval - try exact and normalized\n        etext = evals.get(name, \'\')\n        if not etext:\n            norm = name.replace(\' \', \'_\')\n            etext = evals.get(norm, \'\')\n        candidates.append({\n            \'name\': name,\n            \'resume_text\': rtext,\n            \'eval_text\': etext\n        })\n    \n    return candidates\n\ndef evaluate_candidate(c):\n    """Evaluate candidate against 10 requirements."""\n    name = c[\'name\']\n    r = c[\'resume_text\'].lower()\n    e = c[\'eval_text\'].lower()\n    \n    score = 0\n    details = {}\n    \n    # 1. Minimum Experience: 4+ years\n    m = re.search(r\'(\\d+)\\s*years\', r)\n    years = int(m.group(1)) if m else 0\n    if years >= 4:\n        score += 1\n    details[\'experience\'] = years\n    \n    # 2. Education: Master or higher\n    has_grad = \'master\' in r or \'phd\' in r or \'doctorate\' in r\n    details[\'education\'] = has_grad\n    if has_grad:\n        score += 1\n    \n    # 3. Top-tier University\n    top_tier = [\'stanford\', \'mit\', \'cmu\', \'peking\', \'tsinghua\']\n    has_tier = any(t in r for t in top_tier)\n    details[\'tier_uni\'] = has_tier\n    if has_tier:\n        score += 1\n    \n    # 4. FAANG Experience\n    faang = [\'google\', \'meta\', \'facebook\', \'apple\', \'amazon\', \'netflix\', \'microsoft\']\n    work_sec = re.search(r\'work experience:\\s*.*?(?:technical skills:|$)\', r, re.DOTALL)\n    has_fang = False\n    if work_sec:\n        has_fang = any(f in work_sec.group(0) for f in faang)\n    details[\'faang\'] = has_fang\n    if has_fang:\n        score += 1\n    \n    # 5. Leadership Experience\n    lead_words = [\'led \', \'led\\n\', \'leadership\', \'managed \', \'managed\\n\', \'directed \', \'directed\\n\', \'architected \']\n    has_lead = any(lw in r or lw in e for lw in lead_words)\n    details[\'leadership\'] = has_lead\n    if has_lead:\n        score += 1\n    \n    # 6. High-impact Projects\n    proj_sec = re.search(r\'project experience:\\s*.*?(?:contact:|$)\', r, re.DOTALL)\n    impact_words = [\'users\', \'revenue\', \'latency\', \'engagement\', \'downloads\', \'uptime\', \'vulnerabilities\', \'cost\', \'users\\n\', \'conversion\', \'retention\', \'load\', \'security\']\n    has_impact = False\n    if proj_sec:\n        has_impact = any(iw in proj_sec.group(0) for iw in impact_words)\n    details[\'impact\'] = has_impact\n    if has_impact:\n        score += 1\n    \n    # 7. Advanced Technical Skills: 3+ areas\n    skills_m = re.search(r\'technical skills:\\s*(.+)\', r)\n    if skills_m:\n        skills = [s.strip() for s in skills_m.group(1).split(\',\') if s.strip()]\n        has_skills = len(skills) >= 3\n        details[\'skills\'] = len(skills)\n    else:\n        has_skills = False\n        details[\'skills\'] = 0\n    if has_skills:\n        score += 1\n    \n    # 8. Recommendation: Exceptional/Outstanding\n    has_exc = \'exceptional\' in e or \'outstanding\' in e\n    details[\'recommendation\'] = has_exc\n    if has_exc:\n        score += 1\n    \n    # 9. Excellence Rating: 2+ excellence mentions\n    exc_count = e.count(\'excellent\') + e.count(\'exceptional\') + e.count(\'outstanding\')\n    details[\'excellence\'] = exc_count\n    if exc_count >= 2:\n        score += 1\n    \n    # 10. Salary Budget: Under $150K\n    sal_m = re.search(r\'\\$?(\\d+)[kK]?\\s*[-\\u2013]\\s*(\\d+)[kK]?\', r)\n    if sal_m:\n        sal_high = int(sal_m.group(2))\n        has_budget = sal_high < 150\n    else:\n        cny_m = re.search(r\'(\\d+)k\\s*-\\s*(\\d+)k\\s*cny\', r)\n        if cny_m:\n            cny_high = int(cny_m.group(2))\n            usd_equiv = cny_high * 7 / 10\n            has_budget = usd_equiv < 150\n        else:\n            sal_m2 = re.search(r\'\\$?(\\d+)[kK]\', r)\n            if sal_m2:\n                sal_val = int(sal_m2.group(1))\n                has_budget = sal_val < 150\n            else:\n                has_budget = False\n    details[\'salary\'] = has_budget\n    if has_budget:\n        score += 1\n    \n    c[\'score\'] = score\n    c[\'score_pct\'] = score * 10\n    return c\n\ndef set_cell_shading(cell, color_hex):\n    shading_elm = cell._element.get_or_add_tcPr()\n    shd = shading_elm.makeelement(qn(\'w:shd\'), {\n        qn(\'w:fill\'): color_hex,\n        qn(\'w:val\'): \'clear\'\n    })\n    shading_elm.append(shd)\n\ndef set_cell_text(cell, text):\n    """Set cell text with proper alignment."""\n    cell.text = \'\'\n    p = cell.paragraphs[0]\n    p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = p.add_run(text)\n    run.font.name = \'Cambria\'\n    run.font.size = Pt(11)\n    # Set vertical alignment to top\n    tc = cell._element\n    tcPr = tc.get_or_add_tcPr()\n    tcPr.set(qn(\'w:vAlign\'), \'top\')\n\ndef create_report(c, is_best=False):\n    doc = Document()\n    \n    name = c[\'name\']\n    \n    # Heading\n    h = doc.add_heading(\'Candidate Interview Assessment Report\', level=0)\n    h.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    for run in h.runs:\n        run.font.name = \'Calibri\'\n        run.font.size = Pt(14)\n        run.font.bold = True\n    \n    # Candidate Name\n    np = doc.add_paragraph()\n    nr = np.add_run(\'Candidate Name: \' + name)\n    nr.font.name = \'Cambria\'\n    nr.font.size = Pt(11)\n    \n    # Candidate Information section\n    st1 = doc.add_paragraph()\n    r1 = st1.add_run(\'Candidate Information:\')\n    r1.font.name = \'Cambria\'\n    r1.font.size = Pt(11)\n    r1.bold = True\n    \n    rp = doc.add_paragraph()\n    rr = rp.add_run(c[\'resume_text\'])\n    rr.font.name = \'Cambria\'\n    rr.font.size = Pt(11)\n    \n    # Interviewer Evaluation section\n    st2 = doc.add_paragraph()\n    r2 = st2.add_run(\'Interviewer Evaluation:\')\n    r2.font.name = \'Cambria\'\n    r2.font.size = Pt(11)\n    r2.bold = True\n    \n    ep = doc.add_paragraph()\n    er = ep.add_run(c[\'eval_text\'])\n    er.font.name = \'Cambria\'\n    er.font.size = Pt(11)\n    \n    # Evaluation Conclusion section\n    st3 = doc.add_paragraph()\n    r3 = st3.add_run(\'Evaluation Conclusion:\')\n    r3.font.name = \'Cambria\'\n    r3.font.size = Pt(11)\n    r3.bold = True\n    \n    # Table\n    table = doc.add_table(rows=2, cols=2)\n    table.style = \'Table Grid\'\n    \n    # Header row\n    set_cell_text(table.rows[0].cells[0], \'Overall Assessment\')\n    set_cell_text(table.rows[0].cells[1], \'Recommendation\')\n    set_cell_shading(table.rows[0].cells[0], \'D9D9D9\')\n    set_cell_shading(table.rows[0].cells[1], \'D9D9D9\')\n    \n    # Data row\n    set_cell_text(table.rows[1].cells[0], str(c[\'score_pct\']) + \'%\')\n    if is_best:\n        set_cell_text(table.rows[1].cells[1], \'Best match\')\n    else:\n        set_cell_text(table.rows[1].cells[1], \'Not recommended\')\n    set_cell_shading(table.rows[1].cells[0], \'DAEEF3\')\n    set_cell_shading(table.rows[1].cells[1], \'DAEEF3\')\n    \n    # Ensure all cells have proper formatting\n    for row in table.rows:\n        for cell in row.cells:\n            for para in cell.paragraphs:\n                para.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                para.paragraph_format.space_before = Pt(0)\n                para.paragraph_format.space_after = Pt(0)\n                tc = cell._element\n                tcPr = tc.get_or_add_tcPr()\n                tcPr.set(qn(\'w:vAlign\'), \'top\')\n    \n    # Save\n    safe_name = name.replace(\' \', \'_\')\n    fname = \'Interview_Assessment_Report_\' + name + \'.docx\'\n    doc.save(\'/app/\' + fname)\n    return fname\n\ndef main():\n    # Parse all data\n    candidates = parse_all_candidate_data()\n    print(f"Parsed {len(candidates)} candidates")\n    \n    for c in candidates:\n        c = evaluate_candidate(c)\n        print(f"\\n{c[\'name\']}: {c[\'score\']}/10")\n        print(f"  Experience: {c[\'details\'][\'experience\']} years")\n        print(f"  Education: {c[\'details\'][\'education\']}")\n        print(f"  Tier Uni: {c[\'details\'][\'tier_uni\']}")\n        print(f"  FAANG: {c[\'details\'][\'faang\']}")\n        print(f"  Leadership: {c[\'details\'][\'leadership\']}")\n        print(f"  Impact: {c[\'details\'][\'impact\']}")\n        print(f"  Skills: {c[\'details\'][\'skills\']}")\n        print(f"  Recommendation: {c[\'details\'][\'recommendation\']}")\n        print(f"  Excellence: {c[\'details\'][\'excellence\']}")\n        print(f"  Salary: {c[\'details\'][\'salary\']}")\n    \n    # Find best\n    best = max(candidates, key=lambda x: x[\'score\'])\n    print(f"\\nBest: {best[\'name\']} ({best[\'score\']}/10)")\n    \n    # Create reports\n    for c in candidates:\n        fname = create_report(c, is_best=(c[\'name\'] == best[\'name\']))\n        print(f"Created: {fname}")\n    \n    # recommend.txt\n    with open(\'/app/recommend.txt\', \'w\') as f:\n        f.write(best[\'name\'])\n    print(f"\\nrecommend.txt: {best[\'name\']}")\n\nmain()\nENDOFSCRIPT\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
