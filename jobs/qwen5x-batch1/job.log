Sending keys: ['python3 << \'PYEOF\'\nimport re\nimport os\n\n# Get all bib keys (just the key part)\nwith open(\'/app/my_paper/colm2024_conference.bib\') as f:\n    bib_content = f.read()\nbib_keys = set(re.findall(r\'@(\\w+)\\{([^,]+),\', bib_content))\n\n# Collect all tex files\ntex_dir = \'/app/my_paper\'\ntex_files = []\nfor root, dirs, files in os.walk(tex_dir):\n    for f in files:\n        if f.endswith(\'.tex\'):\n            tex_files.append(os.path.join(root, f))\ntex_files.sort()\n\n# Extract all labels across all files\nall_labels = {}\nfor tf in tex_files:\n    with open(tf) as f:\n        content = f.read()\n        for m in re.finditer(r\'\\label\\{([^}]+)\\}\', content):\n            label = m.group(1)\n            all_labels[label] = tf\n\n# Find all citation keys used in .tex files (not in comments)\nprint("=== UNUSED BIB KEYS ===")\nall_used_keys = set()\nfor tf in tex_files:\n    with open(tf) as f:\n        for line in f:\n            line_s = line.strip()\n            if line_s.startswith(\'%\'):\n                continue\n            for m in re.finditer(r\'\\\\cite[tp]?\\{([^}]*)\\}\', line):\n                keys_str = m.group(1)\n                if keys_str.strip():\n                    for k in keys_str.split(\',\'):\n                        k = k.strip()\n                        if k:\n                            all_used_keys.add(k)\n\nunknown = all_used_keys - bib_keys\nprint(f"Unknown citations ({len(unknown)}):")\nfor k in sorted(unknown):\n    print(f"  \'{k}\'")\n\n# Find empty citations\nprint("\\n=== EMPTY CITATIONS ===")\nfor tf in tex_files:\n    with open(tf) as f:\n        lines = f.readlines()\n    for i, line in enumerate(lines, 1):\n        if line.strip().startswith(\'%\'):\n            continue\n        for m in re.finditer(r\'\\\\cite[tp]?\\{\\s*\\}\', line):\n            print(f"  {os.path.basename(tf)}:{i}: {line.strip()[:80]}")\n\n# Find empty refs\nprint("\\n=== EMPTY REFS ===")\nfor tf in tex_files:\n    with open(tf) as f:\n        lines = f.readlines()\n    for i, line in enumerate(lines, 1):\n        if line.strip().startswith(\'%\'):\n            continue\n        for m in re.finditer(r\'\\\\(?:aut)?ref\\{\\s*\\}\', line):\n            print(f"  {os.path.basename(tf)}:{i}: {line.strip()[:80]}")\n\n# Find broken references\nprint("\\n=== ALL REFS (checking validity) ===")\nfor tf in tex_files:\n    with open(tf) as f:\n        lines = f.readlines()\n    for i, line in enumerate(lines, 1):\n        if line.strip().startswith(\'%\'):\n            continue\n        for m in re.finditer(r\'\\\\autoref\\{([^}]+)\\}\', line):\n            ref_key = m.group(1)\n            if ref_key in all_labels:\n                print(f"  OK: {os.path.basename(tf)}:{i}: autoref{{{ref_key}}}")\n            else:\n                print(f"  BROKEN: {os.path.basename(tf)}:{i}: autoref{{{ref_key}}} -> NOT FOUND (labels: {sorted(all_labels.keys())})")\n        for m in re.finditer(r\'\\\\ref\\{([^}]+)\\}\', line):\n            ref_key = m.group(1)\n            if ref_key in all_labels:\n                pass  # silent ok\n            else:\n                print(f"  BROKEN: {os.path.basename(tf)}:{i}: ref{{{ref_key}}} -> NOT FOUND")\n\nprint("\\n=== ALL LABELS ===")\nfor k in sorted(all_labels.keys()):\n    print(f"  {k} -> {all_labels[k]}")\nPYEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
