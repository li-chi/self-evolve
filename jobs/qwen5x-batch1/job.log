Sending keys: ['python3 << \'PYEOF\'\nimport csv\n\n# Results of manual analysis of all case files\n# Each entry has: case_file, old_clause, quoted_text, new_clause, new_text\n\nresults = [\n    # Case 1\n    {\n        \'case_file\': \'case1.pdf\',\n        \'old_clause\': \'《民法总则》第一百四十六条第一款\',\n        \'old_text\': \'行为人与相对人以虚假的意思表示实施的民事法律行为无效。以虚假的意思表示隐藏的民事法律行为的效力，依照有关法律规定处理。\',\n        \'new_clause\': \'《民法典》第一百四十六条\',\n        \'new_text\': \'行为人与相对人以虚假的意思表示实施的民事法律行为无效。以虚假的意思表示隐藏的民事法律行为的效力，依照有关法律规定处理。\',\n    },\n    {\n        \'case_file\': \'case1.pdf\',\n        \'old_clause\': \'《合同法》第五十六条\',\n        \'old_text\': \'无效的合同或者被撤销的合同自始没有法律约束力。合同部分无效，不影响其他部分效力的，其他部分仍然有效。\',\n        \'new_clause\': \'《民法典》第一百五十五条\',\n        \'new_text\': \'无效的或者被撤销的民事法律行为自始没有法律约束力。\',\n    },\n    {\n        \'case_file\': \'case1.pdf\',\n        \'old_clause\': \'《物权法》第二十条第二款\',\n        \'old_text\': \'预告登记后，债权消灭或者自能够进行不动产登记之日起三个月内未申请登记的，预告登记失效。\',\n        \'new_clause\': \'《民法典》第二百二十一条\',\n        \'new_text\': \'预告登记后，债权消灭或者自能够进行不动产登记之日起九十日内未申请登记的，预告登记失效。\',\n    },\n    # Case 2\n    {\n        \'case_file\': \'case2.pdf\',\n        \'old_clause\': \'《继承法》第五条\',\n        \'old_text\': \'继承开始后，按照法定继承办理；有遗嘱的，按照遗嘱继承或者遗赠办理；有遗赠扶养协议的，按照协议办理。\',\n        \'new_clause\': \'《民法典》第一千一百二十三条\',\n        \'new_text\': \'继承开始后，按照法定继承办理；有遗嘱的，按照遗嘱继承或者遗赠办理；有遗赠扶养协议的，按照协议办理。\',\n    },\n    {\n        \'case_file\': \'case2.pdf\',\n        \'old_clause\': \'《继承法》第十条\',\n        \'old_text\': \'遗产按照下列顺序继承：第一顺序：配偶、子女、父母。第二顺序：兄弟姐妹、祖父母、外祖父母。继承开始后，由第一顺序继承人继承，第二顺序继承人不继承；没有第一顺序继承人继承的，由第二顺序继承人继承。\',\n        \'new_clause\': \'《民法典》第一千一百二十七条\',\n        \'new_text\': \'遗产按照下列顺序继承：（一）第一顺序：配偶、子女、父母；（二）第二顺序：兄弟姐妹、祖父母、外祖父母。继承开始后，由第一顺序继承人继承，第二顺序继承人不继承；没有第一顺序继承人继承的，由第二顺序继承人继承。\',\n    },\n    {\n        \'case_file\': \'case2.pdf\',\n        \'old_clause\': \'《物权法》第二十九条\',\n        \'old_text\': \'因继承或者受遗赠取得物权的，自继承开始时发生效力。\',\n        \'new_clause\': \'《民法典》第二百三十条\',\n        \'new_text\': \'因继承取得物权的，自继承开始时发生效力。\',\n    },\n    # Case 3\n    {\n        \'case_file\': \'case3.pdf\',\n        \'old_clause\': \'《合同法》第一百零六条\',\n        \'old_text\': \'债权和债务同归于一人的，合同的权利义务终止，但涉及第三人利益的除外。\',\n        \'new_clause\': \'《民法典》第五百五十七条\',\n        \'new_text\': \'有下列情形之一的，债权债务终止：（一）债务已经履行；（二）债务相互抵销；（三）债务人依法将标的物提存；（四）债权人免除债务；（五）债权债务同归于一人；（六）法律规定或者当事人约定终止的其他情形。\',\n    },\n    # Case 4\n    {\n        \'case_file\': \'case4.pdf\',\n        \'old_clause\': \'《合同法》第二百一十五条\',\n        \'old_text\': \'租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式的，视为不定期租赁。\',\n        \'new_clause\': \'《民法典》第七百零七条\',\n        \'new_text\': \'租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式的，视为不定期租赁。\',\n    },\n    {\n        \'case_file\': \'case4.pdf\',\n        \'old_clause\': \'《合同法》第二百三十二条\',\n        \'old_text\': \'当事人对租赁期限没有约定或者约定不明确，依照本法第六十一条的规定仍不能确定的，视为不定期租赁。当事人可以随时解除合同，但出租人解除合同应当在合理期限之前通知承租人。\',\n        \'new_clause\': \'《民法典》第七百三十条\',\n        \'new_text\': \'当事人对租赁期限没有约定或者约定不明确的，租赁期限视为不定期。当事人可以随时解除合同，但是应当在合理期限之前通知对方。\',\n    },\n    # Case 5\n    {\n        \'case_file\': \'case5.pdf\',\n        \'old_clause\': \'《婚姻法》第七条第一款第一项\',\n        \'old_text\': \'有下列情形之一的，禁止结婚：（一）直系血亲和三代以内的旁系血亲；（二）患有医学上认为不应当结婚的疾病。\',\n        \'new_clause\': \'《民法典》第一千零四十八条\',\n        \'new_text\': \'直系血亲或者三代以内的旁系血亲禁止结婚。\',\n    },\n    {\n        \'case_file\': \'case5.pdf\',\n        \'old_clause\': \'《婚姻法》第十条第一款第二项\',\n        \'old_text\': \'有下列情形之一的，婚姻无效：（一）重婚的；（二）有禁止结婚的亲属关系的；\',\n        \'new_clause\': \'《民法典》第一千零五十一条\',\n        \'new_text\': \'有下列情形之一的，婚姻无效：（一）重婚；（二）有禁止结婚的亲属关系；（三）未到法定婚龄。\',\n    },\n]\n\n# Now identify which ones have SUBSTANTIVE differences\ndef has_substantive_difference(old, new):\n    if old.strip() == new.strip():\n        return False\n    return True\n\n# Write CSV\ncsv_file = \'/app/revised_terms.csv\'\nwith open(csv_file, \'w\', newline=\'\', encoding=\'utf-8-sig\') as f:\n    writer = csv.writer(f, quoting=csv.QUOTE_ALL)\n    writer.writerow([\'案件文件名称\', \'判决文书中的原始条款\', \'原始引用内容\', \'新法条款\', \'新法条款内容\'])\n    for r in results:\n        writer.writerow([\n            r[\'case_file\'],\n            r[\'old_clause\'],\n            r[\'old_text\'],\n            r[\'new_clause\'],\n            r[\'new_text\'],\n        ])\n\nprint(f"Written {len(results)} rows to {csv_file}")\n\n# Also print for review\nfor r in results:\n    diff = "HAS SUBSTANTIVE DIFFERENCE" if has_substantive_difference(r[\'old_text\'], r[\'new_text\']) else "SAME CONTENT"\n    print(f"{r[\'case_file\']} | {r[\'old_clause\']} -> {r[\'new_clause\']} | {diff}")\n\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
