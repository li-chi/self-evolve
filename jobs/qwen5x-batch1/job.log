)[-1]\n    name = basename.replace(\'.md\', \'\')\n    \n    # Extract title from content\n    title_match = re.match(r\'^# (.+)\', content, re.MULTILINE)\n    if title_match:\n        name = title_match.group(1).strip()\n    \n    # Extract ingredients from 必备原料和工具 section\n    ingredients = []\n    \n    # Find the ingredients section\n    ing_section = re.search(r\'## 必备原料和工具\\n(.*?)##\', content, re.DOTALL)\n    if ing_section:\n        for line in ing_section.group(1).strip().split(\'\\n\'):\n            line = line.strip().lstrip(\'- \')\n            if line and not line.startswith(\'总量\') and not line.startswith(\'#\'):\n                # Clean up annotations\n                item = re.split(r\'[（(（]\\s*别称[^)]*[）)]\\s*\', line)[0].strip()\n                if item:\n                    ingredients.append(item)\n    \n    # Extract quantities from 计算 section\n    quantities = {}\n    qty_section = re.search(r\'## 计算\\n.*?总量：\\n(.*?)(?=## |$)\', content, re.DOTALL)\n    if qty_section:\n        for line in qty_section.group(1).strip().split(\'\\n\'):\n            line = line.strip().lstrip(\'- \')\n            if line and \'*\' in line:\n                parts = line.split(\'*\')\n                ing_name = parts[0].strip()\n                amount = parts[-1].strip()\n                # Clean up annotations\n                ing_name = re.split(r\'[（(（]\\s*别称[^)]*[）)]\\s*\', ing_name)[0].strip()\n                quantities[ing_name] = amount\n    \n    return {\n        \'name\': name,\n        \'ingredients\': ingredients,\n        \'quantities\': quantities\n    }\n\ndef ingredient_match_score(recipe_ingredients, available_names):\n    """Calculate match score based on ingredient overlap"""\n    if not recipe_ingredients:\n        return 0, 0\n    matches = 0\n    matched_names = []\n    recipe_set = set(recipe_ingredients)\n    avail_set = set(available_names)\n    \n    for ri in recipe_ingredients:\n        for ai in available_names:\n            if ai in ri or ri in ai:\n                matches += 1\n                matched_names.append(ri)\n                break\n    \n    return matches, len(recipe_ingredients), matched_names\n\n# Fetch and parse all recipes\nprint(f"Fetching {len(dish_files)} recipes...")\nall_recipes = []\nsuccess_count = 0\n\nfor i, path in enumerate(dish_files):\n    content = fetch_recipe(path)\n    if content:\n        recipe = parse_recipe(content, path)\n        if recipe and recipe[\'ingredients\']:\n            all_recipes.append(recipe)\n            success_count += 1\n    if (i + 1) % 20 == 0:\n        print(f"  Fetched {i+1}/{len(dish_files)} ({success_count} successful)")\n    time.sleep(0.3)\n\nprint(f"\\nParsed {len(all_recipes)} recipes with ingredients")\n\n# Score all recipes\nprint("\\nScoring recipes...")\nscored = []\nfor recipe in all_recipes:\n    matches, total, matched_names = ingredient_match_score(recipe[\'ingredients\'], available_names)\n    if total > 0:\n        ratio = matches / total\n        if ratio >= 0.5:  # At least half match\n            scored.append({\n                \'name\': recipe[\'name\'],\n                \'ingredients\': recipe[\'ingredients\'],\n                \'quantities\': recipe[\'quantities\'],\n                \'matches\': matches,\n                \'total\': total,\n                \'ratio\': ratio,\n                \'matched_names\': matched_names,\n                \'missing_names\': [ing for ing in recipe[\'ingredients\'] if ing not in matched_names]\n            })\n\n# Sort by match ratio, then by number of matches\nscored.sort(key=lambda x: (-x[\'ratio\'], -x[\'matches\']))\n\nprint(f"\\nFound {len(scored)} dishes with >= 50% ingredient match")\nfor r in scored[:20]:\n    print(f"  {r[\'name\']}: {r[\'matches\']}/{r[\'total\']} ({r[\'ratio\']*100:.0f}%) - match: {r[\'matched_names\']}, missing: {r[\'missing_names\']}")\n\n# Select top 3 - try to include soup if possible\nsoup_recipes = [r for r in scored if \'汤\' in r[\'name\'] or \'粥\' in r[\'name\'] or \'羹\' in r[\'name\']]\nother_recipes = [r for r in scored if \'汤\' not in r[\'name\'] and \'粥\' not in r[\'name\'] and \'羹\' not in r[\'name\']]\n\n# Prefer diversity - pick from different categories\nselected = []\nif soup_recipes:\n    selected.append(soup_recipes[0])\n    remaining_soups = soup_recipes[1:]\nelse:\n    remaining_soups = []\n\n# Add other recipes, ensuring variety\ncategories_used = set()\nfor r in other_recipes:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\nprint("\\n=== Selected Dishes ===")\nfor r in selected[:3]:\n    print(f"  {r[\'name\']}: matches={r[\'matched_names\']}, missing={r[\'missing_names\']}")\n    print(f"    Quantities: {r[\'quantities\']}")\n\n# Save cuisine.json\ncuisine = {\n    "recommended_dishes": []\n}\nfor r in selected[:3]:\n    dish_entry = {\n        "name": r[\'name\'],\n        "ingredients": []\n    }\n    for ing in r[\'ingredients\']:\n        qty = r[\'quantities\'].get(ing, \'\')\n        dish_entry[\'ingredients\'].append({\n            "name": ing,\n            "quantity": qty\n        })\n    cuisine[\'recommended_dishes\'].append(dish_entry)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=2)\nprint("\\nSaved cuisine.json")\n\n# Generate shopping list - ingredients missing from our stock\nshopping = []\nfor r in selected[:3]:\n    for ing in r[\'ingredients\']:\n        if ing not in r[\'matched_names\']:\n            qty = r[\'quantities\'].get(ing, \'\')\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    f.write(\'Name,Quantity\\n\')\n    for item in shopping:\n        f.write(f"{item[\'Name\']},{item[\'Quantity\']}\\n")\nprint(f"Saved shopping.csv with {len(shopping)} items")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
