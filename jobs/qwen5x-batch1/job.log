color="000000"/>\'\n        \'  <w:insideV w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'</w:tblBorders>\'\n    )\n    tblPr.append(borders)\n    \n    # Cell alignment helper\n    def set_cell_alignment(cell, h_align=WD_ALIGN_PARAGRAPH.CENTER, v_align=\'top\'):\n        cell.paragraphs[0].alignment = h_align\n        tc = cell._tc\n        tcPr = tc.get_or_add_tcPr()\n        tcPr.set(qn(\'w:vAlign\'), \'top\')\n    \n    # Header row (row 0): Overall Assessment | Recommendation\n    # With color D9D9D9\n    header_data = [\'Overall Assessment\', \'Recommendation\']\n    for col_idx, cell_text in enumerate(header_data):\n        cell = table.cell(0, col_idx)\n        cell.text = \'\'\n        p = cell.paragraphs[0]\n        add_run(p, cell_text, font_name=\'Cambria\', font_size=11, bold=True)\n        set_cell_alignment(cell, WD_ALIGN_PARAGRAPH.CENTER)\n        set_cell_shading(cell, \'D9D9D9\')\n    \n    # Data row (row 1): Percentage | Best match or Not recommended\n    # With color DAEEF3\n    best_color = \'DAEEF3\'\n    \n    overall_assessment = f"{pct}%"\n    recommendation = best_name if name == best_name else \'Not recommended\'\n    \n    data_data = [overall_assessment, recommendation]\n    for col_idx, cell_text in enumerate(data_data):\n        cell = table.cell(1, col_idx)\n        cell.text = \'\'\n        p = cell.paragraphs[0]\n        add_run(p, cell_text, font_name=\'Cambria\', font_size=11)\n        set_cell_alignment(cell, WD_ALIGN_PARAGRAPH.CENTER)\n        set_cell_shading(cell, \'DAEEF3\')\n    \n    # Save\n    safe_name = name.replace(\' \', \'_\')\n    filename = f\'/app/Interview_Assessment_Report_{safe_name}.docx\'\n    doc.save(filename)\n    print(f"Created: {filename}")\n\nprint(f"\\nBest candidate: {best_name}")\nPYEOF\npython3 /tmp/generate_docs.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
