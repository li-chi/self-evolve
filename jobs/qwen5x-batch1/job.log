+= 1 if hl else 0\n    # 6\n    pm = re.search(r\'project experience:\\s*.*?(?=contact)\', r, re.DOTALL)\n    iw = [\'users\',\'revenue\',\'latency\',\'engagement\',\'downloads\',\'uptime\',\'vulnerabilities\',\'cost\',\'conversion\',\'retention\',\'security\']\n    hi = any(i in pm.group(0) for i in iw) if pm else False\n    d[\'impact\'] = hi; score += 1 if hi else 0\n    # 7\n    sm = re.search(r\'technical skills:\\s*(.+)\', r)\n    sk = len([s.strip() for s in sm.group(1).split(\',\') if s.strip()]) if sm else 0\n    d[\'skills\'] = sk; score += 1 if sk >= 3 else 0\n    # 8\n    he = \'exceptional\' in e or \'outstanding\' in e; d[\'rec\'] = he; score += 1 if he else 0\n    # 9\n    ec = e.count(\'excellent\') + e.count(\'exceptional\') + e.count(\'outstanding\')\n    d[\'excl\'] = ec; score += 1 if ec >= 2 else 0\n    # 10\n    salm = re.search(r\'expected salary:\\s*(.+)\', r)\n    hs = False\n    if salm:\n        sp = re.search(r\'\\$?(\\d+)[kK]?\\s*[-\\u2013]\\s*(\\d+)[kK]?\', salm.group(1))\n        if sp:\n            hs = int(sp.group(2)) < 150\n        else:\n            cp = re.search(r\'(\\d+)k\\s*-\\s*(\\d+)k\\s*cny\', salm.group(1))\n            hs = True if cp else False\n    d[\'sal\'] = hs; score += 1 if hs else 0\n    return score, d\n\nfor name in resumes:\n    s, d = ev(name)\n    print(f"{name}: {s}/10  {d}")\nPYEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
