Sending keys: ['python3 << \'PYEOF\'\nimport re\nwith open(\'/app/schedule.txt\', \'r\', encoding=\'utf-8\') as f:\n    lines = f.readlines()\n\n# Collect blocks\ncourse_blocks = []\ncurrent_block = None\nfor i, line in enumerate(lines):\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+\', line)\n    if m:\n        if current_block:\n            course_blocks.append(current_block)\n        current_block = {\'line\': i, \'lines\': [line]}\n    elif current_block:\n        current_block[\'lines\'].append(line)\nif current_block:\n    course_blocks.append(current_block)\n\n# Check ALL 通识核心 Monday 开卷 course blocks\ntarget_cids = [\'PHIL119059.01\', \'BIOL119008.01\', \'FINE110037.01\', \'FINE110001.02\',\n               \'ECON110015.01\', \'ECON110017.01\', \'MANA110057.01\', \'MANA110058.01\',\n               \'MANA110064.01\', \'BIOL110013.01\', \'BIOL110035.01\', \'CHIN110038.01\',\n               \'ICES110024.01\', \'MUSE110002.01\', \'AIS210009.01\']\n\nfor block in course_blocks:\n    first = block[\'lines\'][0]\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+\', first)\n    if not m:\n        continue\n    cid = m.group(1)\n    if cid not in target_cids:\n        continue\n    \n    # Extract name from first line\n    name_part = first[m.end():]\n    cred_m = re.search(r\'\\s(\\d+)\\s\', name_part)\n    if cred_m:\n        first_line_name = name_part[:cred_m.start()].strip()\n    else:\n        first_line_name = \'\'\n    \n    print(f\'\\n=== {cid} ===\')\n    print(f\'  First line name: "{first_line_name}" (len={len(first_line_name)}, cn={len(re.findall(r"[一-龥]", first_line_name))})\')\n    \n    # Show first 5 lines\n    for j in range(min(5, len(block[\'lines\']))):\n        print(f\'  [{j}] {block["lines"][j][:120]}\')\n    \n    # Try to find name in continuation\n    for j in range(1, min(8, len(block[\'lines\']))):\n        stripped = block[\'lines\'][j].strip()\n        cn = re.findall(r\'[一-龥]\', stripped)\n        if len(cn) >= 2:\n            if \'考试\' not in stripped and \'副教授\' not in stripped and \'教授\' not in stripped and \'讲师\' not in stripped:\n                print(f\'  Name candidate in line {j}: "{stripped[:80]}" (cn={len(cn)})\')\nPYEOF\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
