Sending keys: ['python3 << \'PYEOF\'\nimport pdfplumber\nimport re\n\npdf = pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\')\n\ndef extract_courses_from_pages(pdf, page_numbers):\n    all_entries = []\n    \n    for page_num in page_numbers:\n        page = pdf.pages[page_num - 1]\n        lines_data = page.extract_words(x_tolerance=3, y_tolerance=5, group_by_cols=True)\n        \n        if not lines_data:\n            print(f"Page {page_num}: No words extracted")\n            continue\n        \n        # Group words into rows by y-position\n        rows = {}\n        for word in lines_data:\n            y = round(word[\'top\'], 0)\n            if y not in rows:\n                rows[y] = []\n            rows[y].append((word[\'x0\'], word[\'text\']))\n        \n        # Sort rows by y, then sort each row by x\n        sorted_rows = sorted(rows.items(), key=lambda x: x[0])\n        \n        # Now group into course entries\n        # Need to identify column boundaries\n        # For each row, classify the text based on x-position\n        \n        col_boundaries = [\n            (0, 100, \'id\'),      # 选课序号\n            (100, 200, \'name\'),  # 课程名称\n            (180, 210, \'credits\'), # 学分\n            (210, 250, \'instructor\'), # 教师\n            (250, 320, \'title\'),  # 职称\n            (320, 380, \'time\'),   # 时间\n            (380, 420, \'campus\'), # 教室\n            (420, 480, \'enrollment\'), # 人数\n            (480, 570, \'notes\'),  # 备注\n            (570, 680, \'exam\'),   # 考试时间\n            (680, 720, \'assessment\'), # 考试类型\n            (720, 900, \'restriction\'), # 选课限制条件\n        ]\n        \n        current_entry = {}\n        \n        for y, items in sorted_rows:\n            for x, text in sorted(items):\n                # Classify the text\n                classified = False\n                \n                # Course ID: pattern like COMP130025.01\n                if re.match(r\'^[A-Z]{2,6}\\d{4,8}\\.\\d+$\', text):\n                    if current_entry.get(\'id\'):\n                        all_entries.append(current_entry)\n                    current_entry = {\'id\': text, \'page\': page_num}\n                    continue\n                \n                # Section tags like \'思政B\'\n                if text in (\'思政A\', \'思政B\', \'思政A/B\'):\n                    current_entry[\'section\'] = text\n                    continue\n                \n                # Title keywords\n                if text in (\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\'):\n                    current_entry[\'title\'] = text\n                    continue\n                \n                # Time pattern: 一 4-5 [1-16] or similar\n                if re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[\', text):\n                    current_entry[\'time\'] = text\n                    continue\n                \n                # Campus\n                if text in (\'邯郸校区\', \'江湾校区\', \'枫林校区\', \'张江校区\'):\n                    current_entry[\'campus\'] = text\n                    continue\n                \n                # Exam date/time\n                if \'考试日期\' in text:\n                    current_entry[\'exam_date\'] = text.split(\':\')[-1].strip()\n                    continue\n                if \'考试时间\' in text:\n                    current_entry[\'exam_time\'] = text.split(\':\')[-1].strip()\n                    continue\n                \n                # Assessment methods\n                if text in (\'开卷\', \'闭卷\', \'论文\', \'口试\', \'其他\', \'论文/报告\', \'报告\'):\n                    current_entry[\'assessment\'] = text\n                    continue\n                \n                # \'含A+  是\'\n                if text == \'是\' and current_entry.get(\'assessment\'):\n                    current_entry[\'has_a_plus\'] = True\n                    continue\n                \n                # Notes/remarks (varies)\n                if text in (\'复旦大学精品课程\', \'是\'):\n                    if current_entry.get(\'notes\'):\n                        current_entry[\'notes\'] += \' \' + text\n                    else:\n                        current_entry[\'notes\'] = text\n                    continue\n                \n                # Multi-character entries that are likely names\n                if len(text) >= 2:\n                    # Check if it looks like a department\n                    dept_keywords = [\'学院\', \'系\', \'研究中心\']\n                    if any(kw in text for kw in dept_keywords):\n                        if current_entry.get(\'department\'):\n                            current_entry[\'department\'] += \' \' + text\n                        else:\n                            current_entry[\'department\'] = text\n                        continue\n                \n                # If we have a course entry context, try to assign\n                if current_entry.get(\'id\'):\n                    # Credits are single or double digits with optional decimal\n                    if re.match(r\'^\\d+\\.?\\d*$\', text) and len(text) <= 4 and not current_entry.get(\'credits\'):\n                        current_entry[\'credits\'] = text\n                        continue\n                    \n                    # Enrollment (single number)\n                    if re.match(r\'^\\d+$\', text) and len(text) <= 5 and not current_entry.get(\'enrollment\'):\n                        current_entry[\'enrollment\'] = text\n                        continue\n                    \n                    # Instructor name (2-4 Chinese characters, no special patterns)\n                    if re.match(r\'^[\\u4e00-\\u9fa5]{2,4}$\', text) and not current_entry.get(\'instructor\'):\n                        # Make sure it\'s not a title\n                        if text not in (\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\'):\n                            current_entry[\'instructor\'] = text\n                            continue\n                \n                # Section header detection\n                if \'通识教育核心课程——\' in text:\n                    if current_entry.get(\'id\'):\n                        all_entries.append(current_entry)\n                        current_entry = {}\n                    continue\n        \n        if current_entry.get(\'id\'):\n            all_entries.append(current_entry)\n    \n    return all_entries\n\n# Extract from pages containing our target courses\n# 思政B: page 7-8\n# 通识七大模块: pages 9, 10, 11, 12, 13, 14, 15, 16\n# Software Architecture: page 228\n# NLP: pages 229-231\n\nall_courses = extract_courses_from_pages(pdf, list(range(7, 17)) + [228, 229, 230, 231, 232])\n\nprint(f\'Total courses extracted: {len(all_courses)}\')\n\n# Find NLP courses\nnlp = [c for c in all_courses if \'自然语言处理\' in c.get(\'name\', \'\')]\nprint(f\'\\nNLP courses: {len(nlp)}\')\nfor c in nlp:\n    print(f\'  {c}\')\n\n# Find Software Architecture\nsa = [c for c in all_courses if \'软件体系结构\' in c.get(\'name\', \'\')]\nprint(f\'\\nSoftware Architecture: {len(sa)}\')\nfor c in sa:\n    print(f\'  {c}\')\n\n# Find 思政B courses on Monday with open-book\nb_courses = [c for c in all_courses if c.get(\'section\') == \'思政B\']\nprint(f\'\\n思政B courses: {len(b_courses)}\')\nfor c in b_courses:\n    print(f\'  {c}\')\n\n# Find Monday courses with open-book\nmonday_open = [c for c in all_courses if c.get(\'time\') and c[\'time\'].startswith(\'一\') and c.get(\'assessment\') == \'开卷\']\nprint(f\'\\nMonday open-book courses: {len(monday_open)}\')\nfor c in monday_open:\n    print(f\'  {c}\')\n\npdf.close()\nPYEOF\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
