Sending keys: ["cat > /app/check_more.py << 'PYEOF'\nimport re, urllib.request, urllib.parse\n\nRAW = 'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/'\nour = ['鸡蛋','土豆','茄子','蒜苗','冬瓜','瘦猪肉片','五花肉','牛奶','干辣椒']\n\ndef fetch(path):\n    raw = RAW + urllib.parse.quote(path, safe='/')\n    try:\n        with urllib.request.urlopen(raw) as r:\n            return r.read().decode('utf-8', errors='replace')\n    except:\n        return None\n\ntest_paths = [\n    'dishes/vegetable/茄子/油焖茄子.md',\n    'dishes/vegetable/茄子/红烧茄子.md',\n    'dishes/vegetable/茄子/鱼香茄子.md',\n    'dishes/vegetable/肉末茄子.md',\n    'dishes/soup/西红柿鸡蛋汤.md',\n    'dishes/breakfast/蛋炒饭.md',\n    'dishes/vegetable/蒜苔炒肉.md',\n    'dishes/vegetable/番茄炒蛋.md',\n    'dishes/breakfast/牛奶燕麦.md',\n    'dishes/dessert/燕麦鸡蛋饼.md',\n]\n\nfor p in test_paths:\n    txt = fetch(p)\n    if txt:\n        m = re.search(r'^# (.+)$', txt, re.M)\n        title = m.group(1).strip() if m else 'Unknown'\n        print('FOUND: ' + title + ' (' + p + ')')\n        calc = re.search(r'(## 计算.*?)\\n###|\\Z', txt, re.S | re.I)\n        if calc:\n            sec = calc.group(1)\n            for line in sec.split('\\n'):\n                line = line.strip()\n                if line.startswith('-'):\n                    print('  ' + line)\n        else:\n            print('  NO CALC SECTION')\n        for o in our:\n            if o in txt:\n                print('  contains: ' + o)\n    else:\n        print('NOT FOUND: ' + p)\nPYEOF\npython3 /app/check_more.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
