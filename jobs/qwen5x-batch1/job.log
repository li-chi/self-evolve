Sending keys: ['cat > /app/extract_courses.py << \'PYEOF\'\nimport pdfplumber\nimport re\nimport openpyxl\nfrom openpyxl import Workbook\nimport os\n\ndef extract_entries_from_page(page):\n    """Extract course entries from a PDF page by joining multi-line entries."""\n    text = page.extract_text() or \'\'\n    if not text:\n        return []\n    \n    # Split into lines and join multi-line entries\n    # Pattern: each course entry spans 2-4 lines\n    # Lines with exam info for PREVIOUS course are continuations of that course\n    lines = text.split(\'\\n\')\n    \n    entries = []\n    current_entries = []  # Stack of current partial entries per column\n    current = None  # Current entry being built\n    \n    for line in lines:\n        line = line.strip()\n        if not line:\n            continue\n        \n        # Check if this line starts a new course entry\n        m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n        \n        if m:\n            # Save previous entry if exists\n            if current:\n                entries.append(current)\n            # Start new entry\n            current = line\n        else:\n            # This is a continuation line\n            if current:\n                current = current + \' \' + line\n    \n    if current:\n        entries.append(current)\n    \n    return entries\n\ndef parse_entry(entry_text):\n    """Parse a joined course entry text into structured fields."""\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', entry_text)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    parts = rest.split()\n    \n    # Find time position\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    if time_pos <= 0:\n        return {\'Course ID\': code}\n    \n    before_time = parts[:time_pos]\n    \n    # Find instructor title\n    titles = [\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'青年研究员\', \'青年副研究员\',\n              \'研究员\', \'副研究员\', \'高级工程师\', \'工程师\', \'主管技师\',\n              \'主任医师\', \'副主任医师\', \'教授(教学为主型)\', \'副教授(教学为主型)\', \'实验师\']\n    \n    instructor_pos = -1\n    for j in range(len(before_time)-1, 0, -1):\n        if before_time[j] in titles:\n            instructor_pos = j\n            break\n    if instructor_pos <= 0:\n        return {\'Course ID\': code}\n    \n    instructor = before_time[instructor_pos]\n    title = before_time[instructor_pos+1] if instructor_pos+1 < len(before_time) else \'\'\n    \n    # Find credits (number before instructor)\n    credits = \'\'\n    credits_pos = -1\n    for j in range(instructor_pos-1, 0, -1):\n        if before_time[j].isdigit() and int(before_time[j]) <= 5:\n            credits_pos = j\n            credits = before_time[j]\n            break\n    \n    course_name = \' \'.join(before_time[1:credits_pos]) if credits_pos > 1 else \'\'\n    \n    # Parse after time\n    after_parts = parts[time_pos:]\n    class_time = \' \'.join(after_parts[:3])\n    \n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    enrollment = \'\'\n    cm = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n    if cm:\n        enrollment = cm.group(1)\n    \n    assessment = \'\'\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in rest:\n            assessment = a\n            break\n    \n    exam_time = \'\'\n    em = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n    if em:\n        exam_time = em.group(1)\n    \n    restrictions = \'\'\n    after_rest = rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_rest:\n            idx = after_rest.find(a)\n            after_rest = after_rest[idx+len(a):]\n            break\n    restrictions = after_rest.strip()\n    \n    return {\n        \'Course name\': course_name,\n        \'Course ID\': code,\n        \'Instructor\': instructor,\n        \'Campus\': campus,\n        \'Class Time\': class_time,\n        \'Enrollment\': enrollment,\n        \'Credits\': credits,\n        \'Assessment Method\': assessment,\n        \'Exam Time\': exam_time,\n        \'Course Selection Restrictions\': restrictions,\n        \'_day\': parts[time_pos],\n        \'_time\': parts[time_pos+1]\n    }\n\nprint("Opening PDF...")\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    print(f"Total pages: {len(pdf.pages)}")\n    \n    all_entries = []\n    \n    for i, page in enumerate(pdf.pages):\n        try:\n            entries = extract_entries_from_page(page)\n            all_entries.extend(entries)\n        except Exception as e:\n            pass\n    \n    print(f"Total entries extracted: {len(all_entries)}")\n    \n    # Find 自然语言处理\n    for entry in all_entries:\n        if \'自然语言处理\' in entry:\n            parsed = parse_entry(entry)\n            if parsed:\n                print(f"NLP: {parsed[\'Course name\']} [{parsed[\'Course ID\']}] - {parsed[\'Class Time\']} - {parsed[\'Assessment Method\']}")\n    \n    # Find 软件体系结构\n    for entry in all_entries:\n        if \'软件体系结构\' in entry:\n            parsed = parse_entry(entry)\n            if parsed:\n                print(f"Arch: {parsed[\'Course name\']} [{parsed[\'Course ID\']}] - {parsed[\'Class Time\']} - {parsed[\'Assessment Method\']}")\n    \n    # Find 思政B Monday 开卷\n    tongren_courses = []\n    in_section = False\n    for i, page in enumerate(pdf.pages):\n        try:\n            text = page.extract_text() or \'\'\n            if \'通识教育核心课程——七大模块课程\' in text or \'通识教育核心课程——公共艺术课程\' in text:\n                in_section = True\n                continue\n            if in_section and \'通识教育核心课程——思想政治\' in text:\n                in_section = False\n            if \'基础课程和专业课程\' in text and in_section:\n                in_section = False\n        except:\n            pass\n    \n    for entry in all_entries:\n        parsed = parse_entry(entry)\n        if not parsed or not parsed.get(\'Class Time\'):\n            continue\n        \n        # Check if 思政B Monday 开卷\n        if \'思政B\' in entry and \'开卷\' in entry and \'一\' in entry:\n            print(f"思政B Monday: {parsed[\'Course name\']} [{parsed[\'Course ID\']}] - {parsed[\'Class Time\']}")\n        \n        # Check if tongren Monday 开卷 (not in 思政 section)\n        dm = re.search(r\'(一)\\s+(\\d+-\\d+)\\s+\\[\', entry)\n        if dm and \'开卷\' in entry and \'思政\' not in entry and \'半开卷\' not in entry:\n            # Check if in tongren section by checking page number\n            # Pages 10-164 contain tongren courses\n            page_idx = -1\n            for pi, pg_entries in enumerate(all_entries):\n                pass\n            tongren_courses.append(parsed)\n            if parsed.get(\'Course name\'):\n                print(f"Tongren: {parsed[\'Course name\']} [{parsed[\'Course ID\']}] - {parsed[\'Class Time\']}")\n    \n    print(f"\\nTotal tongren options: {len(tongren_courses)}")\n\nPYEOF\npython3 /app/extract_courses.py 2>&1 | head -40\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
