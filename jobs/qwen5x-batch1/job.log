Sending keys: ['cat > /app/process.py << \'PYEOF\'\nimport pdfplumber\nimport openpyxl\nimport os\nimport glob\nimport re\nfrom collections import defaultdict\n\n# Extract data from all PDF files, filtering only taxi receipts\nbills_dir = \'/app/bills\'\npdf_files = sorted(glob.glob(os.path.join(bills_dir, \'*.pdf\')))\n\ndata = []\nfor pdf_path in pdf_files:\n    fname = os.path.basename(pdf_path)\n    file_name = os.path.splitext(fname)[0]\n    \n    with pdfplumber.open(pdf_path) as pdf:\n        text = pdf.pages[0].extract_text()\n    \n    # Only process taxi receipts\n    if \'TAXI RECEIPT\' not in text:\n        print(f"Skipping non-taxi: {fname}")\n        continue\n    \n    # Extract date\n    date_match = re.search(r\'Date:\\s*(\\d{4}-\\d{2}-\\d{2})\', text)\n    if date_match:\n        date_str = date_match.group(1)\n    else:\n        print(f"Warning: No date found in {fname}")\n        continue\n    \n    # Extract amount\n    amount_match = re.search(r\'Amount:\\s*CNY\\s*([\\d,]+\\.?\\d*)\', text)\n    if amount_match:\n        amount = float(amount_match.group(1).replace(\',\', \'\'))\n    else:\n        print(f"Warning: No amount found in {fname}")\n        continue\n    \n    month = date_str[:7]\n    data.append({\n        \'file_name\': file_name,\n        \'month\': month,\n        \'amount\': amount,\n        \'date\': date_str\n    })\n\nprint(f"\\nFound {len(data)} taxi receipts")\nfor d in data:\n    print(f"  {d[\'file_name\']} | {d[\'month\']} | {d[\'amount\']:.2f}")\n\n# Sort by file name (ascending chronological order)\ndata.sort(key=lambda x: x[\'file_name\'])\n\n# Calculate monthly totals\nmonthly_totals = defaultdict(float)\nfor d in data:\n    monthly_totals[d[\'month\']] += d[\'amount\']\n\ngrand_total = sum(d[\'amount\'] for d in data)\nprint(f"\\nMonthly totals:")\nfor m in sorted(monthly_totals.keys()):\n    print(f"  {m}: {monthly_totals[m]:.2f}")\nprint(f"Grand total: {grand_total:.2f}")\n\n# Load Excel template\nwb = openpyxl.load_workbook(\'/app/Bill_Format.xlsx\')\nws = wb.active\n\n# Fill monthly amounts (rows 6-8 for April, May, June)\nmonth_rows = {\n    \'2025-04\': 6,\n    \'2025-05\': 7,\n    \'2025-06\': 8\n}\nfor month, row in month_rows.items():\n    ws.cell(row=row, column=2, value=round(monthly_totals[month], 2))\n\n# Fill grand total (row 9)\nws.cell(row=9, column=2, value=round(grand_total, 2))\n\n# Fill expense details starting at row 13\nrow = 13\nfor d in data:\n    ws.cell(row=row, column=1, value=d[\'file_name\'])\n    ws.cell(row=row, column=2, value=d[\'month\'])\n    ws.cell(row=row, column=3, value=round(d[\'amount\'], 2))\n    row += 1\n\n# Save as department_expenses.xlsx\nwb.save(\'/app/department_expenses.xlsx\')\nprint("\\nSaved as department_expenses.xlsx")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
