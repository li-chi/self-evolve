ks:\n        # Extract name from first line like "Candidate 5 Name: John_Smith"\n        m = re.search(r\'Name:\\s*(.+)\', block)\n        if m:\n            name = m.group(1).strip()\n            # Remove underscores for display\n            evaluations[name] = block\n    \n    return evaluations\n\nresumes = extract_resumes()\nevaluations = extract_evaluations()\n\nprint("=== RESUMES ===")\nfor name, data in resumes.items():\n    print(f"\\n{name}:")\n    for k, v in data.items():\n        if k != \'name\':\n            print(f"  {k}: {v}")\n\nprint("\\n=== EVALUATIONS ===")\nfor name, eval_text in evaluations.items():\n    print(f"\\n{name}:")\n    # Check recommendation keywords\n    lower = eval_text.lower()\n    rec_level = "none"\n    if \'exceptional\' in lower:\n        rec_level = "exceptional"\n    elif \'outstanding\' in lower:\n        rec_level = "outstanding"\n    elif \'strongly recommended\' in lower:\n        rec_level = "strongly recommended"\n    elif \'highly recommended\' in lower:\n        rec_level = "highly recommended"\n    elif \'recommended\' in lower:\n        rec_level = "recommended"\n    \n    excellence_count = lower.count(\'excellence\') + lower.count(\'exceptional\') + lower.count(\'outstanding\')\n    \n    print(f"  Recommendation level: {rec_level}")\n    print(f"  Excellence mentions: {excellence_count}")\n    print(f"  Has leadership mention: {\'leadership\' in lower}")\n    print(f"  Text preview: {eval_text[:100]}...")\n\n# ========== 2. Evaluate candidates against requirements ==========\ntop_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\nfang_companies = [\'Google\', \'Meta\', \'Amazon\', \'Netflix\', \'Apple\', \'Microsoft\']  # FAANG+F\n\ndef evaluate_candidate(name, resume, eval_text):\n    criteria = {}\n    \n    if not resume or not eval_text:\n        return criteria\n    \n    eval_lower = eval_text.lower()\n    \n    # 1. Minimum Experience: 4+ years\n    exp_match = re.search(r\'(\\d+)\\s+years\', resume.get(\'Work Experience\', \'\'))\n    exp_years = int(exp_match.group(1)) if exp_match else 0\n    criteria[\'experience\'] = exp_years >= 4\n    \n    # 2. Education: Master degree or higher\n    edu = resume.get(\'Education\', \'\').lower()\n    criteria[\'education\'] = \'master\' in edu or \'phd\' in edu or \'doctorate\' in edu\n    \n    # 3. Top-tier University\n    edu_full = resume.get(\'Education\', \'\')\n    top_univ = any(u in edu_full for u in top_universities)\n    criteria[\'top_university\'] = top_univ\n    \n    # 4. FAANG Experience\n    work = resume.get(\'Work Experience\', \'\').lower()\n    companies = re.findall(r\'at\\s+([A-Za-z]+)\', work)\n    faang = any(any(fc.lower() in c.lower() for fc in fang_companies) for c in companies)\n    # Also check "previously at" or "previously worked at"\n    company_match = re.findall(r\'(?:previously\\s+at|previously\\s+worked\\s+at|currently\\s+at)\\s+([A-Za-z]+)\', resume.get(\'Work Experience\', \'\'), re.IGNORECASE)\n    faang = any(any(fc.lower() in c.lower() for fc in fang_companies) for c in company_match)\n    criteria[\'faang\'] = faang\n    \n    # 5. Leadership Experience\n    criteria[\'leadership\'] = any(w in resume.get(\'Project Experience\', \'\').lower() or w in eval_lower for w in [\'lead\', \'led\', \'leader\'])\n    \n    # 6. High-impact Projects (projects with quantified results)\n    proj = resume.get(\'Project Experience\', \'\').lower()\n    high_impact = bool(re.search(r\'\\d+%|\\d+\\+|million|billion|\\$[\\d,]+\', proj))\n    criteria[\'high_impact\'] = high_impact\n    \n    # 7. Advanced Technical Skills: 3+ areas\n    skills_str = resume.get(\'Technical Skills\', \'\')\n    skills = [s.strip() for s in skills_str.split(\',\') if s.strip()]\n    criteria[\'tech_skills\'] = len(skills) >= 3\n    \n    # 8. Recommendation Level: Exceptional/Outstanding only\n    rec_level = "not met"\n    if \'exceptional\' in eval_lower:\n        rec_level = "met (exceptional)"\n    elif \'outstanding\' in eval_lower:\n        rec_level = "met (outstanding)"\n    else:\n        rec_level = "not met"\n    criteria[\'recommendation_level\'] = rec_level\n    \n    # 9. Excellence Rating: 2+ excellence mentions\n    excellence_count = eval_lower.count(\'exceptional\') + eval_lower.count(\'outstanding\')\n    criteria[\'excellence_rating\'] = excellence_count >= 2\n    \n    # 10. Salary Budget: Under $150K\n    salary_str = resume.get(\'Expected Salary\', \'\')\n    salary_under_150 = False\n    salary_match = re.search(r\'\\$(\\d+)[Kk]\', salary_str)\n    if salary_match:\n        salary_k = int(salary_match.group(1))\n        salary_under_150 = salary_k < 150\n    else:\n        # Check for CNY or no dollar sign\n        salary_under_150 = True  # Assume under budget if in CNY\n    criteria[\'salary\'] = salary_under_150\n    \n    # Calculate overall percentage\n    total = len(criteria)\n    met = sum(1 for v in criteria.values() if v is True)\n    criteria[\'percentage\'] = int(round(met / total * 100))\n    \n    # Best match determination\n    all_met = all(v is True for k, v in criteria.items() if k != \'percentage\')\n    criteria[\'all_met\'] = all_met\n    criteria[\'score\'] = met\n    \n    return criteria\n\nprint("\\n=== CANDIDATE EVALUATIONS ===")\nall_evaluations = []\nfor name in resumes:\n    resume = resumes[name]\n    eval_text = evaluations.get(name, \'\')\n    criteria = evaluate_candidate(name, resume, eval_text)\n    all_evaluations.append((name, criteria))\n    print(f"\\n{name}:")\n    for k, v in criteria.items():\n        if k != \'percentage\' and k != \'score\':\n            print(f"  {k}: {v}")\n    print(f"  MET: {criteria[\'score\']}/{len(criteria)-2}, PCT: {criteria[\'percentage\']}%")\n\n# Find best candidate\nbest = max(all_evaluations, key=lambda x: (x[1].get(\'score\', 0), x[1].get(\'percentage\', 0)))\nprint(f"\\n=== BEST CANDIDATE: {best[0]} ===")\nprint(f"  Score: {best[1][\'score\']}/{len(best[1])-2}, Percentage: {best[1][\'percentage\']}%")\nPYEOF\npython3 /tmp/solve.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
