Sending keys: ['python3 << \'PYEOF\'\nimport pdfplumber\nimport re\nimport os\n\nwith pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\') as pdf:\n    all_pages = []\n    for i, page in enumerate(pdf.pages):\n        try:\n            text = page.extract_text() or \'\'\n            all_pages.append(text)\n        except:\n            all_pages.append(\'\')\n    print(f"Extracted {len(all_pages)} pages")\n\n# Map text file lines to PDF page boundaries\n# Re-read pdf_text.txt and find page boundaries\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    lines = f.readlines()\n\n# Find page number in text: "=== PAGE X ==="\npage_starts = []\nfor i, line in enumerate(lines):\n    m = re.search(r\'=== PAGE (\\d+) ===\', line)\n    if m:\n        page_starts.append(int(m.group(1)))\n\nprint(f"Page boundaries: {len(page_starts)} pages")\n\n# Now find all 通识教育核心课程 sections\n# From TOC: 七大模块课程 starts page 10, ends page 164\n# Let\'s extract from page 10 to 164 (PDF page numbers)\n\n# Map PDF page numbers to text line ranges\npdf_page_to_lines = {}  # pdf_page_num -> (line_start, line_end)\nfor i in range(1, len(page_starts)):\n    pdf_page_to_lines[page_starts[i-1]] = (page_starts[i-1]-1, page_starts[i]-1)  # approximate\n# Last page\npdf_page_to_lines[page_starts[-1]] = (page_starts[-1]-1, len(lines))\n\n# For each course code we need, find which text line it\'s on and extract name\nprint("\\nLooking for course names on pages 10-164...")\n\n# Let\'s extract courses page by page from PDF directly\nfor pdf_pg in range(9, 15):  # Pages 10-14 (0-indexed 9-14)\n    page = pdf.pages[pdf_pg]\n    try:\n        text = page.extract_text() or \'\'\n    except:\n        continue\n    # Find all course code patterns\n    for code in [\'PHIL119059\', \'FORE119008\', \'BIOL119008\', \'FINE110037\', \'FINE110001\',\n                 \'MANA110057\', \'MANA110058\', \'MANA110064\', \'BIOL110013\', \'MUSE110002\',\n                 \'ECON110015\', \'ECON110017\', \'BIOL110035\', \'CHIN110038\', \'ICES110024\']:\n        idx = text.find(code)\n        if idx >= 0:\n            # Get full line context - find the line with this code\n            # Go backward to find start of this entry\n            before = text[:idx]\n            # Find the start of this section within the page text\n            # The pattern: name_part + exam info + CODE + credits + instructor + time...\n            # Go back to the last newline before the name that\'s Chinese\n            line_before = before.rfind(\'\\n\')\n            if line_before >= 0:\n                line_start = before.rfind(\'\\n\', 0, line_before-1) if line_before > 10 else 0\n                entry_text = before[line_start:].strip()\n                print(f"\\nPage {pdf_pg+1}, {code}:")\n                print(f"  Before: [{entry_text[-200:] if len(entry_text)>200 else entry_text}]")\n                # Get after text  \n                after_text = text[idx:idx+200]\n                print(f"  At code: [{after_text[:150]}]")\nPYEOF\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
