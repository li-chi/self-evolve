Sending keys: ['cat > /app/find_tongshi.py << \'PYEOF\'\nimport re\n\nwith open(\'/app/schedule.txt\', \'r\', encoding=\'utf-8\') as f:\n    lines = f.readlines()\n\n# Build section map: for each line, what section does it belong to?\nsection_starts = []\nfor i, line in enumerate(lines):\n    # Only track 通识核心 headers at the start of a block (not at the very beginning of a line with content)\n    raw = line.strip()\n    # Headers typically appear alone on their line or with minimal content\n    if \'通识教育核心课程——七大模块课程\' in raw and raw.count(\'通识教育核心课程\') == 1 and \'模块\' in raw:\n        section_starts.append((i, \'通识核心\'))\n    elif \'通识教育核心课程——公共艺术课程\' in raw:\n        section_starts.append((i, \'通识核心\'))\n    elif \'通识教育核心课程——思想政治理论课程A组\' in raw:\n        section_starts.append((i, \'思政A\'))\n    elif \'通识教育核心课程——思想政治理论课程B组\' in raw:\n        section_starts.append((i, \'思政B\'))\n    elif \'通识教育核心课程——形势与政策类课程\' in raw:\n        section_starts.append((i, \'形势与政策\'))\n    elif \'通识教育专项教育课程——\' in raw and \'第\' not in raw.split(\'通识\')[0][-5:]:\n        # But not table of contents lines\n        if \'第\' not in raw or raw.find(\'第\') > raw.rfind(\'通识\'):\n            section_starts.append((i, \'通识专项\'))\n    elif \'基础课程和专业课程\' in raw:\n        section_starts.append((i, \'专业\'))\n    elif \'公共选修课程\' in raw and \'大类\' not in raw:\n        section_starts.append((i, \'公选\'))\n\n# Build section map\nsection_map = {}\ncurrent_sec = \'未知\'\nfor sh_line, sh_name in section_starts:\n    current_sec = sh_name\n    for j in range(sh_line, min(sh_line + 10, len(lines))):\n        section_map[j] = current_sec\n\n# For courses, find section by looking backward\nfor i, line in enumerate(lines):\n    if i not in section_map and i > 0:\n        for j in range(i-1, -1, -1):\n            if j in section_map:\n                section_map[i] = section_map[j]\n                break\n        else:\n            section_map[i] = \'未知\'\n\n# Now find all Monday 开卷 courses in 通识核心 section\ndef get_course_fields_from_line(line):\n    m = re.match(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+(.+?)\\s+(\\d+)\\s\', line)\n    if not m:\n        return None\n    cid = m.group(1)\n    rest = m.group(2)\n    credits = m.group(3)\n    \n    # Get name - between cid and credits, but there might be multi-word name\n    name_m = re.search(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+(.+?)\\s+(\\d+)\\s\', line)\n    name = \'\'\n    if name_m:\n        name = name_m.group(2).strip()\n        # Clean up - remove extra numbers and whitespace\n        name = re.sub(r\'\\s*\\d+\\s*\', \' \', name).strip()\n        name = re.sub(r\'\\s{2,}\', \' \', name).strip()\n    \n    wm = re.search(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', line)\n    weekday = wm.group(1) if wm else \'\'\n    time_range = wm.group(2) if wm else \'\'\n    weeks = wm.group(3) if wm else \'\'\n    \n    campus_m = re.search(r\'(邯郸校区|江湾校区|张江校区|枫林校区)\', line)\n    campus = campus_m.group(1) if campus_m else \'\'\n    \n    exam_type = \'\'\n    for t in [\'开卷\', \'闭卷\', \'论文\', \'其他\', \'半开卷\']:\n        if t in line:\n            exam_type = t\n            break\n    \n    # Teacher\n    t_m = re.search(r\'(教授|副教授|讲师|研究员|副研究员|高级工程师|青年研究员|助理研究员)\', line)\n    teacher = \'\'\n    if t_m:\n        teacher = line[:t_m.start()].strip()\n        teacher = re.sub(r\'^[A-Z]{2,6}\\d{6}\\.\\d+\\s+\', \'\', teacher)\n        teacher = re.sub(r\'\\s+\\d+\\s+\', \' \', teacher).strip()\n    \n    # Department\n    dept_keywords = [\'马克思主义学院\', \'哲学学院\', \'中国语言文学系\', \'文学院\',\n                     \'历史学系\', \'文物与博物馆学系\', \'国际文化交流学院\',\n                     \'计算机科学技术学院\', \'软件学院\', \'信息科学与工程学院\', \'航空航天系\',\n                     \'政治学\', \'法学院\', \'艺术学院\', \'经济\', \'管理学院\',\n                     \'生命科学学院\', \'环境科学\', \'物理学系\', \'化学系\', \'数学科学\',\n                     \'大气\', \'相辉\', \'新闻\', \'社会发展\', \'社会学\', \'公共管理\',\n                     \'外国语言\', \'艺术教育中心\', \'体育学院\', \'心理咨询\', \'大学外语\',\n                     \'环境科学与工程系\', \'音乐\', \'舞蹈\', \'戏剧\', \'书法\',\n                     \'国际关系与\', \'社会学系\', \'公共管理系\', \'中外法律\', \'传播学\',\n                     \'文物与考古\', \'留学生\', \'管理科学\']\n    department = \'\'\n    for dk in dept_keywords:\n        if dk in line:\n            di = line.rfind(dk)\n            department = line[di:].strip()\n            break\n    \n    return {\'cid\': cid, \'name\': name, \'credits\': credits, \'teacher\': teacher,\n            \'weekday\': weekday, \'time\': time_range, \'weeks\': weeks,\n            \'campus\': campus, \'exam_type\': exam_type, \'department\': department}\n\nprint(\'=== 通识核心 Monday 开卷 courses ===\')\ntongshi_monday_kj = []\nfor i, line in enumerate(lines):\n    if i not in section_map:\n        continue\n    if section_map[i] != \'通识核心\':\n        continue\n    \n    fields = get_course_fields_from_line(line)\n    if not fields:\n        continue\n    if fields[\'weekday\'] == \'一\' and fields[\'exam_type\'] == \'开卷\':\n        print(f"  {fields[\'cid\']}: {fields[\'name\']}, {fields[\'credits\']}学分, {fields[\'teacher\']}, {fields[\'weekday\']}{fields[\'time\']} {fields[\'weeks\']}, {fields[\'campus\']}, {fields[\'exam_type\']}, {fields[\'department\']}")\n        tongshi_monday_kj.append(fields)\n\nprint(f\'\\nTotal: {len(tongshi_monday_kj)}\')\n\n# Also get 思政B Monday 开卷\nprint(\'\\n=== 思政B Monday 开卷 ===\')\nfor i, line in enumerate(lines):\n    if i not in section_map:\n        continue\n    if section_map[i] != \'思政B\':\n        continue\n    fields = get_course_fields_from_line(line)\n    if not fields:\n        continue\n    if fields[\'weekday\'] == \'一\' and fields[\'exam_type\'] == \'开卷\':\n        print(f"  {fields[\'cid\']}: {fields[\'name\']}, {fields[\'credits\']}学分, {fields[\'teacher\']}, {fields[\'weekday\']}{fields[\'time\']} {fields[\'weeks\']}, {fields[\'campus\']}, {fields[\'exam_type\']}, {fields[\'department\']}")\n\n# Check section_map for some lines\nprint(\'\\n=== Section map for key lines ===\')\nfor line_num in [1245, 1430, 1742, 1844, 1027, 1112, 1614, 1831]:\n    if line_num in section_map:\n        print(f\'  Line {line_num}: {section_map[line_num]}\')\n    else:\n        # Find backward\n        for j in range(line_num-1, max(line_num-100, -1), -1):\n            if j in section_map:\n                print(f\'  Line {line_num}: {section_map[j]} (via line {j})\')\n                break\nPYEOF\npython3 /app/find_tongshi.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
