Sending keys: ['python3 << \'PYEOF\'\nimport openpyxl\n\nwb = openpyxl.load_workbook(\'/app/Nutrition.xlsx\')\nws = wb[\'Sheet1\']\n\nnutrition = {}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    if row[0]:\n        name = row[0]\n        carbs_100 = row[1]\n        prot_100 = row[2]\n        nutrition[name] = {\'carbs\': carbs_100, \'protein\': prot_100}\n\ndef calc_nutrients(ingredients):\n    total_carbs = 0.0\n    total_protein = 0.0\n    for name, amount_g in ingredients:\n        info = nutrition.get(name)\n        if info:\n            total_carbs += amount_g * info[\'carbs\'] / 100.0\n            total_protein += amount_g * info[\'protein\'] / 100.0\n        else:\n            print(f"  WARNING: \'{name}\' not in nutrition table")\n    return total_carbs, total_protein\n\nprint("=== 1) 西红柿炒鸡蛋 (1 portion) ===")\n# Per recipe for 1 portion:\n# 西红柿 = 1个(约180g)\n# 鸡蛋 = 1.5个向上取整 = 2个(50g each = 100g)\n# 食用油 = 4ml * 鸡蛋个 = 4*2 = 8ml -> 8*0.92=7.36g\n# 盐 = 1.5-2g -> avg 1.75g\n# 糖 = 0-2g -> avg 1g\n# 葱花 = 0-10g -> avg 5g\ning1 = [\n    (\'西红柿\', 180),\n    (\'鸡蛋\', 100),\n    (\'植物油\', 8 * 0.92),\n    (\'盐\', 1.75),\n    (\'白砂糖\', 1),\n    (\'葱花\', 5),\n]\nc1, p1 = calc_nutrients(ing1)\nprint(f"  Carbs={c1:.1f}g, Protein={p1:.1f}g")\nfor n,a in ing1:\n    print(f"    {n}: {a:.1f}g -> carbs={a*nutrition[n][\'carbs\']/100:.2f}g, prot={a*nutrition[n][\'protein\']/100:.2f}g")\n\nprint("\\n=== 2) 荔枝肉 (1 portion) ===")\ning2 = [\n    (\'鲜香菇\', 30),    # 2朵, 1朵约15g\n    (\'蟹味菇\', 30),\n    (\'瘦肉（猪肉）\', 150),\n    (\'凤梨（菠萝）\', 100),\n    (\'鸡蛋\', 50),\n    (\'植物油\', 500 * 0.92),\n    (\'白砂糖\', 5),\n    (\'淀粉\', 100),\n    (\'生抽\', 5 * 1.15),\n    (\'鸡精\', 5),\n    (\'姜\', 5),\n    (\'芝麻\', 2),\n    (\'番茄酱\', 20),\n    (\'香醋\', 2 * 1.05),\n]\nc2, p2 = calc_nutrients(ing2)\nprint(f"  Carbs={c2:.1f}g, Protein={p2:.1f}g")\nfor n,a in ing2:\n    print(f"    {n}: {a:.1f}g -> carbs={a*nutrition[n][\'carbs\']/100:.2f}g, prot={a*nutrition[n][\'protein\']/100:.2f}g")\n\nprint("\\n=== 3) 葱油桂鱼 (1 portion - recipe for 2 portions, divide by 2) ===")\n# Recipe per 2 portions:\n# 桂鱼 = 500g -> 250g per portion\n# 小葱 = 1根(10g) -> 5g per portion\n# 小米辣 = 2个(3g each) -> 3g per portion\n# 姜 = 50g -> 25g per portion\n# 料酒 = 25g -> 12.5g per portion\n# 植物油 = 15g -> 7.5g per portion\n# 盐 = 8g -> 4g per portion\n# 蒸鱼豉油 = 10g -> 5g per portion\ning3 = [\n    (\'桂鱼\', 250),\n    (\'小葱\', 5),\n    (\'小米辣\', 3),\n    (\'姜\', 25),\n    (\'料酒\', 12.5),\n    (\'植物油\', 7.5),\n    (\'盐\', 4),\n    (\'蒸鱼豉油\', 5),\n]\nc3, p3 = calc_nutrients(ing3)\nprint(f"  Carbs={c3:.1f}g, Protein={p3:.1f}g")\nfor n,a in ing3:\n    print(f"    {n}: {a:.1f}g -> carbs={a*nutrition[n][\'carbs\']/100:.2f}g, prot={a*nutrition[n][\'protein\']/100:.2f}g")\n\n# Totals\ntotal_carbs = c1 + c2 + c3\ntotal_protein = p1 + p2 + p3\nprint(f"\\n=== TOTALS ===")\nprint(f"Total Carbs: {total_carbs:.1f}g")\nprint(f"Total Protein: {total_protein:.1f}g")\n\n# Expected values\n# BMI = 65/(1.52^2) = 28.13 > 28, obese adjustment\n# Fat loss male initial + rest day:\n# Carbs: 2.4-0.5 to 2.7-0.5 = 1.9-2.2 g/kg\n# Protein: 1.2 g/kg\nweight = 65\ncarb_low = 1.9 * weight  # 123.5\ncarb_high = 2.2 * weight  # 143.0\nprotein_target = 1.2 * weight  # 78.0\n\nprint(f"\\n=== EXPECTED ===")\nprint(f"Carbs: {carb_low}g-{carb_high}g")\nprint(f"Protein: {protein_target}g (tolerance +/-10g: {protein_target-10}-{protein_target+10})")\n\n# Assessments\ncarb_95 = 0.95 * carb_low\ncarb_105 = 1.05 * carb_high\nprot_95 = 0.95 * (protein_target - 10)\nprot_105 = 1.05 * (protein_target + 10)\n\nif total_carbs < carb_95:\n    carb_a = "Below expectations"\nelif total_carbs > carb_105:\n    carb_a = "Excessive intake"\nelse:\n    carb_a = "Meets expectations"\n\nif total_protein < prot_95:\n    prot_a = "Below expectations"\nelif total_protein > prot_105:\n    prot_a = "Excessive intake"\nelse:\n    prot_a = "Meets expectations"\n\nprint(f"\\n=== ASSESSMENTS ===")\nprint(f"Carbs: {carb_a}")\nprint(f"  Range: {carb_low}-{carb_high}, Actual: {total_carbs:.1f}")\nprint(f"  95% lower: {carb_95}, 105% upper: {carb_105}")\nprint(f"Protein: {prot_a}")\nprint(f"  Target: {protein_target}, Range +/-10g: {protein_target-10}-{protein_target+10}")\nprint(f"  Actual: {total_protein:.1f}")\nprint(f"  95% lower: {prot_95}, 105% upper: {prot_105}")\n\nPYEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
