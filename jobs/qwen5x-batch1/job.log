Sending keys: ["python3 << 'PYEND'\nimport json\n\n# Read existing cuisine.json\nwith open('/app/cuisine.json') as f:\n    data = json.load(f)\n\n# Fix 牛奶燕麦 quantities manually from known recipe\nfor dish in data['recommended_dishes']:\n    if dish['name'] == '牛奶燕麦':\n        for ing in dish['ingredients']:\n            if ing['name'] == '牛奶':\n                ing['quantity'] = '280ml'\n            elif ing['name'] == '鸡蛋':\n                ing['quantity'] = '1 个'\n            elif ing['name'] == '燕麦':\n                ing['quantity'] = '40g'\n    elif dish['name'] == '茄子炖土豆':\n        pass  # already correct\n    elif dish['name'] == '炒滑蛋':\n        pass  # already correct\n\nwith open('/app/cuisine.json', 'w', encoding='utf-8') as f:\n    json.dump(data, f, ensure_ascii=False, indent=2)\n\n# Fix shopping list\nshopping = []\nfor dish in data['recommended_dishes']:\n    missing = []\n    have = ['鸡蛋', '土豆', '茄子', '蒜苗', '冬瓜', '瘦猪肉片', '五花肉', '牛奶', '干辣椒']\n    for ing in dish['ingredients']:\n        if ing['name'] not in have:\n            missing.append((ing['name'], ing['quantity']))\n    for name, qty in missing:\n        shopping.append({'Name': name, 'Quantity': qty})\n\nwith open('/app/shopping.csv', 'w', encoding='utf-8') as f:\n    f.write('Name,Quantity' + chr(10))\n    for item in shopping:\n        f.write(item['Name'] + ',' + item['Quantity'] + chr(10))\n\nprint('Updated files')\nprint(json.dumps(data, ensure_ascii=False, indent=2))\nprint('---')\nfor s in shopping:\n    print(s)\nPYEND\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
