Sending keys: ['python3 -c "\nimport json, re, urllib.request\n\ndef gh(path):\n    url = \'https://api.github.com/repos/Anduin2017/HowToCook/contents/\' + path\n    req = urllib.request.Request(url, headers={\'Accept\': \'application/vnd.github.v3+json\'})\n    try:\n        with urllib.request.urlopen(req) as r:\n            return json.loads(r.read().decode())\n    except:\n        return None\n\ndef find_md(base, out=None):\n    if out is None: out = []\n    items = gh(base)\n    if not items: return out\n    for it in items:\n        if it[\'type\']==\'file\' and it[\'name\'].endswith(\'.md\'): out.append(it)\n        elif it[\'type\']==\'dir\': find_md(it[\'path\'], out)\n    return out\n\nfiles = find_md(\'dishes\')\nprint(\'Found\', len(files), \'files\')\n\nrecipes = []\nfor i, f in enumerate(files):\n    raw = \'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/\' + f[\'path\']\n    try:\n        with urllib.request.urlopen(raw) as r:\n            txt = r.read().decode(\'utf-8\', errors=\'replace\')\n    except:\n        continue\n    m = re.search(r\'^# (.+)$\', txt, re.M)\n    title = m.group(1).strip() if m else \'Unknown\'\n    ing = []\n    sm = re.search(r\'(?:###|##)\\s*(?:用料|食材|材料).*?(?=\\n###|##|$)\', txt, re.S|re.I)\n    if sm:\n        for line in sm.group(0).split(\'\\\\n\'):\n            line = line.strip()\n            if not line.startswith(\'-\'): continue\n            line = line[1:].strip()\n            cm = re.match(r\'(.+?)\\s*[：:]\\s*(.+)\', line)\n            if not cm:\n                cm = re.match(r\'(.+?)\\s+([^\\d\\s]+[克个条片块粒颗只盘杯碗勺ml][^\\d]*?)(?=\\s+-|\\s+.*$)\', line)\n            if cm:\n                ing.append([cm.group(1).strip(), cm.group(2).strip()])\n    if ing:\n        recipes.append({\'name\': title, \'ingredients\': ing, \'path\': f[\'path\']})\n    if (i+1)%50==0: print(\'Processed\', i+1, \'/\', len(files))\n\nprint(\'Total recipes with ingredients:\', len(recipes))\nwith open(\'/app/recipes.json\',\'w\',encoding=\'utf-8\') as fo:\n    json.dump(recipes, fo, ensure_ascii=False, indent=2)\nprint(\'Done\')\n"\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
