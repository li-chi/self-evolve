Sending keys: ["cat > /tmp/parse_b.py << 'ENDSCRIPT'\nimport re\n\nwith open('/tmp/b_section.txt') as f:\n    lines = f.read().split('\\n')\n\ncourse_ids = []\nfor i, line in enumerate(lines):\n    m = re.match(r'^PTSS\\d{6}\\.\\d+$', line.strip())\n    if m:\n        course_ids.append((i, m.group(0)))\n\nprint(f'Found {len(course_ids)} course IDs')\nfor idx, cid in course_ids:\n    print(f'  Line {idx}: {cid}')\n\nfor ci, (idx, cid) in enumerate(course_ids):\n    start_line = 0 if ci == 0 else course_ids[ci-1][0] + 1\n    end_idx = course_ids[ci+1][0] if ci < len(course_ids)-1 else len(lines)\n    block_before = lines[start_line:idx]\n    block_after = lines[idx:end_idx]\n    \n    name = ''; credits = ''; instructor = ''; title = ''; times = []; campus = ''\n    \n    for bl in block_before:\n        bl = bl.strip()\n        if not bl: continue\n        if bl in ('邯郸校区', '江湾校区'): campus = bl; continue\n        if re.match(r'^\\d+ 思政B$', bl): continue\n        if not name and re.match(r'^[\\u4e00-\\u9fa5]+$', bl) and len(bl) <= 12: name = bl; continue\n        if not credits and re.match(r'^\\d+\\.?\\d*\\s+[\\u4e00-\\u9fa5]', bl):\n            parts = bl.split(None, 1); credits = parts[0]; instructor = parts[1] if len(parts) > 1 else ''; continue\n        if bl in ('教授', '副教授', '讲师', '助理研究员', '副研究员', '研究员', '青年副研究员'): title = bl; continue\n        if re.match(r'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[', bl): times.append(bl); continue\n    \n    assessment = ''; dept = ''\n    for bl in block_after:\n        bl = bl.strip()\n        if not bl: continue\n        if bl in ('开卷', '闭卷', '论文', '口试', '其他', '随堂考试'): assessment = bl; continue\n        if re.match(r'^[\\u4e00-\\u9fa5]{2,6}$', bl) and '马克思主义' not in bl: dept += bl; continue\n        if '马克思主义' in bl or bl == '院': dept += bl; continue\n        if bl in ('是',) or '考试日期' in bl or '考试时间' in bl or bl in ('邯郸校区', '江湾校区') or re.match(r'^\\d+$', bl): continue\n    \n    time_str = ' '.join(times) if times else ''\n    print(f'{cid}: Name={name} Time={time_str} Assess={assessment}')\nENDSCRIPT\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
