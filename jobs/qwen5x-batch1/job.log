Sending keys: ['python3 << \'PYEOF\'\n# Compute DiT-XL/2 parameters\n# XL config: N=28, d=1152, heads=16, patch=2, ImageNet 256x256\n# Input latent is from VAE: 256x256 / 8 = 32x32, with patch=2 => 16x16 = 256 tokens\n# Channels: 4 (from VAE latent)\n# DiT-XL/2 = 256 tokens + 1 class token = 257 tokens\n\nimport math\n\nd = 1152\nN = 28\nheads = 16\nnum_classes = 1000\nnum_tokens = 256 + 1  # 256 image tokens + 1 class token\n\nclass_embedding = num_classes * d  # class embedding projected to d\npatch_embedding = 4 * (2*2) * d  # patch embedding: 4 channels * 2x2 patch * hidden\ninput_embedding = d  # for each token, a d-dimensional projection\n\n# For each transformer layer:\nlayer_params = 0\n\n# Self-attention:\n# Q, K, V projections: 3 * (num_tokens) * d * d\nqkv_proj = 3 * num_tokens * d * d\n# Attention output projection: num_tokens * d * d\nattn_out = num_tokens * d * d\n\n# MLP:\n# Input projection: num_tokens * d * (4d)\nmlp_in = num_tokens * d * (4 * d)\n# Output projection: num_tokens * (4d) * d\nmlp_out = num_tokens * (4 * d) * d\n\nlayer_params = qkv_proj + attn_out + mlp_in + mlp_out\n\n# adaLN-Zero: 6 * d * d for each layer (6 projection matrices for modulating all layers)\nadaln_zero = 6 * d * d\n\n# Total per layer\nper_layer = layer_params + adaln_zero\n\n# N layers\ntotal = N * per_layer + class_embedding + patch_embedding + input_embedding\n\nprint(f"DiT-XL/2 parameter count: {total}")\nprint(f"DiT-XL/2 parameter count: {total/1e6:.2f}M")\nprint(f"DiT-XL/2 parameter count: {total/1e9:.3f}B")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
