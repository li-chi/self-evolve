\'Work Experience\']:\n                # Multi-line content\n                current_data[current_field] += \'\\n\' + text\n            else:\n                current_data[key] = val\n                current_field = key\n    \n    if current_name:\n        candidates[current_name] = current_data\n    \n    return candidates\n\n# ========== 2. Parse evaluations ==========\ndef parse_evaluations():\n    doc = Document(\'/app/Interviewer_evaluation.docx\')\n    evaluations = {}\n    \n    blocks = []\n    current_block = []\n    \n    for p in doc.paragraphs:\n        text = p.text.strip()\n        if text.startswith(\'Candidate \') and \'Name:\' in text:\n            if current_block:\n                blocks.append(\'\\n\'.join(current_block))\n            current_block = [text]\n        elif text:\n            current_block.append(text)\n    if current_block:\n        blocks.append(\'\\n\'.join(current_block))\n    \n    for block in blocks:\n        m = re.search(r\'Name:\\s*(.+)\', block)\n        if m:\n            name = m.group(1).strip()\n            evaluations[name] = block\n    \n    return evaluations\n\nresumes = parse_resumes()\nevaluations = parse_evaluations()\n\nprint("Parsed resume names:", list(resumes.keys()))\nprint("Parsed eval names:", list(evaluations.keys()))\n\n# ========== 3. Evaluate candidates ==========\ntop_universities = [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']\n\nALL_CRITERIA = [\n    \'experience_4plus\',\n    \'education_master_or_higher\',\n    \'top_tier_university\',\n    \'faang_experience\',\n    \'leadership_experience\',\n    \'high_impact_projects\',\n    \'advanced_tech_skills_3plus\',\n    \'recommendation_exceptional_outstanding\',\n    \'excellence_2plus\',\n    \'salary_under_150k\'\n]\n\ndef evaluate_candidate(name, resume, eval_text):\n    if not resume:\n        return {c: False for c in ALL_CRITERIA}, 0\n    \n    eval_lower = eval_text.lower() if eval_text else \'\'\n    proj_lower = resume.get(\'Project Experience\', \'\').lower()\n    work_lower = resume.get(\'Work Experience\', \'\').lower()\n    edu = resume.get(\'Education\', \'\')\n    skills_str = resume.get(\'Technical Skills\', \'\')\n    salary_str = resume.get(\'Expected Salary\', \'\')\n    \n    results = {}\n    \n    # 1. Min experience 4+ years\n    exp_match = re.search(r\'(\\d+)\\s+years\', resume.get(\'Work Experience\', \'\'))\n    results[\'experience_4plus\'] = int(exp_match.group(1)) >= 4 if exp_match else False\n    \n    # 2. Education: Master or higher\n    edu_lower = edu.lower()\n    results[\'education_master_or_higher\'] = \'master\' in edu_lower or \'phd\' in edu_lower or \'doctor\' in edu_lower\n    \n    # 3. Top-tier university\n    results[\'top_tier_university\'] = any(u in edu for u in top_universities)\n    \n    # 4. FAANG experience - companies mentioned in work experience\n    company_match = re.findall(r\'(?:previously\\s+(?:at|worked\\s+at)|currently\\s+at)\\s+([A-Za-z]+)\', resume.get(\'Work Experience\', \'\'), re.IGNORECASE)\n    faang_keywords = [\'google\', \'meta\', \'amazon\', \'netflix\', \'apple\', \'microsoft\', \'youtube\', \'instagram\']\n    results[\'faang_experience\'] = any(\n        any(fk in c.lower() for fk in faang_keywords) \n        for c in company_match\n    )\n    \n    # 5. Leadership experience\n    has_leadership = bool(re.search(r\'lead\', proj_lower)) or bool(re.search(r\'lead\', eval_lower))\n    results[\'leadership_experience\'] = has_leadership\n    \n    # 6. High-impact projects (quantified results)\n    results[\'high_impact_projects\'] = bool(re.search(r\'\\d+\\+|\\d+%\', proj_lower) or \'million\' in proj_lower or \'billion\' in proj_lower)\n    \n    # 7. 3+ technical skill areas\n    skills = [s.strip() for s in skills_str.split(\',\') if s.strip()]\n    results[\'advanced_tech_skills_3plus\'] = len(skills) >= 3\n    \n    # 8. Recommendation: Exceptional/Outstanding\n    results[\'recommendation_exceptional_outstanding\'] = \'exceptional\' in eval_lower or \'outstanding\' in eval_lower\n    \n    # 9. 2+ excellence mentions (exceptional + outstanding)\n    exc_count = eval_lower.count(\'exceptional\') + eval_lower.count(\'outstanding\')\n    results[\'excellence_2plus\'] = exc_count >= 2\n    \n    # 10. Salary under $150K\n    salary_match = re.search(r\'\\$(\\d+)[Kk]\', salary_str)\n    if salary_match:\n        results[\'salary_under_150k\'] = int(salary_match.group(1)) < 150\n    else:\n        # No dollar sign - CNY salaries or others, assume under $150K equivalent\n        results[\'salary_under_150k\'] = True\n    \n    score = sum(1 for v in results.values() if v)\n    percentage = int(round(score / len(ALL_CRITERIA) * 100))\n    \n    return results, percentage, score\n\nprint("\\n=== CANDIDATE EVALUATIONS ===")\nall_evals = {}\nfor name in resumes:\n    resume = resumes[name]\n    eval_text = evaluations.get(name, \'\')\n    results, percentage, score = evaluate_candidate(name, resume, eval_text)\n    all_evals[name] = {\'results\': results, \'percentage\': percentage, \'score\': score}\n    met = [k for k, v in results.items() if v]\n    print(f"\\n{name}:")\n    print(f"  Score: {score}/{len(ALL_CRITERIA)}, Percentage: {percentage}%")\n    print(f"  Met: {met}")\n\n# ========== 4. Find best candidate ==========\nbest_name = max(all_evals.keys(), key=lambda n: (all_evals[n][\'score\'], all_evals[n][\'percentage\']))\nprint(f"\\n=== BEST CANDIDATE: {best_name} ===")\n\nwith open(\'/app/recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f"Wrote recommend.txt with: {best_name}")\nPYEOF\npython3 /tmp/solve.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
