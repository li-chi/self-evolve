Sending keys: ['python3 << \'PYEOF\'\nimport re\n\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    lines = f.readlines()\n\n# Function to extract course details from a line\n# Format: CODE Name Credits Instructor Title Time Campus Seats Remark ExamTime ExamType Dept\ndef parse_course_line(line):\n    line = line.strip()\n    # Match course code\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', line)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    \n    result = {\'Course ID\': code, \'Course name\': \'\', \'Credits\': \'\', \'Instructor\': \'\', \n              \'Campus\': \'\', \'Class Time\': \'\', \'Enrollment\': \'\', \'Assessment Method\': \'\',\n              \'Exam Time\': \'\', \'Course Selection Restrictions\': \'\'}\n    \n    # Split by common patterns\n    # Credits is a number, instructor is name + title\n    # Time pattern: 一 2-3 [1-16]\n    # Campus: 邯郸校区/枫林校区/江湾校区/张江校区\n    \n    # Try to extract time\n    time_match = re.search(r\'(周一|周二|周三|周四|周五|周六|周日|一|二|三|四|五|六)\\s+(\\d+-\\d+(?:-,\\d+)*)\\s+(\\[[^\\]]+\\])\', rest)\n    \n    # Extract campus\n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    # Extract assessment method\n    assessment = \'\'\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'其他(作品展示)\', \'其他(实践报告)\',\n              \'其他(演奏)\', \'其他(电影评论)\', \'其他(舞蹈表演)\', \'其他(色彩绘画作品)\',\n              \'其他(人物头像写生)\', \'其他(表演片段)\', \'其他(电影评析)\', \'研讨型课程\',\n              \'视频教学\', \'随堂考试\', \'实验考核\', \'实践考核\']:\n        if a in rest:\n            assessment = a\n            break\n    \n    # Credits\n    credit_match = re.search(r\'(\\d)\\s+(?:位|教授|副教授|讲师|助理研究员|青年研究员|青年副研究员|研究员|教授\\(教学为主型\\)|高级工程师|工程师|主管技师|主任医师|副主任医师|副主任医师|副研究员|讲师|副教授\\(教学为主型\\))\', rest)\n    if not credit_match:\n        # Try another pattern: course name then credits number\n        credit_match = re.search(r\'^(.+?)\\s+(\\d)\\s+(教授|副教授|讲师|助理研究员|青年研究员|青年副研究员|研究员|副研究员|高级工程师|工程师|主管技师|主任医师|副主任医师|副主任医师|讲师)\', rest)\n    \n    # Let me try a different approach - parse character by character\n    parts = rest.split()\n    \n    instructor = \'\'\n    title = \'\'\n    course_name = \'\'\n    credits = \'\'\n    enrollment = \'\'\n    exam_time = \'\'\n    dept = \'\'\n    remark = \'\'\n    \n    # Find the position where time starts\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\', \'二\', \'三\', \'四\', \'五\', \'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    \n    if time_pos > 0:\n        # Before time_pos: code (already removed) + course_name + credits + instructor + title\n        before_time = parts[:time_pos]\n        # Find credits (a number)\n        credit_idx = -1\n        for k in range(len(before_time)-1, 0, -1):\n            if before_time[k].isdigit() and int(before_time[k]) <= 5:\n                credit_idx = k\n                break\n        \n        if credit_idx > 0:\n            course_name = \' \'.join(before_time[:credit_idx])\n            credits = before_time[credit_idx]\n            instructor_parts = before_time[credit_idx+1:]\n            if len(instructor_parts) >= 2:\n                instructor = instructor_parts[0]\n                title = \' \'.join(instructor_parts[1:])\n            elif len(instructor_parts) == 1:\n                instructor = instructor_parts[0]\n        elif time_pos == 1:\n            # Only code was before time, no name\n            course_name = \'\'\n            credits = \'\'\n    \n    # After time_pos\n    after_time_parts = parts[time_pos:]\n    # time_part[0]=day, [1]=timeslot, [2]=[weeks]\n    if len(after_time_parts) >= 3:\n        class_time = f"{after_time_parts[0]} {after_time_parts[1]} {after_time_parts[2]}"\n    else:\n        class_time = \'\'\n    \n    # Find campus in after_time\n    after_time_str = \' \'.join(after_time_parts)\n    \n    # Extract remaining info after campus\n    # Look for exam time and type\n    # Pattern: 邯郸校区 180 思政B 开卷 是\n    after_campus = re.sub(r\'(邯郸校区|枫林校区|江湾校区|张江校区)\', \'\', after_time_str).strip()\n    \n    return result, campus, course_name, credits, instructor, title, class_time, after_campus, rest\n\n# Test with known lines\ntest_lines = [\n    \'COMP130141.01 自然语言处理 2 黄萱菁 教授 一 2-3 [1-16] 邯郸校区 60 闭卷 大数据与人工智能(2023)\',\n    \'PTSS110080.01 中国共产党历史 2 薛小荣 副教授 一 11-12 [1-15] 邯郸校区 180 思政B 开卷 是\',\n    \'FINE110037.01 美学与人生 2 高燕 副教授 一 9-10 [1-16] 邯郸校区 60 上海市精品课程团队 开卷 艺术教育中心\',\n]\n\nfor tl in test_lines:\n    result, campus, name, credits, instructor, title, class_time, after_campus, rest = parse_course_line(tl)\n    print(f"\\n=== {tl} ===")\n    print(f"Name: {name}, Credits: {credits}, Instructor: {instructor} {title}")\n    print(f"Campus: {campus}, Time: {class_time}, After: {after_campus}")\nPYEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
