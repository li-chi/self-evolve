Sending keys: ['python3 << \'PYEOF\'\nimport openpyxl\nimport os\nimport re\nimport shutil\n\n# Read college mapping\nwb = openpyxl.load_workbook(\'/app/CollegeNameID.xlsx\')\nmapping = {}  # Name -> (ID, College)\nfor sheet_name in wb.sheetnames:\n    ws = wb[sheet_name]\n    for row in ws.iter_rows(min_row=2, max_row=ws.max_row, values_only=True):\n        name = row[0]\n        student_id = row[1]\n        college = row[2]\n        mapping[name] = (student_id, college)\n\nprint(f"Loaded {len(mapping)} student mappings")\n\n# Find all OS Assignment 3 files\nos_hw3_files = []\nall_files = []\n\nfor f in os.listdir(\'/app\'):\n    fpath = os.path.join(\'/app\', f)\n    if not os.path.isfile(fpath):\n        continue\n    if f.endswith(\'.tar.gz\'):\n        continue\n    if f.endswith(\'.xlsx\'):\n        continue\n    # Only process source files\n    if not any(f.endswith(ext) for ext in [\'.c\', \'.rs\', \'.py\']):\n        continue\n    all_files.append(f)\n    \n    fname_lower = f.lower()\n    # Match OS/OperatingSystems course files\n    has_os = bool(re.search(r\'(?:^|[-_])OS(?:[-_]|$)\', fname_lower)) or \'operatingsystems\' in fname_lower\n    if not has_os:\n        continue\n    \n    # Match Assignment 3 patterns (not Lab3, not Project3)\n    # HW3, Homework3, Assignment3\n    has_hw3 = bool(re.search(r\'(?:HW3|Homework3|Assignment3)\', fname_lower))\n    \n    if has_hw3:\n        os_hw3_files.append(f)\n\nprint(f"\\nTotal source files: {len(all_files)}")\nprint(f"OS Assignment 3 files found: {len(os_hw3_files)}")\nfor f in sorted(os_hw3_files):\n    print(f"  {f}")\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
