weekday and exam type on this line or nearby\n                wm = re.search(r\'([一二三四五六])\\s+(\\d+-\\d+)\\s+(\\[[^\\]]+\\])\', raw)\n                exam_type = \'\'\n                if \'开卷\' in raw: exam_type = \'开卷\'\n                elif \'闭卷\' in raw: exam_type = \'闭卷\'\n                elif \'论文\' in raw: exam_type = \'论文\'\n                elif \'其他\' in raw: exam_type = \'其他\'\n                \n                campus = \'\'\n                campus_m = re.search(r\'(邯郸校区|江湾校区|张江校区|枫林校区)\', raw)\n                if campus_m: campus = campus_m.group(1)\n                \n                department = \'\'\n                # Find department at end\n                dept_keywords = [\'马克思主义学院\', \'哲学学院\', \'中国语言文学系\', \n                               \'历史学系\', \'历史学系\', \'文物与博物馆学系\',\n                               \'国际文化交流学院\', \'计算机科学技术学院\', \'软件学院\',\n                               \'信息科学与工程学院\', \'航空航天系\', \'文学系\',\n                               \'文学院\', \'政治学\', \'法学院\', \'艺术学院\',\n                               \'经济\', \'管理\', \'生命科学学院\', \'环境科学\',\n                               \'物理学系\', \'化学系\', \'数学科学\', \'大气\', \'相辉\',\n                               \'新闻\', \'社会发展\', \'社会学\', \'公共管理\', \'外国语言\',\n                               \'艺术教育中心\', \'体育学院\', \'心理咨询\', \'大学外语\']\n                for dk in dept_keywords:\n                    if dk in raw:\n                        di = raw.rfind(dk)\n                        dept = raw[di:].strip()\n                        dept = re.sub(r\'\\s+$\', \'\', dept)\n                        department = dept\n                        break\n                \n                teacher = \'\'\n                t_m = re.search(r\'(教授|副教授|讲师|研究员|副研究员|高级工程师|青年研究员|助理研究员)\', raw)\n                if t_m:\n                    teacher = raw[:t_m.start()].strip()\n                    teacher = re.sub(r\'\\s+\\d+\\s+\', \' \', teacher).strip()\n                \n                weekday = wm.group(1) if wm else \'\'\n                time_range = wm.group(2) if wm else \'\'\n                weeks = wm.group(3) if wm else \'\'\n                \n                credits = m.group(3)\n                \n                # Get name - between cid and credits\n                name_match = re.search(r\'^\\s*([A-Z]{2,6}\\d{6}\\.\\d+)\\s+(.+?)\\s+(\\d+)\\s\', raw)\n                if name_match:\n                    name = name_match.group(2).strip()\n                    name = re.sub(r\'\\s+\\d+\\s+\', \' \', name).strip()\n                else:\n                    name = \'\'\n                \n                # Get exam date/time from next lines\n                exam_info = \'\'\n                for j in range(i+1, min(i+4, len(lines))):\n                    nline = lines[j].rstrip()\n                    ed = re.search(r\'考试日期:\\s*(\\d{4}-\\d{2}-\\d{2})\', nline)\n                    et = re.search(r\'考试时间:\\s*([^\\n]+)\', nline)\n                    if ed:\n                        exam_info += ed.group(1) + \' \'\n                    if et:\n                        exam_info += et.group(1).strip()\n                exam_info = exam_info.strip()\n                \n                if weekday == \'一\' and exam_type == \'开卷\':\n                    print(f"  {cid}: {name}, {credits}学分, {teacher}, {weekday}{time_range} {weeks}, {campus}, {exam_type}, 考试:{exam_info}, {department}")\n\nPYEOF\npython3 /app/parse_final.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
