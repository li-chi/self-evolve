Sending keys: ['python3 << \'PYEOF\'\nimport csv\n\nwith open(\'/app/new_law.txt\') as f:\n    new_law = f.read()\n\n# Define all substantive differences found\n# Format: (case_file, old_clause_desc, old_quoted_text, new_clause_desc, new_clause_text)\n\nresults = []\n\n# ============ CASE 1 ============\n# Citation: 物权法第20条第二款\n# Old: 预告登记后，债权消灭或者自能够进行不动产登记之日起三个月内未申请登记的，预告登记失效。\n# New (民法典221条第2款): 预告登记后，债权消灭或者自能够进行不动产登记之日起九十日内未申请登记的，预告登记失效。\n# Difference: "三个月" vs "九十日内" (different time period)\nresults.append([\n    "case1.pdf",\n    "《物权法》第20条（第2款）",\n    "预告登记后，债权消灭或者自能够进行不动产登记之日起三个月内未申请登记的，预告登记失效。",\n    "《民法典》第221条（第2款）",\n    "预告登记后，债权消灭或者自能够进行不动产登记之日起九十日内未申请登记的，预告登记失效。"\n])\n\n# Citation: 合同法第56条\n# Old: 无效的合同或者被撤销的合同自始没有法律约束力。合同部分无效，不影响其他部分效力的，其他部分仍然有效。\n# New (民法典155条): 无效的或者被撤销的民事法律行为自始没有法律约束力。\n# New (民法典156条): 民事法律行为部分无效，不影响其他部分效力的，其他部分仍然有效。\n# Difference: Scope expanded from "合同" (contracts) to "民事法律行为" (civil legal acts)\n\nresults.append([\n    "case1.pdf",\n    "《合同法》第56条",\n    "无效的合同或者被撤销的合同自始没有法律约束力。",\n    "《民法典》第155条",\n    "无效的或者被撤销的民事法律行为自始没有法律约束力。"\n])\n\nresults.append([\n    "case1.pdf",\n    "《合同法》第56条",\n    "合同部分无效，不影响其他部分效力的，其他部分仍然有效。",\n    "《民法典》第156条",\n    "民事法律行为部分无效，不影响其他部分效力的，其他部分仍然有效。"\n])\n\n# ============ CASE 2 ============\n# Citation: 物权法第29条\n# Old: 因继承或者受遗赠取得物权的，自继承或者受遗赠开始时发生效力。\n# New (民法典230条): 因继承取得物权的，自继承开始时发生效力。\n# Difference: "受遗赠" was removed - no longer covers acquiring property rights through legacy\nresults.append([\n    "case2.pdf",\n    "《物权法》第29条",\n    "因继承或者受遗赠取得物权的，自继承或者受遗赠开始时发生效力。",\n    "《民法典》第230条",\n    "因继承取得物权的，自继承开始时发生效力。"\n])\n\n# ============ CASE 3 ============\n# Citation: 合同法第106条\n# Old: 债权和债务同归于一人的，合同的权利义务终止，但涉及第三人利益的除外。\n# New (民法典576条): 债权和债务同归于一人的,债权债务终止,但是损害第三人利益的除外。\n# Difference: 1) "合同的权利义务终止" -> "债权债务终止"; 2) "涉及第三人利益" -> "损害第三人利益"\nresults.append([\n    "case3.pdf",\n    "《合同法》第106条",\n    "债权和债务同归于一人的，合同的权利义务终止，但涉及第三人利益的除外。",\n    "《民法典》第576条",\n    "债权和债务同归于一人的,债权债务终止,但是损害第三人利益的除外。"\n])\n\n# ============ CASE 4 ============\n# Citation: 合同法第215条\n# Old: 租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式的，视为不定期租赁。\n# New (民法典707条): 租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式，无法确定租赁期限的，视为不定期租赁。\n# Difference: New law adds condition "无法确定租赁期限的" before "视为不定期租赁"\nresults.append([\n    "case4.pdf",\n    "《合同法》第215条",\n    "租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式的，视为不定期租赁。",\n    "《民法典》第707条",\n    "租赁期限六个月以上的，应当采用书面形式。当事人未采用书面形式，无法确定租赁期限的，视为不定期租赁。"\n])\n\n# Citation: 合同法第232条\n# Old: 当事人对租赁期限没有约定或者约定不明确，依照本法第六十一条的规定仍不能确定的，视为不定期租赁。当事人可以随时解除合同，但出租人解除合同应当在合理期限之前通知承租人。\n# New (民法典730条): 当事人对租赁期限没有约定或者约定不明确，依据本法第五百一十条的规定仍不能确定的，视为不定期租赁；当事人可以随时解除合同，但是应当在合理期限之前通知对方。\n# Difference: "依照本法第六十一条的规定" -> "依据本法第五百一十条的规定"; "通知承租人" -> "通知对方" (bidirectional instead of only lessor notifying lessee)\nresults.append([\n    "case4.pdf",\n    "《合同法》第232条",\n    "当事人对租赁期限没有约定或者约定不明确，依照本法第六十一条的规定仍不能确定的，视为不定期租赁。当事人可以随时解除合同，但出租人解除合同应当在合理期限之前通知承租人。",\n    "《民法典》第730条",\n    "当事人对租赁期限没有约定或者约定不明确，依据本法第五百一十条的规定仍不能确定的，视为不定期租赁；当事人可以随时解除合同，但是应当在合理期限之前通知对方。"\n])\n\n# Citation: 合同法第235条\n# Old: 租赁期间届满，承租人应当返还租赁物。返还的租赁物应当符合按照约定或者租赁物的性质使用后的状态。\n# New (民法典733条): 租赁期限届满，承租人应当返还租赁物。返还的租赁物应当符合按照约定或者根据租赁物的性质使用后的状态。\n# This is essentially the same content (just 期间->期限, slight wording), NOT a substantive change\n# Skip this one as per task requirements\n\n# ============ CASE 5 ============\n# Citation: 婚姻法第7条\n# Old: 有下列情形之一的，禁止结婚：（一）直系血亲和三代以内的旁系血亲；（二）患有医学上认为不应当结婚的疾病。\n# New (民法典1048条): 直系血亲或者三代以内的旁系血亲禁止结婚。\n# Difference: Removed the disease prohibition condition; changed "和" to "或者"\nresults.append([\n    "case5.pdf",\n    "《婚姻法》第7条",\n    "有下列情形之一的，禁止结婚：（一）直系血亲和三代以内的旁系血亲；（二）患有医学上认为不应当结婚的疾病。",\n    "《民法典》第1048条",\n    "直系血亲或者三代以内的旁系血亲禁止结婚。"\n])\n\n# Citation: 婚姻法第10条\n# Old: 有下列情形之一的，婚姻无效：（一）重婚的；（二）有禁止结婚的亲属关系的；（三）婚前患有医学上认为不应当结婚的疾病，婚后尚未治愈的；（四）未到法定婚龄的。\n# Wait, the judgment says: "（一）重婚的；（二）有禁止结婚的亲属关系的；……"\n# Let me check what 婚姻法第10条 actually said\n# 婚姻法第10条: "有下列情形之一的，婚姻无效：（一）重婚的；（二）有禁止结婚的亲属关系的；（三）婚前患有医学上认为不应当结婚的疾病，婚后尚未治愈的；（四）未到法定婚龄的。"\n# New (民法典1051条): "有下列情形之一的，婚姻无效：（一）重婚；（二）有禁止结婚的亲属关系；（三）未到法定婚龄。"\n# Difference: Removed disease ground; added age ground (repositioned);\nresults.append([\n    "case5.pdf",\n    "《婚姻法》第10条",\n    "有下列情形之一的，婚姻无效：（一）重婚的；（二）有禁止结婚的亲属关系的；（三）婚前患有医学上认为不应当结婚的疾病，婚后尚未治愈的；（四）未到法定婚龄的。",\n    "《民法典》第1051条",\n    "有下列情形之一的，婚姻无效：（一）重婚；（二）有禁止结婚的亲属关系；（三）未到法定婚龄。"\n])\n\n# Citation: 婚姻法第12条\n# Old: 无效或被撤销的婚姻，自始无效。当事人不具有夫妻的权利和义务。同居期间所得的财产，由当事人协议处理；协议不成时，由人民法院根据照顾无财产一方的原则判决。对重婚导致的婚姻无效的财产处理，不得侵害合法婚姻当事人的财产权益。当事人所生的子女，适用本法有关父母子女的规定。\n# New (民法典1054条): "无效的或者被撤销的婚姻自始没有法律约束力，当事人不具有夫妻的权利和义务。同居期间所得的财产，由当事人协议处理；协议不成的，由人民法院根据照顾无过错方的原则判决。对重婚导致的无效婚姻的财产处理，不得侵害合法婚姻当事人的财产权益。当事人所生子女，适用本法关于父母子女的规定。婚姻无效或者被撤销的，无过错方有权请求损害赔偿。"\n# Difference: 1) "自始无效" -> "自始没有法律约束力"; 2) "照顾无财产一方的原则" -> "照顾无过错方的原则"; 3) Added damages right for non-fault party\nresults.append([\n    "case5.pdf",\n    "《婚姻法》第12条",\n    "无效或被撤销的婚姻，自始无效。当事人不具有夫妻的权利和义务。同居期间所得的财产，由当事人协议处理；协议不成时，由人民法院根据照顾无财产一方的原则判决。对重婚导致的婚姻无效的财产处理，不得侵害合法婚姻当事人的财产权益。当事人所生的子女，适用本法有关父母子女的规定。",\n    "《民法典》第1054条",\n    "无效的或者被撤销的婚姻自始没有法律约束力，当事人不具有夫妻的权利和义务。同居期间所得的财产，由当事人协议处理；协议不成的，由人民法院根据照顾无过错方的原则判决。对重婚导致的无效婚姻的财产处理，不得侵害合法婚姻当事人的财产权益。当事人所生子女，适用本法关于父母子女的规定。婚姻无效或者被撤销的，无过错方有权请求损害赔偿。"\n])\n\n# Write CSV\nwith open(\'/app/revised_terms.csv\', \'w\', newline=\'\', encoding=\'utf-8\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'案件文件名称\', \'判决文书中的原始条款\', \'原始引用内容\', \'新法条款\', \'新法条款内容\'])\n    for row in results:\n        writer.writerow(row)\n\nprint(f"Written {len(results)} rows to revised_terms.csv")\n\n# Verify\nwith open(\'/app/revised_terms.csv\', \'r\', encoding=\'utf-8\') as f:\n    print(f.read())\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
