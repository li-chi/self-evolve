artswith(\'* \'):\n            raw = line.lstrip(\'-* \').strip()\n        else:\n            continue\n        # Handle range quantities like "尖椒 3 - 4 个"\n        # Pattern: name NUMBER - NUMBER unit\n        m = re.match(r\'(.+?)\\s+\\d+\\s*[-–—]\\s*\\d+\\s*([\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z]+)\', raw)\n        if m:\n            name_raw = m.group(1).strip()\n            qty = \' \'.join(m.group(0).split()[1:]).strip()\n            ingredients.append((name_raw, qty))\n            continue\n        # Normal pattern: name quantity\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s*=\\s*(.+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s+(\\d+.+)\', raw)\n        if m:\n            name_raw = m.group(1).strip()\n            qty = m.group(2).strip() if len(m.groups()) > 1 else \'\'\n            ingredients.append((name_raw, qty))\n    return ingredients\n\ndef parse_recipe(fpath):\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except:\n        return None\n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            name = m.group(1).strip()\n            break\n    if not name:\n        return None\n    name = re.sub(r\'\\s*(的?)做法\\s*$\', \'\', name).strip()\n    name = re.sub(r\'^\\d+\\s*\', \'\', name).strip()\n    ingredients = parse_all_ingredients(\n        re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE).group(1)\n        if re.search(r\'## 计算\', content, re.DOTALL | re.MULTILINE) else \'\'\n    )\n    if not ingredients:\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    for sep in [\'(\', \'（\']:\n                        if sep in raw: raw = raw[:raw.index(sep)].strip()\n                    ingredients.append((clean_raw(raw), \'\'))\n    if not ingredients:\n        return None\n    return {\'name\': name, \'all_ingredients\': ingredients}\n\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in sorted(files):\n        if not fname.endswith(\'.md\'): continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result: recipes.append(result)\n\ncandidates = []\nfor r in recipes:\n    norm_dict = {}\n    for orig, qty in r[\'all_ingredients\']:\n        norm = normalize_ingredient(orig)\n        if norm and norm in available_names:\n            norm_dict[norm] = qty\n    matched = list(norm_dict.keys())\n    total = len(r[\'all_ingredients\'])\n    ratio = len(matched) / total if total > 0 else 0\n    if len(matched) >= 2:\n        candidates.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': norm_dict,\n            \'all_ings\': r[\'all_ingredients\'],\n            \'matched\': matched,\n            \'total\': total,\n            \'ratio\': ratio\n        })\n\ncandidates.sort(key=lambda x: (-len(x[\'matched\']), -x[\'ratio\'], x[\'name\']))\n\n# Select 3 diverse dishes\nselected_names = [\'炒滑蛋\', \'地三鲜\', \'瘦肉土豆片\']\nselected = [c for c in candidates if c[\'name\'] in selected_names]\n\nprint("=== Final Selection ===")\nfor s in selected:\n    print(f"\\n{s[\'name\']} ({len(s[\'matched\'])}/{s[\'total\']} = {s[\'ratio\']:.0%})")\n    for orig, qty in s[\'all_ings\']:\n        norm = normalize_ingredient(orig)\n        status = \'STOCK\' if (norm and norm in available_names) else \'BUY\'\n        print(f"  [{status}] {orig}: {qty}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    ing_dict = {}\n    for orig, qty in s[\'all_ings\']:\n        key = normalize_ingredient(orig) if normalize_ingredient(orig) else orig\n        if key not in ing_dict:\n            ing_dict[key] = qty\n    for k, v in ing_dict.items():\n        dish["ingredients"][k] = v\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list\nshopping = []\nfor s in selected:\n    for orig, qty in s[\'all_ings\']:\n        norm = normalize_ingredient(orig)\n        if not norm or norm not in available_names:\n            name = orig\n            q = qty.strip() if qty else \'\'\n            if q:\n                shopping.append({\'Name\': name, \'Quantity\': q})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nfor item in shopping:\n    print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
