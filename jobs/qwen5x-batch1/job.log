Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport os\nimport openpyxl\nimport re\nimport shutil\n\n# 1. Read the correspondence table\nwb = openpyxl.load_workbook(\'/app/CollegeNameID.xlsx\')\nws = wb.active\ndata = {}\nheader = None\nfor row in ws.iter_rows(values_only=True):\n    if header is None:\n        header = row\n        continue\n    name, student_id, college = row\n    data[name] = {\'id\': str(student_id), \'college\': college}\n\nprint(f"Loaded {len(data)} students")\nfor name, info in data.items():\n    print(f"  {name} -> {info[\'college\']}-{info[\'id\']}")\n\n# 2. Find all OS Assignment 3 files in /app\nos_hw3_files = []\nworkspace = \'/app\'\nfor fname in os.listdir(workspace):\n    fpath = os.path.join(workspace, fname)\n    if not os.path.isfile(fpath):\n        continue\n    # Skip non-code files (xlsx, tar.gz, directories)\n    if not fname.endswith((\'.c\', \'.rs\', \'.py\')):\n        continue\n    \n    fname_lower = fname.lower()\n    \n    # Check if it\'s an Operating Systems file\n    is_os = False\n    os_patterns = [\'operatingsystems\', \'os\']\n    for p in os_patterns:\n        # Match OperatingSystems or standalone OS (with word boundaries)\n        if p == \'os\':\n            # Match OS as a standalone part, not as part of another word\n            # Use regex with word boundaries\n            if re.search(r\'(?<![a-zA-Z])OS(?=[^a-zA-Z]|$)\', fname_lower):\n                is_os = True\n                break\n        else:\n            if p in fname_lower:\n                is_os = True\n                break\n    \n    if not is_os:\n        continue\n    \n    # Check if it\'s Assignment 3 (HW3 or Homework3 or Assignment3)\n    # But NOT Lab3 or Project3\n    is_hw3 = False\n    \n    # Must NOT contain lab or project (case insensitive)\n    if \'lab\' in fname_lower or \'project\' in fname_lower:\n        continue\n    \n    # Check for Assignment3, HW3, Homework3 patterns\n    if re.search(r\'(?<![a-zA-Z])Assignment3\', fname_lower):\n        is_hw3 = True\n    elif re.search(r\'(?<![a-zA-Z])HW3\', fname_lower):\n        is_hw3 = True\n    elif re.search(r\'(?<![a-zA-Z])Homework3\', fname_lower):\n        is_hw3 = True\n    \n    if is_hw3:\n        os_hw3_files.append(fname)\n        print(f"OS HW3 file: {fname}")\n\nprint(f"\\nTotal OS HW3 files found: {len(os_hw3_files)}")\n\n# 3. Rename and organize\n# Create directories\nos.makedirs(\'/app/os_hw3/C\', exist_ok=True)\nos.makedirs(\'/app/os_hw3/Rust\', exist_ok=True)\nos.makedirs(\'/app/os_hw3/Python\', exist_ok=True)\n\nrenamed_files = []\n\nfor fname in os_hw3_files:\n    # Extract student name from filename\n    # Patterns: "Name-OS..." or "Name_OS..."\n    # Name is the part before the first - or _ that isn\'t part of the course\n    \n    # Split on - or _ to get name and rest\n    # Find the first separator after the name\n    parts = re.split(r\'[-_]\', fname, 1)\n    student_name = parts[0].strip()\n    \n    if student_name not in data:\n        print(f"WARNING: Could not find student {student_name} in mapping")\n        continue\n    \n    info = data[student_name]\n    new_name = f"{student_name}-{info[\'college\']}-{info[\'id\']}-OS-HW3"\n    \n    # Determine file extension\n    if fname.endswith(\'.c\'):\n        ext = \'.c\'\n    elif fname.endswith(\'.rs\'):\n        ext = \'.rs\'\n    elif fname.endswith(\'.py\'):\n        ext = \'.py\'\n    else:\n        ext = \'\'\n    \n    new_full_name = new_name + ext\n    \n    # Determine target subdirectory\n    if fname.endswith(\'.c\'):\n        subdir = \'/app/os_hw3/C\'\n    elif fname.endswith(\'.rs\'):\n        subdir = \'/app/os_hw3/Rust\'\n    elif fname.endswith(\'.py\'):\n        subdir = \'/app/os_hw3/Python\'\n    else:\n        subdir = \'/app/os_hw3/C\'\n    \n    src = os.path.join(workspace, fname)\n    dst = os.path.join(subdir, new_full_name)\n    \n    shutil.move(src, dst)\n    renamed_files.append((fname, new_full_name, subdir))\n    print(f"  Renamed: {fname} -> {new_full_name}")\n\n# 4. Delete all remaining original code files\nprint("\\nDeleting all remaining original code files...")\ncount = 0\nfor fname in os.listdir(workspace):\n    fpath = os.path.join(workspace, fname)\n    if not os.path.isfile(fpath):\n        continue\n    if fname.endswith((\'.c\', \'.rs\', \'.py\')):\n        print(f"  Deleting: {fname}")\n        os.remove(fpath)\n        count += 1\n    elif fname.endswith(\'.tar.gz\') or fname.endswith(\'.xlsx\'):\n        print(f"  Deleting: {fname}")\n        os.remove(fpath)\n        count += 1\n\nprint(f"Deleted {count} files")\n\n# 5. Verify\nprint("\\n=== Final state ===")\nfor root, dirs, files in os.walk(\'/app\'):\n    level = root.replace(\'/app\', \'\').count(os.sep)\n    indent = \' \' * 2 * level\n    print(f"{indent}{os.path.basename(root)}/")\n    subindent = \' \' * 2 * (level + 1)\n    for file in sorted(files):\n        print(f"{subindent}{file}")\n\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
