Sending keys: ['cat > /tmp/final_check.py << \'PYEOF\'\nimport re\n\ntex_files = [\n    \'/app/my_paper/sections/1_introduction.tex\',\n    \'/app/my_paper/sections/2_scenarios.tex\',\n    \'/app/my_paper/sections/3_advanced.tex\',\n    \'/app/my_paper/sections/4_evaluation.tex\',\n    \'/app/my_paper/sections/5_tradeoff.tex\',\n    \'/app/my_paper/sections/conclusion.tex\',\n    \'/app/my_paper/appendix/learning-effort.tex\',\n]\n\n# Read bib keys directly from file\nbib_keys = set()\nwith open(\'/app/my_paper/colm2024_conference.bib\') as f:\n    for line in f:\n        m = re.match(r\'^@[a-zA-Z]+\\{([^,]+),\', line)\n        if m:\n            bib_keys.add(m.group(1).strip())\n\n# Read labels from all tex files\nall_labels = set()\nfor tf in tex_files:\n    with open(tf) as f:\n        content = f.read()\n    for m in re.finditer(r\'\\\\label\\{([^}]+)\\}\', content):\n        all_labels.add(m.group(1))\n\nerrors = []\nfor tf in tex_files:\n    with open(tf) as f:\n        content = f.read()\n        lines = content.split(\'\\n\')\n    for i, line in enumerate(lines, 1):\n        # Check empty cite/citep\n        for m in re.finditer(r\'(?<!\\\\\\\\)(cite|citep)\\{\\}\', line):\n            errors.append(f\'{tf}:{i}: empty {m.group()}\')\n        # Check empty ref/autoref\n        if re.search(r\'\\\\ref\\{\\}\', line) and \'cite\' not in line.split(\'\\\\ref\')[0].split(\'\\n\')[-1]:\n            pass  # handle below\n        for m in re.finditer(r\'(?<!\\\\\\\\)(S\\\\)?ref\\{\\}\', line):\n            errors.append(f\'{tf}:{i}: empty \\{m.group()}\n\')\n        for m in re.finditer(r\'\\\\autoref\\{\\}\', line):\n            errors.append(f\'{tf}:{i}: empty \\autoref{}\')\n        # Check known broken label\n        if \'fig:call-api-v0\' in line:\n            errors.append(f\'{tf}:{i}: still has fig:call-api-v0\')\n        if \'autoref{tab:1}\' in line:\n            errors.append(f\'{tf}:{i}: still has autoref{tab:1}\')\n    # Check all cite keys\n    for m in re.finditer(r\'(?<!\\\\\\\\)(cite|citep)\\{([^}]+)\\}\', content):\n        for key in m.group(2).split(\',\'):\n            key = key.strip()\n            if key and key not in bib_keys:\n                errors.append(f\'{tf}: unknown cite key "{key}"\')\n    # Check all ref labels\n    for m in re.finditer(r\'\\\\(S\\\\)?ref\\{([^}]+)\\}\', content):\n        label = m.group(2)\n        if label and label not in all_labels:\n            errors.append(f\'{tf}: unknown label "{label}"\')\n    for m in re.finditer(r\'\\\\autoref\\{([^}]+)\\}\', content):\n        label = m.group(1)\n        if label and label not in all_labels:\n            errors.append(f\'{tf}: unknown label "{label}"\')\n\nif errors:\n    for e in errors:\n        print(e)\n    print(f\'\\nTotal errors: {len(errors)}\')\nelse:\n    print(\'All checks passed! No issues found.\')\n    print(f\'Bib keys: {len(bib_keys)}, Labels: {len(all_labels)}\')\nPYEOF\npython3 /tmp/final_check.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
