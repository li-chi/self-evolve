 f.write('Name,Quantity\\n')\n    for item in shopping_items:\n        f.write(item[0] + ',' + item[1] + '\\n')\n\nprint('shopping.csv written')\nprint('Total missing items: ' + str(len(shopping_items)))\nENDSCRIPT\npython3 /app/generate_output.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
