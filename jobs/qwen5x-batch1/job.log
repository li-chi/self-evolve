Sending keys: ['cat > /app/find_recipes.py << \'PYEOF\'\nimport os\nimport re\nimport json\nimport csv\n\n# Available ingredients\navailable = {\n    \'鸡蛋\': \'2个\',\n    \'土豆\': \'100g\',\n    \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\',\n    \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\',\n    \'牛奶\': \'30ml\',\n    \'干辣椒\': \'50g\',\n}\n\navail_names = list(available.keys())\n\n# Map of ingredient variations to canonical names\ningredient_variants = {\n    \'鸡蛋\': [\'鸡蛋\', \'蛋\'],\n    \'土豆\': [\'土豆\', \'马铃薯\'],\n    \'茄子\': [\'茄子\'],\n    \'蒜苗\': [\'蒜苗\', \'蒜苔\'],\n    \'冬瓜\': [\'冬瓜\'],\n    \'瘦猪肉片\': [\'瘦猪肉片\', \'瘦猪肉\', \'猪肉片\'],\n    \'五花肉\': [\'五花肉\'],\n    \'牛奶\': [\'牛奶\'],\n    \'干辣椒\': [\'干辣椒\', \'干红辣椒\'],\n}\n\nreverse_map = {}\nfor canonical, variants in ingredient_variants.items():\n    for v in variants:\n        reverse_map[v] = canonical\n\ndef extract_dish_name(filepath):\n    """Extract dish name from filepath."""\n    parts = filepath.split(\'/\')\n    for part in parts:\n        if part.endswith(\'.md\'):\n            return part[:-3]\n    return \'unknown\'\n\ndef parse_ingredients(content):\n    """Parse ingredients from the ## 计算 section."""\n    in_jisuan = False\n    ingredients = []\n    for line in content.split(\'\\n\'):\n        stripped = line.strip()\n        if stripped.startswith(\'## 计算\'):\n            in_jisuan = True\n            continue\n        if in_jisuan and stripped.startswith(\'## \'):\n            break\n        if in_jisuan and stripped.startswith(\'#\'):\n            break\n        if in_jisuan and stripped.startswith(\'##\'):\n            break\n        if in_jisuan and (stripped.startswith(\'- \') or stripped.startswith(\'* \')):\n            item = stripped.lstrip(\'- * \')\n            # Match patterns like: 冬瓜 300 g, 五花肉 0.5 斤, 鸡蛋 2个\n            match = re.match(r\'(.+?)\\s+(\\d+\\s*[,，\\.]\\s*\\d*|\\d+)\\s*(\\S+)?\', item)\n            if match:\n                name = match.group(1).strip()\n                amount_raw = match.group(2).strip()\n                unit = match.group(3) if match.group(3) else \'\'\n                # Clean amount\n                amount_raw = amount_raw.replace(\'，\', \',\').replace(\'，\', \',\')\n                ingredients.append((name, f"{amount_raw} {unit}".strip()))\n            else:\n                # No amount found, just ingredient name\n                if name:\n                    ingredients.append((item, \'\'))\n    return ingredients\n\ndef normalize_name(name):\n    """Check if name matches any available ingredient."""\n    name = name.strip()\n    if name in reverse_map:\n        return reverse_map[name], name\n    # Try partial match\n    for av in avail_names:\n        if av in name or name in av:\n            return av, name\n    return None, name\n\n# Parse all recipes\nrecipe_dir = \'/app/HowToCook/dishes\'\nrecipes = []\n\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if f.endswith(\'.md\') and \'示例菜\' not in root and \'template\' not in root:\n            filepath = os.path.join(root, f)\n            try:\n                with open(filepath, \'r\', encoding=\'utf-8\') as fh:\n                    content = fh.read()\n            except:\n                continue\n            \n            dish_name = extract_dish_name(filepath)\n            ingredients = parse_ingredients(content)\n            \n            # Score matching ingredients\n            matched = []\n            for ing_name, ing_amount in ingredients:\n                can_name, _ = normalize_name(ing_name)\n                if can_name and can_name in available:\n                    matched.append((can_name, ing_name, ing_amount))\n            \n            if matched:\n                recipes.append({\n                    \'name\': dish_name,\n                    \'path\': filepath,\n                    \'matched\': matched,\n                    \'match_count\': len(matched),\n                    \'match_names\': [m[0] for m in matched],\n                    \'all_ingredients\': [(n, a) for n, a in ingredients],\n                })\n\n# Sort by match count (descending)\nrecipes.sort(key=lambda x: x[\'match_count\'], reverse=True)\n\nprint("Top matching recipes:")\nfor i, r in enumerate(recipes[:20]):\n    print(f"\\n{i+1}. {r[\'name\']} ({r[\'match_count\']} matches)")\n    print(f"   Matched: {r[\'match_names\']}")\n    print(f"   Ingredients: {[(n, a) for n, a in r[\'all_ingredients\']]}")\n\nprint(f"\\nTotal recipes parsed: {len(recipes)}")\nPYEOF\npython3 /app/find_recipes.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
