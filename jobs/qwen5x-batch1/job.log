Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport openpyxl\nimport pandas as pd\nfrom collections import OrderedDict\n\nwb = openpyxl.load_workbook(\'/app/Market_Data.xlsx\')\n\n# ---- Parse Methodology sheet ----\nmethod_ws = wb[\'Methodology\']\n\n# Row 2: Segment/Source header, row 2 cols B onwards = source names\n# Row 3: source types (CDP, S&P, etc)\n# Rows 4-13: segments with weights\n# Column A = segment name, Column B = source name\n# Remaining columns: source columns with weights\n\n# Get source names from Methodology row 2, columns B onwards\nmethod_source_names = []\nfor col in range(2, method_ws.max_column + 1):  # col 2=B\n    val = method_ws.cell(row=2, column=col).value\n    if val is not None:\n        method_source_names.append(val)\nprint("Methodology sources:", method_source_names)\n\n# Get segments and their weights\n# Column A has segment names, Column B has source name, remaining cols have weights\nsegments = OrderedDict()\nfor row in range(4, method_ws.max_row + 1):\n    seg_name = method_ws.cell(row=row, column=1).value\n    src_name = method_ws.cell(row=row, column=2).value\n    if seg_name is None or src_name is None:\n        continue\n    if seg_name == \'Total\':\n        continue\n    if seg_name not in segments:\n        segments[seg_name] = {}\n    # Get weights from remaining columns\n    for col in range(3, method_ws.max_column + 1):\n        weight = method_ws.cell(row=row, column=col).value\n        if weight is not None and weight != 0:\n            segments[seg_name][method_source_names[col - 2]] = float(weight)\n\nprint("Segments and their sources:")\nfor seg, srcs in segments.items():\n    print(f"  {seg}: {srcs}")\n\n# ---- Parse RawData sheet ----\nraw_ws = wb[\'RawData\']\n\n# Find the row with source names (YY header row)\nsource_col_names = []\ndata_start_row = None\nfor row in range(1, raw_ws.max_row + 1):\n    first_cell = raw_ws.cell(row=row, column=1).value\n    if first_cell == \'YY\':\n        data_start_row = row\n        # Get source names from this row (col 2 onwards)\n        for col in range(2, raw_ws.max_column + 1):\n            val = raw_ws.cell(row=row, column=col).value\n            source_col_names.append(val)\n        break\n\nprint("\\nRawData source names:", source_col_names)\nprint(f"Data starts at row: {data_start_row}")\n\n# Read data from data_start_row+1 onwards\nsource_data = {}  # {source_name: {year: value}}\nfor src in source_col_names:\n    source_data[src] = {}\n\nfor row in range(data_start_row + 1, raw_ws.max_row + 1):\n    year_cell = raw_ws.cell(row=row, column=1).value\n    if year_cell is None or not isinstance(year_cell, (int, float)):\n        continue\n    year = int(year_cell)\n    for col in range(2, raw_ws.max_column + 1):\n        src = source_col_names[col - 2]\n        val = raw_ws.cell(row=row, column=col).value\n        # Handle string values (formulas) - treat as None\n        if val is None or isinstance(val, str):\n            val = None\n        else:\n            try:\n                val = float(val)\n            except (ValueError, TypeError):\n                val = None\n        source_data[src][year] = val\n\n# Print sample data\nfor src in source_col_names[:5]:\n    print(f"\\n{src}:")\n    for year in sorted(source_data[src].keys()):\n        print(f"  {year}: {source_data[src][year]}")\n\n# ---- Calculate YoY growth rates ----\n# Growth rate = (current - prev) / prev * 100\n# Only if both current and previous exist and prev != 0\ngrowth_rates = {}  # {source_name: {year: growth_rate_pct}}\n\nfor src in source_col_names:\n    growth_rates[src] = {}\n    years = sorted(source_data[src].keys())\n    for i in range(1, len(years)):\n        curr_year = years[i]\n        prev_year = years[i - 1]\n        curr_val = source_data[src][curr_year]\n        prev_val = source_data[src][prev_year]\n        if curr_val is not None and prev_val is not None and prev_val != 0:\n            gr = (curr_val - prev_val) / prev_val * 100\n            growth_rates[src][curr_year] = gr\n\n# Print growth rates for key sources\nprint("\\nGrowth rates for Agriculture (first few):")\nfor year in sorted(growth_rates[\'Agriculture\'].keys()):\n    print(f"  {year}: {growth_rates[\'Agriculture\'][year]:.4f}%")\n\nprint("\\nGrowth rates for Auto Production:")\nfor year in sorted(growth_rates[\'Auto Production\'].keys()):\n    print(f"  {year}: {growth_rates[\'Auto Production\'][year]:.4f}%")\n\nprint("\\nGrowth rates for Air Bus:")\nfor year in sorted(growth_rates[\'Air Bus\'].keys()):\n    print(f"  {year}: {growth_rates[\'Air Bus\'][year]:.4f}%")\n\nprint("\\nGrowth rates for Steel Production:")\nfor year in sorted(growth_rates[\'Steel Production\'].keys()):\n    print(f"  {year}: {growth_rates[\'Steel Production\'][year]:.4f}%")\n\nprint("\\nGrowth rates for MRO:")\nfor year in sorted(growth_rates[\'MRO\'].keys()):\n    print(f"  {year}: {growth_rates[\'MRO\'][year]:.4f}%")\n\n# ---- Calculate segment growth rates ----\n# Years to output: 2015 to 2024\nyears = list(range(2015, 2025))\nsegment_order = list(segments.keys())  # same order as in Methodology\n\nresults = {\'Year\': years}\n\nfor seg in segment_order:\n    results[seg] = []\n    for year in years:\n        source_grs = []\n        all_valid = True\n        for src, weight in segments[seg].items():\n            if src not in growth_rates:\n                all_valid = False\n                break\n            if year not in growth_rates[src]:\n                all_valid = False\n                break\n            source_grs.append((weight, growth_rates[src][year]))\n        \n        if not all_valid:\n            results[seg].append(\'N/A\')\n        else:\n            weighted_sum = sum(w * gr for w, gr in source_grs)\n            results[seg].append(round(weighted_sum, 1))\n\nprint("\\n\\nFinal Results:")\nfor seg in segment_order:\n    print(f"\\n{seg}:")\n    for year in years:\n        print(f"  {year}: {results[seg][years.index(year)]}")\n\n# ---- Save to Excel ----\ndf = pd.DataFrame(results)\ndf.to_excel(\'/app/segment_growth_rates.xlsx\', index=False)\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
