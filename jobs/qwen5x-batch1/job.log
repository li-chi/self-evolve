Sending keys: ['cat > /app/generate_reports.py << \'SCRIPTEOF\'\nimport docx\nfrom docx import Document\nfrom docx.shared import Inches, Pt, Cm, RGBColor, Emu\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\nfrom copy import deepcopy\nimport re\n\n# ========== PARSE CANDIDATES ==========\ndef parse_candidates():\n    doc = docx.Document(\'/app/Candidates_resumes.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    # Split by "Candidate N:" sections\n    # Pattern: "Candidate N:\\nName: ..."\n    candidate_blocks = re.split(r\'(?=Candidate \\d+:)\', full_text)\n    \n    candidates = []\n    for block in candidate_blocks:\n        block = block.strip()\n        if not block or \'Name:\' not in block:\n            continue\n        # Parse name\n        name_match = re.search(r\'Name:\\s*(.+?)(?:\\n|$)\', block)\n        if not name_match:\n            continue\n        name = name_match.group(1).strip()\n        candidates.append(name)\n    \n    return candidates\n\n# ========== PARSE EVALUATIONS ==========\ndef parse_evaluations():\n    doc = docx.Document(\'/app/Interviewer_evaluation.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    # Split by "Candidate N Name: ..." sections\n    eval_sections = re.split(r\'(?=Candidate \\d+ Name:)\', full_text)\n    \n    evaluations = {}\n    for section in eval_sections:\n        section = section.strip()\n        if not section:\n            continue\n        name_match = re.search(r\'Candidate \\d+ Name:\\s*(.+)\', section)\n        if not name_match:\n            continue\n        name = name_match.group(1).strip()\n        # Remove the name line\n        eval_text = section[len(name_match.group(0)):].strip()\n        evaluations[name] = eval_text\n    \n    return evaluations\n\n# ========== PARSE REQUIREMENTS & EVALUATE ==========\ndef parse_requirements():\n    with open(\'/app/Requirement.txt\', \'r\') as f:\n        return f.read()\n\ndef evaluate_candidate(name, resume_text, eval_text):\n    reqs = {\n        \'resumes\': [],\n        \'evaluations\': [],\n        \'names\': [],\n        \'resumes_raw\': {},\n        \'evaluations_raw\': {}\n    }\n    return reqs\n\ndef evaluate_candidate(name, resume_text, eval_text):\n    """Evaluate candidate against 10 requirements. Returns (score, details)"""\n    score = 0\n    details = []\n    \n    r_lower = resume_text.lower()\n    e_lower = eval_text.lower()\n    \n    # 1. Minimum Experience: 4+ years\n    exp_match = re.search(r\'(\\d+)\\s*years?\', r_lower)\n    if exp_match and int(exp_match.group(1)) >= 4:\n        score += 1\n        details.append("Experience: 4+ years - MET")\n    else:\n        exp_val = exp_match.group(1) if exp_match else "unknown"\n        details.append(f"Experience: {exp_val} years - NOT MET")\n    \n    # 2. Education: Master degree or higher\n    edu_lower = r_lower\n    if \'master\' in edu_lower or \'phd\' in edu_lower or \'doctorate\' in edu_lower:\n        score += 1\n        details.append("Education: Master or higher - MET")\n    else:\n        details.append("Education: Master or higher - NOT MET")\n    \n    # 3. Top-tier University: Stanford, MIT, CMU, Peking, Tsinghua\n    top_tier = [\'stanford\', \'mit\', \'cmu\', \'peking\', \'tsinghua\']\n    found_tier = False\n    for uni in top_tier:\n        if uni in edu_lower:\n            found_tier = True\n            break\n    if found_tier:\n        score += 1\n        details.append("Top-tier University - MET")\n    else:\n        details.append("Top-tier University - NOT MET")\n    \n    # 4. FAANG Experience: Google, Meta (Facebook), Apple, Netflix, Amazon\n    faang = [\'google\', \'meta\', \'facebook\', \'apple\', \'amazon\', \'netflix\', \'microsoft\']\n    found_fang = False\n    # Also check company names in context of work experience\n    work_match = re.search(r\'Work Experience:\\s*.*?(?:Technical Skills:|$)\', r_lower, re.DOTALL)\n    if work_match:\n        work_text = work_match.group(0)\n        for company in faang:\n            if company in work_text:\n                found_fang = True\n                break\n    if found_fang:\n        score += 1\n        details.append("FAANG Experience - MET")\n    else:\n        details.append("FAANG Experience - NOT MET")\n    \n    # 5. Leadership Experience\n    leadership_words = [\'led\', \'lead\', \'leadership\', \'managed\', \'directed\', \'architected\']\n    found_lead = False\n    for word in leadership_words:\n        if word in r_lower or word in e_lower:\n            found_lead = True\n            break\n    if found_lead:\n        score += 1\n        details.append("Leadership Experience - MET")\n    else:\n        details.append("Leadership Experience - NOT MET")\n    \n    # 6. High-impact Projects (projects with measurable impact)\n    impact_words = [\'users\', \'revenue\', \'latency\', \'engagement\', \'downloads\', \'uptime\', \'vulnerabilities\', \'cost\']\n    found_impact = False\n    if \'Project Experience\' in resume_text or \'project experience\' in r_lower:\n        proj_section = re.search(r\'Project Experience:\\s*.*?(?:Contact:|$)\', r_lower, re.DOTALL)\n        if proj_section:\n            proj_text = proj_section.group(0)\n            for word in impact_words:\n                if word in proj_text:\n                    found_impact = True\n                    break\n    if found_impact:\n        score += 1\n        details.append("High-impact Projects - MET")\n    else:\n        details.append("High-impact Projects - NOT MET")\n    \n    # 7. Advanced Technical Skills: 3+ areas\n    skills_match = re.search(r\'Technical Skills:\\s*(.+)\', r_lower)\n    if skills_match:\n        skills_str = skills_match.group(1)\n        skills = [s.strip() for s in skills_str.split(\',\') if s.strip()]\n        if len(skills) >= 3:\n            score += 1\n            details.append(f"Technical Skills: {len(skills)} areas - MET")\n        else:\n            details.append(f"Technical Skills: {len(skills)} areas - NOT MET")\n    else:\n        details.append("Technical Skills: Not found - NOT MET")\n    \n    # 8. Recommendation Level: Exceptional/Outstanding only\n    eval_lower = eval_text.lower()\n    if \'exceptional\' in eval_lower or \'outstanding\' in eval_lower:\n        score += 1\n        details.append("Recommendation: Exceptional/Outstanding - MET")\n    else:\n        details.append("Recommendation: Exceptional/Outstanding - NOT MET")\n    \n    # 9. Excellence Rating: 2+ excellence mentions\n    excellent_count = 0\n    if eval_lower.count(\'excellent\') >= 2:\n        excellent_count += eval_lower.count(\'excellent\')\n    if eval_lower.count(\'exceptional\') >= 1:\n        excellent_count += eval_lower.count(\'exceptional\')\n    if eval_lower.count(\'outstanding\') >= 1:\n        excellent_count += eval_lower.count(\'outstanding\')\n    if excellent_count >= 2:\n        score += 1\n        details.append(f"Excellence mentions: {excellent_count} - MET")\n    else:\n        details.append(f"Excellence mentions: {excellent_count} - NOT MET")\n    \n    # 10. Salary Budget: Under $150K\n    salary_match = re.search(r\'(?:\\$?)(\\d+)[Kk]?\\s*[-–]\\s*(\\d+)[Kk]?\', r_lower)\n    if salary_match:\n        salary_upper = int(salary_match.group(2))\n        if salary_upper < 150:\n            score += 1\n            details.append(f"Salary: Under $150K - MET")\n        else:\n            details.append(f"Salary: ${salary_upper}K - NOT MET")\n    else:\n        # Check for other salary formats\n        cny_match = re.search(r\'(\\d+)K\\s*-\\s*(\\d+)K\\s*CNY\', r_lower)\n        if cny_match:\n            # Convert CNY to approximate USD (roughly 7:1)\n            cny_upper = int(cny_match.group(2))\n            usd_upper = cny_upper * 7 / 10  # approximate\n            if usd_upper < 150:\n                score += 1\n                details.append(f"Salary: Under $150K (CNY converted) - MET")\n            else:\n                details.append(f"Salary: Over $150K - NOT MET")\n        else:\n            salary_usd = re.search(r\'(\\$?)(\\d+)K\\s*-\\s*(\\d+)K\', r_lower)\n            if salary_usd:\n                sal_upper = int(salary_usd.group(3))\n                if sal_upper < 150:\n                    score += 1\n                    details.append(f"Salary: Under $150K - MET")\n                else:\n                    details.append(f"Salary: ${sal_upper}K - NOT MET")\n            else:\n                details.append("Salary: Unknown - NOT MET")\n    \n    return score, details\n\n\n# ========== EXTRACT CANDIDATE RESUME TEXT ==========\ndef extract_resume_text(doc_path, candidate_name):\n    doc = docx.Document(doc_path)\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    # Find candidate section\n    pattern = f\'Name:\\s*{re.escape(candidate_name)}\'\n    match = re.search(pattern, full_text, re.IGNORECASE)\n    if not match:\n        return \'\'\n    \n    start = match.start()\n    # Find next candidate section or end\n    next_pattern = f\'Name:\\s*(?!{re.escape(candidate_name)})\'\n    next_match = re.search(next_pattern, full_text[start+1:])\n    if next_match:\n        end = start + 1 + next_match.start()\n    else:\n        end = len(full_text)\n    \n    return full_text[start:end].strip()\n\n\n# ========== EXTRACT EVALUATION TEXT ==========\ndef extract_eval_text(doc_path, candidate_name):\n    doc = docx.Document(doc_path)\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    \n    # Find candidate section\n    pattern = f\'Name:\\s*{re.escape(candidate_name)}\'\n    match = re.search(pattern, full_text, re.IGNORECASE)\n    if not match:\n        return \'\'\n    \n    start = match.start()\n    # Find next candidate section or end\n    next_pattern = f\'Name:\\s*(?!{re.escape(candidate_name)})\'\n    next_match = re.search(next_pattern, full_text[start+1:])\n    if next_match:\n        end = start + 1 + next_match.start()\n    else:\n        end = len(full_text)\n    \n    return full_text[start:end].strip()\n\n\n# ========== CREATE WORD DOCUMENT ==========\ndef set_cell_shading(cell, color_hex):\n    """Set cell background color"""\n    shading_elm = cell._element.get_or_add_tcPr()\n    shd = shading_elm.makeelement(qn(\'w:shd\'), {\n        qn(\'w:fill\'): color_hex,\n        qn(\'w:val\'): \'clear\'\n    })\n    shading_elm.append(shd)\n\ndef create_assessment_report(candidates_data, output_dir=\'/app\'):\n    """Generate assessment report for a candidate"""\n    doc = Document()\n    \n    name = candidates_data[\'name\']\n    resume_text = candidates_data[\'resume_text\']\n    eval_text = candidates_data[\'eval_text\']\n    score = candidates_data[\'score\']\n    score_pct = int(score * 100 // 10)\n    is_best = candidates_data[\'is_best\']\n    \n    # 1. First-level Heading: "Candidate Interview Assessment Report"\n    heading = doc.add_heading(\'Candidate Interview Assessment Report\', level=0)\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    for run in heading.runs:\n        run.font.name = \'Calibri\'\n        run.font.size = Pt(14)\n        run.font.bold = True\n    \n    # 2. Candidate Name paragraph\n    name_para = doc.add_paragraph()\n    name_run = name_para.add_run(f\'Candidate Name: {name}\')\n    name_run.font.name = \'Cambria\'\n    name_run.font.size = Pt(11)\n    \n    # 3. Candidate Information section\n    section1_title = doc.add_paragraph()\n    title_run1 = section1_title.add_run(\'Candidate Information:\')\n    title_run1.font.name = \'Cambria\'\n    title_run1.font.size = Pt(11)\n    title_run1.bold = True\n    \n    # Resume content - clean it up\n    clean_resume = resume_text.strip()\n    resume_para = doc.add_paragraph()\n    resume_run = resume_para.add_run(clean_resume)\n    resume_run.font.name = \'Cambria\'\n    resume_run.font.size = Pt(11)\n    \n    # 4. Interviewer Evaluation section\n    section2_title = doc.add_paragraph()\n    title_run2 = section2_title.add_run(\'Interviewer Evaluation:\')\n    title_run2.font.name = \'Cambria\'\n    title_run2.font.size = Pt(11)\n    title_run2.bold = True\n    \n    clean_eval = eval_text.strip()\n    eval_para = doc.add_paragraph()\n    eval_run = eval_para.add_run(clean_eval)\n    eval_run.font.name = \'Cambria\'\n    eval_run.font.size = Pt(11)\n    \n    # 5. Evaluation Conclusion section with table\n    section3_title = doc.add_paragraph()\n    title_run3 = section3_title.add_run(\'Evaluation Conclusion:\')\n    title_run3.font.name = \'Cambria\'\n    title_run3.font.size = Pt(11)\n    title_run3.bold = True\n    \n    # Create 2x2 table\n    table = doc.add_table(rows=2, cols=2)\n    table.style = \'Table Grid\'\n    \n    # Header row (D9D9D9)\n    header_cells = table.rows[0].cells\n    header_cells[0].text = \'Overall Assessment\'\n    header_cells[1].text = \'Recommendation\'\n    set_cell_shading(header_cells[0], \'D9D9D9\')\n    set_cell_shading(header_cells[1], \'D9D9D9\')\n    \n    # Data row (DAEEF3)\n    data_cells = table.rows[1].cells\n    if is_best:\n        data_cells[0].text = f\'{score_pct}%\'\n        data_cells[1].text = \'Best match\'\n    else:\n        data_cells[0].text = f\'{score_pct}%\'\n        data_cells[1].text = \'Not recommended\'\n    set_cell_shading(data_cells[0], \'DAEEF3\')\n    set_cell_shading(data_cells[1], \'DAEEF3\')\n    \n    # Format table cells\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                for run in paragraph.runs:\n                    run.font.name = \'Cambria\'\n                    run.font.size = Pt(11)\n            # Set vertical alignment to top\n            tc = cell._element\n            tcPr = tc.get_or_add_tcPr()\n            tcPr.set(qn(\'w:vAlign\'), \'top\')\n    \n    # Save document\n    filename = f\'Interview_Assessment_Report_{name}.docx\'\n    output_path = f\'{output_dir}/{filename}\'\n    doc.save(output_path)\n    return output_path\n\n\ndef main():\n    # Parse candidates\n    candidate_names = parse_candidates()\n    print(f"Found {len(candidate_names)} candidates: {candidate_names}")\n    \n    # Parse evaluations\n    evaluations = parse_evaluations()\n    print(f"Found {len(evaluations)} evaluations")\n    \n    # Extract resume texts\n    candidates_data = []\n    for name in candidate_names:\n        resume_text = extract_resume_text(\'/app/Candidates_resumes.docx\', name)\n        eval_text = evaluations.get(name, \'\')\n        \n        score, details = evaluate_candidate(name, resume_text, eval_text)\n        candidates_data.append({\n            \'name\': name,\n            \'resume_text\': resume_text,\n            \'eval_text\': eval_text,\n            \'score\': score / 10,\n            \'raw_score\': score,\n            \'details\': details\n        })\n        print(f"\\n{name}: {score}/10")\n        for d in details:\n            print(f"  {d}")\n    \n    # Find best candidate\n    best = max(candidates_data, key=lambda c: c[\'raw_score\'])\n    print(f"\\nBest candidate: {best[\'name\']} ({best[\'raw_score\']}/10)")\n    \n    # Mark best candidate\n    for c in candidates_data:\n        c[\'is_best\'] = (c[\'name\'] == best[\'name\'])\n    \n    # Create documents\n    for c in candidates_data:\n        output_path = create_assessment_report(c)\n        print(f"Created: {output_path}")\n    \n    # Create recommend.txt\n    with open(\'/app/recommend.txt\', \'w\') as f:\n        f.write(best[\'name\'])\n    print(f"\\nCreated recommend.txt with: {best[\'name\']}")\n\nif __name__ == \'__main__\':\n    main()\nSCRIPTEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
