Sending keys: ['cat > /app/final_gen.py << \'PYEOF\'\nimport re\nimport openpyxl\nfrom openpyxl import Workbook\nimport os\n\ntitles = [\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'青年研究员\', \'青年副研究员\', \n          \'研究员\', \'副研究员\', \'高级工程师\', \'工程师\', \'主管技师\',\n          \'主任医师\', \'副主任医师\', \'教授(教学为主型)\', \'副教授(教学为主型)\', \'实验师\']\n\ndef is_title(word):\n    return word in titles\n\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    lines = f.readlines()\n\ndef parse_course_line(line):\n    line = line.strip()\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', line)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    parts = rest.split()\n    \n    # Find time position\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\',\'二\',\'三\',\'四\',\'五\',\'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    if time_pos <= 0:\n        return {\'Course ID\': code}\n    \n    before_time = parts[:time_pos]  # code(name removed) + name + credits + instructor\n    # Find instructor (word that matches a title)\n    instructor_pos = -1\n    for j in range(len(before_time)-1, -1, -1):\n        if is_title(before_time[j]):\n            instructor_pos = j\n            break\n    \n    if instructor_pos <= 0:\n        return {\'Course ID\': code}\n    \n    instructor = before_time[instructor_pos]\n    title = before_time[instructor_pos+1] if instructor_pos+1 < len(before_time) else \'\'\n    \n    # Between title/credits and instructor\n    # Credits is a number before the instructor\n    credits = \'\'\n    credits_pos = -1\n    for j in range(instructor_pos-1, 0, -1):\n        if before_time[j].isdigit() and int(before_time[j]) <= 5:\n            credits_pos = j\n            credits = before_time[j]\n            break\n    \n    course_name = \' \'.join(before_time[1:credits_pos]) if credits_pos > 1 else \'\'\n    \n    # If no name found, look at previous lines for continuation\n    if not course_name:\n        for pl in lines[max(0, lines.index(line)-5):lines.index(line)]:\n            pl = pl.strip()\n            if not pl:\n                continue\n            if pl.startswith(\'考试日期:\'):\n                continue\n            # Extract trailing Chinese text from the line\n            m_trail = re.search(r\'([\\u4e00-\\u9fff][\\u4e00-\\u9fff\\d\\（）《》，。！？、·-]*)\', pl)\n            if m_trail:\n                course_name = m_trail.group(1)\n                break\n    \n    # Parse after time\n    after_parts = parts[time_pos:]\n    class_time = \' \'.join(after_parts[:3])\n    \n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    enrollment = \'\'\n    cm = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n    if cm:\n        enrollment = cm.group(1)\n    \n    assessment = \'\'\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in rest:\n            assessment = a\n            break\n    \n    exam_time = \'\'\n    em = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n    if em:\n        exam_time = em.group(1)\n    \n    restrictions = \'\'\n    after_rest = rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_rest:\n            idx = after_rest.find(a)\n            after_rest = after_rest[idx+len(a):]\n            break\n    restrictions = after_rest.strip()\n    \n    return {\n        \'Course name\': course_name,\n        \'Course ID\': code,\n        \'Instructor\': instructor,\n        \'Campus\': campus,\n        \'Class Time\': class_time,\n        \'Enrollment\': enrollment,\n        \'Credits\': credits,\n        \'Assessment Method\': assessment,\n        \'Exam Time\': exam_time,\n        \'Course Selection Restrictions\': restrictions,\n        \'_day\': parts[time_pos],\n        \'_time\': parts[time_pos+1]\n    }\n\n# Fixed courses\nfixed = [\n    parse_course_line(\'COMP130141.01 自然语言处理 2 黄萱菁 教授 一 2-3 [1-16] 邯郸校区 60 闭卷 大数据与人工智能(2023)\'),\n    parse_course_line(\'COMP130025.01 软件体系结构 2 陈彤兵 讲师 一 4-5 [1-16] 邯郸校区 50 闭卷 23 22 计算机科学与技术\'),\n    parse_course_line(\'PTSS110080.01 中国共产党历史 2 薛小荣 副教授 一 11-12 [1-15] 邯郸校区 180 思政B 开卷 是\'),\n]\n\n# Extract tongren courses\ntongren_entries = []\nin_tongren = False\n\nfor i, line in enumerate(lines):\n    line_num = i + 1\n    if line_num >= 1059:\n        in_tongren = True\n    if line_num >= 6038:\n        in_tongren = False\n    if not in_tongren:\n        continue\n    \n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n    if not m:\n        continue\n    \n    parsed = parse_course_line(line)\n    if parsed and parsed.get(\'Class Time\'):\n        dm = re.search(r\'(一)\\s+(\\d+-\\d+)\\s+\\[\', line)\n        if dm and \'开卷\' in line and \'思政\' not in line and \'半开卷\' not in line:\n            tongren_entries.append(parsed)\n\nprint(f"Fixed: {len(fixed)}")\nfor f in fixed:\n    print(f"  {f[\'Course name\']} [{f[\'Course ID\']}] - {f[\'Class Time\']}")\n\nprint(f"\\nOptions: {len(tongren_entries)}")\nfor i, t in enumerate(tongren_entries):\n    print(f"  {i+1}. {t[\'Course name\']} [{t[\'Course ID\']}] - {t[\'Class Time\']} - {t[\'Assessment Method\']}")\n\n# Check conflicts\nfixed_times = [(f[\'_day\'], f[\'_time\']) for f in fixed]\ndef has_conflict(d1, t1, d2, t2):\n    if d1 != d2: return False\n    m1 = re.match(r\'(\\d+)-(\\d+)\', t1)\n    m2 = re.match(r\'(\\d+)-(\\d+)\', t2)\n    if m1 and m2:\n        return int(m1.group(1)) <= int(m2.group(2)) and int(m2.group(1)) <= int(m1.group(2))\n    return False\n\nvalid = [o for o in tongren_entries if not any(has_conflict(o[\'_day\'], o[\'_time\'], d, t) for d, t in fixed_times)]\nprint(f"\\nValid: {len(valid)}")\nfor i, v in enumerate(valid):\n    print(f"  {i+1}. {v[\'Course name\']} [{v[\'Course ID\']}] - {v[\'Class Time\']}")\n\n# Create Excel\nfields = [\'Course name\',\'Course ID\',\'Instructor\',\'Campus\',\'Class Time\',\'Enrollment\',\'Credits\',\'Assessment Method\',\'Exam Time\',\'Course Selection Restrictions\']\n\nfor idx, opt in enumerate(valid):\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'Sheet1\'\n    for ci, field in enumerate(fields, 1):\n        ws.cell(row=1, column=ci, value=field)\n    for ri, course in enumerate(fixed + [opt], 2):\n        for ci, field in enumerate(fields, 1):\n            val = course.get(field, \'\')\n            ws.cell(row=ri, column=ci, value=val if val is not None else \'\')\n    wb.save(f\'/app/scheme_{idx+1}.xlsx\')\n    print(f"Saved scheme_{idx+1}.xlsx")\n\n# Cleanup\nfor f in [\'/app/pdf_text.txt\', \'/app/search_nlp.txt\', \'/app/extract.py\', \'/app/generate.py\', \'/app/generate2.py\', \'/app/generate3.py\', \'/app/final_gen.py\']:\n    if os.path.exists(f): os.remove(f)\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
