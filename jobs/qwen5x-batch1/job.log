Sending keys: ['python3 << \'PYEOF\'\nimport openpyxl\n\n# Load nutrition data\nwb = openpyxl.load_workbook(\'/app/Nutrition.xlsx\')\nws = wb[\'Sheet1\']\n\nnutrition = {}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    if row[0]:\n        name = row[0]\n        carbs_100 = row[1]  # g per 100g\n        prot_100 = row[2]\n        nutrition[name] = {\'carbs\': carbs_100, \'protein\': prot_100}\n\n# Helper to calculate nutrients from ingredients\ndef calc_nutrients(ingredients):\n    total_carbs = 0.0\n    total_protein = 0.0\n    for name, amount_g in ingredients:\n        info = nutrition.get(name)\n        if info:\n            total_carbs += amount_g * info[\'carbs\'] / 100.0\n            total_protein += amount_g * info[\'protein\'] / 100.0\n        else:\n            print(f"  WARNING: Ingredient \'{name}\' not found in nutrition table")\n    return total_carbs, total_protein\n\nprint("=== 西红柿炒鸡蛋 (1 portion) ===")\n# Recipe: 西红柿=1个(约180g), 鸡蛋=1.5向上取整=2个(50g each), 食用油=4ml*鸡蛋个=8ml\n# 盐=1.5-2g(平均1.75g), 糖=0-2g(平均1g), 葱花=0-10g(平均5g)\ningredients_1 = [\n    (\'西红柿\', 180),\n    (\'鸡蛋\', 100),  # 2 * 50g\n    (\'植物油\', 8 * 0.92),  # 8ml * 0.92g/ml\n    (\'盐\', 1.75),  # avg of 1.5-2\n    (\'白砂糖\', 1),  # avg of 0-2\n    (\'葱花\', 5),  # avg of 0-10\n]\nc1, p1 = calc_nutrients(ingredients_1)\nprint(f"  Carbs: {c1:.1f}g, Protein: {p1:.1f}g")\nfor name, amt in ingredients_1:\n    info = nutrition.get(name)\n    if info:\n        c = amt * info[\'carbs\'] / 100\n        pr = amt * info[\'protein\'] / 100\n        print(f"    {name}: {amt:.1f}g -> carbs={c:.2f}g, protein={pr:.2f}g")\n\nprint("\\n=== 荔枝肉 (1 portion) ===")\ningredients_2 = [\n    (\'鲜香菇\', 30),    # 2朵, 1朵约15g\n    (\'蟹味菇\', 30),\n    (\'瘦肉（猪肉）\', 150),\n    (\'凤梨（菠萝）\', 100),\n    (\'鸡蛋\', 50),      # 1个\n    (\'植物油\', 500 * 0.92),  # 500ml * 0.92g/ml\n    (\'白砂糖\', 5),\n    (\'淀粉\', 100),\n    (\'生抽\', 5 * 1.15),   # 5ml * 1.15g/ml\n    (\'鸡精\', 5),\n    (\'姜\', 5),\n    (\'芝麻\', 2),\n    (\'番茄酱\', 20),\n    (\'香醋\', 2 * 1.05),   # 2ml * 1.05g/ml\n]\nc2, p2 = calc_nutrients(ingredients_2)\nprint(f"  Carbs: {c2:.1f}g, Protein: {p2:.1f}g")\nfor name, amt in ingredients_2:\n    info = nutrition.get(name)\n    if info:\n        c = amt * info[\'carbs\'] / 100\n        pr = amt * info[\'protein\'] / 100\n        print(f"    {name}: {amt:.1f}g -> carbs={c:.2f}g, protein={pr:.2f}g")\n\nprint("\\n=== 葱油桂鱼 (1 portion, recipe is for 2 portions) ===")\ningredients_3 = [\n    (\'桂鱼\', 250),    # 500g / 2份 = 250g per portion\n    (\'小葱\', 10),     # 1根约10g\n    (\'小米辣\', 6),    # 2个, 1个约3g\n    (\'姜\', 50),\n    (\'料酒\', 25),     # 25g as listed\n    (\'植物油\', 15),   # 15g as listed\n    (\'盐\', 8),\n    (\'蒸鱼豉油\', 10), # 10g as listed\n]\nc3, p3 = calc_nutrients(ingredients_3)\nprint(f"  Carbs: {c3:.1f}g, Protein: {p3:.1f}g")\nfor name, amt in ingredients_3:\n    info = nutrition.get(name)\n    if info:\n        c = amt * info[\'carbs\'] / 100\n        pr = amt * info[\'protein\'] / 100\n        print(f"    {name}: {amt:.1f}g -> carbs={c:.2f}g, protein={pr:.2f}g")\n\n# Grand totals\ntotal_carbs = c1 + c2 + c3\ntotal_protein = p1 + p2 + p3\nprint(f"\\n=== TOTALS ===")\nprint(f"Total Carbs: {total_carbs:.1f}g")\nprint(f"Total Protein: {total_protein:.1f}g")\n\n# Health calculations\nweight = 65\n# BMI = 65 / (1.52^2) = 28.13 > 28, so obese adjustments apply\n# Training day: carbs 2.4-2.7 g/kg, protein 1.2 g/kg (BMI>28)\n# Rest day: reduce carbs by 0.5g/kg -> 1.9-2.2 g/kg\ncarb_low = 1.9 * weight  # 123.5\ncarb_high = 2.2 * weight  # 143.0\nprotein_target = 1.2 * weight  # 78.0\n\nprint(f"\\n=== EXPECTED (Male, Initial Fat Loss, Rest Day, BMI>28) ===")\nprint(f"Carbs: {carb_low}g - {carb_high}g")\nprint(f"Protein: {protein_target}g")\n\n# Assessment\n# Protein has +/-10g tolerance: effective range 68-88\ncarb_lower = carb_low\ncarb_upper = carb_high\nprot_lower = protein_target - 10  # 68\nprot_upper = protein_target + 10  # 88\n\n# Carbs assessment\ncarb_95 = 0.95 * carb_lower\ncarb_105 = 1.05 * carb_upper\nif total_carbs < carb_95:\n    carb_assessment = "Below expectations"\nelif total_carbs > carb_105:\n    carb_assessment = "Excessive intake"\nelse:\n    carb_assessment = "Meets expectations"\n\n# Protein assessment\nprot_95 = 0.95 * prot_lower\nprot_105 = 1.05 * prot_upper\nif total_protein < prot_95:\n    prot_assessment = "Below expectations"\nelif total_protein > prot_105:\n    prot_assessment = "Excessive intake"\nelse:\n    prot_assessment = "Meets expectations"\n\nprint(f"\\n=== ASSESSMENT ===")\nprint(f"Carbs: {carb_assessment} ({total_carbs:.1f}g vs {carb_lower}g-{carb_high}g)")\nprint(f"  95% of lower: {carb_95}, 105% of upper: {carb_105}")\nprint(f"Protein: {prot_assessment} ({total_protein:.1f}g vs {protein_target}g)")\nprint(f"  Range with tolerance: {prot_lower}-{prot_upper}g")\nprint(f"  95% of lower: {prot_95}, 105% of upper: {prot_105}")\n\nPYEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
