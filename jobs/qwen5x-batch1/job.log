Sending keys: ['cat > /app/generate_reports.py << \'PYEOF\'\nimport re\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn, nsdecls\nfrom docx.oxml import parse_xml\n\ndef parse_resumes():\n    doc = Document(\'/app/Candidates_resumes.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    candidates = {}\n    parts = re.split(r\'Candidate \\d+:\', full_text)\n    for i, part in enumerate(parts[1:], 1):\n        lines = part.strip().split(\'\\n\')\n        name = None\n        data = {\'Technical Skills List\': [], \'Projects\': []}\n        for line in lines:\n            line = line.strip()\n            if not line:\n                continue\n            if line.startswith(\'Name:\'):\n                name = line[5:].strip()\n            elif line.startswith(\'Gender:\'):\n                data[\'Gender\'] = line[7:].strip()\n            elif line.startswith(\'Age:\'):\n                data[\'Age\'] = line[4:].strip()\n            elif line.startswith(\'Education:\'):\n                data[\'Education\'] = line[10:].strip()\n            elif line.startswith(\'Work Experience:\'):\n                data[\'Work Experience\'] = line[18:].strip()\n            elif line.startswith(\'Technical Skills:\'):\n                data[\'Technical Skills\'] = line[17:].strip()\n                data[\'Technical Skills List\'] = [s.strip() for s in line[17:].split(\',\') if s.strip()]\n            elif line.startswith(\'Project Experience:\'):\n                data[\'Project Experience\'] = \'\'\n            elif line.startswith(\'- \'):\n                data[\'Project Experience\'] += line + \'\\n\'\n                data[\'Projects\'].append(line[2:])\n            elif line.startswith(\'Contact:\'):\n                data[\'Contact\'] = line[8:].strip()\n            elif line.startswith(\'Expected Salary:\'):\n                data[\'Expected Salary\'] = line[16:].strip()\n        if name:\n            candidates[name] = data\n    return candidates\n\ndef parse_evaluations():\n    doc = Document(\'/app/Interviewer_evaluation.docx\')\n    full_text = \'\\n\'.join([p.text for p in doc.paragraphs])\n    evals = {}\n    parts = re.split(r\'Candidate \\d+ Name:\\s*\', full_text)\n    for part in parts[1:]:\n        lines = part.strip().split(\'\\n\')\n        name = lines[0].strip()\n        data = {}\n        in_key = None\n        value_lines = []\n        for line in lines:\n            ls = line.strip()\n            if not ls:\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                    value_lines = []\n                    in_key = None\n                continue\n            if ls.startswith(\'Interviewer Evaluation:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = None\n                continue\n            elif ls.startswith(\'Interviewer:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Interviewer\'\n                value_lines = [ls[10:].strip()]\n            elif ls.startswith(\'Interview Time:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Interview Time\'\n                value_lines = [ls[13:].strip()]\n            elif ls.startswith(\'Position:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Position\'\n                value_lines = [ls[9:].strip()]\n            elif ls.startswith(\'Technical Assessment:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Technical Assessment\'\n                value_lines = []\n            elif ls.startswith(\'Soft Skills Assessment:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Soft Skills Assessment\'\n                value_lines = []\n            elif ls.startswith(\'Overall Impression:\'):\n                if in_key and value_lines:\n                    data[in_key] = \'\\n\'.join(value_lines)\n                in_key = \'Overall Impression\'\n                value_lines = []\n            else:\n                if in_key:\n                    value_lines.append(ls)\n        if in_key and value_lines:\n            data[in_key] = \'\\n\'.join(value_lines)\n        evals[name] = data\n    return evals\n\ndef evaluate_candidate(name, resume, interview):\n    c = []\n    exp_text = resume.get(\'Work Experience\', \'\').lower()\n    exp_match = re.search(r\'(\\d+)\\s*years?\', exp_text)\n    exp_y = int(exp_match.group(1)) if exp_match else 0\n    c.append(exp_y >= 4)\n    edu = resume.get(\'Education\', \'\').lower()\n    c.append(\'master\' in edu or \'phd\' in edu or \'doctor\' in edu)\n    edu_text = resume.get(\'Education\', \'\')\n    c.append(any(t in edu_text for t in [\'Stanford\',\'MIT\',\'CMU\',\'Peking\',\'Tsinghua\']))\n    work = resume.get(\'Work Experience\', \'\')\n    c.append(any(f in work for f in [\'Google\',\'Meta\',\'Amazon\',\'Apple\',\'Netflix\',\'Microsoft\']))\n    resume_full = resume.get(\'Project Experience\', \'\') + \' \' + resume.get(\'Work Experience\', \'\')\n    c.append(bool(re.search(r\'\\bled\\b|managed |led development|led security|led research|led cloud|led ui\', resume_full, re.IGNORECASE)))\n    projects = resume.get(\'Project Experience\', \'\').lower()\n    c.append(any([\n        \'vulnerabilities\' in projects, \'100m\' in projects,\n        \'millions\' in projects, \'99.9\' in projects,\n        \'billion\' in projects, \'revenue\' in projects,\n        \'increasing\' in projects,\n    ]))\n    skills_list = resume.get(\'Technical Skills List\', [])\n    c.append(len(skills_list) >= 3)\n    if interview:\n        eval_text = str(interview).lower()\n        c.append(\'exceptional\' in eval_text or \'outstanding\' in eval_text)\n    else:\n        c.append(False)\n    if interview:\n        eval_text = str(interview).lower()\n        c.append(eval_text.count(\'excell\') >= 2)\n    else:\n        c.append(False)\n    salary = resume.get(\'Expected Salary\', \'\')\n    usd_m = re.search(r\'\\$(\\d+)K-\\$(\\d+)K\', salary)\n    if usd_m:\n        c.append(int(usd_m.group(2)) < 150)\n    elif re.search(r\'(\\d+)K\', salary):\n        c.append(int(re.search(r\'(\\d+)K\', salary).group(1)) < 150)\n    else:\n        c.append(True)\n    return sum(c)\n\ndef set_cell_shading(cell, color_hex):\n    shading_elm = parse_xml(f\'<w:shd {nsdecls("w")} w:fill="{color_hex}"/>\')\n    cell._tc.get_or_add_tcPr().append(shading_elm)\n\ndef set_run_font(run, font_name=\'Cambria\', size=11, bold=False):\n    run.font.name = font_name\n    run.font.size = Pt(size)\n    run._element.rPr.rFonts.set(qn(\'w:eastAsia\'), font_name)\n    if bold:\n        run.bold = True\n\ndef set_cell_vertical_align(cell):\n    tc = cell._tc\n    tcPr = tc.get_or_add_tcPr()\n    v_align = parse_xml(\n        f\'<w:vAlign {nsdecls("w")} w:val="top"/>\'\n    )\n    tcPr.append(v_align)\n\ndef create_candidate_report(name, resume, interview, score):\n    doc = Document()\n    style = doc.styles[\'Normal\']\n    style.font.name = \'Cambria\'\n    style.font.size = Pt(11)\n\n    # 1. Heading\n    heading = doc.add_paragraph()\n    heading.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    run = heading.add_run(\'Candidate Interview Assessment Report\')\n    run.font.name = \'Calibri\'\n    run.font.size = Pt(14)\n    run.bold = True\n    run._element.rPr.rFonts.set(qn(\'w:eastAsia\'), \'Calibri\')\n\n    # 2. Candidate Name\n    name_para = doc.add_paragraph()\n    run = name_para.add_run(f\'Candidate Name: {name}\')\n    set_run_font(run)\n\n    # 3. Candidate Information section\n    info_title = doc.add_paragraph()\n    run = info_title.add_run(\'Candidate Information:\')\n    set_run_font(run, bold=True)\n\n    info_lines = []\n    for key in [\'Gender\', \'Age\', \'Education\', \'Work Experience\', \'Technical Skills\', \'Contact\', \'Expected Salary\']:\n        if resume.get(key):\n            info_lines.append(f\'{key}: {resume[key]}\')\n    for p in resume.get(\'Projects\', []):\n        info_lines.append(p)\n    info_para = doc.add_paragraph()\n    set_run_font(info_para.add_run(\'\\n\'.join(info_lines)))\n\n    # 4. Interviewer Evaluation section\n    eval_title = doc.add_paragraph()\n    run = eval_title.add_run(\'Interviewer Evaluation:\')\n    set_run_font(run, bold=True)\n\n    if interview:\n        eval_lines = []\n        for key in [\'Interviewer\', \'Interview Time\', \'Position\', \'Technical Assessment\', \'Soft Skills Assessment\', \'Overall Impression\']:\n            if interview.get(key):\n                eval_lines.append(f\'{key}: {interview[key]}\')\n        eval_para = doc.add_paragraph()\n        set_run_font(eval_para.add_run(\'\\n\'.join(eval_lines)))\n    else:\n        no_eval = doc.add_paragraph()\n        set_run_font(no_eval.add_run(\'No interview evaluation available.\'))\n\n    # 5. Evaluation Conclusion section with 2x2 table\n    conclusion_title = doc.add_paragraph()\n    run = conclusion_title.add_run(\'Evaluation Conclusion:\')\n    set_run_font(run, bold=True)\n\n    table = doc.add_table(rows=2, cols=2)\n    table.alignment = WD_TABLE_ALIGNMENT.CENTER\n\n    tbl = table._tbl\n    tblPr = tbl.tblPr if tbl.tblPr is not None else parse_xml(f\'<w:tblPr {nsdecls("w")}/>\')\n    borders = parse_xml(\n        f\'<w:tblBorders {nsdecls("w")}>\'\n        \'  <w:top w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:left w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:bottom w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:right w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideH w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'  <w:insideV w:val="single" w:sz="4" w:space="0" w:color="000000"/>\'\n        \'</w:tblBorders>\'\n    )\n    tblPr.append(borders)\n\n    table.cell(0, 0).text = \'Overall Assessment\'\n    table.cell(0, 1).text = \'Recommendation\'\n    table.cell(1, 0).text = f\'{score * 10}%\'\n    table.cell(1, 1).text = recommendation_map.get(name, \'Not recommended\')\n\n    set_cell_shading(table.cell(0, 0), \'D9D9D9\')\n    set_cell_shading(table.cell(0, 1), \'D9D9D9\')\n    set_cell_shading(table.cell(1, 0), \'DAEEF3\')\n    set_cell_shading(table.cell(1, 1), \'DAEEF3\')\n\n    for row in table.rows:\n        for cell in row.cells:\n            set_cell_vertical_align(cell)\n            for p in cell.paragraphs:\n                p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                for r in p.runs:\n                    set_run_font(r)\n\n    safe_name = name.replace(\' \', \'_\')\n    filename = f\'Interview_Assessment_Report_{safe_name}.docx\'\n    doc.save(f\'/app/{filename}\')\n    print(f\'  Created: {filename} - Score: {score}/10\')\n\n###############################################\n# MAIN\n###############################################\nprint(\'Parsing resumes...\')\nresumes = parse_resumes()\nprint(f\'Found {len(resumes)} candidates\')\n\nprint(\'Parsing evaluations...\')\nevaluations = parse_evaluations()\nprint(f\'Found {len(evaluations)} evaluations\')\n\n# Evaluate\nprint(\'\\nEvaluating candidates...\')\nall_scores = {}\nfor name, resume in resumes.items():\n    interview = evaluations.get(name, None)\n    score = evaluate_candidate(name, resume, interview)\n    all_scores[name] = score\n    max_score = max(all_scores.values())\n\n# Build recommendation map\nbest_names = [n for n, s in all_scores.items() if s == max(all_scores.values