Sending keys: ['cat << \'PYEOF\' > /app/solve.py\nimport openpyxl\nimport pandas as pd\n\n# Read Methodology sheet\nwb = openpyxl.load_workbook(\'/app/Market_Data.xlsx\', data_only=True)\nws_meth = wb[\'Methodology\']\nws_raw = wb[\'RawData\']\n\n# Parse Methodology: get segments in order, their sources and weights\n# Row 2 (index 1): headers - col B = Segment/Source, cols C onwards = sources\n# Row 3 (index 2): source types\n# Rows 4-14 (index 3-13): segment definitions\n\nsources_order = []\nfor col_idx in range(3, ws_meth.max_column + 1):  # C onwards\n    val = ws_meth.cell(row=2, column=col_idx).value\n    if val is not None:\n        sources_order.append(val)\n\nprint("Sources:", sources_order)\n\n# Parse segments in order\nsegments = []\nfor row_idx in range(4, ws_meth.max_row + 1):  # starting row 4\n    seg_name = ws_meth.cell(row=row_idx, column=2).value\n    if seg_name is None:\n        continue\n    if seg_name == \'Total\':\n        break\n    # Get weights for each source\n    weights = {}\n    for col_idx, src in enumerate(sources_order, start=3):\n        w = ws_meth.cell(row=row_idx, column=col_idx).value\n        if w is not None and w != 0:\n            weights[src] = float(w)\n    segments.append((seg_name, weights))\n\nprint("Segments:", [(s[0], s[1]) for s in segments])\n\n# Parse RawData\n# Row 3 (index 2): header row with source names\n# Row 4 (index 3): column headers (YY, Agriculture, ...)\n# Data starts row 5 (index 4)\n\nraw_ws = wb[\'RawData\']\n\n# Get source names from RawData row 2 (index 1) - the CDP, S&P row\n# Actually let me re-examine: row 2 has the source names, row 3 has units, row 4 has column headers\n# Let me map column index to source name\nraw_sources = []\nfor col_idx in range(2, ws_raw.max_column + 1):\n    val = ws_raw.cell(row=2, column=col_idx).value\n    if val is not None:\n        raw_sources.append((col_idx, val))\n\nprint("RawData source columns:", raw_sources)\n\n# Parse yearly data\nyears_data = {}  # {year: {source: value}}\nfor row_idx in range(5, ws_raw.max_row + 1):\n    year_val = ws_raw.cell(row=row_idx, column=1).value\n    if year_val is None or not isinstance(year_val, (int, float)):\n        continue\n    year = int(year_val)\n    yearly = {}\n    for col_idx, src_name in raw_sources:\n        val = ws_raw.cell(row=row_idx, column=col_idx).value\n        if val is not None and val != \'\' and val != \'None\':\n            try:\n                yearly[src_name] = float(val)\n            except (ValueError, TypeError):\n                pass\n    if yearly:\n        years_data[year] = yearly\n\nprint("Years in raw data:", sorted(years_data.keys()))\n\n# Calculate YoY growth rate per source for years 2015-2024\nall_sources = sorted(set(src for weights in [s[1] for s in segments] for src in weights))\nprint("All sources needed:", all_sources)\n\ngrowth_rates = {}  # {year: {source: growth_pct}}\nfor year in range(2015, 2025):\n    growth_rates[year] = {}\n    prev_year = year - 1\n    if prev_year not in years_data or year not in years_data:\n        continue\n    for src in all_sources:\n        curr_val = years_data[year].get(src)\n        prev_val = years_data[prev_year].get(src)\n        if curr_val is not None and prev_val is not None and prev_val != 0:\n            gr = ((curr_val - prev_val) / prev_val) * 100\n            growth_rates[year][src] = gr\n        else:\n            growth_rates[year][src] = None  # missing\n\n# Calculate segment growth rates\nsegment_names = [s[0] for s in segments]\nresult_rows = []\n\nfor year in range(2015, 2025):\n    row = {\'Year\': year}\n    for seg_name, weights in segments:\n        # Check all component sources\n        all_available = True\n        weighted_sum = 0.0\n        for src, w in weights.items():\n            if src not in growth_rates[year] or growth_rates[year][src] is None:\n                all_available = False\n                break\n            weighted_sum += growth_rates[year][src] * w\n        if al