Sending keys: ['cat << \'PYEOF\' > /app/transform.py\nimport pandas as pd\nimport numpy as np\n\n# Read source file without header\nraw = pd.read_excel(\'/app/Household_Appliances.xlsx\', header=None)\n\n# Data starts at row 2\ndata = raw.iloc[2:].copy()\ndata = data.reset_index(drop=True)\n\n# Filter: keep only months where at least one sales value (cols 1-12) is not NaN\nvalid_mask = data.iloc[:, 1:13].notna().any(axis=1)\nvalid_data = data[valid_mask].copy()\nprint(f"Filtered from {len(data)} to {len(valid_data)} rows")\n\n# Build output rows\nresult_rows = []\nappliance_names = [\'Household Refrigerators\', \'Air Conditioners\', \'Household Washing Machines\']\n\nfor idx in range(len(valid_data)):\n    row = valid_data.iloc[idx]\n    time_val = row[0]\n    if pd.isna(time_val):\n        continue\n    try:\n        t = pd.Timestamp(time_val)\n        time_str = t.strftime(\'%Y-%m\')\n    except:\n        time_str = str(time_val)[:7]\n    \n    for i, name in enumerate(appliance_names):\n        base_col = 1 + i * 4  # 1, 5, 9\n        current_sales = row[base_col]\n        accum_sales = row[base_col + 1]\n        yoy_growth = row[base_col + 2]\n        accum_growth = row[base_col + 3]\n        \n        # Convert growth to percentage (multiply by 100)\n        if not pd.isna(yoy_growth):\n            yoy_growth = yoy_growth * 100\n        if not pd.isna(accum_growth):\n            accum_growth = accum_growth * 100\n        \n        result_rows.append({\n            \'Time\': time_str,\n            \'Appliance types\': name,\n            \'Current Period Sales(Ten Thousand Units)\': current_sales,\n            \'Accumulated Sales (Ten Thousand Units)\': accum_sales,\n            \'Year-on-Year Growth (%)\': yoy_growth,\n            \'Accumulated Growth (%)\': accum_growth\n        })\n\nresult = pd.DataFrame(result_rows)\n\n# Sort in reverse chronological order using the Time string directly (YYYY-MM sorts correctly)\nresult = result.sort_values(\'Time\', ascending=False).reset_index(drop=True)\n\nprint(f"Total output rows: {len(result)}")\nprint(\'First 10 rows:\')\nprint(result.head(10).to_string())\nprint()\nprint(\'Last 10 rows:\')\nprint(result.tail(10).to_string())\n\n# Save\nresult.to_excel(\'/app/Processed.xlsx\', index=False, engine=\'openpyxl\')\nprint("\\nSaved to /app/Processed.xlsx")\nPYEOF\npython3 /app/transform.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
