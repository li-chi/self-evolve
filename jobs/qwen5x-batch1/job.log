Sales (Ten Thousand Units)\': accumulated,\n            \'Year-on-Year Growth (%)\': yoy * 100 if not (yoy is None or (isinstance(yoy, float) and np.isnan(yoy))) else np.nan,\n            \'Accumulated Growth (%)\': acc_growth * 100 if not (acc_growth is None or (isinstance(acc_growth, float) and np.isnan(acc_growth))) else np.nan,\n        })\n\ndf_out = pd.DataFrame(records)\n\n# Sort reverse chronologically (December 2024 first, going backward)\ndf_out[\'sort_key\'] = pd.to_datetime(df_out[\'Time\'])\ndf_out = df_out.sort_values(\'sort_key\', ascending=False).reset_index(drop=True)\ndf_out = df_out.drop(columns=[\'sort_key\'])\n\n# Write to Excel\nwith pd.ExcelWriter(\'/app/Processed.xlsx\', engine=\'openpyxl\') as writer:\n    df_out.to_excel(writer, sheet_name=\'Format_Example\', index=False)\n\nprint(f"Total records: {len(df_out)}")\nprint(df_out.head(15).to_string())\nprint("...")\nprint(df_out.tail(5).to_string())\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
