text):\n    """Parse ingredients from 计算 section."""\n    ingredients = {}\n    for line in section_text.split(\'\\n\'):\n        line = line.strip()\n        if not line:\n            continue\n        # Skip headers, comments, structural\n        if line.startswith(\'#\') or line.startswith(\'<!--\') or line.startswith(\'```\'):\n            continue\n        if \'**\' in line and \':\' in line:\n            continue\n        \n        raw = None\n        # Bullet list: "- name quantity" or "* name quantity"\n        if line.startswith(\'- \') or line.startswith(\'* \'):\n            raw = line.lstrip(\'-* \').strip()\n        elif line.startswith(\'| \') or line.startswith(\'**|\'):\n            continue  # skip table rows for now\n        else:\n            continue\n        \n        # Match: name quantity pattern\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s*=\\s*(.+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s+(.+)\', raw)\n        \n        if m:\n            name_raw = m.group(1).strip()\n            qty_raw = m.group(2).strip()\n            norm = normalize_ingredient(name_raw)\n            if norm and norm in available_names:\n                ingredients[norm] = qty_raw\n    \n    # Also try table format: | name | qty | unit |\n    for line in section_text.split(\'\\n\'):\n        if line.strip().startswith(\'|\') and \'原料\' not in line:\n            parts = [p.strip() for p in line.strip().split(\'|\')]\n            parts = [p for p in parts if p.strip()]\n            if len(parts) >= 2:\n                name_raw = parts[0]\n                qty_raw = parts[1]\n                if name_raw not in (\'原料\', \'名称\', \'材料\', \'\') and qty_raw:\n                    norm = normalize_ingredient(name_raw)\n                    if norm and norm in available_names:\n                        ingredients[norm] = qty_raw\n    \n    return ingredients\n\ndef parse_recipe(fpath):\n    """Parse a single recipe file."""\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except:\n        return None\n    \n    # Dish name\n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            name = m.group(1).strip()\n            break\n    if not name:\n        return None\n    # Clean name: remove .做法, 的做法, trailing whitespace\n    name = re.sub(r\'\\s*(的?)做法\\s*$\', \'\', name).strip()\n    name = re.sub(r\'^\\d+\\s*\', \'\', name).strip()\n    \n    ingredients = {}\n    \n    # Strategy 1: Parse 计算 section\n    calc_match = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if calc_match:\n        ingredients = parse_calc_section(calc_match.group(1))\n    \n    # Strategy 2: 必备原料 section\n    if not ingredients:\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    # Remove parenthetical\n                    for sep in [\'(\', \'（\']:\n                        if sep in raw:\n                            raw = raw[:raw.index(sep)].strip()\n                    norm = normalize_ingredient(raw)\n                    if norm and norm in available_names:\n                        ingredients[norm] = \'\'\n    \n    if not ingredients:\n        return None\n    \n    return {\'name\': name, \'ingredients\': ingredients}\n\n# Parse all recipes\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in sorted(files):\n        if not fname.endswith(\'.md\'):\n            continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result:\n            recipes.append(result)\n\nprint(f"Parsed {len(recipes)} recipes")\n\n# Score candidates\ncandidates = []\nfor r in recipes:\n    matched = [n for n in r[\'ingredients\'] if n in available_names]\n    total = len(r[\'ingredients\'])\n    ratio = len(matched) / total if total > 0 else 0\n    if ratio >= 0.5 and len(matched) >= 2:\n        candidates.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': r[\'ingredients\'],\n            \'matched\': matched,\n            \'total\': total,\n            \'ratio\': ratio\n        })\n\ncandidates.sort(key=lambda x: (-len(x[\'matched\']), -x[\'ratio\'], x[\'name\']))\n\nprint(f"\\nTop candidates (>=50% coverage, >=2 matches): {len(candidates)}")\nfor i, c in enumerate(candidates[:25]):\n    missing = [n for n in c[\'ingredients\'] if n not in available_names]\n    print(f"  {i+1}. {c[\'name\']}: {len(c[\'matched\'])}/{c[\'total\']} ({c[\'ratio\']:.0%}) - avail:{c[\'matched\']} missing:{missing}")\n\n# Select 3 diverse dishes\n# Priority: soup dish included if possible, then variety of matched ingredients\nselected = []\n\ndef pick_soup(candidates):\n    """Try to find a soup dish from candidates."""\n    for c in candidates:\n        if \'汤\' in c[\'name\'] or \'粥\' in c[\'name\'] or \'羹\' in c[\'name\']:\n            return c\n    return None\n\nsoup = pick_soup(candidates)\nif soup:\n    selected.append(soup)\n    # Remove soup from candidates\n    remaining = [c for c in candidates if c[\'name\'] != soup[\'name\']]\nelse:\n    remaining = candidates\n\n# Pick next 2 with diverse ingredient coverage\nused_match = set()\nfor c in remaining:\n    if len(selected) >= 3:\n        break\n    # Score diversity: how many new available ingredients does this dish add?\n    new_match = [m for m in c[\'matched\'] if m not in used_match]\n    if len(selected) == 0 or len(new_match) >= 1:\n        selected.append(c)\n        used_match.update(c[\'matched\'])\n\nprint(f"\\n=== Selected {len(selected)} dishes ===")\nfor s in selected:\n    missing = {n: q for n, q in s[\'ingredients\'].items() if n not in available_names}\n    print(f"\\n{s[\'name\']} ({len(s[\'matched\'])}/{s[\'total\']})")\n    for ing, qty in s[\'ingredients\'].items():\n        status = \'STOCK\' if ing in available_names else \'MISSING\'\n        print(f"  [{status}] {ing}: {qty}")\n    if missing:\n        print(f"  Missing ingredients: {list(missing.keys())}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    for ing, qty in s[\'ingredients\'].items():\n        dish["ingredients"][ing] = qty\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list: ALL ingredients not in our stock\nshopping = []\nfor s in selected:\n    for ing, qty in s[\'ingredients\'].items():\n        if ing not in available:\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nfor item in shopping:\n    print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
