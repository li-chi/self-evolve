d)\n    processed += 1\n    print(f\'Processed: {filename} -> {dest_filename}\')\nprint(f\'Done! Processed {processed} files.\')\n\'\'\'\nwith open(\'/app/desensitize.py\', \'w\') as f:\n    f.write(script)\nprint(\'Script written.\')\n"\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
