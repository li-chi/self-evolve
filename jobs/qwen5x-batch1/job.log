Sending keys: ["python3 << 'PYEOF' > /tmp/monday_openbook.txt 2>&1\nimport pdfplumber\nimport re\nimport sys\n\nwith pdfplumber.open('25-26学年第一学期课程表.pdf') as pdf:\n    for i in range(27, 50):  # Cover general education pages\n        text = pdf.pages[i].extract_text()\n        if not text:\n            continue\n        # Find all course entries\n        for match in re.finditer(r'(PTSS\\d+\\.\\d+|FINE\\d+\\.\\d+|[A-Z]{2,}\\d+\\.\\d+)\\s+(.+?)\\s+\\d\\s+(.+?)\\s+(讲师|教授|副教授|研究员|助理研究员|高级工程师|助理研究员|助理教授|讲师|教授|教授|高级讲师|助教|助理教授|研究员|研究员\\([^)]*\\))\\s+(.+)\\s+', text):\n            code = match.group(1)\n            name = match.group(2)\n            # Check if this line contains 周一 and 开卷\n            line = match.group(0)\n            pass\n\n        # Simpler approach: extract lines with course codes\n        lines = text.split('\\n')\n        for idx, line in enumerate(lines):\n            # Match course codes\n            m = re.match(r'^\\s*(PTSS\\d+\\.\\d+|FINE\\d+\\.\\d+|[A-Z]{2,}\\d+\\.\\d+)\\s+(.+?)\\s+(\\d)\\s', line)\n            if m:\n                code = m.group(1)\n                name = m.group(2)\n                credits = m.group(3)\n                # Get more context from nearby lines\n                context = '\\n'.join(lines[max(0,idx-1):idx+3])\n                if '一' in context and '开卷' in context:\n                    # But exclude 思政B courses\n                    if '思政B' in context:\n                        continue\n                    print(f'=== Page {i+1} ===')\n                    print(f'{name} ({code}) Credits={credits}')\n                    print(context[:500])\n                    print()\nPYEOF\ncat /tmp/monday_openbook.txt\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
