Sending keys: ['cat > /app/process.py << \'PYEOF\'\nimport PyPDF2\nimport openpyxl\nimport os\nimport re\nfrom collections import defaultdict\n\n# Step 1: Extract data from taxi PDFs\ntaxi_data = []\nfor f in sorted(os.listdir(\'bills\')):\n    if not f.endswith(\'.pdf\'):\n        continue\n    filepath = os.path.join(\'bills\', f)\n    with open(filepath, \'rb\') as fh:\n        reader = PyPDF2.PdfReader(fh)\n        text = reader.pages[0].extract_text()\n        if \'TAXI RECEIPT\' not in text:\n            continue\n        # Extract amount\n        amount_match = re.search(r\'Amount:\\s*CNY\\s*([\\d,.]+)\', text)\n        if not amount_match:\n            print(f\'Warning: Could not find amount in {f}\')\n            continue\n        amount_str = amount_match.group(1).replace(\',\', \'\')\n        amount = float(amount_str)\n        # Extract date to determine month\n        date_match = re.search(r\'Date:\\s*(\\d{4}-\\d{2}-\\d{2})\', text)\n        if not date_match:\n            print(f\'Warning: Could not find date in {f}\')\n            continue\n        date_str = date_match.group(1)\n        year, month, day = date_str.split(\'-\')\n        month_str = f\'{year}-{month}\'\n        # File name without extension\n        file_name = f.replace(\'.pdf\', \'\')\n        taxi_data.append({\n            \'file_name\': file_name,\n            \'month\': month_str,\n            \'amount\': amount\n        })\n\n# Sort by file name (ascending chronological order)\ntaxi_data.sort(key=lambda x: x[\'file_name\'])\n\nprint(f\'Found {len(taxi_data)} taxi receipts:\')\nfor d in taxi_data:\n    print(f\'  {d["file_name"]} | Month: {d["month"]} | Amount: {d["amount"]:.2f}\')\n\n# Step 2: Calculate monthly totals\nmonthly_totals = defaultdict(float)\nfor d in taxi_data:\n    monthly_totals[d[\'month\']] += d[\'month\']\n    monthly_totals[d[\'month\']] = round(monthly_totals[d[\'month\']], 2)\n\ntotal_amount = round(sum(d[\'amount\'] for d in taxi_data), 2)\nprint(f\'\\nMonthly totals: {dict(sorted(monthly_totals.items()))}\')\nprint(f\'Total amount: {total_amount:.2f}\')\n\n# Step 3: Load and modify Excel\ntemplate_name = \'Bill_Format.xlsx\'\noutput_name = \'department_expenses.xlsx\'\n\nwb = openpyxl.load_workbook(template_name)\nws = wb.active\n\n# Fill monthly totals (rows 6-8, column A has dates, column B has amounts)\n# Row 6: April, Row 7: May, Row 8: June\nmonths_order = [\'2025-04\', \'2025-05\', \'2025-06\']\nfor i, month in enumerate(months_order):\n    row = i + 6  # rows 6, 7, 8\n    # Set month as YYYY-MM string\n    ws.cell(row=row, column=1, value=month)\n    # Set amount\n    ws.cell(row=row, column=2, value=round(monthly_totals.get(month, 0.0), 2))\n\n# Row 9: Total_amount in column A, total in column B\nws.cell(row=9, column=1, value=\'Total_amount\')\nws.cell(row=9, column=2, value=total_amount)\n\n# Step 4: Fill expense details starting from row 13 (after header row 12)\n# Preserve the layout - write data starting at row 13\nrow_start = 13\nfor d in taxi_data:\n    ws.cell(row=row_start, column=1, value=d[\'file_name\'])\n    ws.cell(row=row_start, column=2, value=d[\'month\'])\n    ws.cell(row=row_start, column=3, value=round(d[\'amount\'], 2))\n    row_start += 1\n\n# Save as department_expenses.xlsx\nwb.save(output_name)\nprint(f\'\\nSaved to {output_name}\')\nprint(f\'Data written to rows 13-{row_start - 1}\')\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
