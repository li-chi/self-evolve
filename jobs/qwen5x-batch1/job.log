Sending keys: ['cat > /app/process_bills.py << \'PYEOF\'\nimport os\nimport glob\nimport re\nimport pdfplumber\nfrom datetime import datetime\nimport openpyxl\n\n# Extract data from all PDF bills in bills/ directory\nbill_dir = \'/app/bills/\'\npdf_files = sorted(glob.glob(os.path.join(bill_dir, \'receipt_*.pdf\')))\n\nall_data = []  # list of (filename_no_ext, month, amount)\n\nfor pdf_path in pdf_files:\n    fname = os.path.basename(pdf_path)  # e.g. receipt_20250402_1.pdf\n    fname_no_ext = os.path.splitext(fname)[0]  # e.g. receipt_20250402_1\n    \n    # Determine month from filename: receipt_YYYYMMDD_X.pdf -> YYYY-MM\n    match = re.match(r\'receipt_(\\d{4})(\\d{2})\\d{2}_\\d+\\.pdf\', fname)\n    if not match:\n        print(f"Warning: Could not parse filename: {fname}")\n        continue\n    year = match.group(1)\n    month = match.group(2)\n    month_str = f"{year}-{month}"  # YYYY-MM\n    \n    # Extract amount from PDF\n    amount = None\n    with pdfplumber.open(pdf_path) as pdf:\n        for page in pdf.pages:\n            text = page.extract_text()\n            if text is None:\n                continue\n            # Look for Amount: CNY XXX.XX\n            amt_match = re.search(r\'Amount:\\s*[Cc][Nn][Yy]\\s*([\\d,]+\\.?\\d*)\', text)\n            if amt_match:\n                amount = float(amt_match.group(1).replace(\',\', \'\'))\n                break\n    \n    if amount is not None:\n        all_data.append((fname_no_ext, month_str, amount))\n        print(f"Extracted: {fname_no_ext}, {month_str}, {amount}")\n    else:\n        print(f"Warning: Could not extract amount from {fname}")\n\n# Sort by file name ascending (already sorted but let\'s be explicit)\nall_data.sort(key=lambda x: x[0])\n\nprint(f"\\nTotal records: {len(all_data)}")\n\n# Compute monthly totals\nmonthly_totals = {}  # month_str -> total\nfor fname, month, amount in all_data:\n    monthly_totals[month] = monthly_totals.get(month, 0) + amount\n\ngrand_total = sum(monthly_totals.values())\n\nprint("Monthly totals:")\nfor m in sorted(monthly_totals.keys()):\n    print(f"  {m}: {monthly_totals[m]:.2f}")\nprint(f"Grand total: {grand_total:.2f}")\n\n# Load the template\nwb = openpyxl.load_workbook(\'/app/Bill_Format.xlsx\')\nws = wb.active\n\n# Fill monthly amounts in the summary section\n# Row 6: April, Row 7: May, Row 8: June\nmonthly_map = {\n    \'2025-04\': (6, \'B6\'),\n    \'2025-05\': (7, \'B7\'),\n    \'2025-06\': (8, \'B8\'),\n}\n\nfor month_str, (row, cell) in monthly_map.items():\n    if month_str in monthly_totals:\n        ws[cell].value = round(monthly_totals[month_str], 2)\n        print(f"Set {cell} = {monthly_totals[month_str]:.2f}")\n\n# Fill total in row 9\nws[\'B9\'].value = round(grand_total, 2)\nprint(f"Set B9 = {grand_total:.2f}")\n\n# Fill expense details starting from row 13\nrow_num = 13\nfor fname_no_ext, month_str, amount in all_data:\n    ws.cell(row=row_num, column=1, value=fname_no_ext)\n    ws.cell(row=row_num, column=2, value=month_str)\n    ws.cell(row=row_num, column=3, value=round(amount, 2))\n    row_num += 1\n\nprint(f"Wrote {len(all_data)} expense detail rows")\n\n# Save as department_expenses.xlsx\nwb.save(\'/app/department_expenses.xlsx\')\nprint("\\nSaved to /app/department_expenses.xlsx")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
