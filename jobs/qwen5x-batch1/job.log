Sending keys: ['cat > /app/fetch_recipes.py << \'PYEOF\'\nimport json, re, urllib.request, urllib.parse\n\nGH = \'https://api.github.com/repos/Anduin2017/HowToCook/contents/\'\nRAW = \'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/\'\n\ndef gh(path):\n    url = GH + urllib.parse.quote(path, safe=\'/\')\n    req = urllib.request.Request(url, headers={\'Accept\': \'application/vnd.github.v3+json\'})\n    try:\n        with urllib.request.urlopen(req) as r:\n            return json.loads(r.read().decode())\n    except:\n        return None\n\ndef find_md(base, out=None):\n    if out is None: out = []\n    items = gh(base)\n    if not items: return out\n    for it in items:\n        if it[\'type\'] == \'file\' and it[\'name\'].endswith(\'.md\'):\n            out.append(it)\n        elif it[\'type\'] == \'dir\':\n            find_md(it[\'path\'], out)\n    return out\n\ndef parse_recipe(path):\n    raw = RAW + urllib.parse.quote(path, safe=\'/\')\n    try:\n        with urllib.request.urlopen(raw) as r:\n            txt = r.read().decode(\'utf-8\', errors=\'replace\')\n    except:\n        return None\n\n    # Get dish name from title\n    m = re.search(r\'^# (.+)$\', txt, re.M)\n    if not m: return None\n    title = m.group(1).strip()\n    # Remove common suffixes\n    for suffix in [\'的做法\', \'的作法\', \'\']: \n        if title.endswith(suffix) and suffix:\n            title = title[:-len(suffix)].strip()\n            break\n\n    ingredients = []\n\n    # Parse the "计算" section for per-serve quantities\n    calc_match = re.search(r\'## 计算.*?每份[：:].*?(?=##|\\Z)\', txt, re.S | re.I)\n    if calc_match:\n        calc_section = calc_match.group(0)\n        for line in calc_section.split(\'\\n\'):\n            line = line.strip()\n            if not line.startswith(\'-\'):\n                continue\n            line = line[1:].strip()\n            # Match patterns like:\n            # - 肉蟹 1 只（大约 300g） * 份数\n            # - 咖喱块 15g（一小块）*份数\n            # - 椰浆 100ml*份数\n            # - 鸡蛋 1 个 *份数\n            # - 洋葱 200g *份数\n            # - 水 50 g\n            # - 白糖 6-15 g\n            # Pattern: name followed by space then amount\n            m2 = re.match(r\'(.+?)\\s+(\\S+)\', line)\n            if m2:\n                name = m2.group(1).strip()\n                amount = m2.group(2).strip()\n                # Clean up: remove "*份数" or "* 份数" and trailing special chars\n                amount = re.sub(r\'\\s*[*]\\s*份数\', \'\', amount).strip()\n                # Remove parenthetical alternatives for common ones like "（大约 300g）"\n                # But keep the amount\n                # Actually let\'s keep the whole amount string\n                # Remove trailing spaces\n                amount = amount.rstrip()\n                # If amount has parenthetical like "1 只（大约 300g）", extract first part\n                inner_paren = re.search(r\'^(\\S+?)\\s*（.*）\', amount)\n                if inner_paren:\n                    amount = inner_paren.group(1)\n                else:\n                    # Could be like "15g（一小块）"\n                    inner_paren2 = re.search(r\'^(\\S*?\\S)\\s*（.*）\', amount)\n                    if inner_paren2:\n                        amount = inner_paren2.group(1)\n                ingredients.append([name, amount])\n\n    if not ingredients:\n        # Fallback: try parsing ingredient list section\n        ing_match = re.search(r\'## 必备原料和工具.*?(?=##|\\Z)\', txt, re.S | re.I)\n        if ing_match:\n            for line in ing_match.group(0).split(\'\\n\'):\n                line = line.strip()\n                if not line.startswith(\'-\'):\n                    continue\n                name = line[1:].strip()\n                ingredients.append([name, \'适量\'])\n\n    return {\'name\': title, \'ingredients\': ingredients, \'path\': path}\n\nprint(\'Finding all recipe files...\')\nfiles = find_md(\'dishes\')\nprint(f\'Found {len(files)} files\')\n\nrecipes = []\nfor i, f in enumerate(files):\n    r = parse_recipe(f[\'path\'])\n    if r and r[\'ingredients\']:\n        recipes.append(r)\n    if (i+1) % 50 == 0:\n        print(f\'  Processed {i+1}/{len(files)}\')\n\nprint(f\'Total recipes with ingredients: {len(recipes)}\')\n\n# Show sample\nfor r in recipes[:5]:\n    print(f"\\n=== {r[\'name\']} ===")\n    for n, a in r[\'ingredients\']:\n        print(f"  {n}: {a}")\n\nwith open(\'/app/recipes.json\', \'w\', encoding=\'utf-8\') as fo:\n    json.dump(recipes, fo, ensure_ascii=False, indent=2)\nprint(\'\\nSaved recipes.json\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
