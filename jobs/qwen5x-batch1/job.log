Sending keys: ['cat > /app/process.py << \'PYEOF\'\nimport os\nimport re\nimport fitz  # PyMuPDF\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nfrom datetime import datetime\nimport shutil\n\n# Step 1: Extract data from all PDFs\nbills_dir = \'/app/bills\'\npdf_files = sorted([f for f in os.listdir(bills_dir) if f.endswith(\'.pdf\')])\n\ndata = []\nfor pdf_file in pdf_files:\n    pdf_path = os.path.join(bills_dir, pdf_file)\n    doc = fitz.open(pdf_path)\n    text = doc[0].get_text()\n    doc.close()\n    \n    # Extract date\n    date_match = re.search(r\'Date:\\s*\\n\\s*(\\d{4}-\\d{2}-\\d{2})\', text)\n    date_str = date_match.group(1) if date_match else None\n    \n    # Extract amount\n    amount_match = re.search(r\'Amount:\\s*\\n\\s*CNY\\s*([\\d.]+)\', text)\n    amount = float(amount_match.group(1)) if amount_match else None\n    \n    if date_str and amount is not None:\n        # Extract YYYY-MM from date\n        month_str = date_str[:7]  # e.g., \'2025-04\'\n        file_name = os.path.splitext(pdf_file)[0]  # filename without extension\n        data.append({\n            \'file_name\': file_name,\n            \'month\': month_str,\n            \'amount\': amount,\n            \'date\': date_str\n        })\n\n# Sort by filename (ascending chronological order)\ndata.sort(key=lambda x: x[\'file_name\'])\n\nprint(f"Extracted {len(data)} records")\nfor d in data:\n    print(f"  {d[\'file_name\']} | {d[\'month\']} | {d[\'amount\']:.2f}")\n\n# Step 2: Calculate monthly totals\nmonthly_totals = {}\nfor d in data:\n    m = d[\'month\']\n    monthly_totals[m] = monthly_totals.get(m, 0) + d[\'amount\']\n\nprint("\\nMonthly totals:")\nfor m in sorted(monthly_totals.keys()):\n    print(f"  {m}: {monthly_totals[m]:.2f}")\n\n# Step 3: Load Excel template\nwb = openpyxl.load_workbook(\'/app/Bill_Format.xlsx\')\nws = wb.active\n\n# Step 4: Update month cells in the monthly summary (rows 6-8)\n# Row 6 = 2025-04, Row 7 = 2025-05, Row 8 = 2025-06\nmonth_map = {\n    \'2025-04\': 6,\n    \'2025-05\': 7,\n    \'2025-06\': 8\n}\n\n# Store original values and formats for reference\nprint("\\nProcessing Excel cells...")\n\nfor month_str, row_num in month_map.items():\n    cell_a = ws.cell(row=row_num, column=1)\n    cell_b = ws.cell(row=row_num, column=2)\n    \n    # Replace datetime with YYYY-MM string\n    cell_a.value = month_str\n    \n    # Set amount if exists\n    if month_str in monthly_totals:\n        cell_b.value = round(monthly_totals[month_str], 2)\n        cell_b.number_format = \'0.00\'\n        print(f"  Row {row_num}: Month={month_str}, Amount={cell_b.value}")\n\n# Step 5: Total_amount row (row 9)\ntotal_all = sum(monthly_totals.values())\nws.cell(row=9, column=2).value = round(total_all, 2)\nws.cell(row=9, column=2).number_format = \'0.00\'\nprint(f"  Row 9: Total_amount={total_all:.2f}")\n\n# Step 6: Fill expense details starting at row 14\n# Row 12 = headers, Row 13 = blank, Row 14 onwards = data\nprint("\\nFilling expense details...")\nfor i, d in enumerate(data):\n    row = 14 + i\n    ws.cell(row=row, column=1).value = d[\'file_name\']\n    ws.cell(row=row, column=2).value = d[\'month\']\n    ws.cell(row=row, column=3).value = round(d[\'amount\'], 2)\n    ws.cell(row=row, column=3).number_format = \'0.00\'\n    print(f"  Row {row}: {d[\'file_name\']} | {d[\'month\']} | {d[\'amount\']:.2f}")\n\n# Step 7: Save as department_expenses.xlsx\noutput_path = \'/app/department_expenses.xlsx\'\nwb.save(output_path)\nprint(f"\\nSaved to {output_path}")\n\n# Step 8: Remove original Bill_Format.xlsx\nos.remove(\'/app/Bill_Format.xlsx\')\nprint("Removed original Bill_Format.xlsx")\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
