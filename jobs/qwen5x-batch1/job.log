Sending keys: ['cat > /tmp/find_recipes.py << \'PYEOF\'\nimport os, re, json, csv\n\nour_ingredients = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\', \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\',\n}\n\ndef parse_recipe(filepath):\n    with open(filepath, \'r\', encoding=\'utf-8\') as f:\n        content = f.read()\n    \n    dish_name = \'\'\n    ingredients_with_amounts = []\n    \n    title_match = re.search(r\'^# (.+)\\s*做法\', content, re.MULTILINE)\n    if title_match:\n        dish_name = title_match.group(1)\n    else:\n        dish_name = os.path.basename(os.path.dirname(filepath))\n    \n    # Try \'## 计算\' section first\n    js_match = re.search(r\'## 计算\\n(.*?)(?=\\n## |\\n\\n#|\\Z)\', content, re.DOTALL)\n    if js_match:\n        lines = js_match.group(1).split(\'\\n\')\n        for line in lines:\n            line = line.strip()\n            if not line or not line.startswith(\'-\'):\n                continue\n            line = line.lstrip(\'- \').strip()\n            if not line:\n                continue\n            match = re.match(r\'^([\\u4e00-\\u9fff\\w]+?)\\s+(.+)$\', line)\n            if match:\n                name = match.group(1).strip()\n                amount = match.group(2).strip()\n                amount = re.sub(r\'\\*.*$\', \'\', amount).strip()\n                amount = re.sub(r\'^.*\\(取 \', \'\', amount).strip()\n                if amount and len(amount) > 0:\n                    ingredients_with_amounts.append((name, amount))\n        if ingredients_with_amounts:\n            return dish_name, ingredients_with_amounts\n    \n    # Try \'## 必备原料和工具\' section\n    tm_match = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if tm_match:\n        lines = tm_match.group(1).split(\'\\n\')\n        for line in lines:\n            line = line.strip()\n            if line.startswith(\'- \'):\n                name = line[2:].strip()\n                if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n                    ingredients_with_amounts.append((name, \'\'))\n        if ingredients_with_amounts:\n            return dish_name, ingredients_with_amounts\n    \n    return dish_name, ingredients_with_amounts\n\nrecipe_dir = \'/tmp/HowToCook/dishes\'\nrecipes = []\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if f.endswith(\'.md\'):\n            filepath = os.path.join(root, f)\n            name, ingrs = parse_recipe(filepath)\n            if ingrs:\n                recipes.append({\'name\': name, \'ingredients\': ingrs, \'filepath\': filepath})\n\nprint(f"Found {len(recipes)} recipes")\n\n# Score recipes\nresults = []\nfor recipe in recipes:\n    matched = []\n    unmatched = []\n    for ing_name, amount in recipe[\'ingredients\']:\n        found = False\n        for our_name in our_ingredients:\n            if ing_name == our_name or our_name in ing_name or ing_name in our_name:\n                matched.append((ing_name, amount, our_ingredients[our_name]))\n                found = True\n                break\n        if not found:\n            unmatched.append((ing_name, amount))\n    \n    total = len(matched) + len(unmatched)\n    if total == 0:\n        continue\n    ratio = len(matched) / total\n    if ratio < 0.5:\n        continue\n    results.append({\n        \'name\': recipe[\'name\'],\n        \'score\': len(matched),\n        \'ratio\': ratio,\n        \'matched\': matched,\n        \'unmatched\': unmatched,\n        \'filepath\': recipe[\'filepath\'],\n    })\n\nresults.sort(key=lambda x: x[\'score\'], reverse=True)\n\nprint(f"Recipes with >=50% match: {len(results)}")\nfor i, r in enumerate(results[:30]):\n    print(f"{i+1}. {r[\'name\']} (score={r[\'score\']}, ratio={r[\'ratio\']:.2f})")\n    print(f"   Matched: {[m[0] for m in r[\'matched\']]}")\n    print(f"   Unmatched: {[u[0] for u in r[\'unmatched\']]}")\n\n# Select 3 diverse dishes\nselected = []\nused_names = set()\nfor r in results:\n    if len(selected) >= 3:\n        break\n    if r[\'name\'] in used_names:\n        continue\n    used_names.add(r[\'name\'])\n    selected.append(r)\n\nprint("\\n=== Selected dishes ===")\nall_missing = []\nfor r in selected:\n    print(f"\\n{r[\'name\']}")\n    for m in r[\'matched\']:\n        print(f"  [MATCHED] {m[0]}: recipe amount={m[1]}, available={m[2]}")\n    print(f"  Missing:")\n    for u in r[\'unmatched\']:\n        print(f"    {u[0]}: {u[1]}")\n        all_missing.append((u[0], u[1]))\nPYEOF\npython3 /tmp/find_recipes.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
