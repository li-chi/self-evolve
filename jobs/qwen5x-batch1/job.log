Sending keys: ["cat > /app/explore_structure.py << 'PYEOF'\nimport json, re, urllib.request, urllib.parse\n\nGH = 'https://api.github.com/repos/Anduin2017/HowToCook/contents/'\nRAW = 'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/'\n\ndef gh(path):\n    url = GH + urllib.parse.quote(path, safe='/')\n    req = urllib.request.Request(url, headers={'Accept': 'application/vnd.github.v3+json'})\n    try:\n        with urllib.request.urlopen(req) as r:\n            return json.loads(r.read().decode())\n    except:\n        return None\n\ndef find_all_md(base, out=None):\n    if out is None: out = []\n    items = gh(base)\n    if not items: return out\n    for it in items:\n        if it['type'] == 'file' and it['name'].endswith('.md'):\n            out.append(it['path'])\n        elif it['type'] == 'dir':\n            find_all_md(it['path'], out)\n    return out\n\n# Get all recipe paths\nall_paths = find_all_md('dishes')\nprint('Total recipe paths:', len(all_paths))\n\n# Search for recipes containing our ingredients\nour = ['鸡蛋', '土豆', '茄子', '蒜苗', '冬瓜', '猪肉', '五花肉', '牛奶', '干辣椒', '辣椒']\nmatches = {}\n\nfor path in all_paths:\n    # Skip the path - fetch content and check\n    raw = RAW + urllib.parse.quote(path, safe='/')\n    try:\n        with urllib.request.urlopen(raw) as r:\n            txt = r.read().decode('utf-8', errors='replace')\n    except:\n        continue\n    \n    m = re.search(r'^# (.+)$', txt, re.M)\n    title = m.group(1).strip() if m else 'Unknown'\n    \n    matched_ingredients = [o for o in our if o in txt]\n    if matched_ingredients:\n        matches[path] = {'name': title, 'matched': matched_ingredients, 'text': txt}\n\nprint('Recipes with ingredient matches:', len(matches))\nfor path, info in matches.items():\n    print('  ' + info['name'] + ' -> ' + str(info['matched']))\nPYEOF\npython3 /app/explore_structure.py\n"] min_timeout_sec: 45.0 max_timeout_sec: 180.0
