Sending keys: ["cat > /app/check_soup.py << 'ENDSCRIPT'\nimport re, urllib.request, urllib.parse, json\n\nRAW = 'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/'\nGH = 'https://api.github.com/repos/Anduin2017/HowToCook/contents/'\nour = ['鸡蛋','土豆','茄子','蒜苗','冬瓜','瘦猪肉片','五花肉','牛奶','干辣椒']\n\ndef fetch(path):\n    raw = RAW + urllib.parse.quote(path, safe='/')\n    try:\n        with urllib.request.urlopen(raw) as r:\n            return r.read().decode('utf-8', errors='replace')\n    except:\n        return None\n\ndef gh_api(path):\n    url = GH + urllib.parse.quote(path, safe='/')\n    hdrs = {}\n    hdrs['Accept'] = 'application/vnd.github.v3+json'\n    req = urllib.request.Request(url, headers=hdrs)\n    try:\n        with urllib.request.urlopen(req) as r:\n            return json.loads(r.read().decode())\n    except Exception as e:\n        print('gh error for ' + path + ': ' + str(e))\n        return None\n\n# Check soup recipes\nsoup_paths = [\n    'dishes/soup/西红柿鸡蛋汤.md',\n    'dishes/soup/冬瓜汤.md',\n    'dishes/soup/紫菜蛋花汤.md',\n    'dishes/soup/排骨汤.md',\n    'dishes/soup/丝瓜蛋汤.md',\n    'dishes/soup/鸡蛋汤.md',\n    'dishes/soup/番茄蛋汤.md',\n    'dishes/soup/豆腐汤.md',\n]\n\nfor p in soup_paths:\n    txt = fetch(p)\n    if txt:\n        m = re.search(r'^# (.+)$', txt, re.M)\n        title = m.group(1).strip() if m else 'Unknown'\n        title = title.replace('的做法','').strip()\n        print('FOUND: ' + title + ' (' + p + ')')\n        calc = re.search(r'(## 计算.*?)((?:## )|$)', txt, re.S)\n        if calc:\n            sec = calc.group(1)\n            for line in sec.split('\\n'):\n                line = line.strip()\n                if line.startswith('-'):\n                    print('  ' + line)\n        else:\n            print('  NO CALC SECTION')\n        for o in our:\n            if o in txt:\n                print('  contains: ' + o)\n        print()\n    else:\n        print('NOT FOUND: ' + p)\n\n# Explore dishes structure\nprint('=== Exploring dishes structure ===')\nfor cat in gh_api('dishes'):\n    print('  ' + cat['name'])\n    sub = gh_api(cat['path'])\n    if sub:\n        for s in sub:\n            print('    ' + s['name'] + ' (' + s['type'] + ')')\nENDSCRIPT\npython3 /app/check_soup.py\n"] min_timeout_sec: 30.0 max_timeout_sec: 180.0
