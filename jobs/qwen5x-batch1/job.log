Sending keys: ['cat > /tmp/solve.py << \'PYEOF\'\nimport os, re, json, csv\nfrom collections import defaultdict\n\n# Our available ingredients\nour_ings = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\', \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\',\n}\n\ndef normalize_ingredient(name):\n    """Normalize ingredient name for matching."""\n    name = name.strip()\n    # Remove parenthetical notes\n    name = re.sub(r\'\\(.*?\\)\', \'\', name).strip()\n    return name\n\ndef parse_calc_section(content):\n    """Parse the 计算 section and return list of (name, amount)."""\n    # Find 计算 section\n    match = re.search(r\'## 计算\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not match:\n        return []\n    \n    block = match.group(1)\n    results = []\n    \n    for line in block.split(\'\\n\'):\n        line = line.strip()\n        if not line:\n            continue\n        \n        # Handle different list markers: \'- \', \'* \', \'+ \'\n        if not (line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \')):\n            continue\n        \n        line = line[2:].strip()\n        if not line:\n            continue\n        \n        # Skip nested/indented lines (like "小料" subsections)\n        if line.startswith(\'  \') or (line and not line[0].isascii()):\n            continue\n            \n        # Match: ingredient_name amount\n        # Name is typically Chinese characters, possibly with English/numbers\n        # Amount follows after whitespace\n        m = re.match(r\'^([\\u4e00-\\u9fff\\w\\s\\.]+?)\\s+(.+)$\', line)\n        if m:\n            name = m.group(1).strip()\n            amount = m.group(2).strip()\n            # Clean up amount\n            amount = re.sub(r\'\\*.*$\', \'\', amount).strip()\n            amount = re.sub(r\'\\s*\\(.*?\\)\', \'\', amount).strip()\n            amount = re.sub(r\'^.*?\\(取 \', \'\', amount).strip()\n            # Handle cases where name is a placeholder like 小料\n            if not amount or len(amount) < 1:\n                continue\n            results.append((name, amount))\n    \n    return results\n\ndef parse_ingredients_section(content):\n    """Parse the 必备原料和工具 section."""\n    match = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |\\Z)\', content, re.DOTALL)\n    if not match:\n        return []\n    \n    block = match.group(1)\n    results = []\n    \n    for line in block.split(\'\\n\'):\n        line = line.strip()\n        if not (line.startswith(\'- \') or line.startswith(\'* \') or line.startswith(\'+ \')):\n            continue\n        name = line[2:].strip()\n        if name and re.search(r\'[\\u4e00-\\u9fff]\', name):\n            results.append((name, \'\'))\n    \n    return results\n\ndef extract_dish_name(content):\n    """Extract dish name from markdown title."""\n    m = re.search(r\'^# (.+)\\s*做法\', content, re.MULTILINE)\n    if m:\n        return m.group(1)\n    return \'\'\n\ndef get_category(filepath, base_dir):\n    """Get category from filepath."""\n    rel = os.path.relpath(filepath, base_dir)\n    return rel.split(\'/\')[0]\n\n# Collect all recipes\nrecipe_dir = \'/tmp/HowToCook/dishes\'\nall_recipes = []\n\nfor root, dirs, files in os.walk(recipe_dir):\n    for f in files:\n        if not f.endswith(\'.md\'):\n            continue\n        filepath = os.path.join(root, f)\n        with open(filepath, \'r\', encoding=\'utf-8\') as fh:\n            content = fh.read()\n        \n        dish_name = extract_dish_name(content)\n        if not dish_name:\n            continue\n        \n        # Try to parse 计算 section first\n        calc_ings = parse_calc_section(content)\n        if not calc_ings:\n            calc_ings = parse_ingredients_section(content)\n        \n        if not calc_ings:\n            continue\n        \n        all_recipes.append({\n            \'name\': dish_name,\n            \'ingredients\': calc_ings,\n            \'filepath\': filepath,\n            \'category\': get_category(filepath, recipe_dir),\n        })\n\nprint(f"Total recipes parsed: {len(all_recipes)}")\n\n# Debug: show parsing for a sample\nprint("\\n--- Sample recipe: 瘦肉土豆片 ---")\nfor r in all_recipes:\n    if \'瘦肉土豆片\' in r[\'name\']:\n        print(f"  Name: {r[\'name\']}")\n        print(f"  Ingredients: {r[\'ingredients\'][:10]}")\n        break\n\nprint("\\n--- Sample recipe: 回锅肉 ---")\nfor r in all_recipes:\n    if \'回锅肉\' in r[\'name\']:\n        print(f"  Name: {r[\'name\']}")\n        print(f"  Ingredients: {r[\'ingredients\'][:15]}")\n        break\n\n# Match and score\nresults = []\nfor recipe in all_recipes:\n    matched = []\n    unmatched = []\n    \n    for ing_name, amount in recipe[\'ingredients\']:\n        found = False\n        for our_name in our_ings:\n            norm_our = normalize_ingredient(our_name)\n            norm_ing = normalize_ingredient(ing_name)\n            \n            # Exact match\n            if norm_our == norm_ing:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n            # Our ingredient is contained in recipe ingredient\n            if our_name in ing_name:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n            # Recipe ingredient is contained in our ingredient (rare)\n            if ing_name in our_name:\n                matched.append((ing_name, amount, our_ings[our_name]))\n                found = True\n                break\n        \n        if not found:\n            unmatched.append((ing_name, amount))\n    \n    total = len(matched) + len(unmatched)\n    if total == 0:\n        continue\n    \n    ratio = len(matched) / total\n    if ratio < 0.5:\n        continue\n    \n    # Count how many unique ingredient TYPES match\n    matched_types = set(m[0] for m in matched)\n    results.append({\n        \'name\': recipe[\'name\'],\n        \'category\': recipe[\'category\'],\n        \'score\': len(matched_types),\n        \'ratio\': ratio,\n        \'matched\': matched,\n        \'unmatched\': unmatched,\n        \'filepath\': recipe[\'filepath\'],\n    })\n\nresults.sort(key=lambda x: (-x[\'score\'], -x[\'ratio\']))\n\nprint(f"\\n=== Recipes with >= 50% ingredient match ({len(results)} total) ===")\nfor i, r in enumerate(results[:40]):\n    print(f"{i+1}. {r[\'name\']} [{r[\'category\']}] score={r[\'score\']} ratio={r[\'ratio\']:.2f}")\n    for m in r[\'matched\']:\n        print(f"    MATCH: {m[0]} -> recipe={m[1]}, avail={m[2]}")\n    for u in r[\'unmatched\']:\n        print(f"    MISS: {u[0]} ({u[1]})")\n\n# Select 3 diverse dishes\n# Prefer diverse categories, with at least one soup if possible\nsoup_selected = False\nselected = []\nfor r in results:\n    if len(selected) >= 3:\n        break\n    # If it\'s a soup and we haven\'t selected one, prefer it\n    # For diversity, allow same category but different dish\n    selected.append(r)\n\nprint("\\n=== FINAL SELECTED DISHES ===")\nall_missing = []\nfor r in selected:\n    soup_check = r[\'category\'] == \'soup\'\n    if soup_check:\n        soup_selected = True\n    print(f"\\n--- {r[\'name\']} ---")\n    print(f"Category: {r[\'category\']}")\n    print("Ingredients:")\n    for m in r[\'matched\']:\n        print(f"  [HAVE] {m[0]}: recipe={m[1]}, available={m[2]}")\n    print("Missing:")\n    for u in r[\'unmatched\']:\n        norm = normalize_ingredient(u[0])\n        all_missing.append((norm, u[1]))\n        print(f"  [MISS] {u[0]}: need {u[1]}")\n\nprint("\\n=== MISSING INGREDIENTS FOR SHOPPING LIST ===")\nfor name, qty in all_missing:\n    print(f"  {name}: {qty}")\nPYEOF\npython3 /tmp/solve.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
