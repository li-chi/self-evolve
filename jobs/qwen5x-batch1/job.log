Sending keys: ['cat > generate_reports.py << \'PYEOF\'\nfrom docx import Document\nfrom docx.shared import Pt\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.enum.table import WD_TABLE_ALIGNMENT\nfrom docx.oxml.ns import qn\nimport re\n\ndef set_cell_shading(cell, color_hex):\n    tc = cell._element\n    tcPr = tc.get_or_add_tcPr()\n    shading = tcPr.makeelement(qn(\'w:shd\'), {\n        qn(\'w:fill\'): color_hex,\n        qn(\'w:val\'): \'clear\',\n    })\n    tcPr.append(shading)\n\ndef set_cell_vertical_top(cell):\n    tc = cell._element\n    tcPr = tc.get_or_add_tcPr()\n    tcPr.append(tc.makeelement(qn(\'w:vAlign\'), {qn(\'w:val\'): \'top\'}))\n\ndef parse_candidates():\n    doc = Document(\'Candidates_resumes.docx\')\n    text = "\\n".join(p.text for p in doc.paragraphs)\n    candidates = {}\n    entries = re.split(r\'\\nCandidate \\d+:\', text)\n    entries = [e for e in entries if \'Name:\' in e]\n    for entry in entries:\n        lines = entry.strip().split(\'\\n\')\n        name = None\n        for line in lines:\n            if line.strip().startswith(\'Name:\'):\n                name = line.replace(\'Name:\', \'\').strip()\n                break\n        if name:\n            candidates[name] = \'\\n\'.join(lines)\n    return candidates\n\ndef parse_evaluations():\n    doc = Document(\'Interviewer_evaluation.docx\')\n    evaluations = {}\n    current_name = None\n    current_eval = ""\n    for para in doc.paragraphs:\n        text = para.text.strip()\n        m = re.match(r\'Candidate \\d+ Name:\\s*(\\S+)\', text)\n        if m:\n            if current_name and current_eval:\n                evaluations[current_name] = current_eval\n            name = m.group(1).replace(\'_\', \' \')\n            current_name = name\n            current_eval = ""\n        elif current_name:\n            current_eval += text + "\\n"\n    if current_name and current_eval:\n        evaluations[current_name] = current_eval\n    return evaluations\n\ndef eval_single(name, resume, eval_text):\n    c = {\'exp\': False, \'edu\': False, \'uni\': False, \'faang\': False,\n         \'lead\': False, \'impact\': False, \'tech\': False, \'rec\': False,\n         \'exc\': False, \'salary\': False}\n    faang = [\'Google\', \'Meta\', \'Apple\', \'Netflix\', \'Amazon\', \'Facebook\']\n    # 1. Experience >= 4\n    m = re.search(r\'Work Experience:\\s*(\\d+)\', resume)\n    if m and int(m.group(1)) >= 4:\n        c[\'exp\'] = True\n    # 2. Master or higher\n    edu = ""\n    for l in resume.split(\'\\n\'):\n        if l.startswith(\'Education:\'):\n            edu = l.replace(\'Education:\', \'\').strip()\n            break\n    if \'Master\' in edu or \'PhD\' in edu or \'Doctor\' in edu:\n        c[\'edu\'] = True\n    # 3. Top university\n    for u in [\'Stanford\', \'MIT\', \'CMU\', \'Peking\', \'Tsinghua\']:\n        if u in edu:\n            c[\'uni\'] = True\n            break\n    # 4. FAANG\n    wline = " ".join(l for l in resume.split(\'\\n\'))\n    for co in faang:\n        if co in wline:\n            c[\'faang\'] = True\n            break\n    # 5. Leadership\n    for l in resume.split(\'\\n\'):\n        ll = l.lower()\n        if \'led \' in ll or \'lead \' in ll:\n            c[\'lead\'] = True\n            break\n    if eval_text:\n        for l in eval_text.split(\'\\n\'):\n            ll = l.lower()\n            if \'leadership\' in ll or \'led team\' in ll:\n                c[\'lead\'] = True\n    # 6. High impact\n    proj_lines = []\n    in_p = False\n    for l in resume.split(\'\\n\'):\n        if \'Project Experience:\' in l:\n            in_p = True\n            continue\n        if in_p:\n            if l.strip().startswith(\'-\'):\n                proj_lines.append(l)\n            elif l.strip() == \'\' and proj_lines:\n                break\n    pt = " ".join(proj_lines).lower()\n    for kw in [\'million\', \'users\', \'uptime\', \'latency\', \'revenue\', \'accuracy\',\n               \'conversion\', \'vulnerabilities\', \'deployment\', \'download\']:\n        if kw in pt:\n            c[\'impact\'] = True\n            break\n    # 7. 3+ skills\n    skills = []\n    in_s = False\n    for l in resume.split(\'\\n\'):\n        if \'Technical Skills:\' in l:\n            in_s = True\n            for s in l.replace(\'Technical Skills:\', \'\').strip().split(\',\'):\n                s = s.strip()\n                if s: skills.append(s)\n            continue\n        if in_s:\n            if l.strip().startswith(\'-\') or l.strip() == \'\':\n                break\n            for s in l.split(\',\'):\n                s = s.strip()\n                if s: skills.append(s)\n    if len(skills) >= 3:\n        c[\'tech\'] = True\n    # 8. Exceptional/Outstanding\n    if eval_text:\n        el = eval_text.lower()\n        if \'exceptional\' in el or \'outstanding\' in el:\n            c[\'rec\'] = True\n    # 9. 2+ excellence mentions\n    if eval_text:\n        cnt = eval_text.lower().count(\'excellent\') + eval_text.lower().count(\'exceptional\')\n        if cnt >= 2:\n            c[\'exc\'] = True\n    # 10. Salary under 150K\n    sal_line = ""\n    for l in resume.split(\'\\n\'):\n        if \'Salary\' in l or \'Expected\' in l:\n            sal_line = l\n            break\n    um = re.search(r\'(\\$)(\\d+)K\', sal_line)\n    if um:\n        if int(um.group(2)) < 150:\n            c[\'salary\'] = True\n    else:\n        c[\'salary\'] = True  # non-USD or low local currency\n    return c\n\ndef clean_resume(name, resume):\n    lines = resume.split(\'\\n\')\n    skip = False\n    result = []\n    for l in lines:\n        if re.match(r\'^Candidate \\d+:\', l):\n            skip = True\n            continue\n        if skip:\n            skip = False\n            continue\n        result.append(l)\n    return \'\\n\'.join(result)\n\ndef clean_eval(name, eval_text):\n    lines = eval_text.split(\'\\n\')\n    skip = False\n    result = []\n    for l in lines:\n        if re.match(r\'^Candidate \\d+ Name:\', l):\n            skip = True\n            continue\n        if skip:\n            skip = False\n            continue\n        result.append(l)\n    return \'\\n\'.join(result).strip()\n\ndef fmt(doc, text, bold=False, name=\'Cambria\', size=11):\n    run = doc.add_run(text)\n    run.font.name = name\n    run.font.size = Pt(size)\n    run.bold = bold\n    return run\n\ndef create_report(name, resume, eval_text, criteria):\n    doc = Document()\n    # Heading\n    h = doc.add_paragraph()\n    h.alignment = WD_ALIGN_PARAGRAPH.CENTER\n    r = h.add_run(\'Candidate Interview Assessment Report\')\n    r.font.name = \'Calibri\'\n    r.font.size = Pt(14)\n    r.bold = True\n    # Name\n    np = doc.add_paragraph()\n    r = np.add_run(\'Candidate Name: \' + name)\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    # Section 1\n    s1t = doc.add_paragraph()\n    r = s1t.add_run(\'Candidate Information:\')\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    r.bold = True\n    s1b = doc.add_paragraph()\n    r = s1b.add_run(clean_resume(name, resume))\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    # Section 2\n    s2t = doc.add_paragraph()\n    r = s2t.add_run(\'Interviewer Evaluation:\')\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    r.bold = True\n    s2b = doc.add_paragraph()\n    r = s2b.add_run(clean_eval(name, eval_text))\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    # Section 3\n    s3t = doc.add_paragraph()\n    r = s3t.add_run(\'Evaluation Conclusion:\')\n    r.font.name = \'Cambria\'\n    r.font.size = Pt(11)\n    r.bold = True\n    # Table\n    total = len(criteria)\n    met = sum(1 for v in criteria.values() if v)\n    pct = int(round(met / total * 100))\n    is_best = (met == total)\n    tbl = doc.add_table(rows=2, cols=2)\n    tbl.style = \'Table Grid\'\n    tbl.alignment = WD_TABLE_ALIGNMENT.CENTER\n    cells = [\n        (\'Overall Assessment\', \'D9D9D9\'),\n        (\'Recommendation\', \'D9D9D9\'),\n        (str(pct) + \'%\', \'DAEEF3\'),\n        (\'Best match\' if is_best else \'Not recommended\', \'DAEEF3\'),\n    ]\n    idx = 0\n    for i in range(2):\n        for j in range(2):\n            cell = tbl.cell(i, j)\n            cell.text = cells[idx][0]\n            set_cell_shading(cell, cells[idx][1])\n            set_cell_vertical_top(cell)\n            for p in cell.paragraphs:\n                p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n                for run in p.runs:\n                    run.font.name = \'Cambria\'\n                    run.font.size = Pt(11)\n            idx += 1\n    fn = \'Interview_Assessment_Report_\' + name.replace(\' \', \'_\') + \'.docx\'\n    doc.save(fn)\n    print(f\'  Created: {fn} ({met}/{total}, {pct}%)\')\n    return met == total\n\ncandidates = parse_candidates()\nevaluations = parse_evaluations()\nprint(f\'Found {len(candidates)} candidates, {len(evaluations)} evaluations\')\n\nbest_name = None\nbest_score = -1\nall_criteria = {}\n\nfor name in sorted(candidates.keys()):\n    res = candidates[name]\n    ev = evaluations.get(name, \'\')\n    cr = eval_single(name, res, ev)\n    m = sum(1 for v in cr.values() if v)\n    all_criteria[name] = cr\n    print(f\'{name}: {m}/10\')\n    if m > best_score:\n        best_score = m\n        best_name = name\n\nprint(f\'Best: {best_name} ({best_score}/10)\')\n\nprint(\'\\n--- Generating Reports ---\')\nfor name in sorted(candidates.keys()):\n    res = candidates[name]\n    ev = evaluations.get(name, \'\')\n    cr = all_criteria[name]\n    create_report(name, res, ev, cr)\n\nwith open(\'recommend.txt\', \'w\') as f:\n    f.write(best_name)\nprint(f\'\\nrecommend.txt: {best_name}\')\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
