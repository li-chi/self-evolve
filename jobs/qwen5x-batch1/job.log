ne:\n                all_available = False\n                break\n            weighted_sum += gr * w\n        if all_available:\n            row[seg_name] = round(weighted_sum, 1)\n        else:\n            row[seg_name] = \'N/A\'\n    output_rows.append(row)\n\ndf = pd.DataFrame(output_rows, columns=[\'Year\'] + segment_names)\nprint("\\nOutput:")\nprint(df.to_string(index=False))\n\ndf.to_excel(\'/app/segment_growth_rates.xlsx\', index=False)\nprint("\\nSaved to /app/segment_growth_rates.xlsx")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
