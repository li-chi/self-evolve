Sending keys: ['cat > /app/final_v7.py << \'PYEOF\'\nimport os, re, json, csv\n\navailable_names = {\'鸡蛋\', \'土豆\', \'茄子\', \'蒜苗\', \'冬瓜\', \'瘦猪肉片\', \'五花肉\', \'牛奶\', \'干辣椒\'}\navailable = {\n    \'鸡蛋\': \'2个\', \'土豆\': \'100g\', \'茄子\': \'200g\', \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\', \'瘦猪肉片\': \'150g\', \'五花肉\': \'100g\', \'牛奶\': \'30ml\', \'干辣椒\': \'50g\'\n}\n\nNORM = {\n    \'青茄子\': \'茄子\', \'茄子\': \'茄子\',\n    \'带皮五花肉\': \'五花肉\', \'五花肉\': \'五花肉\',\n    \'纯瘦肉\': \'瘦猪肉片\', \'瘦肉\': \'瘦猪肉片\', \'猪肉\': \'瘦猪肉片\',\n    \'猪肉末\': \'瘦猪肉片\', \'肉末\': \'瘦猪肉片\',\n    \'鸡蛋\': \'鸡蛋\',\n    \'蒜苗\': \'蒜苗\',\n    \'冬瓜\': \'冬瓜\',\n    \'干辣椒\': \'干辣椒\',\n    \'牛奶\': \'牛奶\', \'全脂牛奶\': \'牛奶\', \'全脂牛奶/奶油\': \'牛奶\',\n}\n\ndef clean_raw(name):\n    name = re.sub(r\'[\\u1F300-\\u1F9FF\\U0001F600-\\U0001F9FF]\', \'\', name)\n    for sep in [\'(\', \'（\']:\n        if sep in name: name = name[:name.index(sep)].strip()\n    if \'=\' in name: name = name[:name.index(\'=\')].strip()\n    for sep in [\')\', \'）\']:\n        if sep in name: name = name[:name.index(sep)].strip()\n    name = name.strip()\n    name = re.sub(r\'[\\s\\-=/\\|]+$]\', \'\', name).strip()\n    return name\n\ndef normalize_ingredient(raw_name):\n    name = clean_raw(raw_name)\n    if not name: return None\n    if name in NORM: return NORM[name]\n    if name in available_names: return name\n    for av in available_names:\n        if av in name: return av\n    return None\n\ndef parse_all_ingredients(section_text):\n    """Parse ALL ingredients from 计算 section."""\n    ingredients = []  # list of (original_name, cleaned_name, quantity)\n    for line in section_text.split(\'\\n\'):\n        line = line.strip()\n        if not line or line.startswith(\'#\') or line.startswith(\'<!--\') or line.startswith(\'```\'):\n            continue\n        if \'**\' in line and \':\' in line:\n            continue\n        raw = None\n        if line.startswith(\'- \') or line.startswith(\'* \'):\n            raw = line.lstrip(\'-* \').strip()\n        else:\n            continue\n        # Try to extract name and quantity\n        m = re.match(r\'(.+?)\\s+(\\d+\\s*[\\u4e00-\\u9fff\\u00b7.gkgmla-zA-Z/]+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s*=\\s*(.+)\', raw)\n        if not m:\n            m = re.match(r\'(.+?)\\s+(\\d+.+)\', raw)\n        if m:\n            name_raw = m.group(1).strip()\n            qty = m.group(2).strip() if len(m.groups()) > 1 else \'\'\n            clean_name = clean_raw(name_raw)\n            norm = normalize_ingredient(name_raw)\n            ingredients.append((clean_name, norm, qty))\n    \n    # Try table format: | name | qty | unit |\n    for line in section_text.split(\'\\n\'):\n        if line.strip().startswith(\'|\') and \'原料\' not in line and \'数量\' not in line:\n            parts = [p.strip() for p in line.strip().split(\'|\')]\n            parts = [p for p in parts if p.strip()]\n            if len(parts) >= 2:\n                name_raw = clean_raw(parts[0])\n                qty = parts[1]\n                if name_raw and name_raw not in (\'原料\', \'名称\', \'材料\'):\n                    norm = normalize_ingredient(name_raw)\n                    ingredients.append((name_raw, norm, qty))\n    \n    return ingredients\n\ndef parse_recipe(fpath):\n    try:\n        with open(fpath, \'r\', encoding=\'utf-8\') as f:\n            content = f.read()\n    except:\n        return None\n    name = None\n    for line in content.split(\'\\n\'):\n        m = re.match(r\'^#\\s+(.+)\', line.strip())\n        if m:\n            name = m.group(1).strip()\n            break\n    if not name:\n        return None\n    name = re.sub(r\'\\s*(的?)做法\\s*$\', \'\', name).strip()\n    name = re.sub(r\'^\\d+\\s*\', \'\', name).strip()\n    \n    ingredients = []\n    calc_match = re.search(r\'## 计算\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n    if calc_match:\n        ingredients = parse_all_ingredients(calc_match.group(1))\n    \n    if not ingredients:\n        ing_match = re.search(r\'## 必备原料和工具\\n(.*?)(?:^## |\\Z)\', content, re.DOTALL | re.MULTILINE)\n        if ing_match:\n            for line in ing_match.group(1).split(\'\\n\'):\n                line = line.strip()\n                if line.startswith(\'- \') or line.startswith(\'* \'):\n                    raw = line.lstrip(\'-* \').strip()\n                    for sep in [\'(\', \'（\']:\n                        if sep in raw: raw = raw[:raw.index(sep)].strip()\n                    ingredients.append((clean_raw(raw), normalize_ingredient(raw), \'\'))\n    \n    if not ingredients:\n        return None\n    \n    return {\'name\': name, \'all_ingredients\': ingredients}\n\n# Parse all recipes\nrecipes = []\nfor root, dirs, files in os.walk(\'/tmp/HowToCook/dishes\'):\n    for fname in sorted(files):\n        if not fname.endswith(\'.md\'):\n            continue\n        result = parse_recipe(os.path.join(root, fname))\n        if result:\n            recipes.append(result)\n\nprint(f"Parsed {len(recipes)} recipes")\n\n# Build candidates with FULL ingredient lists\ncandidates = []\nfor r in recipes:\n    # Build dict of norm -> qty (only for matching ones)\n    norm_dict = {}\n    for orig, norm, qty in r[\'all_ingredients\']:\n        if norm and norm in available_names:\n            norm_dict[norm] = qty\n    \n    matched = list(norm_dict.keys())\n    total = len(r[\'all_ingredients\'])\n    matched_total = len(matched)\n    ratio = matched_total / total if total > 0 else 0\n    \n    if matched_total >= 2:\n        candidates.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': norm_dict,  # only matching ingredients with qty\n            \'all_ings\': r[\'all_ingredients\'],  # ALL ingredients\n            \'matched\': matched,\n            \'total\': total,\n            \'ratio\': ratio\n        })\n\ncandidates.sort(key=lambda x: (-len(x[\'matched\']), -x[\'ratio\'], x[\'name\']))\n\nprint(f"Candidates with >= 2 matches: {len(candidates)}")\nprint("Top 15:")\nfor i, c in enumerate(candidates[:15]):\n    missing = [(o, q) for o, n, q in c[\'all_ings\'] if not n or n not in available_names]\n    print(f"  {i+1}. {c[\'name\']:20s} match:{c[\'matched\']}/total:{c[\'total\']} ({c[\'ratio\']:.0%}) missing:{[o for o,_ in missing[:5]]}")\n\n# Select 3 diverse dishes\nselected_names = [\'炒滑蛋\', \'地三鲜\', \'瘦肉土豆片\']\nselected = [c for c in candidates if c[\'name\'] in selected_names]\n\nprint(f"\\n=== Final Selection ===")\nfor s in selected:\n    in_stock = {n: q for n, q in s[\'ingredients\'].items()}\n    missing = [(o, q) for o, n, q in s[\'all_ings\'] if not n or n not in available_names]\n    missing_names = [n for n in s[\'ingredients\'].keys() if n not in available_names]\n    print(f"\\n{s[\'name\']} ({len(s[\'matched\'])}/{s[\'total\']} = {s[\'ratio\']:.0%})")\n    print(f"  In stock: {list(in_stock.keys())}")\n    print(f"  Missing (not in our stock): {missing_names}")\n    for o, n, q in s[\'all_ings\']:\n        if n and n in available_names:\n            print(f"    [STOCK] {o}: {q}")\n        else:\n            print(f"    [BUY]   {o}: {q}")\n\n# Save cuisine.json\n# For cuisine.json, use only the normalized (matching + other) ingredients as per MCP format\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    # Include ALL ingredients with normalized names\n    ing_dict = {}\n    for orig, norm, qty in s[\'all_ings\']:\n        key = norm if norm else orig  # use original if no normalization\n        if key not in ing_dict:\n            ing_dict[key] = qty\n    for k, v in ing_dict.items():\n        dish["ingredients"][k] = v\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list: all missing ingredients\nshopping = []\nfor s in selected:\n    for orig, norm, qty in s[\'all_ings\']:\n        if not norm or norm not in available_names:\n            # Use original name for non-matching\n            name = orig\n            # Clean up quantity\n            q = qty.strip() if qty else \'\'\n            if q:\n                shopping.append({\'Name\': name, \'Quantity\': q})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nfor item in shopping:\n    print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
