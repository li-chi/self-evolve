Sending keys: ['cat > /app/solve2.py << \'PYEOF\'\nimport json\nimport urllib.request\nimport urllib.parse\nimport re\nimport time\nimport os\n\navailable_names = ["鸡蛋", "土豆", "茄子", "蒜苗", "冬瓜", "瘦猪肉片", "五花肉", "牛奶", "干辣椒"]\n\n# Read dish files from saved list\nwith open(\'/tmp/dish_files.txt\') as f:\n    dish_files = [line.strip() for line in f if line.strip()]\n\ndef fetch_recipe(path):\n    encoded = urllib.parse.quote(path, safe=\'/\')\n    url = f\'https://raw.githubusercontent.com/Anduin2017/HowToCook/master/{encoded}\'\n    try:\n        req = urllib.request.Request(url, headers={\'User-Agent\': \'Mozilla/5.0\'})\n        resp = urllib.request.urlopen(req, timeout=15)\n        return resp.read().decode(\'utf-8\', errors=\'replace\')\n    except Exception:\n        return None\n\ndef clean_ingredient(name):\n    """Remove parenthetical annotations from ingredient names"""\n    name = name.strip()\n    # Remove (别称: xxx) or (推荐 xxx) etc.\n    name = re.split(r\'（[^）]*）\', name)[0].strip()\n    name = re.split(r\'\\([^)]*\\)\', name)[0].strip()\n    return name\n\ndef parse_recipe(content, path):\n    if not content or \'404\' in content or len(content) < 30:\n        return None\n    \n    # Extract title and strip .的做法 suffix\n    title_match = re.search(r\'^# (.+)\', content, re.MULTILINE)\n    if title_match:\n        name = title_match.group(1).strip()\n        name = re.sub(r\'的做法$\', \'\', name)\n        name = re.sub(r\'\\.md$\', \'\', name)\n    else:\n        name = path.split(\'/\')[-1].replace(\'.md\', \'\')\n    \n    # Extract ingredients from 必备原料和工具\n    ingredients = []\n    ing_section = re.search(r\'## 必备原料和工具\\n(.*?)(?=\\n## |$)\', content, re.DOTALL)\n    if ing_section:\n        for line in ing_section.group(1).split(\'\\n\'):\n            line = line.strip()\n            if line.startswith(\'- \'):\n                item = line[2:].strip()\n                # Remove brand/annotation annotations\n                item = clean_ingredient(item)\n                if item:\n                    ingredients.append(item)\n    \n    # Extract quantities from 计算 section\n    quantities = {}\n    calc_section = re.search(r\'## 计算\\n(.*?)(?=\\n## |$)\', content, re.DOTALL)\n    if calc_section:\n        for line in calc_section.group(1).split(\'\\n\'):\n            line = line.strip().lstrip(\'- \')\n            if not line:\n                continue\n            # Skip text lines (sentences)\n            if re.match(r\'^注意|^使用|^计算|^每份|^每次\', line):\n                continue\n            # Skip lines without a quantity\n            # Format: [emoji] 食材 数量  or just 食材 数量\n            # Match: ingredient name followed by quantity\n            m = re.match(r\'^(?:[\\u{1F300}-\\u{1F6FF}\\u{2600}-\\u{27BF}])\\s*(.*)\', line)\n            if m:\n                line = m.group(1)\n            \n            # Look for ingredient + quantity pattern\n            # Pattern: some text, then ingredient name, then amount\n            # Examples: 牛奶 280ml/per, 鸡蛋 1 个/per, 茄子 200g, 土豆 150g, 尖椒 3 - 4 个\n            m = re.match(r\'^(.+?)\\s+(\\d+\\s*[,.\\-\\u223c]\\s*\\d*\\s*个?\\s*g\\s*ml\\s*ml/per|\\d+\\s*[,.\\u223c]\\s*\\d*\\s*个\\s*/per|\\d+\\s*个|\\d+\\s*g|\\d+\\s*ml|\\d+ml|\\d+/per|per|g/ml|/per|份|克|个)$\', line)\n            if not m:\n                # Try: name + simple number+unit\n                m = re.match(r\'^(.+?)\\s+(\\d+\\s*(?:g|ml|个|份))\', line)\n            if not m:\n                # Try: name + number+unit with /per\n                m = re.match(r\'^(.+?)\\s+(\\d+\\s*(?:g|ml|个|份)\\s*/per)\', line)\n            \n            if m:\n                ing_name = clean_ingredient(m.group(1).strip())\n                amount = m.group(2).strip().replace(\'/per\', \'\').strip()\n                quantities[ing_name] = amount\n    \n    return {\n        \'name\': name,\n        \'ingredients\': ingredients,\n        \'quantities\': quantities\n    }\n\ndef match_score(recipe_ingredients):\n    """Match recipe ingredients against available names"""\n    matches = []\n    for ri in recipe_ingredients:\n        for ai in available_names:\n            # Check if available ingredient name is contained in recipe ingredient\n            # or vice versa (for exact or partial match)\n            if ai == ri or ai in ri or ri in ai:\n                matches.append(ri)\n                break\n    return len(matches), recipe_ingredients, matches\n\nprint(f"Found {len(dish_files)} dish files to process")\nall_recipes = []\nsuccess = 0\nfailed = 0\n\nfor i, path in enumerate(dish_files):\n    content = fetch_recipe(path)\n    if content:\n        recipe = parse_recipe(content, path)\n        if recipe and recipe[\'ingredients\']:\n            all_recipes.append(recipe)\n            success += 1\n        else:\n            failed += 1\n    else:\n        failed += 1\n    if (i + 1) % 50 == 0:\n        print(f"  {i+1}/{len(dish_files)}, parsed: {len(all_recipes)}, fail: {failed}")\n    time.sleep(0.3)\n\nprint(f"\\nParsed {len(all_recipes)} recipes with ingredients ({success} success, {failed} fail)")\n\n# Score and filter\nscored = []\nfor recipe in all_recipes:\n    m, all_i, matched = match_score(recipe[\'ingredients\'])\n    total = len(recipe[\'ingredients\'])\n    if total > 0:\n        ratio = m / total\n        scored.append({\n            \'name\': recipe[\'name\'],\n            \'ingredients\': recipe[\'ingredients\'],\n            \'quantities\': recipe[\'quantities\'],\n            \'matches\': m, \'total\': total, \'ratio\': ratio,\n            \'matched_names\': matched,\n            \'missing_names\': [ing for ing in recipe[\'ingredients\'] if ing not in matched]\n        })\n\nscored.sort(key=lambda x: (-x[\'ratio\'], -x[\'matches\']))\nprint(f"\\nAll scored ({len(scored)}) - showing top matches:")\nfor r in scored[:20]:\n    pct = r[\'ratio\']*100\n    has_text = \',\'.join(r[\'matched_names\'])\n    miss_text = \',\'.join(r[\'missing_names\'])\n    print(f"  {r[\'name\']}: {r[\'matches\']}/{r[\'total\']} ({pct:.0f}%) - have: {has_text} | missing: {miss_text}")\n\n# Select 3 dishes\nsoup_kw = [\'汤\', \'粥\', \'羹\', \'炖\', \'煲\']\nsoup_list = [r for r in scored if any(kw in r[\'name\'] for kw in soup_kw)]\nnon_soup = [r for r in scored if r not in soup_list]\n\n# Pick soup first if available, then top non-soups\nselected = []\nif soup_list:\n    selected.append(soup_list[0])\nfor r in non_soup:\n    if len(selected) >= 3:\n        break\n    selected.append(r)\n\n# If we have fewer than 3 and soup was selected, add more soups\nif len(selected) < 3 and len(selected) == 1 and soup_list:\n    for r in soup_list[1:]:\n        if len(selected) >= 3:\n            break\n        selected.append(r)\n\nprint("\\n=== Selected 3 Dishes ===")\nfor r in selected:\n    print(f"  {r[\'name\']}: {r[\'matches\']}/{r[\'total\']} ({r[\'ratio\']*100:.0f}%)")\n    print(f"    Ingredients: {r[\'ingredients\']}")\n    print(f"    Have: {r[\'matched_names\']}")\n    print(f"    Missing: {r[\'missing_names\']}")\n    print(f"    Quantities: {json.dumps(r[\'quantities\'], ensure_ascii=False)}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor r in selected:\n    entry = {"name": r[\'name\'], "ingredients": []}\n    for ing in r[\'ingredients\']:\n        entry[\'ingredients\'].append({\n            "name": ing,\n            "quantity": r[\'quantities\'].get(ing, \'\')\n        })\n    cuisine[\'recommended_dishes\'].append(entry)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=2)\nprint("\\nSaved cuisine.json")\n\n# Shopping list\nshopping = []\nseen = set()\nfor r in selected:\n    for ing in r[\'missing_names\']:\n        if ing not in seen:\n            qty = r[\'quantities\'].get(ing, \'\')\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n            seen.add(ing)\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\') as f:\n    f.write(\'Name,Quantity\\n\')\n    for item in shopping:\n        f.write(f"{item[\'Name\']},{item[\'Quantity\']}\\n")\nprint(f"Saved shopping.csv ({len(shopping)} items)")\nfor s in shopping:\n    print(f"  {s[\'Name\']}: {s[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
