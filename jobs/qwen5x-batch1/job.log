Sending keys: ["cat << 'PYEOF' > /app/transform.py\nimport openpyxl\nfrom datetime import datetime\n\n# Read source\nwb = openpyxl.load_workbook('/app/Household_Appliances.xlsx')\nws = wb.active\n\n# Parse header rows\n# Row 1: main category names, Row 2: metric names\nrow1 = [c.value for c in ws[1]]\nrow2 = [c.value for c in ws[2]]\n\n# Define appliance columns: each has 4 consecutive metric columns\nappliances = [\n    {\n        'name': 'Household Refrigerators',\n        'start_col': 2,  # B\n        'metrics': [\n            ('Current Period Sales(Ten Thousand Units)', 2),   # B\n            ('Accumulated Sales (Ten Thousand Units)', 3),     # C\n            ('Year-on-Year Growth (%)', 4),                    # D\n            ('Accumulated Growth (%)', 5),                     # E\n        ]\n    },\n    {\n        'name': 'Air Conditioners',\n        'start_col': 6,  # F\n        'metrics': [\n            ('Current Period Sales(Ten Thousand Units)', 6),   # F\n            ('Accumulated Sales (Ten Thousand Units)', 7),     # G\n            ('Year-on-Year Growth (%)', 8),                    # H\n            ('Accumulated Growth (%)', 9),                     # I\n        ]\n    },\n    {\n        'name': 'Household Washing Machines',\n        'start_col': 10,  # J\n        'metrics': [\n            ('Current Period Sales(Ten Thousand Units)', 10),  # J\n            ('Accumulated Sales (Ten Thousand Units)', 11),    # K\n            ('Year-on-Year Growth (%)', 12),                   # L\n            ('Accumulated Growth (%)', 13),                    # M\n        ]\n    }\n]\n\n# Read data rows starting from row 3\ndata_rows = []\nfor row_num in range(3, ws.max_row + 1):\n    time_val = ws.cell(row=row_num, column=1).value\n    if not isinstance(time_val, datetime):\n        continue\n    \n    month_key = time_val.strftime('%Y-%m')\n    \n    for app in appliances:\n        metrics = {}\n        has_any_data = False\n        for metric_name, col in app['metrics']:\n            val = ws.cell(row=row_num, column=col).value\n            metrics[metric_name] = val\n            if val is not None:\n                has_any_data = True\n        \n        if has_any_data:\n            data_rows.append({\n                'time': month_key,\n                'datetime': time_val,\n                'appliance': app['name'],\n                'metrics': metrics,\n                'has_data': True\n            })\n\n# Sort reverse chronological\ndata_rows.sort(key=lambda x: x['datetime'], reverse=True)\n\n# Write output\nout_wb = openpyxl.Workbook()\nout_ws = out_wb.active\nout_ws.title = 'Sheet1'\n\n# Header\nout_ws.append(['Time', 'Appliance types', 'Current Period Sales(Ten Thousand Units)', \n               'Accumulated Sales (Ten Thousand Units)', 'Year-on-Year Growth (%)', \n               'Accumulated Growth (%)'])\n\nfor row in data_rows:\n    m = row['metrics']\n    # Multiply growth values by 100\n    yoy = m['Year-on-Year Growth (%)']\n    ag = m['Accumulated Growth (%)']\n    yoy_val = round(yoy * 100, 10) if yoy is not None else None\n    ag_val = round(ag * 100, 10) if ag is not None else None\n    \n    out_ws.append([\n        row['time'],\n        row['appliance'],\n        m['Current Period Sales(Ten Thousand Units)'],\n        m['Accumulated Sales (Ten Thousand Units)'],\n        yoy_val,\n        ag_val\n    ])\n\nout_wb.save('/app/Processed.xlsx')\nprint(f'Written {len(data_rows)} rows to Processed.xlsx')\nPYEOF\npython3 /app/transform.py\n"] min_timeout_sec: 3.0 max_timeout_sec: 180.0
