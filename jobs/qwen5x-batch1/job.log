Sending keys: ['cat > /app/process_recipes.py << \'PYEOF\'\nimport os\nimport re\nimport json\nimport csv\nfrom pathlib import Path\n\navailable = {\n    \'鸡蛋\': \'2个\',\n    \'土豆\': \'100g\',\n    \'茄子\': \'200g\',\n    \'蒜苗\': \'100g\',\n    \'冬瓜\': \'100g\',\n    \'瘦猪肉片\': \'150g\',\n    \'五花肉\': \'100g\',\n    \'牛奶\': \'30ml\',\n    \'干辣椒\': \'50g\'\n}\n\ndef parse_recipes(repo_path):\n    dishes_dir = os.path.join(repo_path, \'dishes\')\n    recipes = []\n    for root, dirs, files in os.walk(dishes_dir):\n        for fname in files:\n            if not fname.endswith(\'.md\'):\n                continue\n            fpath = os.path.join(root, fname)\n            try:\n                with open(fpath, \'r\', encoding=\'utf-8\') as f:\n                    content = f.read()\n            except:\n                continue\n            \n            # Get dish name from first # header\n            name = None\n            for line in content.split(\'\\n\'):\n                m = re.match(r\'^#\\s+(.+)\', line.strip())\n                if m:\n                    name = m.group(1).strip()\n                    break\n            if not name:\n                continue\n            \n            # Try to find ingredient section\n            ingredients = {}\n            \n            # Strategy 1: Look for "## 计算" section and parse lines after it\n            calc_match = re.search(r\'## 计算\\n(.*?)(?:## |$)\', content, re.DOTALL)\n            if calc_match:\n                calc_section = calc_match.group(1)\n                \n                # Strategy 1a: Parse "- ingredient quantity" or "* ingredient quantity" style\n                for line in calc_section.split(\'\\n\'):\n                    line = line.strip()\n                    if not line:\n                        continue\n                    # Skip metadata lines\n                    if line.startswith(\'#\') or line.startswith(\'---\') or line.startswith(\'**\'):\n                        continue\n                    if \'=\' in line and not line.strip().startswith(\'-\') and not line.strip().startswith(\'*\'):\n                        continue\n                    \n                    # Pattern: - ingredient_name quantity (e.g., "- 鸡蛋 2个")\n                    # Or:   - ingredient_name = quantity\n                    # Or:   * ingredient quantity\n                    m = re.match(r\'^[-*]\\s+(.+?)\\s*=?\\s*(\\d+\\s*[一-鿿\\u00b7.gkgmla-zA-Z]+)\\b\', line)\n                    if not m:\n                        m = re.match(r\'^[-*]\\s+(.+?)\\s*=\\s*(\\d+\\s*[一-鿿\\u00b7.gkgmla-zA-Z]+)\\b\', line)\n                    if m:\n                        ing_name = m.group(1).strip()\n                        ing_qty = m.group(2).strip()\n                        # Remove trailing unit suffixes for cleaner name\n                        if \'(\' in ing_name:\n                            ing_name = ing_name[:ing_name.index(\'(\')].strip()\n                        # Skip if it looks like a note or instruction\n                        if len(ing_name) < 1:\n                            continue\n                        if ing_name in (\'必须配料\', \'进阶配料\', \'可选配料\', \'主料\', \'调料\', \'香料包\', \'丸子部分\', \'酱汁部分\'):\n                            continue\n                        # Skip measurement conversion lines\n                        if \'汤匙\' in ing_name or \'茶匙\' in ing_name and \'=\' in line:\n                            if re.match(r\'^-\\s+\\d+\', line):\n                                continue\n                        ingredients[ing_name] = ing_qty\n                \n                # Strategy 1b: Parse table format under 计算\n                # |原料|数量|单位|\n                table_pattern = re.compile(r\'\\|([^|]+)\\|([^|]+)\\|[^|]*\\|\')\n                for line in calc_section.split(\'\\n\'):\n                    table_match = table_pattern.match(line.strip())\n                    if table_match:\n                        tname = table_match.group(1).strip()\n                        tqty = table_match.group(2).strip()\n                        if tname in (\'原料\', \'数量\', \'单位\'):\n                            continue\n                        # Only add if it looks like an actual ingredient\n                        if tname and tqty:\n                            ingredients[tname] = tqty\n            \n            # Strategy 2: If no 计算 section, try the main ingredient list under "## 必备原料和工具"\n            if not ingredients:\n                ing_section = re.search(r\'## 必备原料和工具\\n(.*?)(?:## |$)\', content, re.DOTALL)\n                if ing_section:\n                    for line in ing_section.group(1).split(\'\\n\'):\n                        line = line.strip()\n                        if line.startswith(\'- \'):\n                            ing = line[2:].strip()\n                            # Remove note in parentheses\n                            if \'(\' in ing:\n                                ing = ing[:ing.index(\'(\')].strip()\n                            if ing and len(ing) > 1 and ing not in (\'可选原料\',):\n                                ingredients[ing] = \'\'\n            \n            if not ingredients:\n                continue\n            \n            recipes.append({\'name\': name, \'ingredients\': ingredients})\n    \n    return recipes\n\ndef match_score(name, ingredients, available):\n    matched = []\n    for ing in ingredients:\n        # Direct match\n        if ing in available:\n            matched.append(ing)\n        else:\n            # Check if available ingredient is in the recipe ingredient or vice versa\n            # e.g., "鸡蛋" matches "鸡蛋 2个" or "鸡蛋"\n            for av in available:\n                if av in ing or ing in av:\n                    matched.append(ing)\n                    break\n            # Also try removing common suffixes\n            if not any(m in available for m in matched[-1:] if matched):\n                # strip numbers/units from name\n                clean = re.sub(r\'[\\s0-9一-鿿\\u00b7gkgmlA-Z/.（）\\-=]+$]\', \'\', ing).strip()\n                if clean in available:\n                    matched.append(ing)\n    ratio = len(matched) / len(ingredients) if ingredients else 0\n    return len(matched), ratio, matched\n\nprint("Loading recipes...")\nrecipes = parse_recipes(\'/tmp/HowToCook\')\nprint(f"Loaded {len(recipes)} recipes")\n\n# Score and filter\nscores = []\nfor r in recipes:\n    matched_count, ratio, matched_list = match_score(r[\'name\'], r[\'ingredients\'], available)\n    # Need at least half of ingredient types from our stock, and at least 2 matches\n    if ratio >= 0.5 and matched_count >= 2:\n        scores.append({\n            \'name\': r[\'name\'],\n            \'ingredients\': r[\'ingredients\'],\n            \'matched_count\': matched_count,\n            \'total\': len(r[\'ingredients\']),\n            \'ratio\': ratio,\n            \'matched_list\': matched_list\n        })\n\nscores.sort(key=lambda x: (-x[\'matched_count\'], -x[\'ratio\']))\n\nprint(f"\\nCandidates (>=50% coverage, >=2 matches): {len(scores)}")\nfor c in scores[:30]:\n    print(f"  {c[\'name\']}: {c[\'matched_count\']}/{c[\'total\']} ({c[\'ratio\']:.0%}) - matched: {c[\'matched_list\']}")\n\n# Select 3 diverse dishes\nselected = []\nfor s in scores:\n    if len(selected) >= 3:\n        break\n    selected.append(s)\n\nprint(f"\\nSelected {len(selected)} dishes:")\nfor s in selected:\n    print(f"  {s[\'name\']} ({s[\'matched_count\']}/{s[\'total\']})")\n    for ing, qty in s[\'ingredients\'].items():\n        has = \'OK\' if ing in available else \'MISSING\'\n        print(f"    [{has}] {ing}: {qty}")\n\n# Save cuisine.json\ncuisine = {"recommended_dishes": []}\nfor s in selected:\n    dish = {"name": s[\'name\'], "ingredients": {}}\n    for ing, qty in s[\'ingredients\'].items():\n        dish["ingredients"][ing] = qty\n    cuisine["recommended_dishes"].append(dish)\n\nwith open(\'/app/cuisine.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(cuisine, f, ensure_ascii=False, indent=4)\nprint("\\nSaved cuisine.json")\n\n# Shopping list: ingredients not in stock, or we have less than needed\nshopping = []\nfor s in selected:\n    for ing, qty in s[\'ingredients\'].items():\n        if ing not in available:\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n        elif available[ing] != qty and qty:\n            # We have some but need more - list what\'s needed\n            shopping.append({\'Name\': ing, \'Quantity\': qty})\n\nwith open(\'/app/shopping.csv\', \'w\', encoding=\'utf-8\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'Name\', \'Quantity\'])\n    writer.writeheader()\n    writer.writerows(shopping)\nprint(f"Saved shopping.csv with {len(shopping)} items")\nif shopping:\n    for item in shopping:\n        print(f"  {item[\'Name\']}: {item[\'Quantity\']}")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
