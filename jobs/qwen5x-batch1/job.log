 "", tm.group(1).strip())\')\nlines.append(\'    else:\')\nlines.append(\'        name = path.split("/")[-1].replace(".md", "")\')\nlines.append(\'    ingredients = []\')\nlines.append(\'    im = re.search(r"## 必备原料和工具[\\\\n](.*?)[\\\\n]## |$", content, re.DOTALL)\')\nlines.append(\'    if im:\')\nlines.append(\'        for line in im.group(1).split("\\\\n"):\')\nlines.append(\'            line = line.strip()\')\nlines.append(\'            if line.startswith("- "):\')\nlines.append(\'                item = clean_ing(line[2:])\')\nlines.append(\'                if item: ingredients.append(item)\')\nlines.append(\'    ingredients = split_ingredients(ingredients)\')\nlines.append(\'    quantities = {}\')\nlines.append(\'    qm = re.search(r"## 计算[\\\\n](.*?)(?:[\\\\n]## |$)", content, re.DOTALL)\')\nlines.append(\'    if qm:\')\nlines.append(\'        qt = qm.group(1)\')\nlines.append(\'        pm = re.search(r"每份[：:]([\\\\s\\\\S]*?)(?:[\\\\n]## |$)", qt)\')\nlines.append(\'        fm = re.search(r"总量[：:]([\\\\s\\\\S]*?)(?:[\\\\n]## |$)", qt)\')\nlines.append(\'        if pm:\')\nlines.append(\'            for line in pm.group(1).split("\\\\n"):\')\nlines.append(\'                line = line.strip()\')\nlines.append(\'                if line.startswith("- "): line = line[2:].strip()\')\nlines.append(\'                mm = re.match(r"^(.+?)\\\\s+(\\\\d+[^\\\\n]*)$", line)\')\nlines.append(\'                if mm:\')\nlines.append(\'                    iname = clean_ing(mm.group(1).strip())\')\nlines.append(\'                    qty = mm.group(2).strip().replace("每份", "").strip()\')\nlines.append(\'                    if iname and qty: quantities[iname] = qty\')\nlines.append(\'        elif fm:\')\nlines.append(\'            for line in fm.group(1).split("\\\\n"):\')\nlines.append(\'                line = line.strip()\')\nlines.append(\'                if line.startswith("- "): line = line[2:].strip()\')\nlines.append(\'                mm = re.match(r"^(.+?)[=:](.*)$", line)\')\nlines.append(\'                if mm:\')\nlines.append(\'                    bname = clean_ing(mm.group(1).strip())\')\nlines.append(\'                    qmm = re.search(r"(\\\\d+[^\\\\n]+)", mm.group(2).strip())\')\nlines.append(\'                    qty = qmm.group(1).strip() if qmm else mm.group(2).strip()\')\nlines.append(\'                    qty = re.sub(r"（[^）]*）", "", qty).strip()\')\nlines.append(\'                    if bname and qty: quantities[bname] = qty\')\nlines.append(\'    return {"name": name, "ingredients": ingredients, "quantities": quantities}\')\nlines.append(\'print("Processing", len(dish_files))\')\nlines.append(\'all_r = []\')\nlines.append(\'for i, path in enumerate(dish_files):\')\nlines.append(\'    c = fetch_recipe(path)\')\nlines.append(\'    if c:\')\nlines.append(\'        r = parse_recipe(c, path)\')\nlines.append(\'        if r and r["ingredients"]: all_r.append(r)\')\nlines.append(\'    if (i+1) % 50 == 0: print("  ", i+1, len(all_r))\')\nlines.append(\'    time.sleep(0.3)\')\nlines.append(\'print("Parsed", len(all_r))\')\nlines.append(\'scored = []\')\nlines.append(\'for r in all_r:\')\nlines.append(\'    mt = []\')\nlines.append(\'    for ri in r["ingredients"]:\')\nlines.append(\'        for ai in avail:\')\nlines.append(\'            if ai == ri or ai in ri or ri in ai: mt.append(ri); break\')\nlines.append(\'    m = len(mt); t = len(r["ingredients"])\')\nlines.append(\'    if t > 0:\')\nlines.append(\'        scored.append({"name": r["name"], "ingredients": r["ingredients"], "quantities": r["quantities"], "matches": m, "total": t, "ratio": m/t, "matched": mt, "missing": [x for x in r["ingredients"] if x not in mt]})\')\nlines.append(\'scored.sort(key=lambda x: (-x["ratio"], -x["matches"]))\')\nlines.append(\'for r in scored[:20]:\')\nlines.append(\'    print(" ", r["name"], r["matches"], "/", r["total"], round(r["ratio"]*100), "%")\')\nlines.append(\'    print("   Have:", r["matched"])\')\nlines.append(\'    print("   Missing:", r["missing"])\')\nlines.append(\'    print("   Qty:", json.dumps(r["quantities"], ensure_ascii=False))\')\nlines.append(\'    print()\')\nlines.append(\'soup_kw = ["汤", "粥", "羹", "炖", "煲"]\')\nlines.append(\'soup_l = [r for r in scored if any(kw in r["name"] for kw in soup_kw)]\')\nlines.append(\'other_l = [r for r in scored if r not in soup_l]\')\nlines.append(\'selected = []\')\nlines.append(\'if soup_l: selected.append(soup_l[0])\')\nlines.append(\'for r in other_l:\')\nlines.append(\'    if len(selected) >= 3: break\')\nlines.append(\'    selected.append(r)\')\nlines.append(\'print("Selected:")\')\nlines.append(\'for r in selected:\')\nlines.append(\'    print(r["name"], r["matches"], "/", r["total"], round(r["ratio"]*100))\')\nlines.append(\'    print("  Have:", r["matched"])\')\nlines.append(\'    print("  Missing:", r["missing"])\')\nlines.append(\'    print("  Qty:", json.dumps(r["quantities"], ensure_ascii=False))\')\nlines.append(\'cuisine = {"recommended_dishes": []}\')\nlines.append(\'for r in selected:\')\nlines.append(\'    e = {"name": r["name"], "ingredients": []}\')\nlines.append(\'    for ing in r["ingredients"]:\')\nlines.append(\'        e["ingredients"].append({"name": ing, "quantity": r["quantities"].get(ing, "")})\')\nlines.append(\'    cuisine["recommended_dishes"].append(e)\')\nlines.append(\'with open("/app/cuisine.json", "w", encoding="utf-8") as f: json.dump(cuisine, f, ensure_ascii=False, indent=2)\')\nlines.append(\'print("Saved cuisine.json")\')\nlines.append(\'shopping = []; seen = set()\')\nlines.append(\'for r in selected:\')\nlines.append(\'    for ing in r["missing"]:\')\nlines.append(\'        if ing not in seen: shopping.append({"Name": ing, "Quantity": r["quantities"].get(ing, "")}); seen.add(ing)\')\nlines.append(\'with open("/app/shopping.csv", "w", encoding="utf-8") as f:\')\nlines.append(\'    f.write("Name,Quantity" + chr(10))\')\nlines.append(\'    for item in shopping: f.write(item["Name"] + "," + item["Quantity"] + chr(10))\')\nlines.append(\'print("Saved shopping.csv", len(shopping))\')\nwith open(\'/app/solve_final.py\', \'w\', encoding=\'utf-8\') as f:\n    f.write(chr(10).join(lines) + chr(10))\nprint(\'Written \' + str(len(lines)) + \' lines\')\nPYEND\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
