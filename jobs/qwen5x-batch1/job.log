: content = f.read()'+NL\ns+='    except Exception: continue'+NL\ns+='    dc = desensitize(content)'+NL\ns+='    name, ext = os.path.splitext(filename)'+NL\ns+='    ofn = name + '+Q+'_desensitized'+Q+' + ext'+NL\ns+='    with open(os.path.join(output_dir, ofn), '+Q+'w'+Q+', encoding='+Q+'utf-8'+Q+') as f: f.write(dc)'+NL\ns+='    processed += 1'+NL\ns+='    print('+Q+'Processed: '+Q+'+ filename + '+Q+' -> '+Q+'+ ofn)'+NL\ns+='print('+Q+'Total: '+Q+'+ str(processed))'+NL\nwith open('/app/desensitize.py','w') as f:\n    f.write(s)\nprint('Generated OK')\nGENFILE\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
