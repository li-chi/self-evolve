Sending keys: ['cat > /app/generate.py << \'PYEOF\'\nimport re\nimport openpyxl\nfrom openpyxl import Workbook\n\nwith open(\'/app/pdf_text.txt\', \'r\') as f:\n    text = f.read()\n\n# Fixed courses\ncourses_data = [\n    # (line_in_text, course_line)\n    (15990, \'COMP130141.01 自然语言处理 2 黄萱菁 教授 一 2-3 [1-16] 邯郸校区 60 闭卷 大数据与人工智能(2023)\'),\n    (15846, \'COMP130025.01 软件体系结构 2 陈彤兵 讲师 一 4-5 [1-16] 邯郸校区 50 闭卷 23 22 计算机科学与技术\'),\n    (983, \'PTSS110080.01 中国共产党历史 2 薛小荣 副教授 一 11-12 [1-15] 邯郸校区 180 思政B 开卷 是\'),\n]\n\ndef parse_course_line(line):\n    line = line.strip()\n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\\s+(.+)\', line)\n    if not m:\n        return None\n    code = m.group(1)\n    rest = m.group(2)\n    \n    parts = rest.split()\n    \n    # Find time position\n    time_pos = -1\n    for j, p in enumerate(parts):\n        if p in [\'一\', \'二\', \'三\', \'四\', \'五\', \'六\'] and j+1 < len(parts):\n            if re.match(r\'\\d+-\\d+\', parts[j+1]):\n                time_pos = j\n                break\n    \n    if time_pos <= 0:\n        return {\'Course ID\': code}\n    \n    # Parse before time\n    before_time = parts[:time_pos]\n    course_name = \'\'\n    credits = \'\'\n    instructor = \'\'\n    title = \'\'\n    \n    credit_idx = -1\n    for k in range(len(before_time)-1, 0, -1):\n        if before_time[k].isdigit() and int(before_time[k]) <= 5:\n            credit_idx = k\n            break\n    \n    if credit_idx > 0:\n        course_name = \' \'.join(before_time[:credit_idx])\n        credits = before_time[credit_idx]\n        instructor_parts = before_time[credit_idx+1:]\n        if len(instructor_parts) >= 2:\n            instructor = instructor_parts[0]\n            title = \' \'.join(instructor_parts[1:])\n        elif len(instructor_parts) == 1:\n            instructor = instructor_parts[0]\n    \n    # Parse after time\n    after_time_parts = parts[time_pos:]\n    class_time = \' \'.join(after_time_parts[:3])\n    \n    # Extract campus\n    campus = \'\'\n    for c in [\'邯郸校区\', \'枫林校区\', \'江湾校区\', \'张江校区\']:\n        if c in rest:\n            campus = c\n            break\n    \n    # Find enrollment (number after campus)\n    enrollment = \'\'\n    campus_match = re.search(r\'(?:邯郸校区|枫林校区|江湾校区|张江校区)\\s+(\\d+)\', rest)\n    if campus_match:\n        enrollment = campus_match.group(1)\n    \n    # Find assessment method\n    assessment = \'\'\n    # After enrollment, look for assessment keywords\n    after_enroll = rest[campus_match.end():] if campus_match else rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_enroll:\n            assessment = a\n            break\n    # Also check the full line\n    if not assessment:\n        for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n            if a in rest:\n                assessment = a\n                break\n    \n    # Find exam time (date format)\n    exam_time = \'\'\n    exam_match = re.search(r\'(\\d{4}-\\d{2}-\\d{2})\', rest)\n    if exam_match:\n        exam_time = exam_match.group(1)\n    \n    # Find restrictions\n    restrictions = \'\'\n    # After assessment, rest of text\n    after_assess = rest\n    for a in [\'开卷\', \'闭卷\', \'半开卷\', \'论文\', \'视频教学\', \'随堂考试\', \'研讨型课程\']:\n        if a in after_assess:\n            idx = after_assess.find(a)\n            after_assess = after_assess[idx+len(a):]\n            break\n    restrictions = after_assess.strip()\n    \n    return {\n        \'Course name\': course_name,\n        \'Course ID\': code,\n        \'Instructor\': instructor,\n        \'Campus\': campus,\n        \'Class Time\': class_time,\n        \'Enrollment\': enrollment,\n        \'Credits\': credits,\n        \'Assessment Method\': assessment,\n        \'Exam Time\': exam_time,\n        \'Course Selection Restrictions\': restrictions,\n        \'_day\': parts[time_pos] if time_pos < len(parts) else \'\',\n        \'_time\': parts[time_pos+1] if time_pos+1 < len(parts) else \'\'\n    }\n\n# Parse fixed courses\nfixed = []\nfor line_num, line in courses_data:\n    parsed = parse_course_line(line)\n    if parsed:\n        fixed.append(parsed)\n        print(f"Parsed: {parsed[\'Course name\']} - {parsed[\'Class Time\']}")\n\n# Extract 通识教育核心课程 Monday 开卷 options\nstart_line = 1059\nend_line = 6038\ntongren_courses = []\n\nfor i, line in enumerate(text.split(\'\\n\')):\n    line_num = i + 1\n    if line_num < start_line or line_num > end_line:\n        continue\n    \n    m = re.match(r\'([A-Z]{2,4}[0-9]+\\.[0-9]+)\', line)\n    if not m:\n        continue\n    \n    day_match = re.search(r\'(一)\\s+(\\d+-\\d+)\\s+\\[\', line)\n    if day_match and \'开卷\' in line and \'思政\' not in line and \'半开卷\' not in line:\n        parsed = parse_course_line(line)\n        if parsed and parsed[\'Class Time\']:\n            tongren_courses.append(parsed)\n            print(f"Option: {parsed[\'Course name\']} - {parsed[\'Class Time\']} - {parsed[\'Assessment Method\']}")\n\nprint(f"\\nFixed courses: {len(fixed)}")\nprint(f"通识教育核心课程 options: {len(tongren_courses)}")\n\n# Check for time conflicts\nfixed_times = [f[\'_day\'] + f[\'_time\'] for f in fixed]\nprint(f"Fixed times: {fixed_times}")\n\nfor opt in tongren_courses:\n    opt_time = opt[\'_day\'] + opt[\'_time\']\n    has_conflict = False\n    for ft in fixed_times:\n        # Check if times overlap\n        ft_parts = re.match(r\'(\\w)(\\d+-\\d+)\', ft)\n        ot_parts = re.match(r\'(\\w)(\\d+-\\d+)\', opt_time)\n        if ft_parts and ot_parts and ft_parts.group(1) == ot_parts.group(1):\n            ft_start, ft_end = map(int, ft_parts.group(2).split(\'-\'))\n            ot_start, ot_end = map(int, ot_parts.group(2).split(\'-\'))\n            if ft_start <= ot_end and ot_start <= ft_end:\n                has_conflict = True\n                print(f"CONFLICT: {opt[\'Course name\']} ({opt_time}) vs {ft}")\n    if not has_conflict:\n        opt[\'valid\'] = True\n    else:\n        opt[\'valid\'] = False\n\nvalid_options = [o for o in tongren_courses if o.get(\'valid\', True)]\nprint(f"Valid options (no conflict): {len(valid_options)}")\n\n# Create Excel files for each scheme\nwb_ref = openpyxl.load_workbook(\'/app/reference_format.xlsx\')\nsheet_ref = wb_ref[\'Sheet1\']\n\nfor idx, opt in enumerate(valid_options):\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'Sheet1\'\n    \n    # Copy header from reference\n    for col in range(1, sheet_ref.max_column + 1):\n        ws.cell(row=1, column=col, value=sheet_ref.cell(row=1, column=col).value)\n    \n    all_courses = fixed + [opt]\n    for row_idx, course in enumerate(all_courses, start=2):\n        fields = [\'Course name\', \'Course ID\', \'Instructor\', \'Campus\', \'Class Time\', \n                  \'Enrollment\', \'Credits\', \'Assessment Method\', \'Exam Time\', \'Course Selection Restrictions\']\n        for col_idx, field in enumerate(fields, start=1):\n            val = course.get(field, \'\')\n            if val is None:\n                val = \'\'\n            ws.cell(row=row_idx, column=col_idx, value=val)\n    \n    # Save with encoding\n    filename = f\'/app/scheme_{idx+1}.xlsx\'\n    wb.save(filename)\n    print(f"Saved: {filename} with course {opt[\'Course name\']}")\n\n# Clean up\nimport os\nos.remove(\'/app/pdf_text.txt\')\nif os.path.exists(\'/app/search_nlp.txt\'):\n    os.remove(\'/app/search_nlp.txt\')\nif os.path.exists(\'/app/extract.py\'):\n    os.remove(\'/app/extract.py\')\nif os.path.exists(\'/app/generate.py\'):\n    os.remove(\'/app/generate.py\')\n\nprint("\\nDone! Files saved.")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
