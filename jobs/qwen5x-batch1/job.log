[j+1] if j+1 < len(lines) else \'\'):\n                j += 1\n            \n            if j < len(lines):\n                # Module (sometimes on same line or next)\n                # Course name (can be multiline)\n                course_name = \'\'\n                while j < len(lines) and lines[j].strip() and not re.match(r\'^\\d+\\.?\\d*$\', lines[j].strip()) and \\\n                      not re.match(r\'^\\s*[一二三四五六日]\', lines[j].strip()) and \\\n                      not re.match(r\'^[A-Z]{2,4}\\d{5,6}\\.\\d+$\', lines[j].strip()) and \\\n                      not re.match(r\'^考试\', lines[j].strip()) and \\\n                      not re.match(r\'^第\\s\', lines[j].strip()):\n                    if course_name:\n                        course_name += lines[j].strip()\n                    else:\n                        course_name = lines[j].strip()\n                    j += 1\n                if course_name:\n                    course[\'name\'] = course_name\n                \n                # Credits (a number like 2, 3, 4.5)\n                if j < len(lines) and re.match(r\'^\\d+\\.?\\d*$\', lines[j].strip()):\n                    course[\'credits\'] = lines[j].strip()\n                    j += 1\n                \n                # Instructor name\n                if j < len(lines) and lines[j].strip():\n                    course[\'instructor\'] = lines[j].strip()\n                    j += 1\n                \n                # Title (职称) - check if it\'s a title like 教授, 副教授, etc.\n                if j < len(lines) and lines[j].strip() in (\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'青年副研究员\', \'副研究员\', \'研究员\'):\n                    course[\'title\'] = lines[j].strip()\n                    j += 1\n                \n                # Time (like 一 4-5 [1-16])\n                time_pattern = re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[.*?\\]\', lines[j].strip())\n                if time_pattern:\n                    course[\'time\'] = lines[j].strip()\n                    j += 1\n                \n                # Classroom\n                if j < len(lines) and lines[j].strip() in (\'邯郸校区\', \'江湾校区\', \'枫林校区\'):\n                    course[\'campus\'] = lines[j].strip()\n                    j += 1\n                \n                # Enrollment (number)\n                if j < len(lines) and re.match(r\'^\\d+$\', lines[j].strip()):\n                    course[\'enrollment\'] = lines[j].strip()\n                    j += 1\n                \n                # Notes (备注) - can be multiline\n                notes = \'\'\n                while j < len(lines) and lines[j].strip() and not re.match(r\'^考试\', lines[j].strip()) and \\\n                      not re.match(r\'^[A-Z]{2,4}\\d{5,6}\\.\\d+$\', lines[j].strip()) and \\\n                      not re.match(r\'^含A\\+$\', lines[j].strip()):\n                    if notes:\n                        notes += lines[j].strip() + \' \'\n                    else:\n                        notes = lines[j].strip()\n                    j += 1\n                if notes.strip():\n                    course[\'notes\'] = notes.strip()\n                \n                # Exam date and time\n                while j < len(lines) and lines[j].strip():\n                    if \'考试日期\' in lines[j]:\n                        course[\'exam_date\'] = lines[j].strip().replace(\'考试日期:\', \'\').strip()\n                    elif \'考试时间\' in lines[j]:\n                        exam_time_val = lines[j].strip().replace(\'考试时间:\', \'\').strip()\n                        if not course.get(\'exam_time\'):\n                            course[\'exam_time\'] = exam_time_val\n                        else:\n                            course[\'exam_time\'] += \' | \' + exam_time_val\n                    j += 1\n                \n                # Assessment method\n                if j < len(lines) and lines[j].strip() in (\'开卷\', \'闭卷\', \'论文\', \'口试\', \'其他\'):\n                    course[\'assessment\'] = lines[j]