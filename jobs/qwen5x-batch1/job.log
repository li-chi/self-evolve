tion(\'白砂糖\', 1),             # avg(0, 2)\n    calc_nutrition(\'葱花\', 5),               # avg(0, 10)\n)\nprint(f"Carbs: {d1[\'carbs\']:.4f}g")\nprint(f"Protein: {d1[\'protein\']:.4f}g")\n\nprint("\\n=== 荔枝肉 (1 portion) ===")\nd2 = sum_dicts(\n    calc_nutrition(\'鲜香菇\', 30),            # 2朵 * 15g\n    calc_nutrition(\'蟹味菇\', 30),\n    calc_nutrition(\'瘦肉（猪肉）\', 150),\n    calc_nutrition(\'凤梨（菠萝）\', 100),\n    calc_nutrition(\'鸡蛋\', 50),              # 1 egg = 50g\n    calc_nutrition(\'植物油\', 500 * 0.92),    # 500ml * 0.92g/ml\n    calc_nutrition(\'白砂糖\', 5),\n    calc_nutrition(\'淀粉\', 100),\n    calc_nutrition(\'生抽\', 5 * 1.15),        # 5ml * 1.15g/ml\n    calc_nutrition(\'鸡精\', 5),\n    calc_nutrition(\'姜\', 5),\n    calc_nutrition(\'芝麻\', 2),\n    calc_nutrition(\'番茄酱\', 20),\n    calc_nutrition(\'香醋\', 2 * 1.05),        # 2ml * 1.05g/ml\n)\nprint(f"Carbs: {d2[\'carbs\']:.4f}g")\nprint(f"Protein: {d2[\'protein\']:.4f}g")\n\nprint("\\n=== 葱油桂鱼 (1 portion, half of 2-portion recipe) ===")\nd3 = sum_dicts(\n    calc_nutrition(\'桂鱼\', 250),             # 500g / 2\n    calc_nutrition(\'小葱\', 10),              # 1根 * 10g\n    calc_nutrition(\'小米辣\', 2 * 3),         # 2个 * 3g\n    calc_nutrition(\'姜\', 25),                # 50g / 2\n    calc_nutrition(\'料酒\', 12.5),            # 25g / 2\n    calc_nutrition(\'植物油\', 7.5),           # 15g / 2\n    calc_nutrition(\'盐\', 4),                 # 8g / 2\n    calc_nutrition(\'蒸鱼豉油\', 5),           # 10g / 2\n)\nprint(f"Carbs: {d3[\'carbs\']:.4f}g")\nprint(f"Protein: {d3[\'protein\']:.4f}g")\n\n# Grand total\ntotal = sum_dicts(d1, d2, d3)\nprint(f"\\n=== TOTAL ===")\nprint(f"Carbs: {total[\'carbs\']:.4f}g")\nprint(f"Protein: {total[\'protein\']:.4f}g")\n\n# Expected values\nweight = 65\nbmi = weight / (1.52 ** 2)\nprint(f"\\nBMI: {bmi:.2f}")\n\n# Rest day, fat loss male initial, BMI>28\ncarbs_low = (2.4 - 0.5) * weight  # rest day: -0.5g\ncarbs_high = (2.7 - 0.5) * weight\nprotein_target = 1.2 * weight\n\nprint(f"Expected Carbs: {carbs_low}g-{carbs_high}g")\nprint(f"Expected Protein: {protein_target}g")\n\n# Assessment\nactual_carbs = total[\'carbs\']\nactual_protein = total[\'protein\']\n\ndef assess(actual, low, high):\n    if actual < low * 0.95:\n        return "Below expectations"\n    elif actual > high * 1.05:\n        return "Excessive intake"\n    else:\n        return "Meets expectations"\n\ncarbs_assessment = assess(actual_carbs, carbs_low, carbs_high)\nprotein_assessment = assess(actual_protein, protein_target, protein_target)\n\nprint(f"\\nCarbs assessment: {carbs_assessment}")\nprint(f"Protein assessment: {protein_assessment}")\n\n# Format output\ncarbs_range_str = f"{carbs_low}g-{carbs_high}g"\nprotein_str = f"{protein_target}g"\n\n# Round actual values to 1 decimal\nactual_carbs_rounded = round(actual_carbs, 1)\nactual_protein_rounded = round(actual_protein, 1)\n\nprint(f"\\nFormatted Output:")\nprint(f"Carbs: {carbs_assessment}. Expected: {carbs_range_str} | Actual: {actual_carbs_rounded}g")\nprint(f"Protein: {protein_assessment}. Expected: {protein_str} | Actual: {actual_protein_rounded}g")\n\n# Write analysis.md\noutput = f"""# Today\'s Meal Nutritional Analysis\n\n- **Carbohydrates**: {carbs_assessment}. Expected: {carbs_range_str} | Actual: {actual_carbs_rounded}g\n\n- **Protein**: {protein_assessment}. Expected: {protein_str} | Actual: {actual_protein_rounded}g"""\n\nwith open(\'/app/analysis.md\', \'w\') as f:\n    f.write(output + \'\\n\')\n\nprint("\\nWrote /app/analysis.md")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
