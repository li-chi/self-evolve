Sending keys: ['cat > /tmp/gen_excel.py << \'PYEOF\'\nimport pdfplumber\nimport re\nfrom openpyxl import Workbook\n\nheaders = [\'Course name\', \'Course ID\', \'Instructor\', \'Campus\', \'Class Time\', \'Enrollment\', \'Credits\', \'Assessment Method\', \'Exam Time\', \'Course Selection Restrictions\']\n\npdf = pdfplumber.open(\'/app/25-26学年第一学期课程表.pdf\')\n\n# Define the target courses with their IDs\n# 1. Software Architecture (fixed)\nsa_id = \'COMP130025.01\'\n# 2. NLP (fixed)\nnlp_id = \'COMP130141.01\'\n# 3. 思政B Monday+开卷 (fixed)\nsfb_id = \'PTSS110080.01\'\n# 4. 通识教育核心 Monday+开卷 (5 options)\ntgr_ids = [\'PHIL119038.01\', \'PHIL119059.01\', \'FORE119008.01\', \'INFO119005.01\', \'BIOL119008.01\']\n\nall_target_ids = [sa_id, nlp_id, sfb_id] + tgr_ids\n\n# Extract course data from all relevant pages\ndef extract_all_courses(pdf):\n    courses = {}\n    target_pages = [30, 251, 252, 254, 32, 33, 34, 35, 36, 37]\n    \n    for p in target_pages:\n        page = pdf.pages[p-1]\n        text = page.extract_text() or \'\'\n        lines = text.split(\'\\n\')\n        \n        for i, line in enumerate(lines):\n            # Find all course IDs on this line\n            for m in re.finditer(r\'([A-Z]{2,4}\\d{5,6}\\.\\d+)\', line):\n                cid = m.group(1)\n                if cid not in all_target_ids:\n                    continue\n                \n                # Get the complete entry\n                # The format is: ID Name Credits Instructor Title Time Campus Enrollment Notes ExamDate ExamTime Assessment HasA Dept Restriction\n                # All on one line in pdfplumber output\n                \n                # Start from this line and collect subsequent lines that are exam info\n                block_lines = [line]\n                j = i + 1\n                while j < len(lines) and not re.search(r\'[A-Z]{2,4}\\d{5,6}\\.\\d+\', lines[j]):\n                    # Check if it\'s exam-related or department\n                    if lines[j].strip() and lines[j].strip() not in (\'\', \'考试类型\', \'考试时间\'):\n                        if not any(x in lines[j] for x in [\'考试日期\', \'考试时间\']) or lines[j].strip().startswith(\'考试\'):\n                            block_lines.append(lines[j])\n                            j += 1\n                            continue\n                    if re.search(r\'[A-Z]{2,4}\\d{5,6}\\.\\d+\', lines[j]):\n                        break\n                    if lines[j].strip() in (\'考试日期:\', \'考试时间:\'):\n                        break\n                    if re.match(r\'^\\d{4}-\\d{2}-\\d{2}\', lines[j].strip()):\n                        block_lines.append(lines[j])\n                        j += 1\n                        continue\n                    if \'考试\' in lines[j]:\n                        block_lines.append(lines[j])\n                        j += 1\n                        continue\n                    # Check if it looks like department name\n                    if re.match(r\'^[\\u4e00-\\u9fa5]{2,10}$\', lines[j].strip()):\n                        block_lines.append(lines[j])\n                        j += 1\n                        continue\n                    break\n                \n                full_text = \' \'.join(block_lines)\n                \n                # Parse fields\n                entry = parse_course_line(cid, full_text)\n                if entry:\n                    courses[cid] = entry\n    \n    return courses\n\ndef parse_course_line(cid, text):\n    entry = {\'id\': cid}\n    \n    # Remove the course ID from the beginning to get remaining text\n    remaining = text.replace(cid, \'\', 1).strip()\n    \n    # Try to parse: Name Credits Instructor Title Time Campus Enrollment Notes ExamDate ExamTime Assessment HasA Dept\n    # The course name is 2-10 Chinese characters\n    # Split by spaces\n    tokens = remaining.split()\n    \n    # Course name: Chinese characters (possibly multiple)\n    name = \'\'\n    token_idx = 0\n    \n    # First tokens that are Chinese chars = name\n    while token_idx < len(tokens) and re.match(r\'^[\\u4e00-\\u9fa5\\u3000\\uFF08\\uFF09\\u300E\\u300F\\u201C\\u201D\\u2018\\u2019\\u2014\\u2026]+$\', tokens[token_idx]):\n        if name:\n            name += tokens[token_idx]\n        else:\n            name = tokens[token_idx]\n        token_idx += 1\n    \n    # Credits: number\n    if token_idx < len(tokens) and re.match(r\'^\\d+\\.?\\d*$\', tokens[token_idx]):\n        entry[\'credits\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Instructor: 2-4 Chinese characters\n    if token_idx < len(tokens) and re.match(r\'^[\\u4e00-\\u9fa5]{2,4}$\', tokens[token_idx]):\n        entry[\'instructor\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Title: 教授/副教授/讲师/etc.\n    if token_idx < len(tokens) and tokens[token_idx] in [\'教授\', \'副教授\', \'讲师\', \'助理研究员\', \'副研究员\', \'研究员\', \'青年副研究员\', \'高级工程师\', \'工程师\', \'教授\\(教学为主型\\)\']:\n        entry[\'title\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Time: 一 4-5 [1-16]\n    if token_idx < len(tokens) and re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[\', tokens[token_idx]):\n        entry[\'time\'] = tokens[token_idx]\n        token_idx += 1\n        # Check for additional time slots\n        while token_idx < len(tokens) and re.match(r\'^[一二三四五六日]\\s+\\d+-\\d+\\s+\\[\', tokens[token_idx]):\n            entry[\'time\'] += \' \' + tokens[token_idx]\n            token_idx += 1\n    \n    # Campus\n    if token_idx < len(tokens) and tokens[token_idx] in [\'邯郸校区\', \'江湾校区\', \'枫林校区\', \'张江校区\']:\n        entry[\'campus\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Enrollment (number)\n    if token_idx < len(tokens) and re.match(r\'^\\d+$\', tokens[token_idx]):\n        entry[\'enrollment\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Notes/Remarks (text between enrollment and exam info)\n    notes_parts = []\n    while token_idx < len(tokens):\n        t = tokens[token_idx]\n        # Stop at exam-related tokens\n        if t in [\'考试日期\', \'闭卷\', \'开卷\', \'闭卷\', \'闭卷\'] or re.match(r\'^\\d{4}-\', t):\n            break\n        if \'考试\' in t and not t.startswith(\'考试\'):\n            break\n        # Check if it looks like department\n        if re.match(r\'^[\\u4e00-\\u9fa5]{2,10}$\', t):\n            entry[\'department\'] = t\n            token_idx += 1\n            continue\n        notes_parts.append(t)\n        token_idx += 1\n    \n    # Assessment (闭卷/开卷/论文/口试/其他)\n    if token_idx < len(tokens) and tokens[token_idx] in [\'开卷\', \'闭卷\', \'论文\', \'口试\', \'其他\', \'报告\']:\n        entry[\'assessment\'] = tokens[token_idx]\n        token_idx += 1\n    \n    # Check for A+\n    if token_idx < len(tokens) and tokens[token_idx] == \'是\':\n        entry[\'has_a_plus\'] = \'是\'\n        token_idx += 1\n    \n    # Department might be captured later\n    if \'department\' not in entry:\n        # Look in the full text for department\n        dept_match = re.search(r\'(计算与智能创新学院|计算机科学技术学院|马克思主义学院|哲学学院|外国语言文学学院|信息科学与工程学院|生命科学学院|中国语言文学系|国际关系与公共事务学院)\', text)\n        if dept_match:\n            entry[\'department\'] = dept_match.group(1)\n    \n    # Exam time from remaining text\n    exam_match = re.search(r\'考试时间:\\s*([^\\n]+)\', text)\n    if exam_match:\n        entry[\'exam_time\'] = exam_match.group(1).strip()\n    \n    return entry\n\ncourses = extract_all_courses(pdf)\n\nprint(\'\\nExtracted courses:\')\nfor cid, c in courses.items():\n    print(f\'  {cid}: {c}\')\n\npdf.close()\n\n# Check which required courses we have\nfor cid in all_target_ids:\n    if cid in courses:\n        print(f\'OK: {cid} - {courses[cid].get("name", "N/A")}\')\n    else:\n        print(f\'MISSING: {cid}\')\nPYEOF\npython3 /tmp/gen_excel.py 2>&1\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
