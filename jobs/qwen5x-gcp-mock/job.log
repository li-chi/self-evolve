Sending keys: ['cat > /app/find_anomalies.py << \'PYEOF\'\nimport pandas as pd\nimport json\nimport subprocess\nimport csv\n\n# 1. Read Excel parameters\ndf_params = pd.read_excel(\'/app/machine_operating_parameters.xlsx\', sheet_name=\'Operating Parameters\')\nprint(f"Excel params: {len(df_params)} rows")\nprint(df_params.head())\n\n# Create lookup: (machine_id, sensor_type) -> (min_value, max_value)\nparam_lookup = {}\nfor _, row in df_params.iterrows():\n    param_lookup[(row[\'machine_id\'], row[\'sensor_type\'])] = (row[\'min_value\'], row[\'max_value\'])\n\nprint(f"\\nParam lookup entries: {len(param_lookup)}")\nprint(f"Sample: {list(param_lookup.items())[:3]}")\n\n# 2. Query BigQuery for all data in the time range\nquery = """\nSELECT timestamp, machine_id, sensor_type, reading\nFROM `machine_operating.live_sensor`\nWHERE timestamp >= \'2025-08-19 11:30:00\'\n  AND timestamp < \'2025-08-19 12:30:00\'\nORDER BY timestamp\n"""\n\nresult = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'bigquery_run_query\', json.dumps({\'query\': query})],\n    capture_output=True, text=True\n)\nprint("\\nBigQuery stdout last lines:")\nfor line in result.stdout.strip().split(\'\\n\')[-20:]:\n    print(line)\n\n# Parse JSON output\nlines = result.stdout.strip().split(\'\\n\')\njson_start = None\nfor i, line in enumerate(lines):\n    if line.startswith(\'__FULL_RESULTS_JSON__\'):\n        json_start = i + 1\n        break\n\nif json_start is None:\n    print("ERROR: Could not find JSON results")\n    exit(1)\n\njson_str = lines[-1]\ndata = json.loads(json_str)\n\nrows = data[\'rows\']\nprint(f"\\nTotal rows from BQ: {len(rows)}")\n\n# 3. Find anomalies\nanomalies = []\nfor row in rows:\n    key = (row[\'machine_id\'], row[\'sensor_type\'])\n    if key in param_lookup:\n        min_val, max_val = param_lookup[key]\n        reading = row[\'reading\']\n        if reading < min_val or reading > max_val:\n            anomalies.append({\n                \'timestamp\': row[\'timestamp\'],\n                \'machine_id\': row[\'machine_id\'],\n                \'sensor_type\': row[\'sensor_type\'],\n                \'reading\': row[\'reading\'],\n                \'normal_range\': f"{min_val} - {max_val}"\n            })\n\nprint(f"\\nFound {len(anomalies)} anomalies")\nfor a in anomalies[:10]:\n    print(a)\n\n# 4. Write CSV\nwith open(\'/app/anomaly_report.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'timestamp\', \'machine_id\', \'sensor_type\', \'reading\', \'normal_range\'])\n    writer.writeheader()\n    for a in anomalies:\n        writer.writerow(a)\n\nprint("\\nCSV written to /app/anomaly_report.csv")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
