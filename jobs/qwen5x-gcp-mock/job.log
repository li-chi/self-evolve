Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport csv\nimport json\nimport subprocess\n\ndef run_mcp(tool, args_json):\n    result = subprocess.run(\n        [\'mcp-tool\', \'call\', \'google-cloud\', tool, args_json],\n        capture_output=True, text=True\n    )\n    return result.stdout\n\n# Step 1: Read latest quiz scores\nlatest_scores = {}\nwith open(\'/app/latest_quiz_scores.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        latest_scores[row[\'student_id\']] = {\n            \'name\': row[\'name\'],\n            \'score\': float(row[\'score\'])\n        }\n\nprint(f"Loaded {len(latest_scores)} latest scores")\n\n# Step 2: Query BigQuery for all historical scores\nquery = """\nSELECT student_id, name, AVG(score) as avg_score\nFROM (\n  SELECT student_id, name, score FROM academic_warning.scores_2501\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2502\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2503\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2504\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2505\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2506\n  UNION ALL\n  SELECT student_id, name, score FROM academic_warning.scores_2507\n)\nt GROUP BY student_id, name\n"""\n\nresult = run_mcp(\'bigquery_run_query\', json.dumps({\'query\': query}))\nprint(f"BigQuery query output:\\n{result}")\n\n# Parse the output - extract rows\nrows_data = []\nfor line in result.split(\'\\n\'):\n    if line.startswith(\'{"student_id"\') or line.startswith(\'{"\'): \n        try:\n            row = json.loads(line)\n            if \'student_id\' in row and \'score\' not in row and \'avg_score\' in row:\n                rows_data.append(row)\n        except:\n            pass\n\n# Better approach: use the __FULL_RESULTS_JSON__ line\nfull_json_start = result.find(\'__FULL_RESULTS_JSON__\')\nif full_json_start != -1:\n    full_json = result[full_json_start + len(\'__FULL_RESULTS_JSON__\'):].strip()\n    full_data = json.loads(full_json)\n    for row in full_data.get(\'rows\', []):\n        rows_data.append(row)\n\nprint(f"Parsed {len(rows_data)} rows from BigQuery")\n\n# Build average scores dict\navg_scores = {}\nfor row in rows_data:\n    sid = row[\'student_id\']\n    avg_scores[sid] = {\n        \'name\': row[\'name\'],\n        \'avg_score\': row[\'avg_score\']\n    }\n\nprint(f"Unique students with historical data: {len(avg_scores)}")\n\n# Step 3: Calculate drops and categorize\nbad_students = []  # drop > 25%\ncritical_students = []  # drop > 45%\n\nfor sid, latest in latest_scores.items():\n    if sid in avg_scores:\n        avg = avg_scores[sid][\'avg_score\']\n        latest_score = latest[\'score\']\n        if avg > 0:\n            drop_pct = (avg - latest_score) / avg * 100\n            if drop_pct > 25:\n                bad_students.append({\n                    \'student_id\': sid,\n                    \'name\': latest[\'name\'],\n                    \'latest_score\': latest_score,\n                    \'avg_score\': round(avg, 2),\n                    \'drop_percent\': round(drop_pct, 2)\n                })\n                if drop_pct > 45:\n                    critical_students.append({\n                        \'student_id\': sid,\n                        \'name\': latest[\'name\'],\n                        \'latest_score\': latest_score,\n                        \'avg_score\': round(avg, 2),\n                        \'drop_percent\': round(drop_pct, 2)\n                    })\n\n# Step 4: Write bad_student.csv\nwith open(\'/app/bad_student.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'student_id\', \'name\', \'latest_score\', \'avg_score\', \'drop_percent\'])\n    writer.writeheader()\n    for s in bad_students:\n        writer.writerow(s)\n\nprint(f"\\nWrote {len(bad_students)} bad students to bad_student.csv")\n\n# Step 5: Write critical log entries for students with drop > 45%\nfor s in critical_students:\n    log_msg = f"Critical academic warning: Student {s[\'name\']} (ID: {s[\'student_id\']}) score dropped by {s[\'drop_percent\']}% (avg: {s[\'avg_score\']}, latest: {s[\'latest_score\']})"\n    log_data = json.dumps({\n        \'log_name\': \'exam_log-b711e7743e03\',\n        \'log_entry\': log_msg\n    })\n    print(f"Writing log: {log_msg}")\n    run_mcp(\'logging_write_log\', log_data)\n\nprint(f"\\nTotal critical students: {len(critical_students)}")\nprint("Done!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
