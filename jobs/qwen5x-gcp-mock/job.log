* 100\n            name = latest_scores[sid][\'name\']\n            if drop_pct > 25:\n                drop_25.append((sid, name, avg, latest, drop_pct))\n            if drop_pct > 45:\n                drop_45.append((sid, name, avg, latest, drop_pct))\n\nprint(f"\\nStudents with >25% drop: {len(drop_25)}")\nprint(f"Students with >45% drop: {len(drop_45)}")\n\n# Step 4: Write bad_student.csv\nwith open(\'/app/bad_student.csv\', \'w\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'student_id\', \'name\', \'average_score\', \'latest_score\', \'drop_percentage\'])\n    for sid, name, avg, latest, drop_pct in sorted(drop_25, key=lambda x: -x[4]):\n        writer.writerow([sid, name, round(avg, 2), round(latest, 2), round(drop_pct, 2)])\n\nprint(f"\\nWrote {len(drop_25)} students to bad_student.csv")\n\n# Step 5: Write critical warning logs for >45% drop students\nlog_bucket = \'exam_log-b711e7743e03\'\nfor sid, name, avg, latest, drop_pct in sorted(drop_45, key=lambda x: -x[4]):\n    log_entry = f"CRITICAL ALERT: Student {name} (ID: {sid}) has experienced a severe academic warning. Score dropped from {round(avg, 2)} to {round(latest, 2)} ({round(drop_pct, 2)}% decrease). Immediate counselor notification required."\n    print(f"Writing critical log for {name} ({sid}): drop {round(drop_pct, 2)}%")\n    log_params = {\n        \'bucket\': log_bucket,\n        \'log_message\': log_entry\n    }\n    try:\n        mcp_call(\'logging_write_log\', log_params)\n    except Exception as e:\n        print(f"Error writing log for {sid}: {e}")\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
