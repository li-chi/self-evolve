Sending keys: ['cat > /app/solve.py << \'PYEOF\'\nimport csv\nimport json\nimport subprocess\nimport sys\n\ndef run_mcp(tool_name, args):\n    cmd = [\'mcp-tool\', \'call\', \'google-cloud\', tool_name, json.dumps(args)]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    return result\n\ndef parse_query_output(output):\n    """Parse the __FULL_RESULTS_JSON__ from BigQuery output."""\n    lines = output.strip().split(\'\\n\')\n    for line in lines:\n        if line.startswith(\'{"columns"\') or line.startswith(\'{"rows"\'):\n            # Find the JSON block\n            idx = output.find(\'__FULL_RESULTS_JSON__\')\n            if idx >= 0:\n                json_str = output[idx + len(\'__FULL_RESULTS_JSON__\'):].strip()\n                return json.loads(json_str)\n    return None\n\ndef run_query(query):\n    result = run_mcp(\'bigquery_run_query\', {\'query\': query})\n    parsed = parse_query_output(result.stdout + result.stderr)\n    if parsed is None:\n        return None, result.stdout + result.stderr\n    return parsed, None\n\n# Step 1: Load latest quiz scores\nlatest_scores = {}\nwith open(\'/app/latest_quiz_scores.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        sid = row[\'student_id\']\n        latest_scores[sid] = {\n            \'name\': row[\'name\'],\n            \'score\': float(row[\'score\'])\n        }\n\nprint(f"Loaded {len(latest_scores)} latest scores")\n\n# Step 2: Query all historical tables\ntables = [\'scores_2501\', \'scores_2502\', \'scores_2503\', \'scores_2504\', \'scores_2505\', \'scores_2506\', \'scores_2507\']\n\n# Use UNION ALL to get all historical scores in one query\nunion_tables = \' UNION ALL \'.join([f"SELECT * FROM academic_warning.{t}" for t in tables])\nquery = f"SELECT student_id, name, score FROM ({union_tables})"\n\nprint(f"Running query for all historical scores...")\nparsed, err = run_query(query)\nif err:\n    print(f"Error: {err}")\n    sys.exit(1)\n\nprint(f"Total historical rows: {len(parsed[\'rows\'])}")\n\n# Step 3: Calculate average score per student\nfrom collections import defaultdict\n\nstudent_scores = defaultdict(list)\nfor row in parsed[\'rows\']:\n    sid = row[\'student_id\']\n    student_scores[sid].append(row[\'score\'])\n\nstudent_avg = {}\nfor sid, scores in student_scores.items():\n    student_avg[sid] = sum(scores) / len(scores)\n\nprint(f"Unique students in historical data: {len(student_avg)}")\n\n# Step 4: Compare with latest scores and identify drops\ndrop_25 = []\ndrop_45 = []\n\nfor sid, info in latest_scores.items():\n    latest = info[\'score\']\n    if sid in student_avg:\n        avg = student_avg[sid]\n        if avg > 0:\n            drop_pct = (avg - latest) / avg * 100\n        else:\n            drop_pct = 0\n        \n        if drop_pct > 45:\n            drop_45.append((sid, info[\'name\'], latest, avg, drop_pct))\n            print(f"CRITICAL: {sid} {info[\'name\']} - latest: {latest}, avg: {avg:.2f}, drop: {drop_pct:.1f}%")\n        elif drop_pct > 25:\n            drop_25.append((sid, info[\'name\'], latest, avg, drop_pct))\n            print(f"WARNING: {sid} {info[\'name\']} - latest: {latest}, avg: {avg:.2f}, drop: {drop_pct:.1f}%")\n\n# Step 5: Write bad_student.csv\nall_bad = sorted(drop_25 + drop_45, key=lambda x: x[0])\nwith open(\'/app/bad_student.csv\', \'w\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'student_id\', \'name\', \'latest_score\', \'average_score\', \'drop_percentage\'])\n    for sid, name, latest, avg, drop in all_bad:\n        writer.writerow([sid, name, latest, round(avg, 2), round(drop, 2)])\n\nprint(f"\\nTotal students with >25% drop: {len(all_bad)}")\nprint(f"Total students with >45% drop: {len(drop_45)}")\nprint(f"Written to /app/bad_student.csv")\n\n# Step 6: Write critical warnings to log bucket\ncritical_count = 0\nfor sid, name, latest, avg, drop in drop_45:\n    log_entry = {\n        \'logName\': \'projects/mcp-bench0606/logs/critical_warning\',\n        \'resource\': {\'type\': \'global\'},\n        \'severity\': \'CRITICAL\',\n        \'insertId\': f\'critical_{sid}_{int(critical_count)}\',\n        \'jsonPayload\': {\n            \'alert_type\': \'CRITICAL_ACADEMIC_WARNING\',\n            \'student_id\': sid,\n            \'student_name\': name,\n            \'latest_score\': latest,\n            \'average_score\': round(avg, 2),\n            \'drop_percentage\': round(drop, 2),\n            \'message\': f\'Student {name} ({sid}) test score dropped by {round(drop, 2)}% below average. Needs immediate counselor notification.\'\n        }\n    }\n    result = run_mcp(\'logging_write_log\', log_entry)\n    print(f"Log written for {sid} {name}: drop={drop:.1f}%")\n    critical_count += 1\n\nprint(f"\\nTotal critical logs written: {critical_count}")\nprint("Done!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
