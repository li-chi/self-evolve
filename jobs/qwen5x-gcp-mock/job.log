Sending keys: ['cat > /tmp/full_process.py << \'PYEOF\'\nimport subprocess, json\n\n# Fetch all data\nsql = "SELECT * FROM `game_analytics.daily_scores_stream`"\nresult = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'bigquery_run_query\', json.dumps({\'query\': sql})],\n    capture_output=True, text=True\n)\n\n# Parse the __FULL_RESULTS_JSON\nimport re\nmatch = re.search(r\'__FULL_RESULTS_JSON__\\n(.*)\', result.stdout)\nfull_json = json.loads(match.group(1))\nrows = full_json[\'rows\']\n\n# Aggregate by player_id\nfrom collections import defaultdict\nplayer_stats = defaultdict(lambda: {\'total_score\': 0, \'online_score\': 0, \'task_score\': 0, \'game_count\': 0, \'player_region\': \'\'})\n\nfor row in rows:\n    pid = row[\'player_id\']\n    region = row[\'player_region\']\n    scores = json.loads(row[\'scores\'])\n    online = int(scores[\'online_score\'])\n    task = int(scores[\'task_score\'])\n    total = online + task\n    player_stats[pid][\'total_score\'] += total\n    player_stats[pid][\'online_score\'] += online\n    player_stats[pid][\'task_score\'] += task\n    player_stats[pid][\'game_count\'] += 1\n    player_stats[pid][\'player_region\'] = region\n\n# Create leaderboard (top 100 by total_score desc)\nsorted_players = sorted(player_stats.items(), key=lambda x: x[1][\'total_score\'], reverse=True)\nleaderboard = sorted_players[:100]\n\nprint(f"Total players: {len(player_stats)}")\nprint(f"Leaderboard players: {len(leaderboard)}")\nprint(f"Top 5: {[(p, s[\'total_score\']) for p, s in leaderboard[:5]]}")\n\n# Build CREATE TABLE with UNION ALL for leaderboard\ncols = "player_id, total_score, rank"\nvalues = []\nfor i, (pid, s) in enumerate(leaderboard):\n    values.append(f"SELECT \'{pid}\' as player_id, {s[\'total_score\']} as total_score, {i+1} as rank")\n\ncreate_sql = "CREATE TABLE `game_analytics.leaderboard_20260801` AS " + "\\n".join(\n    [values[0]] + [f"UNION ALL\\n{v}" for v in values[1:]]\n)\n\n# Write SQL files\nwith open(\'/tmp/leaderboard_create.sql\', \'w\') as f:\n    f.write(create_sql)\n\n# Build INSERT for player_historical_stats\ninsert_rows = []\nfor pid, s in player_stats.items():\n    insert_rows.append(f"(\'{pid}\', \'{s[\'player_region\']}\', \'2026-08-01\', {s[\'online_score\']}, {s[\'task_score\']}, {s[\'total_score\']}, {s[\'game_count\']})")\n\ninsert_sql = "INSERT INTO `game_analytics.player_historical_stats` (player_id, player_region, date, total_online_score, total_task_score, total_score, game_count) VALUES " + ",\\n".join(insert_rows)\n\nwith open(\'/tmp/historical_insert.sql\', \'w\') as f:\n    f.write(insert_sql)\n\nprint(f"Leaderboard SQL length: {len(create_sql)}")\nprint(f"Insert SQL length: {len(insert_sql)}")\nprint("Files written successfully")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
