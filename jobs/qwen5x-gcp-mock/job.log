ts)}")\nprint(f"Total critical students (>45% drop): {len(critical_students)}")\n\n# Write critical log entries for each student with >45% drop\nfor s in critical_students:\n    log_entry = {\n        \'severity\': \'CRITICAL\',\n        \'student_id\': s[\'student_id\'],\n        \'name\': s[\'name\'],\n        \'avg_score\': s[\'avg_score\'],\n        \'latest_score\': s[\'latest_score\'],\n        \'drop_percentage\': round(s[\'drop_pct\'], 2),\n        \'message\': f"Academic Warning: {s[\'name\']} (ID: {s[\'student_id\']}) score dropped by {round(s[\'drop_pct\'], 2)}%. Average: {s[\'avg_score\']}, Latest: {s[\'latest_score\']}"\n    }\n    print(f"Writing critical log for {s[\'name\']} ({s[\'student_id\']}): {round(s[\'drop_pct\'], 2)}% drop")\n\nprint("\\nDone processing!")\nPYEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
