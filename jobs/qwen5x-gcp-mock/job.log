l_b)\nprint(f"\\nOverall: A={overall_a:.4f}%, B={overall_b:.4f}%")\n\n# Write record.csv\nwith open(\'/app/record.csv\', \'w\') as f:\n    f.write(\'scenario,A_conversion %,B_conversion %\\n\')\n    for s in scenarios:\n        a_pct, b_pct = results[s]\n        f.write(f"{s},{a_pct:.4f},{b_pct:.4f}\\n")\n    # Overall row - need to figure out the format\n    a_over, b_over = results[\'overall\']\n    f.write(f"overall,{a_over:.4f},{b_over:.4f}\\n")\n\nprint("\\nrecord.csv written.")\n\n# Determine winner\nif overall_b > overall_a:\n    print("Winner: B")\nelse:\n    print("Winner: A (or tie)")\n\nPYEOF\npython3 /app/analyze.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
