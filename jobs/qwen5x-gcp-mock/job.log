Sending keys: ['cat << \'PYSCRIPT\' > /tmp/fraud3.py\nimport json\nimport subprocess\n\ndef run_query(query):\n    try:\n        proc = subprocess.run(\n            [\'mcp-tool\', \'call\', \'google-cloud\', \'bigquery_run_query\', json.dumps({\'query\': query})],\n            capture_output=True, text=True, timeout=30\n        )\n        stdout = proc.stdout\n        if \'__FULL_RESULTS_JSON__\' in stdout:\n            idx = stdout.index(\'__FULL_RESULTS_JSON__\')\n            json_str = stdout[idx + len(\'__FULL_RESULTS_JSON__\'):].strip()\n            return json.loads(json_str)\n        else:\n            print(f"  No JSON found. Output: {stdout[:300]}")\n            return None\n    except subprocess.TimeoutExpired:\n        print("  Timeout")\n        return None\n    except Exception as e:\n        print(f"  Exception: {e}")\n        return None\n\nTXN_ID = \'T8492XJ3\'\nUSER_ID = \'U8847293\'\nPROJECT = \'mcp-bench0606\'\nDATASET = \'transactions_analytics\'\n\nresult = {}\n\n# Tables to query by transaction_id\ntxn_tables = [\'live_transactions\', \'fraud_alerts\', \'risk_scores\', \'blacklist\']\nfor t in txn_tables:\n    q = f"SELECT * FROM {PROJECT}.{DATASET}.{t} WHERE transaction_id = \'{TXN_ID}\'"\n    print(f"Querying {t} by transaction_id...")\n    d = run_query(q)\n    if d and d.get(\'rows\'):\n        result[t] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n        print(f"  -> Found {len(d[\'rows\'])} row(s)")\n    else:\n        print(f"  -> Not found")\n\n# Tables to query by user_id\nuser_tables = [\'users\', \'accounts\', \'cards\', \'devices\']\nfor t in user_tables:\n    q = f"SELECT * FROM {PROJECT}.{DATASET}.{t} WHERE user_id = \'{USER_ID}\'"\n    print(f"Querying {t} by user_id...")\n    d = run_query(q)\n    if d and d.get(\'rows\'):\n        result[t] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n        print(f"  -> Found {len(d[\'rows\'])} row(s)")\n    else:\n        print(f"  -> Not found")\n\n# merchants by merchant_id from the transaction\nq = f"SELECT * FROM {PROJECT}.{DATASET}.merchants WHERE merchant_id = \'MER9934814\'"\nprint(f"Querying merchants by merchant_id...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'merchants\'] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} row(s)")\nelse:\n    print(f"  -> Not found")\n\n# locations by location_id from the transaction\nq = f"SELECT * FROM {PROJECT}.{DATASET}.locations WHERE location_id = \'LOC006\'"\nprint(f"Querying locations by location_id...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'locations\'] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} row(s)")\nelse:\n    print(f"  -> Not found")\n\n# Related transactions for user U8847293\nq = f"SELECT * FROM {PROJECT}.{DATASET}.live_transactions WHERE user_id = \'{USER_ID}\' AND transaction_id != \'{TXN_ID}\' ORDER BY timestamp DESC"\nprint(f"Querying related transactions for {USER_ID}...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'related_transactions\'] = d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} related transactions")\nelse:\n    result[\'related_transactions\'] = []\n    print("  -> None")\n\n# Save JSON\nout_path = \'/app/T8492XJ3.json\'\nwith open(out_path, \'w\') as f:\n    json.dump(result, f, indent=2)\nprint(f"\\nSaved to {out_path}")\n\n# Upload to storage\nprint("Uploading to storage...")\nproc = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'storage_upload_file\',\n     json.dumps({\'bucket_name\': \'mcp-fraud-investigation-archive-68e6af9a4b5a\',\n                 \'source_file_path\': out_path,\n                 \'destination_blob_name\': \'T8492XJ3.json\'})],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"  Upload ok: {proc.returncode == 0}")\nprint(f"  stdout: {proc.stdout[:200]}")\n\n# Write CRITICAL log\nprint("Writing CRITICAL log entry...")\nlog_msg = json.dumps({\'alert_type\': \'Fraud\', \'transaction_id\': \'T8492XJ3\', \'status\': \'Pending_Investigation\'})\nproc = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'logging_write_log\',\n     json.dumps({\'log_name\': \'projects/mcp-bench0606/logs/fraud-investigation-alerts\',\n                 \'message\': log_msg,\n                 \'severity\': \'CRITICAL\'})],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"  Log ok: {proc.returncode == 0}")\nprint(f"  stdout: {proc.stdout[:200]}")\n\nprint("\\nDone!")\nPYSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
