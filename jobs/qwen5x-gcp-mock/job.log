df[df[\'is_anomaly\']].copy()\n\nprint(f"\\nTotal anomalies found: {len(anomalies)}")\nif len(anomalies) > 0:\n    print(anomalies[[\'transaction_id\', \'client_id\', \'txn_time\', \'amount\']].to_string())\n\n# Read existing Excel\nxls = pd.ExcelFile(\'/app/anomaly_audit_report.xlsx\')\nexisting_df = pd.read_excel(xls, sheet_name=xls.sheet_names[0])\nprint(f"\\nExisting Excel rows (before removing sample): {len(existing_df)}")\nprint(existing_df)\n\n# Remove sample data (rows with client_xxxx placeholder)\nexisting_df = existing_df[existing_df[\'client_id\'] != \'client_xxxx\'].reset_index(drop=True)\nprint(f"After removing sample: {len(existing_df)}")\n\n# Prepare anomaly rows for Excel\nanomaly_cols = [\'client_id\', \'transaction_id\', \'txn_time\']\nanomaly_report = anomalies[anomaly_cols].copy()\nanomaly_report[\'txn_time\'] = anomaly_report[\'txn_time\'].dt.strftime(\'%Y-%m-%d %H:%M:%S.%f\') + \' UTC\'\n\nprint(f"Anomaly rows to add: {len(anomaly_report)}")\nprint(anomaly_report.head())\n\n# Combine\nfinal_df = pd.concat([existing_df, anomaly_report], ignore_index=True)\nfinal_df = final_df.sort_values(\'transaction_id\').reset_index(drop=True)\nprint(f"\\nFinal report shape: {final_df.shape}")\nprint(final_df.to_string())\n\n# Write to Excel\nfinal_df.to_excel(\'/app/anomaly_audit_report.xlsx\', index=False)\nprint("\\nDone! File written to /app/anomaly_audit_report.xlsx")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
