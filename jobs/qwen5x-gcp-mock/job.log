        print(f"  -> Not found")\n\n# merchants by merchant_id (from the transaction)\nq = f"SELECT * FROM {PROJECT}.{DATASET}.merchants WHERE merchant_id = \'MER9934814\'"\nprint(f"Querying merchants by merchant_id...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'merchants\'] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} row(s)")\nelse:\n    print(f"  -> Not found")\n\n# locations by location_id from the transaction\nq = f"SELECT * FROM {PROJECT}.{DATASET}.locations WHERE location_id = \'LOC006\'"\nprint(f"Querying locations by location_id...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'locations\'] = d[\'rows\'][0] if len(d[\'rows\']) == 1 else d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} row(s)")\nelse:\n    print(f"  -> Not found")\n\n# Related transactions for user U8847293\nq = f"SELECT * FROM {PROJECT}.{DATASET}.live_transactions WHERE user_id = \'{USER_ID}\' AND transaction_id != \'{TXN_ID}\' ORDER BY timestamp DESC"\nprint(f"Querying related transactions for {USER_ID}...")\nd = run_query(q)\nif d and d.get(\'rows\'):\n    result[\'related_transactions\'] = d[\'rows\']\n    print(f"  -> Found {len(d[\'rows\'])} related transactions")\nelse:\n    result[\'related_transactions\'] = []\n    print("  -> None")\n\n# Save JSON\nout_path = \'/app/T8492XJ3.json\'\nwith open(out_path, \'w\') as f:\n    json.dump(result, f, indent=2)\nprint(f"\\nSaved to {out_path}")\n\n# Upload to storage\nprint("Uploading to storage...")\nproc = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'storage_upload_file\',\n     json.dumps({\'bucket_name\': \'mcp-fraud-investigation-archive-68e6af9a4b5a\',\n                 \'source_file_path\': out_path,\n                 \'destination_blob_name\': \'T8492XJ3.json\'})],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"  Upload stdout: {proc.stdout[:200]}")\nprint(f"  Upload stderr: {proc.stderr[:200]}")\n\n# Write CRITICAL log\nprint("Writing CRITICAL log entry...")\nlog_msg = json.dumps({\'alert_type\': \'Fraud\', \'transaction_id\': \'T8492XJ3\', \'status\': \'Pending_Investigation\'})\nproc = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'logging_write_log\',\n     json.dumps({\'log_name\': \'projects/mcp-bench0606/logs/fraud-investigation-alerts\',\n                 \'message\': log_msg,\n                 \'severity\': \'CRITICAL\'})],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"  Log stdout: {proc.stdout[:200]}")\nprint(f"  Log stderr: {proc.stderr[:200]}")\n\nprint("\\nDone!")\nPYSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
