print("Querying accounts for AC7739286...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.accounts WHERE account_id = "{account_id}"\')\nresults["accounts"] = {"columns": data["columns"], "rows": data["rows"]}\n\n# 6. cards for CARD6672841\nprint("Querying cards for CARD6672841...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.cards WHERE card_id = "{card_id}"\')\nresults["cards"] = {"columns": data["columns"], "rows": data["rows"]}\n\n# 7. merchants for MER9934814\nprint("Querying merchants for MER9934814...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.merchants WHERE merchant_id = "{merchant_id}"\')\nresults["merchants"] = {"columns": data["columns"], "rows": data["rows"]}\n\n# 8. devices for DEV4482915\nprint("Querying devices for DEV4482915...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.devices WHERE device_id = "{device_id}"\')\nresults["devices"] = {"columns": data["columns"], "rows": data["rows"]}\n\n# 9. locations for LOC006\nprint("Querying locations for LOC006...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.locations WHERE location_id = "LOC006"\')\nresults["locations"] = {"columns": data["columns"], "rows": data["rows"]}\n\n# 10. blacklist for any matching IDs\nprint("Querying blacklist...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.blacklist\')\n# Filter rows that have any matching ID\nmatching_blacklist = []\nfor row in data["rows"]:\n    row_str = json.dumps(row).lower()\n    if any(v.lower() in row_str for v in [tx_id, user_id, account_id, merchant_id, card_id, device_id]):\n        matching_blacklist.append(row)\nresults["blacklist"] = {"columns": data["columns"], "rows": matching_blacklist}\n\n# 11. Related transactions for user U8847293\nprint("Querying related transactions for user U8847293...")\ndata = bq_query(f\'SELECT * FROM transactions_analytics.live_transactions WHERE user_id = "{user_id}" AND transaction_id != "{tx_id}"\')\nresults["related_transactions"] = {"