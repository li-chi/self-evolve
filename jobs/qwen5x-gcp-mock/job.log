\'])} row(s) in {table}")\n    else:\n        print(f"  No data found in {table}")\n\n# For non-txn tables, try user_id\nfor table in other_tables:\n    query = f"SELECT * FROM {PROJECT}.{DATASET}.{table} WHERE user_id = \'{USER_ID}\'"\n    print(f"Querying {table} for user_id {USER_ID}...")\n    data = run_query(query)\n    if data and data.get(\'rows\'):\n        result[table] = data[\'rows\'][0] if len(data[\'rows\']) == 1 else data[\'rows\']\n        print(f"  Found {len(data[\'rows\'])} row(s) in {table}")\n    else:\n        print(f"  No data found in {table}")\n\n# Query related transactions for user U8847293\nprint(f"\\nQuerying related transactions for user {USER_ID}...")\nquery = f"SELECT * FROM {PROJECT}.{DATASET}.live_transactions WHERE user_id = \'{USER_ID}\' AND transaction_id != \'{TXN_ID}\' ORDER BY timestamp DESC"\ndata = run_query(query)\nif data and data.get(\'rows\'):\n    result[\'related_transactions\'] = data[\'rows\']\n    print(f"  Found {len(data[\'rows\'])} related transactions")\nelse:\n    print("  No related transactions found")\n    result[\'related_transactions\'] = []\n\n# Save to workspace\noutput_file = \'/app/T8492XJ3.json\'\nwith open(output_file, \'w\') as f:\n    json.dump(result, f, indent=2)\nprint(f"\\nJSON saved to {output_file}")\n\n# Upload to storage bucket\nbucket = \'mcp-fraud-investigation-archive-68e6af9a4b5a\'\nresult2 = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'storage_upload_file\', \n     json.dumps({\'bucket_name\': bucket, \'source_path\': output_file, \'resource\': f\'{TXN_ID}.json\'})],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"\\nUpload result: {result2.stdout}")\nif result2.stderr:\n    print(f"Upload stderr: {result2.stderr[:300]}")\n\n# Write CRITICAL log entry\nprint(f"\\nWriting log entry...")\nlog_entry = {\n    \'alert_type\': \'Fraud\',\n    \'transaction_id\': \'T8492XJ3\',\n    \'status\': \'Pending_Investigation\'\n}\nlog_result = subprocess.run(\n    [\'mcp-tool\', \'call\', \'google-cloud\', \'logging_write_log\',\n     json.dumps({\n         \'log_name\': \'projects/mcp-bench0606/logs/fraud-investigation-alerts\',\n         \'severity\': \'CRITICAL\',\n         \'log_entry\': log_entry\n     })],\n    capture_output=True, text=True, timeout=30\n)\nprint(f"Log result: {log_result.stdout}")\nif log_result.stderr:\n    print(f"Log stderr: {log_result.stderr[:300]}")\n\nprint("\\nDone!")\nPYSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
