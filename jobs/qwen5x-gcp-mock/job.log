Sending keys: ['cat > /app/process_scores.py << \'PYEOF\'\nimport csv\nimport json\nimport subprocess\n\ndef mcp_call(query):\n    """Execute a BigQuery query via mcp-tool and return parsed JSON results."""\n    cmd = [\n        \'mcp-tool\', \'call\', \'google-cloud\', \'bigquery_run_query\',\n        json.dumps({"query": query})\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    output = result.stdout\n    # Extract the __FULL_RESULTS_JSON__ section\n    idx = output.rfind(\'{\')\n    if idx >= 0:\n        json_str = output[idx:]\n        return json.loads(json_str)\n    return None\n\n# Step 1: Query all 7 tables with UNION ALL to get all historical scores\n# Then compute average per student_id\nunion_query = """\nSELECT student_id, AVG(score) as avg_score\nFROM (\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2501\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2502\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2503\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2504\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2505\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2506\n    UNION ALL\n    SELECT student_id, score FROM mcp-bench0606.academic_warning.scores_2507\n)\nGROUP BY student_id\nORDER BY student_id\n"""\n\nprint("Querying historical averages from BigQuery...")\nhist_result = mcp_call(union_query)\n\n# Step 2: Read latest scores\nlatest_scores = {}\nwith open(\'/app/latest_quiz_scores.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        latest_scores[row[\'student_id\']] = {\n            \'name\': row[\'name\'],\n            \'score\': float(row[\'score\'])\n        }\n\nprint(f"Loaded {len(latest_scores)} latest scores")\nprint(f"Loaded {len(hist_result[\'rows\'])} historical student averages")\n\n# Step 3: Build history lookup\nhist_avg = {}\nfor row in hist_result[\'rows\']:\n    hist_avg[row[\'student_id\']] = row[\'avg_score\']\n\n# Step 4: Calculate drops and classify\nbad_students = []  # >25% drop\ncritical_students = []  # >45% drop\n\nfor sid in sorted(latest_scores.keys()):\n    latest = latest_scores[sid]\n    if sid in hist_avg:\n        avg = hist_avg[sid]\n        drop_pct = (avg - latest[\'score\']) / avg * 100\n        if drop_pct > 25:\n            entry = {\n                \'student_id\': sid,\n                \'name\': latest[\'name\'],\n                \'latest_score\': latest[\'score\'],\n                \'historical_avg\': round(avg, 2),\n                \'drop_percentage\': round(drop_pct, 2)\n            }\n            bad_students.append(entry)\n            if drop_pct > 45:\n                critical_students.append({\n                    \'student_id\': sid,\n                    \'name\': latest[\'name\'],\n                    \'latest_score\': latest[\'score\'],\n                    \'historical_avg\': round(avg, 2),\n                    \'drop_percentage\': round(drop_pct, 2)\n                })\n\nprint(f"\\nStudents with >25% drop: {len(bad_students)}")\nprint(f"Students with >45% drop: {len(critical_students)}")\n\n# Step 5: Write bad_student.csv\nwith open(\'/app/bad_student.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'student_id\', \'name\', \'latest_score\', \'historical_avg\', \'drop_percentage\'])\n    writer.writeheader()\n    for entry in bad_students:\n        writer.writerow(entry)\n\nprint(f"\\nWrote bad_student.csv with {len(bad_students)} students")\n\n# Step 6: Write critical warning logs for >45% drop\nfor cs in critical_students:\n    log_message = f"CRITICAL: Student {cs[\'name\']} (ID: {cs[\'student_id\']}) has a {cs[\'drop_percentage\']}% score drop (latest: {cs[\'latest_score\']}, historical avg: {cs[\'historical_avg\']})"\n    print(f"\\nWriting critical log for: {cs[\'name\']} ({cs[\'student_id\']})")\n    print(f"  Log: {log_message}")\n    log_cmd = {\n        "log_name": "projects/mcp-bench0606/logs/academic_warning_critical",\n        "log_bucket": "exam_log-b711e7743e03",\n        "log_entries": [{\n            "log_name": "academic_warning_critical",\n            "payload": {\n                "level": "CRITICAL",\n                "student_id": cs[\'student_id\'],\n                "name": cs[\'name\'],\n                "latest_score": cs[\'latest_score\'],\n                "historical_avg": cs[\'historical_avg\'],\n                "drop_percentage": cs[\'drop_percentage\'],\n                "message": log_message\n            },\n            "resource_type": "global"\n        }]\n    }\n    mcp_call_tool(log_cmd)\n\nprint("\\nDone!")\n\ndef mcp_call_tool(args_dict):\n    cmd = [\n        \'mcp-tool\', \'call\', \'google-cloud\', \'logging_write_log\',\n        json.dumps(args_dict)\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    print(f"  mcp-tool output: {result.stdout[:500]}")\n    return result\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
