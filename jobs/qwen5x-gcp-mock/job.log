users WHERE user_id = \'" + user_id + "\'")\nresults["users"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("5. accounts...")\ndata = bq_query("SELECT * FROM transactions_analytics.accounts WHERE account_id = \'" + account_id + "\'")\nresults["accounts"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("6. cards...")\ndata = bq_query("SELECT * FROM transactions_analytics.cards WHERE card_id = \'" + card_id + "\'")\nresults["cards"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("7. merchants...")\ndata = bq_query("SELECT * FROM transactions_analytics.merchants WHERE merchant_id = \'" + merchant_id + "\'")\nresults["merchants"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("8. devices...")\ndata = bq_query("SELECT * FROM transactions_analytics.devices WHERE device_id = \'" + device_id + "\'")\nresults["devices"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("9. locations...")\ndata = bq_query("SELECT * FROM transactions_analytics.locations WHERE location_id = \'LOC006\'")\nresults["locations"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} rows")\n\nprint("10. blacklist...")\ndata = bq_query("SELECT * FROM transactions_analytics.blacklist")\nmatching_blacklist = []\nfor row in data["rows"]:\n    row_str = json.dumps(row).lower()\n    if any(v.lower() in row_str for v in [tx_id, user_id, account_id, merchant_id, card_id, device_id]):\n        matching_blacklist.append(row)\nresults["blacklist"] = {"columns": data["columns"], "rows": matching_blacklist}\nprint(f"   Found {len(matching_blacklist)} matching rows")\n\nprint("11. related_transactions...")\ndata = bq_query("SELECT * FROM transactions_analytics.live_transactions WHERE user_id = \'" + user_id + "\' AND transaction_id != \'" + tx_id + "\'")\nresults["related_transactions"] = {"columns": data["columns"], "rows": data["rows"]}\nprint(f"   Found {len(data[\'rows\'])} related transactions")\n\nprint(f"\\nTotal tables: {len(results)}")\nprint("Building JSON...")\n\nwith open("/app/T8492XJ3.json", "w") as f:\n    json.dump(results, f, indent=2)\nprint("Saved /app/T8492XJ3.json")\nprint("Done!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
