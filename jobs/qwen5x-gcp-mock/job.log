Sending keys: ['cat > /app/process.py << \'PYEOF\'\nimport subprocess, json, csv, os\nfrom openpyxl import load_workbook\n\ndef mcp_call(tool_name, args_dict):\n    cmd = [\'mcp-tool\', \'call\', \'google-cloud\', tool_name, json.dumps(args_dict)]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    return result.stdout\n\n# Step 1: Read Excel parameter ranges\nprint("Reading Excel file...")\nwb = load_workbook(\'/app/machine_operating_parameters.xlsx\')\nws = wb[\'Operating Parameters\']\n\n# Build param lookup: (machine_id, sensor_type) -> (min_value, max_value)\nparam_ranges = {}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    machine_id, desc, sensor_type, unit, min_val, max_val, _, _ = row\n    param_ranges[(machine_id, sensor_type)] = (float(min_val), float(max_val))\n\nprint(f"Loaded {len(param_ranges)} parameter ranges")\n\n# Step 2: Query BigQuery\nprint("Querying BigQuery...")\nquery = "SELECT timestamp, machine_id, sensor_type, reading FROM `mcp-bench0606.machine_operating.live_sensor` WHERE timestamp >= \'2025-08-19 11:30:00\' AND timestamp <= \'2025-08-19 12:30:00\' ORDER BY timestamp"\nbq_result = mcp_call(\'bigquery_run_query\', {\'query\': query})\nprint("BQ query done")\n\n# Parse the __FULL_RESULTS_JSON__ section\njson_start = bq_result.find(\'__FULL_RESULTS_JSON__\')\nif json_start == -1:\n    raise Exception("Could not find __FULL_RESULTS_JSON__ in output")\njson_str = bq_result[json_start + len(\'__FULL_RESULTS_JSON__\'):].strip()\n\ntry:\n    data = json.loads(json_str)\nexcept json.JSONDecodeError:\n    # Try parsing from the end\n    print("Warning: JSON parse issue, trying alternate parsing...")\n    data = json.loads(json_str)\n\ncolumns = data[\'columns\']\nrows = data[\'rows\']\nprint(f"Parsed {len(rows)} rows from BigQuery")\n\n# Step 3: Find anomalies\nanomalies = []\nfor row in rows:\n    ts = row[\'timestamp\']\n    mid = row[\'machine_id\']\n    stype = row[\'sensor_type\']\n    reading = float(row[\'reading\'])\n    \n    key = (mid, stype)\n    if key in param_ranges:\n        min_val, max_val = param_ranges[key]\n        if reading < min_val or reading > max_val:\n            normal_range = f"{min_val} - {max_val}"\n            anomalies.append({\n                \'timestamp\': ts,\n                \'machine_id\': mid,\n                \'sensor_type\': stype,\n                \'reading\': reading,\n                \'normal_range\': normal_range\n            })\n            print(f"  ANOMALY: {mid}/{stype} = {reading} (range: {normal_range})")\n    else:\n        print(f"  WARNING: No param range for {mid}/{stype}")\n\nprint(f"\\nTotal anomalies found: {len(anomalies)}")\n\n# Step 4: Write CSV\nwith open(\'/app/anomaly_report.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'timestamp\', \'machine_id\', \'sensor_type\', \'reading\', \'normal_range\'])\n    writer.writeheader()\n    writer.writerows(anomalies)\n\nprint("Saved anomaly_report.csv")\n\n# Step 5: Find GCS bucket with prefix iot_anomaly_reports\nprint("Finding GCS bucket...")\nbuckets = mcp_call(\'storage_list_buckets\', {})\nprint("Buckets:", buckets)\n\nimport re\nbucket_match = re.search(r\'([\\w.-]+).*iot_anomaly_reports|[\\w.-]+.*?(iot_anomaly_reports.*)\', buckets)\n# Also search for bucket names containing iot_anomaly_reports\nbucket_name = None\nfor line in buckets.split(\'\\n\'):\n    if \'iot_anomaly_reports\' in line.lower():\n        # Extract bucket name\n        m = re.search(r\'(?:name:|bucket:|gs://)?([\\w.-]+)\', line)\n        if m:\n            bn = m.group(1)\n            if bn in line.lower():\n                bucket_name = bn\n                break\n            # Try just the last word-like thing\n            words = line.split()\n            for w in words:\n                if \'iot_anomaly\' in w.lower():\n                    bucket_name = w.strip(\'\\"\').strip(\',\')\n                    break\n            break\n\nif not bucket_name:\n    # Just look for any bucket name pattern\n    for line in buckets.split(\'\\n\'):\n        m = re.search(r\'(\\S+[\\w.-]+\\S+)\', line)\n        if m:\n            bucket_name = m.group(1).strip(\'\\"\').strip(\',\')\n            break\n\nprint(f"Bucket name found: {bucket_name}")\nif not bucket_name or \'iot_anomaly\' not in bucket_name.lower():\n    # List all buckets more carefully\n    all_buckets = mcp_call(\'storage_list_buckets\', {})\n    print(f"All buckets output:\\n{all_buckets}")\n\nprint("\\n=== About to upload ===")\nupload_result = mcp_call(\'storage_upload_file\', {\n    \'bucket_name\': bucket_name,\n    \'file_path\': \'/app/anomaly_report.csv\',\n    \'destination_blob_name\': \'anomaly_report.csv\'\n})\nprint(f"Upload result: {upload_result}")\n\nprint("\\nDONE!")\nPYEOF\npython3 /app/process.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
