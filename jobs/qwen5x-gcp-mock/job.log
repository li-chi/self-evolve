Sending keys: ['cat > /app/process.py << \'PYEOF\'\nimport csv\nimport json\nimport subprocess\nimport re\n\ndef mcp_call(method, params):\n    cmd = [\'mcp-tool\', \'call\', \'google-cloud\', method, json.dumps(params)]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    output = result.stdout\n    full_marker = \'__FULL_RESULTS_JSON__\'\n    if full_marker in output:\n        idx = output.index(full_marker)\n        output = output[idx + len(full_marker):].strip()\n    if \'{\' not in output:\n        return None\n    try:\n        return json.loads(output)\n    except json.JSONDecodeError:\n        return None\n\n# Step 1: Query BigQuery for all historical scores and compute averages\nunion_tables = \' UNION ALL \'.join([\n    f\'SELECT student_id, name, score FROM academic_warning.scores_250{i}\'\n    for i in range(1, 8)\n])\nquery = f"SELECT student_id, name, AVG(score) as avg_score FROM ({union_tables}) GROUP BY student_id, name"\nprint("Running BigQuery union of 7 tables...")\nresult = mcp_call(\'bigquery_run_query\', {\'query\': query})\n\navg_scores = {}\nfor row in result[\'rows\']:\n    sid = row[\'student_id\']\n    avg_scores[sid] = {\'name\': row[\'name\'], \'avg_score\': row[\'avg_score\']}\nprint(f"Loaded {len(avg_scores)} students from historical data")\n\n# Step 2: Read latest quiz scores\nlatest_scores = {}\nwith open(\'/app/latest_quiz_scores.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        sid = row[\'student_id\']\n        latest_scores[sid] = {\'name\': row[\'name\'], \'score\': float(row[\'score\'])}\nprint(f"Loaded {len(latest_scores)} latest scores")\n\n# Step 3: Calculate drops\ndrop_25 = []\ndrop_45 = []\nfor sid in latest_scores:\n    latest = latest_scores[sid][\'score\']\n    if sid in avg_scores:\n        avg = avg_scores[sid][\'avg_score\']\n        if avg > 0:\n            drop_pct = (avg - latest) / avg * 100\n            name = latest_scores[sid][\'name\']\n            if drop_pct > 25:\n                drop_25.append((sid, name, avg, latest, drop_pct))\n            if drop_pct > 45:\n                drop_45.append((sid, name, avg, latest, drop_pct))\n\nprint(f"Students with >25% drop: {len(drop_25)}")\nprint(f"Students with >45% drop: {len(drop_45)}")\n\n# Step 4: Write bad_student.csv\nwith open(\'/app/bad_student.csv\', \'w\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'student_id\', \'name\', \'average_score\', \'latest_score\', \'drop_percentage\'])\n    for sid, name, avg, latest, drop_pct in sorted(drop_25, key=lambda x: -x[4]):\n        writer.writerow([sid, name, round(avg, 2), round(latest, 2), round(drop_pct, 2)])\nprint(f"Wrote {len(drop_25)} students to bad_student.csv")\n\n# Step 5: Write critical warning logs for >45% drop students\nlog_bucket = \'exam_log-b711e7743e03\'\nfor sid, name, avg, latest, drop_pct in sorted(drop_45, key=lambda x: -x[4]):\n    log_entry = f"CRITICAL ALERT: Student {name} (ID: {sid}) has experienced a severe academic warning. Score dropped from {round(avg, 2)} to {round(latest, 2)} ({round(drop_pct, 2)}% decrease). Immediate counselor notification required."\n    print(f"Writing critical log for {name} ({sid}): drop {round(drop_pct, 2)}%")\n    params = {\n        \'log_name\': log_bucket,\n        \'message\': log_entry,\n        \'severity\': \'CRITICAL\'\n    }\n    r = mcp_call(\'logging_write_log\', params)\n    if r:\n        print(f"  -> Log written successfully")\n\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
