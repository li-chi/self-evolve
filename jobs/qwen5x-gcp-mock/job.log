Sending keys: ['python3 << \'PYEOF\'\nimport sqlite3\nimport json\nfrom collections import defaultdict\n\nconn = sqlite3.connect(\'/var/lib/mock-state/gcp/db.sqlite3\')\nconn.row_factory = sqlite3.Row\ncur = conn.cursor()\n\n# Read all rows from daily_scores_stream\ncur.execute("SELECT * FROM game_analytics__daily_scores_stream")\nrows = [dict(row) for row in cur.fetchall()]\nprint(f"Total rows: {len(rows)}")\n\n# Aggregate scores per player\nplayer_scores = defaultdict(lambda: {\'total_score\': 0, \'game_count\': 0, \'region\': \'\'})\nfor row in rows:\n    pid = row[\'player_id\']\n    region = row[\'player_region\']\n    ts = row[\'timestamp\']\n    scores_str = row[\'scores\']\n    \n    player_scores[pid][\'region\'] = region\n    player_scores[pid][\'game_count\'] += 1\n    \n    # Parse JSON scores\n    scores = json.loads(scores_str)\n    online = scores.get(\'online_score\', 0)\n    task = scores.get(\'task_score\', 0)\n    player_scores[pid][\'total_score\'] += online + task\n\nprint(f"Total players: {len(player_scores)}")\n\n# Sort by total_score descending and assign ranks\nplayers_sorted = sorted(player_scores.items(), key=lambda x: x[1][\'total_score\'], reverse=True)\n\n# Create leaderboard table\ncur.execute(\'\'\'CREATE TABLE IF NOT EXISTS game_analytics__leaderboard_20260801 \n               (player_id TEXT, total_score INTEGER, rank INTEGER)\'\'\')\ncur.execute("DELETE FROM game_analytics__leaderboard_20260801")\n\n# Insert top 100\nfor i, (pid, data) in enumerate(players_sorted[:100], 1):\n    cur.execute("INSERT INTO game_analytics__leaderboard_20260801 VALUES (?, ?, ?)",\n                (pid, data[\'total_score\'], i))\n\nconn.commit()\n\n# Verify leaderboard\ncur.execute("SELECT * FROM game_analytics__leaderboard_20260801 LIMIT 5")\nprint("\\nTop 5 leaderboard entries:")\nfor row in cur.fetchall():\n    print(dict(row))\n\n# Insert into player_historical_stats\ncur.execute("DELETE FROM game_analytics__player_historical_stats WHERE date = \'2026-08-01\'")\n\nfor pid, data in player_scores.items():\n    online = 0\n    task = 0\n    total = 0\n    for row in rows:\n        if row[\'player_id\'] == pid:\n            s = json.loads(row[\'scores\'])\n            online += s.get(\'online_score\', 0)\n            task += s.get(\'task_score\', 0)\n    total = online + task\n    cur.execute("INSERT INTO game_analytics__player_historical_stats \n                 VALUES (?, ?, ?, ?, ?, ?, ?)",\n                (pid, data[\'region\'], \'2026-08-01\', online, task, total, data[\'game_count\']))\n\nconn.commit()\n\n# Verify historical stats\ncur.execute("SELECT * FROM game_analytics__player_historical_stats WHERE date = \'2026-08-01\' LIMIT 3")\nprint("\\nFirst 3 historical stats entries:")\nfor row in cur.fetchall():\n    print(dict(row))\n\ncur.execute("SELECT COUNT(*) FROM game_analytics__player_historical_stats WHERE date = \'2026-08-01\'")\nprint(f"\\nTotal historical stats records: {cur.fetchone()[0]}")\n\nconn.close()\nprint("\\nDone!")\nPYEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
