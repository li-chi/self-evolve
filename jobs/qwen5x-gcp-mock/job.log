Sending keys: ['cat > /tmp/compute.py << \'PYEOF\'\nimport json, csv\n\ndata = [\n  ("Appliances", 33490, 24191, 38464, 28185),\n  ("Automotive", 57686, 43806, 63417, 46194),\n  ("Baby", 32477, 23500, 32361, 24698),\n  ("Beauty", 31583, 23554, 27470, 20391),\n  ("Books", 36879, 27450, 39169, 28398),\n  ("Clothing", 45548, 33266, 43569, 32870),\n  ("Education", 46952, 34827, 49738, 36615),\n  ("Electronics", 44865, 33165, 40057, 29003),\n  ("Food", 41177, 30716, 42212, 31158),\n  ("FreshFood", 43471, 31674, 40305, 29480),\n  ("Gaming", 49124, 36824, 52201, 39043),\n  ("Health", 43737, 32493, 43746, 32957),\n  ("Home", 37799, 27819, 37719, 27545),\n  ("Hospitality", 35587, 26743, 36994, 28029),\n  ("Music", 50133, 37547, 55882, 41741),\n  ("Office", 38898, 28132, 37638, 28100),\n  ("Outdoor", 38074, 27837, 38334, 28580),\n  ("Pets", 49344, 35506, 50972, 37395),\n  ("Sports", 45242, 33404, 43659, 32234),\n  ("Travel", 48071, 35833, 53216, 39806),\n]\n\nresults = []\nfor name, a_clicks, a_views, b_clicks, b_views in data:\n    a_conv = round(a_clicks / a_views * 100, 2)\n    b_conv = round(b_clicks / b_views * 100, 2)\n    results.append((name, a_conv, b_conv))\n    print(f"{name}: A={a_conv}%, B={b_conv}%")\n\na_convs = [r[1] for r in results]\nb_convs = [r[2] for r in results]\noverall_a = round(sum(a_convs) / len(a_convs), 2)\noverall_b = round(sum(b_convs) / len(b_convs), 2)\nprint(f"\\nOverall A: {overall_a}%, Overall B: {overall_b}%")\n\nif overall_b > overall_a:\n    winner = \'B\'\n    print("Winner: B")\nelif overall_a > overall_b:\n    winner = \'A\'\n    print("Winner: A")\nelse:\n    winner = \'TIE\'\n    print("TIE")\n\n# Write record.csv\nwith open(\'/app/record.csv\', \'w\', newline=\'\') as f:\n    w = csv.writer(f)\n    w.writerow([\'scenario\', \'A_conversion %\', \'B_conversion %\'])\n    for name, a_conv, b_conv in results:\n        w.writerow([name, a_conv, b_conv])\n    w.writerow([\'overall\', overall_a, overall_b])\n\nprint("\\nrecord.csv written.")\nwith open(\'/app/record.csv\') as f:\n    print(f.read())\n\n# Save winner info for next step\nwith open(\'/tmp/winner.txt\', \'w\') as f:\n    f.write(winner)\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
