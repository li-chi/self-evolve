f, fieldnames=[\'timestamp\', \'machine_id\', \'sensor_type\', \'reading\', \'normal_range\'])\n    writer.writeheader()\n    writer.writerows(anomalies)\n\nprint("Saved anomaly_report.csv")\nfor a in anomalies[:5]:\n    print(a)\nPYEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
