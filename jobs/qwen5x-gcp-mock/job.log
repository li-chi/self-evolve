Sending keys: ['python3 -c "\nimport json, subprocess, csv, re\nfrom collections import defaultdict\n\ndef run_query(query):\n    args = json.dumps({\'query\': query})\n    result = subprocess.run([\'mcp-tool\', \'call\', \'google-cloud\', \'bigquery_run_query\', args], capture_output=True, text=True)\n    full = result.stdout + result.stderr\n    json_pattern = r\'\\\\{(?:[^{}]|\\\\{[^{}]*\\\\})*\\\\}\'\n    matches = re.findall(json_pattern, full)\n    if matches:\n        return json.loads(matches[-1])\n    return None\n\nscenarios = [\'Appliances\',\'Automotive\',\'Baby\',\'Beauty\',\'Books\',\'Clothing\',\'Education\',\'Electronics\',\'Food\',\'FreshFood\',\'Gaming\',\'Health\',\'Home\',\'Hospitality\',\'Music\',\'Office\',\'Outdoor\',\'Pets\',\'Sports\',\'Travel\']\n\nunion_parts = []\nfor s in scenarios:\n    part = \\"SELECT \'" + s + "\' as scenario, A_clicks, A_store_views, B_clicks, B_store_views FROM ab_testing.ab_\\" + s\n    union_parts.append(part)\n\nquery = \'SELECT * FROM (\' + \' UNION ALL \'.join(union_parts) + \')\'\nresult = run_query(query)\n\nagg = defaultdict(lambda: {\'A_clicks\':0,\'A_views\':0,\'B_clicks\':0,\'B_views\':0})\nfor row in result.get(\'rows\', []):\n    s = row[\'scenario\']\n    agg[s][\'A_clicks\'] += row[\'A_clicks\']\n    agg[s][\'A_views\'] += row[\'A_store_views\']\n    agg[s][\'B_clicks\'] += row[\'B_clicks\']\n    agg[s][\'B_views\'] += row[\'B_store_views\']\n\nresults = {}\nfor s in scenarios:\n    results[s] = {\n        \'A_conv\': agg[s][\'A_clicks\']/agg[s][\'A_views\'] if agg[s][\'A_views\']>0 else 0,\n        \'B_conv\': agg[s][\'B_clicks\']/agg[s][\'B_views\'] if agg[s][\'B_views\']>0 else 0\n    }\n\nA_overall = sum(results[s][\'A_conv\'] for s in scenarios)/len(scenarios)\nB_overall = sum(results[s][\'B_conv\'] for s in scenarios)/len(scenarios)\n\nif B_overall > A_overall:\n    winner = \'B\'\nelif A_overall > B_overall:\n    winner = \'A\'\nelse:\n    winner = \'Tie\'\n\nprint(f\'Overall A: {A_overall:.6f}\')\nprint(f\'Overall B: {B_overall:.6f}\')\nprint(f\'Winner: {winner}\')\n\nwith open(\'/app/record.csv\', \'w\', newline=\'\') as f:\n    w = csv.writer(f)\n    w.writerow([\'scenario\',\'A_conversion %\',\'B_conversion %\'])\n    for s in scenarios:\n        w.writerow([s, f\\"{results[s][\'A_conv\']:.6f}\\", f\\"{results[s][\'B_conv\']:.6f}\\"])\n    w.writerow([\'overall\', f\\"{A_overall:.6f}\\", f\\"{B_overall:.6f}\\"])\nprint(\'Done writing record.csv\')\n"\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
