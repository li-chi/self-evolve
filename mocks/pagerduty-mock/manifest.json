{
  "name": "pagerduty-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "PAGERDUTY_MOCK_STATE_DIR": "{output_dir}/end_state/pagerduty"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/pagerduty/state.json",
    "short_name": "pagerduty",
    "schema_ref": "synth/mock_seed/pagerduty.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_incidents",
      "get_incident",
      "create_incident",
      "manage_incidents",
      "create_incident_note",
      "list_incident_alerts",
      "list_services",
      "get_service",
      "create_service",
      "list_escalation_policies",
      "get_escalation_policy",
      "list_users",
      "get_user",
      "get_current_user",
      "list_teams",
      "get_team",
      "list_schedules",
      "get_schedule",
      "list_on_calls"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
