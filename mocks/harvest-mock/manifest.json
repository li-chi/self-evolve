{
  "name": "harvest-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "HARVEST_MOCK_STATE_DIR": "{output_dir}/end_state/harvest"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/harvest/state.json",
    "short_name": "harvest",
    "schema_ref": "synth/mock_seed/harvest.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_clients",
      "list_projects",
      "list_tasks",
      "list_time_entries",
      "create_time_entry",
      "get_current_user"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
