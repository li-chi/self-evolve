{
  "name": "gmail-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GMAIL_MOCK_STATE_DIR": "{output_dir}/end_state/gmail"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/gmail/state.json",
    "short_name": "gmail",
    "schema_ref": "synth/mock_seed/gmail.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "send_message",
      "list_messages",
      "get_message",
      "modify_message",
      "trash_message",
      "untrash_message",
      "list_threads",
      "get_thread",
      "list_labels",
      "create_label",
      "create_draft",
      "send_draft"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
