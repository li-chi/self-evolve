{
  "name": "huggingface-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "HF_MOCK_STATE_DIR": "{output_dir}/end_state/huggingface"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/huggingface/state.json",
    "short_name": "huggingface",
    "schema_ref": "synth/mock_seed/huggingface.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "create_repo",
      "model_search",
      "dataset_search",
      "upload_file"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
