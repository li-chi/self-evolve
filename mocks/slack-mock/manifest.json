{
  "name": "slack-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SLACK_MOCK_STATE_DIR": "{output_dir}/end_state/slack"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/slack/state.json",
    "short_name": "slack",
    "schema_ref": "synth/mock_seed/slack.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "channels_list",
      "channels_me",
      "conversations_history",
      "chat_postMessage"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
