{
  "name": "sentry-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SENTRY_MOCK_STATE_DIR": "{output_dir}/end_state/sentry"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/sentry/state.json",
    "short_name": "sentry",
    "schema_ref": "synth/mock_seed/sentry.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_organizations",
      "get_organization",
      "list_projects",
      "get_project",
      "create_project",
      "list_teams",
      "get_team",
      "list_organization_members",
      "list_project_issues",
      "list_organization_issues",
      "get_issue",
      "update_issue",
      "delete_issue",
      "resolve_issue",
      "assign_issue",
      "ignore_issue",
      "list_issue_events",
      "get_latest_event_for_issue",
      "get_event",
      "list_issue_comments",
      "create_issue_comment",
      "list_releases",
      "get_release",
      "create_release",
      "list_environments",
      "list_project_alerts",
      "create_project_alert"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
