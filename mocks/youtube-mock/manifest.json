{
  "name": "youtube-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "YOUTUBE_MOCK_STATE_DIR": "{output_dir}/end_state/youtube"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/youtube/state.json",
    "short_name": "youtube",
    "schema_ref": "synth/mock_seed/youtube.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "videos_list",
      "videos_insert",
      "videos_update",
      "videos_delete",
      "videos_rate",
      "videos_getRating",
      "channels_list",
      "playlists_list",
      "playlists_insert",
      "playlists_update",
      "playlists_delete",
      "playlistItems_list",
      "playlistItems_insert",
      "playlistItems_update",
      "playlistItems_delete",
      "search_list",
      "commentThreads_list",
      "commentThreads_insert",
      "comments_list",
      "comments_insert",
      "subscriptions_list",
      "subscriptions_insert",
      "subscriptions_delete",
      "captions_list"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
