{
  "name": "strava-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "STRAVA_MOCK_STATE_DIR": "{output_dir}/end_state/strava"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/strava/state.json",
    "short_name": "strava",
    "schema_ref": "synth/mock_seed/strava.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "getLoggedInAthlete",
      "getLoggedInAthleteActivities",
      "getActivityById",
      "createActivity",
      "exploreSegments"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
