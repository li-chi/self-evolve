{
  "name": "mailgun-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "MAILGUN_MOCK_STATE_DIR": "{output_dir}/end_state/mailgun"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/mailgun/state.json",
    "short_name": "mailgun",
    "schema_ref": "synth/mock_seed/mailgun.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "send_message",
      "retrieve_stored_message",
      "list_domains",
      "get_domain",
      "create_domain",
      "delete_domain",
      "list_mailing_lists",
      "create_mailing_list",
      "list_list_members",
      "add_list_member",
      "remove_list_member",
      "list_events",
      "get_stats",
      "list_bounces",
      "add_bounce",
      "delete_bounce",
      "list_unsubscribes",
      "list_complaints",
      "list_tags",
      "get_tag"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
