{
  "name": "postgres-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "PG_MOCK_STATE_DIR": "{output_dir}/end_state/postgres"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/postgres/state.json",
    "short_name": "postgres",
    "schema_ref": "synth/mock_seed/postgres.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "query",
      "execute",
      "list_databases",
      "list_schemas",
      "list_tables",
      "describe_table",
      "list_indexes",
      "list_views",
      "explain_query",
      "list_functions",
      "current_settings"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
