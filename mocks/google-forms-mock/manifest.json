{
  "name": "google-forms-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GFORMS_MOCK_STATE_DIR": "{output_dir}/end_state/google_forms"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_forms/state.json",
    "short_name": "google_forms",
    "schema_ref": "synth/mock_seed/google_forms.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "create_form",
      "add_text_question",
      "add_multiple_choice_question"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
