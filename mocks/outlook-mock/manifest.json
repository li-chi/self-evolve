{
  "name": "outlook-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "OUTLOOK_MOCK_STATE_DIR": "{output_dir}/end_state/outlook"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/outlook/state.json",
    "short_name": "outlook",
    "schema_ref": "synth/mock_seed/outlook.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_messages",
      "get_message",
      "send_mail",
      "create_draft",
      "list_events",
      "create_event"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
