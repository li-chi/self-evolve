{
  "name": "airtable-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "AIRTABLE_MOCK_STATE_DIR": "{output_dir}/end_state/airtable"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/airtable/state.json",
    "short_name": "airtable",
    "schema_ref": "synth/mock_seed/airtable.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_bases",
      "list_tables",
      "create_table"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
