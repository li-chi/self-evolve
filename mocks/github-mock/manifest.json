{
  "name": "github-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GITHUB_MOCK_STATE_DIR": "{output_dir}/end_state/github"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/github/state.json",
    "short_name": "github",
    "schema_ref": "synth/mock_seed/github.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_me",
      "create_repository",
      "fork_repository",
      "list_branches",
      "get_file_contents"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
