{
  "name": "snowflake-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SNOWFLAKE_MOCK_STATE_DIR": "{output_dir}/end_state/snowflake"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/snowflake/state.json",
    "short_name": "snowflake",
    "schema_ref": "synth/mock_seed/snowflake.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_databases",
      "list_schemas",
      "list_tables",
      "execute_query"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
