{
  "name": "zendesk-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "ZENDESK_MOCK_STATE_DIR": "{output_dir}/end_state/zendesk"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/zendesk/state.json",
    "short_name": "zendesk",
    "schema_ref": "synth/mock_seed/zendesk.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_tickets",
      "get_ticket",
      "create_ticket",
      "update_ticket",
      "delete_ticket",
      "list_ticket_comments",
      "search_tickets",
      "incremental_tickets",
      "list_users",
      "get_user",
      "create_user",
      "update_user",
      "search_users",
      "list_organizations",
      "get_organization",
      "create_organization",
      "list_groups",
      "create_group",
      "add_user_to_group",
      "list_macros",
      "apply_macro_to_ticket",
      "list_satisfaction_ratings",
      "list_ticket_fields",
      "list_views",
      "count_tickets_in_view"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
