{
  "name": "vercel-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "VERCEL_MOCK_STATE_DIR": "{output_dir}/end_state/vercel"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/vercel/state.json",
    "short_name": "vercel",
    "schema_ref": "synth/mock_seed/vercel.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "listProjects",
      "getProject",
      "createProject",
      "updateProject",
      "deleteProject",
      "listDeployments",
      "getDeployment",
      "createDeployment",
      "cancelDeployment",
      "deleteDeployment",
      "listDeploymentFiles",
      "listProjectDomains",
      "addProjectDomain",
      "removeProjectDomain",
      "listProjectEnv",
      "createProjectEnv",
      "deleteProjectEnv",
      "listTeams",
      "getTeam",
      "getAuthUser"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
