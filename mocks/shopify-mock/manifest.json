{
  "name": "shopify-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SHOPIFY_MOCK_STATE_DIR": "{output_dir}/end_state/shopify"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/shopify/state.json",
    "short_name": "shopify",
    "schema_ref": "synth/mock_seed/shopify.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_products",
      "get_product",
      "create_product",
      "update_product",
      "delete_product",
      "count_products",
      "list_variants",
      "get_variant",
      "create_variant",
      "update_variant",
      "list_orders",
      "get_order",
      "create_order",
      "update_order",
      "cancel_order",
      "close_order",
      "list_customers",
      "get_customer",
      "create_customer",
      "update_customer",
      "get_inventory_level",
      "adjust_inventory_level",
      "list_collections",
      "get_collection",
      "get_shop"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
