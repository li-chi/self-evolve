{
  "name": "google-sheets-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GSHEETS_MOCK_STATE_DIR": "{output_dir}/end_state/google_sheets"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_sheets/state.json",
    "short_name": "google_sheets",
    "schema_ref": "synth/mock_seed/google_sheets.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_sheet_data",
      "get_sheet_formulas",
      "update_cells"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
