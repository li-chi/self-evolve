{
  "name": "stripe-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "STRIPE_MOCK_STATE_DIR": "{output_dir}/end_state/stripe"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/stripe/state.json",
    "short_name": "stripe",
    "schema_ref": "synth/mock_seed/stripe.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "create_customer",
      "retrieve_customer",
      "create_charge",
      "create_payment_intent",
      "create_refund",
      "create_subscription",
      "create_invoice",
      "finalize_invoice",
      "pay_invoice"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
