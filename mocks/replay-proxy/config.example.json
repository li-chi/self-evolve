{
  "servers": [
    {
      "name": "yahoo-finance",
      "cassette": "/workspace/cassettes/yahoo-finance.jsonl",
      "tools": [
        {
          "name": "get_stock_quote",
          "description": "Get the latest regular-market quote for a single ticker symbol.",
          "params": {
            "ticker": {"type": "string", "required": true}
          }
        },
        {
          "name": "get_history",
          "description": "Get historical OHLCV candles for a ticker over a period (e.g. '5d', '1mo', '1y').",
          "params": {
            "ticker": {"type": "string", "required": true},
            "period": {"type": "string", "required": true, "default": "5d"},
            "interval": {"type": "string", "required": false, "default": "1d"}
          }
        }
      ]
    }
  ]
}
