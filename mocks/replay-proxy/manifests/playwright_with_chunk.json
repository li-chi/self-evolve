{
  "name": "playwright_with_chunk",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/playwright_with_chunk.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/playwright_with_chunk.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "browser_navigate",
      "browser_navigate_back",
      "browser_navigate_forward",
      "browser_snapshot",
      "browser_snapshot_navigate_to_span",
      "browser_snapshot_navigate_to_first_span",
      "browser_snapshot_navigate_to_last_span",
      "browser_snapshot_navigate_to_next_span",
      "browser_snapshot_navigate_to_prev_span",
      "browser_snapshot_navigate_to_line",
      "browser_snapshot_search",
      "browser_click",
      "browser_hover",
      "browser_drag",
      "browser_type",
      "browser_select_option",
      "browser_press_key",
      "browser_wait_for",
      "browser_evaluate",
      "browser_take_screenshot",
      "browser_file_upload",
      "browser_handle_dialog",
      "browser_console_messages",
      "browser_network_requests",
      "browser_resize",
      "browser_close",
      "browser_install",
      "browser_scroll_up",
      "browser_scroll_down",
      "browser_scroll_to_top",
      "browser_scroll_to_bottom",
      "browser_tab_list",
      "browser_tab_new",
      "browser_tab_select",
      "browser_tab_close"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
