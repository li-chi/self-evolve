{
  "name": "weather-data",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/weather-data.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/weather-data.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "weather_current",
      "weather_forecast",
      "weather_history",
      "weather_alerts",
      "weather_airquality",
      "weather_astronomy",
      "weather_search",
      "weather_timezone"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
