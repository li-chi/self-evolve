{
  "name": "youtube-transcript",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/youtube-transcript.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/youtube-transcript.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_transcript",
      "get_timed_transcript",
      "get_video_info",
      "get_available_languages"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
