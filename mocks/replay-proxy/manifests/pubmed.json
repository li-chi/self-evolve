{
  "name": "pubmed",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/pubmed.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/pubmed.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "search_pubmed_key_words",
      "search_pubmed_advanced",
      "get_pubmed_article_metadata",
      "download_pubmed_pdf"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
