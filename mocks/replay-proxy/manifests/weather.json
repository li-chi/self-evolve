{
  "name": "weather",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/weather.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/weather.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_current_weather",
      "get_weather_forecast",
      "get_hourly_forecast",
      "get_weather_alerts",
      "find_weather_stations",
      "get_local_time"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
