{
  "name": "open-library",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/open-library.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/open-library.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_book_by_title",
      "get_authors_by_name",
      "get_author_info",
      "get_author_photo",
      "get_book_cover",
      "get_book_by_id"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
