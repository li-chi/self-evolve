{
  "name": "wikipedia",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/wikipedia.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/wikipedia.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "search_wikipedia",
      "get_article",
      "get_summary",
      "get_sections",
      "get_links",
      "get_coordinates",
      "get_related_topics",
      "summarize_article_for_query",
      "summarize_article_section",
      "extract_key_facts"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
