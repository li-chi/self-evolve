{
  "name": "arxiv",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/arxiv.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/arxiv.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "search_papers",
      "download_paper",
      "list_papers",
      "read_paper"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
