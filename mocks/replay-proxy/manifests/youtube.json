{
  "name": "youtube",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/youtube.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/youtube.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "videos_getVideo",
      "videos_searchVideos",
      "transcripts_getTranscript",
      "channels_getChannel",
      "channels_listVideos",
      "channels_navigateList",
      "playlists_getPlaylist",
      "playlists_getPlaylistItems",
      "playlists_searchPlaylists"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
