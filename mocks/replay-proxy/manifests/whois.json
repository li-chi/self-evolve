{
  "name": "whois",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/whois.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/whois.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "whois_domain",
      "whois_tld",
      "whois_ip",
      "whois_as"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
