{
  "name": "osm-mcp-server",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/osm-mcp-server.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/osm-mcp-server.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "geocode_address",
      "reverse_geocode",
      "find_nearby_places",
      "get_route_directions",
      "explore_area"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
