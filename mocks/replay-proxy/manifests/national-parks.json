{
  "name": "national-parks",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/national-parks.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/national-parks.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "findParks",
      "getParkDetails",
      "getAlerts",
      "getVisitorCenters",
      "getCampgrounds",
      "getEvents"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
