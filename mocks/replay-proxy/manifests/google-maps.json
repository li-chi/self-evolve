{
  "name": "google-maps",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/google-maps.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/google-maps.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "maps_geocode",
      "maps_reverse_geocode",
      "maps_search_places",
      "maps_place_details",
      "maps_distance_matrix",
      "maps_elevation",
      "maps_directions"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
