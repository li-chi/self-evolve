{
  "name": "lara-translate",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/lara-translate.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/lara-translate.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "translate",
      "detect_language",
      "list_languages"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
