{
  "name": "met-museum",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/met-museum.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/met-museum.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list-departments",
      "search-museum-objects",
      "get-museum-object"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
