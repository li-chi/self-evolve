{
  "name": "fetch",
  "tier": "cassette",
  "host": "replay-proxy",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "REPLAY_PROXY_CONFIG": "{cassette_config_path}"
    }
  },
  "seed": {
    "kind": "cassette",
    "path": "mcp_servers/replay-proxy/cassettes/fetch.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/fetch.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "fetch_html",
      "fetch_markdown",
      "fetch_txt",
      "fetch_json"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
