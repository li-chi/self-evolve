    "path": "mcp_servers/replay-proxy/cassettes/exa.jsonl",
    "config_path": "mcp_servers/replay-proxy/configs/exa.json"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "web_search_exa",
      "web_fetch_exa"
    ]
  },
  "ship": {
    "dockerfile": null,
    "central": false
  }
}
