{
  "servers": [
    {
      "name": "wikipedia",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/wikipedia.jsonl",
      "tools": [
        {
          "name": "search_wikipedia",
          "description": "Search Wikipedia for articles matching a query.",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "limit": {
              "type": "integer",
              "required": false,
              "default": 10
            }
          }
        },
        {
          "name": "get_article",
          "description": "Get the full content of a Wikipedia article.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_summary",
          "description": "Get a concise summary of a Wikipedia article.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_sections",
          "description": "Get the section tree of a Wikipedia article.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_links",
          "description": "Get the outbound links contained within a Wikipedia article.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_coordinates",
          "description": "Get the geographic coordinates of a Wikipedia article subject.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_related_topics",
          "description": "Get topics related to a Wikipedia article based on links and categories.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            },
            "limit": {
              "type": "integer",
              "required": false,
              "default": 10
            }
          }
        },
        {
          "name": "summarize_article_for_query",
          "description": "Get an article summary focused on a specific query.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            },
            "query": {
              "type": "string",
              "required": true
            },
            "max_length": {
              "type": "integer",
              "required": false,
              "default": 250
            }
          }
        },
        {
          "name": "summarize_article_section",
          "description": "Summarize a specific section of an article.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            },
            "section_title": {
              "type": "string",
              "required": true
            },
            "max_length": {
              "type": "integer",
              "required": false,
              "default": 150
            }
          }
        },
        {
          "name": "extract_key_facts",
          "description": "Extract key facts from an article, optionally focused on a topic.",
          "params": {
            "title": {
              "type": "string",
              "required": true
            },
            "topic_within_article": {
              "type": "string",
              "required": false
            },
            "count": {
              "type": "integer",
              "required": false,
              "default": 5
            }
          }
        }
      ],
      "loose_args_match": true
    }
  ]
}