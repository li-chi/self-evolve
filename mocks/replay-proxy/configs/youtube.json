{
  "servers": [
    {
      "name": "youtube",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/youtube.jsonl",
      "tools": [
        {
          "name": "videos_getVideo",
          "description": "Get detailed information about a YouTube video (YouTube Data API v3 videos.list).",
          "params": {
            "videoId": {
              "type": "string",
              "required": true
            },
            "parts": {
              "type": "array",
              "required": false
            }
          }
        },
        {
          "name": "videos_searchVideos",
          "description": "Search for videos on YouTube (search.list + videos.list detail join).",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "maxResults": {
              "type": "number",
              "required": false,
              "default": 10
            }
          }
        },
        {
          "name": "transcripts_getTranscript",
          "description": "Get the transcript of a YouTube video via the youtube-transcript npm package.",
          "params": {
            "videoId": {
              "type": "string",
              "required": true
            },
            "language": {
              "type": "string",
              "required": false,
              "default": "en"
            }
          }
        },
        {
          "name": "channels_getChannel",
          "description": "Get information about a YouTube channel (channels.list).",
          "params": {
            "channelId": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "channels_listVideos",
          "description": "Start a new channel videos list session with sorting options (max 20 per page).",
          "params": {
            "channelId": {
              "type": "string",
              "required": true
            },
            "maxResults": {
              "type": "number",
              "required": false
            },
            "sortOrder": {
              "type": "string",
              "required": false
            }
          }
        },
        {
          "name": "channels_navigateList",
          "description": "Navigate within an existing channel-videos list session (prev/next/jump to page).",
          "params": {
            "listId": {
              "type": "string",
              "required": true
            },
            "page": {
              "type": "integer",
              "required": true
            }
          }
        },
        {
          "name": "playlists_getPlaylist",
          "description": "Get information about a YouTube playlist (playlists.list).",
          "params": {
            "playlistId": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "playlists_getPlaylistItems",
          "description": "Get videos in a YouTube playlist (playlistItems.list).",
          "params": {
            "playlistId": {
              "type": "string",
              "required": true
            },
            "maxResults": {
              "type": "number",
              "required": false
            }
          }
        },
        {
          "name": "playlists_searchPlaylists",
          "description": "Search for playlists on YouTube (search.list with type=playlist).",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "maxResults": {
              "type": "number",
              "required": false
            }
          }
        }
      ],
      "loose_args_match": true
    }
  ]
}