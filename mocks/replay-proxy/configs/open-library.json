{
  "servers": [
    {
      "name": "open-library",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/open-library.jsonl",
      "tools": [
        {
          "name": "get_book_by_title",
          "description": "Search for book information by title (Open Library /search.json).",
          "params": {
            "title": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_authors_by_name",
          "description": "Search for author information by name.",
          "params": {
            "name": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_author_info",
          "description": "Retrieve detailed information for an author by Open Library author key.",
          "params": {
            "author_key": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_author_photo",
          "description": "Get the URL for an author's photo by OLID.",
          "params": {
            "olid": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_book_cover",
          "description": "Get a book cover image URL by identifier.",
          "params": {
            "key": {
              "type": "string",
              "required": true
            },
            "value": {
              "type": "string",
              "required": true
            },
            "size": {
              "type": "string",
              "required": false,
              "default": "M"
            }
          }
        },
        {
          "name": "get_book_by_id",
          "description": "Retrieve detailed book info by identifier (isbn/lccn/oclc/olid).",
          "params": {
            "idType": {
              "type": "string",
              "required": true
            },
            "idValue": {
              "type": "string",
              "required": true
            }
          }
        }
      ],
      "loose_args_match": true
    }
  ]
}