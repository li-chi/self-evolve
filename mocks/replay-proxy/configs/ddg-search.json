{
  "servers": [
    {
      "name": "ddg-search",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/ddg-search.jsonl",
      "tools": [
        {
          "name": "search",
          "description": "Search the web using DuckDuckGo. Returns a formatted list of results with titles, URLs, and snippets.",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "max_results": {
              "type": "integer",
              "required": false,
              "default": 10
            },
            "region": {
              "type": "string",
              "required": false,
              "default": ""
            }
          }
        },
        {
          "name": "fetch_content",
          "description": "Fetch and extract the main text content from a webpage. Returns cleaned, paginated plain text.",
          "params": {
            "url": {
              "type": "string",
              "required": true
            },
            "start_index": {
              "type": "integer",
              "required": false,
              "default": 0
            },
            "max_length": {
              "type": "integer",
              "required": false,
              "default": 8000
            },
            "backend": {
              "type": "string",
              "required": false
            }
          }
        }
      ],
      "loose_args_match": true
    }
  ]
}