{
  "servers": [
    {
      "name": "weather",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/weather.jsonl",
      "tools": [
        {
          "name": "get_current_weather",
          "description": "Current US weather from weather.gov (coords lat,lng).",
          "params": {
            "location": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "get_weather_forecast",
          "description": "Multi-day US weather forecast (1-7 days).",
          "params": {
            "location": {
              "type": "string",
              "required": true
            },
            "days": {
              "type": "integer",
              "required": false,
              "default": 7
            }
          }
        },
        {
          "name": "get_hourly_forecast",
          "description": "Hourly forecast for up to 48 hours.",
          "params": {
            "location": {
              "type": "string",
              "required": true
            },
            "hours": {
              "type": "integer",
              "required": false,
              "default": 24
            }
          }
        },
        {
          "name": "get_weather_alerts",
          "description": "Active weather alerts for a US location or state code.",
          "params": {
            "location": {
              "type": "string",
              "required": true
            },
            "severity": {
              "type": "string",
              "required": false,
              "default": "all"
            }
          }
        },
        {
          "name": "find_weather_stations",
          "description": "Find nearby weather observation stations.",
          "params": {
            "location": {
              "type": "string",
              "required": true
            },
            "limit": {
              "type": "integer",
              "required": false,
              "default": 10
            }
          }
        },
        {
          "name": "get_local_time",
          "description": "Current local time for a US location.",
          "params": {
            "location": {
              "type": "string",
              "required": true
            }
          }
        }
      ],
      "loose_args_match": true
    }
  ]
}