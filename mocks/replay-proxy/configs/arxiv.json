{
  "servers": [
    {
      "name": "arxiv",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/arxiv.jsonl",
      "loose_args_match": true,
      "tools": [
        {
          "name": "search_papers",
          "description": "Search arXiv for papers; supports date range, categories, and sort.",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "max_results": {
              "type": "integer",
              "required": false,
              "default": 10
            },
            "date_from": {
              "type": "string",
              "required": false
            },
            "date_to": {
              "type": "string",
              "required": false
            },
            "categories": {
              "type": "array",
              "required": false
            },
            "sort_by": {
              "type": "string",
              "required": false,
              "default": "relevance"
            }
          }
        },
        {
          "name": "download_paper",
          "description": "Download a paper by arXiv ID (HTML first, falls back to PDF).",
          "params": {
            "paper_id": {
              "type": "string",
              "required": true
            },
            "start": {
              "type": "integer",
              "required": false
            },
            "max_chars": {
              "type": "integer",
              "required": false
            }
          }
        },
        {
          "name": "list_papers",
          "description": "List all papers downloaded locally.",
          "params": {}
        },
        {
          "name": "read_paper",
          "description": "Read the full text of a locally downloaded paper in markdown.",
          "params": {
            "paper_id": {
              "type": "string",
              "required": true
            },
            "start": {
              "type": "integer",
              "required": false
            },
            "max_chars": {
              "type": "integer",
              "required": false
            }
          }
        }
      ]
    }
  ]
}
