{
  "servers": [
    {
      "name": "google-maps",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/google-maps.jsonl",
      "tools": [
        {
          "name": "maps_geocode",
          "description": "Convert an address into geographic coordinates.",
          "params": {
            "address": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "maps_reverse_geocode",
          "description": "Convert coordinates into an address.",
          "params": {
            "latitude": {
              "type": "number",
              "required": true
            },
            "longitude": {
              "type": "number",
              "required": true
            }
          }
        },
        {
          "name": "maps_search_places",
          "description": "Search for places using Google Places API.",
          "params": {
            "query": {
              "type": "string",
              "required": true
            },
            "location": {
              "type": "object",
              "required": false
            },
            "radius": {
              "type": "number",
              "required": false
            }
          }
        },
        {
          "name": "maps_place_details",
          "description": "Get detailed information about a specific place.",
          "params": {
            "place_id": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "maps_distance_matrix",
          "description": "Calculate travel distance and time for multiple origins and destinations.",
          "params": {
            "origins": {
              "type": "array",
              "required": true
            },
            "destinations": {
              "type": "array",
              "required": true
            },
            "mode": {
              "type": "string",
              "required": false,
              "default": "driving"
            }
          }
        },
        {
          "name": "maps_elevation",
          "description": "Get elevation data for locations on the earth.",
          "params": {
            "locations": {
              "type": "array",
              "required": true
            }
          }
        },
        {
          "name": "maps_directions",
          "description": "Get directions between two points.",
          "params": {
            "origin": {
              "type": "string",
              "required": true
            },
            "destination": {
              "type": "string",
              "required": true
            },
            "mode": {
              "type": "string",
              "required": false,
              "default": "driving"
            }
          }
        }
      ],
      "loose_args_match": true,
      "tool_aliases": [
        {
          "alias_tool": "maps_search_places",
          "canonical_tool": "maps_geocode",
          "arg_map": {
            "query": "address"
          },
          "response_transform": "geocode_to_search_places"
        }
      ]
    }
  ]
}
