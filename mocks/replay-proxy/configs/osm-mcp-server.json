{
  "servers": [
    {
      "name": "osm-mcp-server",
      "cassette": "/Users/chili/Projects/mcp-env/mcp_servers/replay-proxy/cassettes/osm-mcp-server.jsonl",
      "tools": [
        {
          "name": "geocode_address",
          "description": "Geocode a free-form address using OpenStreetMap Nominatim.",
          "params": {
            "address": {
              "type": "string",
              "required": true
            }
          }
        },
        {
          "name": "reverse_geocode",
          "description": "Reverse-geocode a lat/lon pair into a postal address.",
          "params": {
            "latitude": {
              "type": "number",
              "required": true
            },
            "longitude": {
              "type": "number",
              "required": true
            }
          }
        },
        {
          "name": "find_nearby_places",
          "description": "Find OSM POIs within a radius of a location.",
          "params": {
            "latitude": {
              "type": "number",
              "required": true
            },
            "longitude": {
              "type": "number",
              "required": true
            },
            "radius": {
              "type": "number",
              "required": false,
              "default": 1000
            },
            "categories": {
              "type": "array",
              "required": false
            },
            "limit": {
              "type": "integer",
              "required": false,
              "default": 20
            }
          }
        },
        {
          "name": "get_route_directions",
          "description": "Get OSRM driving/walking/cycling directions between two points.",
          "params": {
            "from_latitude": {
              "type": "number",
              "required": true
            },
            "from_longitude": {
              "type": "number",
              "required": true
            },
            "to_latitude": {
              "type": "number",
              "required": true
            },
            "to_longitude": {
              "type": "number",
              "required": true
            },
            "mode": {
              "type": "string",
              "required": false,
              "default": "car"
            },
            "steps": {
              "type": "boolean",
              "required": false,
              "default": false
            },
            "overview": {
              "type": "string",
              "required": false,
              "default": "simplified"
            },
            "annotations": {
              "type": "boolean",
              "required": false,
              "default": false
            }
          }
        },
        {
          "name": "explore_area",
          "description": "Summarize OSM features around a point.",
          "params": {
            "latitude": {
              "type": "number",
              "required": true
            },
            "longitude": {
              "type": "number",
              "required": true
            },
            "radius": {
              "type": "number",
              "required": false,
              "default": 500
            }
          }
        }
