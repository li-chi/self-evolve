{
  "name": "google-cloud-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GCP_MOCK_STATE_DIR": "{output_dir}/end_state/google_cloud"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_cloud/state.json",
    "short_name": "google_cloud",
    "schema_ref": "synth/mock_seed/google_cloud.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "bq_query",
      "bq_create_dataset",
      "gcs_upload",
      "gcs_download"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
