{
  "name": "zotero-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "ZOTERO_MOCK_STATE_DIR": "{output_dir}/end_state/zotero"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/zotero/state.json",
    "short_name": "zotero",
    "schema_ref": "synth/mock_seed/zotero.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "get_items",
      "get_item",
      "get_top_items",
      "create_items",
      "update_item",
      "delete_item",
      "get_collections",
      "get_collection_items",
      "get_tags"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
