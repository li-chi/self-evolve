{
  "name": "discord-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "DISCORD_MOCK_STATE_DIR": "{output_dir}/end_state/discord"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/discord/state.json",
    "short_name": "discord",
    "schema_ref": "synth/mock_seed/discord.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_guilds",
      "get_guild",
      "list_guild_channels",
      "list_guild_members",
      "get_guild_member",
      "list_guild_roles",
      "add_member_role",
      "list_active_threads",
      "get_channel",
      "create_channel",
      "modify_channel",
      "delete_channel",
      "list_messages",
      "get_message",
      "create_message",
      "edit_message",
      "delete_message",
      "add_reaction",
      "remove_reaction",
      "list_reactions",
      "create_thread_from_message",
      "create_thread",
      "get_user",
      "get_current_user",
      "create_dm"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
