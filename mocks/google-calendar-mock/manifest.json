{
  "name": "google-calendar-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GCAL_MOCK_STATE_DIR": "{output_dir}/end_state/google_calendar"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_calendar/state.json",
    "short_name": "google_calendar",
    "schema_ref": "synth/mock_seed/google_calendar.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "create_event",
      "get_event",
      "update_event",
      "list_events",
      "delete_event"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
