{
  "name": "notion-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "NOTION_MOCK_STATE_DIR": "{output_dir}/end_state/notion"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/notion/state.json",
    "short_name": "notion",
    "schema_ref": "synth/mock_seed/notion.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "create_page",
      "update_page",
      "query_database",
      "retrieve_page"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
