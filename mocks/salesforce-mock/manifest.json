{
  "name": "salesforce-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SF_MOCK_STATE_DIR": "{output_dir}/end_state/salesforce"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/salesforce/state.json",
    "short_name": "salesforce",
    "schema_ref": "synth/mock_seed/salesforce.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "query",
      "query_all",
      "search",
      "describe_object",
      "describe_global",
      "get_record",
      "create_record",
      "update_record",
      "delete_record",
      "upsert_record",
      "list_record_attachments",
      "get_limits"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
