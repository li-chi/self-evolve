{
  "name": "wandb-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "WANDB_MOCK_STATE_DIR": "{output_dir}/end_state/wandb"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/wandb/state.json",
    "short_name": "wandb",
    "schema_ref": "synth/mock_seed/wandb.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "query_wandb_tool",
      "query_wandb_entity_projects",
      "query_weave_traces_tool"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
