{
  "name": "linear-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "LINEAR_MOCK_STATE_DIR": "{output_dir}/end_state/linear"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/linear/state.json",
    "short_name": "linear",
    "schema_ref": "synth/mock_seed/linear.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "viewer",
      "teams",
      "team",
      "users",
      "user",
      "issues",
      "issue",
      "projects",
      "project",
      "workflowStates",
      "comments",
      "issueCreate",
      "issueUpdate",
      "issueDelete",
      "commentCreate",
      "projectCreate",
      "projectUpdate"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
