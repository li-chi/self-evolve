{
  "name": "bluesky-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "BLUESKY_MOCK_STATE_DIR": "{output_dir}/end_state/bluesky"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/bluesky/state.json",
    "short_name": "bluesky",
    "schema_ref": "synth/mock_seed/bluesky.py"
  },
  "tool_surface": {
    "prefixes": ["com.atproto.", "app.bsky."],
    "tool_names": [
      "com.atproto.server.createSession",
      "com.atproto.server.refreshSession",
      "com.atproto.server.getSession",
      "com.atproto.server.deleteSession",
      "app.bsky.actor.getProfile",
      "app.bsky.actor.getProfiles",
      "app.bsky.actor.searchActors",
      "app.bsky.actor.getPreferences",
      "app.bsky.feed.getTimeline",
      "app.bsky.feed.getAuthorFeed",
      "app.bsky.feed.getPostThread",
      "app.bsky.feed.getPosts",
      "app.bsky.feed.getLikes",
      "app.bsky.feed.getRepostedBy",
      "app.bsky.feed.searchPosts",
      "app.bsky.feed.post",
      "app.bsky.feed.repost",
      "app.bsky.feed.like",
      "app.bsky.feed.deletePost",
      "app.bsky.graph.getFollows",
      "app.bsky.graph.getFollowers",
      "app.bsky.graph.follow",
      "app.bsky.graph.unfollow",
      "app.bsky.graph.mute",
      "app.bsky.graph.unmute",
      "app.bsky.graph.block",
      "app.bsky.graph.unblock",
      "app.bsky.notification.listNotifications",
      "app.bsky.notification.updateSeen",
      "app.bsky.notification.getUnreadCount"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
