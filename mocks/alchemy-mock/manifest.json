{
  "name": "alchemy-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "ALCHEMY_MOCK_STATE_DIR": "{output_dir}/end_state/alchemy"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/alchemy/state.json",
    "short_name": "alchemy",
    "schema_ref": "synth/mock_seed/alchemy.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": []
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
