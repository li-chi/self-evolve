{
  "name": "asana-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "ASANA_MOCK_STATE_DIR": "{output_dir}/end_state/asana"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/asana/state.json",
    "short_name": "asana",
    "schema_ref": "synth/mock_seed/asana.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_workspaces",
      "get_workspace",
      "list_users",
      "get_user",
      "get_me",
      "list_teams",
      "get_team",
      "list_projects",
      "get_project",
      "create_project",
      "update_project",
      "list_sections",
      "create_section",
      "list_tasks",
      "get_task",
      "create_task",
      "update_task",
      "delete_task",
      "search_tasks",
      "add_task_to_section",
      "add_followers_to_task",
      "list_stories",
      "create_story",
      "list_tags",
      "create_tag",
      "add_tag_to_task",
      "list_custom_fields"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
