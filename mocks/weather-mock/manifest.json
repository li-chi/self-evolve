{
  "name": "weather-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "WEATHER_MOCK_STATE_DIR": "{output_dir}/end_state/weather"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/weather/state.json",
    "short_name": "weather",
    "schema_ref": "synth/mock_seed/weather.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "get_current_weather",
      "get_forecast",
      "get_alerts"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
