{
  "name": "confluence-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "CONFLUENCE_MOCK_STATE_DIR": "{output_dir}/end_state/confluence"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/confluence/state.json",
    "short_name": "confluence",
    "schema_ref": "synth/mock_seed/confluence.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "get_spaces",
      "get_space",
      "get_pages",
      "get_page_by_id",
      "create_page",
      "update_page",
      "delete_page",
      "get_page_children",
      "get_page_versions",
      "get_blog_posts",
      "create_blog_post",
      "get_page_footer_comments",
      "create_footer_comment",
      "get_page_inline_comments",
      "get_page_labels",
      "add_label_to_page"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
