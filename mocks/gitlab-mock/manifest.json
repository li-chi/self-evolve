{
  "name": "gitlab-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GITLAB_MOCK_STATE_DIR": "{output_dir}/end_state/gitlab"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/gitlab/state.json",
    "short_name": "gitlab",
    "schema_ref": "synth/mock_seed/gitlab.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "get_current_user",
      "list_projects",
      "get_project",
      "create_project",
      "list_issues",
      "get_issue",
      "create_issue",
      "update_issue",
      "close_issue",
      "add_issue_comment",
      "list_merge_requests",
      "get_merge_request",
      "create_merge_request",
      "update_merge_request",
      "accept_merge_request",
      "list_branches",
      "get_branch",
      "create_branch",
      "get_file_contents",
      "create_or_update_file",
      "search_users"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
