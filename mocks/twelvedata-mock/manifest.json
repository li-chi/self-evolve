{
  "name": "twelvedata-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "TWELVEDATA_MOCK_STATE_DIR": "{output_dir}/end_state/twelvedata"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/twelvedata/state.json",
    "short_name": "twelvedata",
    "schema_ref": "synth/mock_seed/twelvedata.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "price",
      "time_series",
      "exchange_rate"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
