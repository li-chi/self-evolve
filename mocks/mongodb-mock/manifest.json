{
  "name": "mongodb-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "MONGO_MOCK_STATE_DIR": "{output_dir}/end_state/mongodb"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/mongodb/state.json",
    "short_name": "mongodb",
    "schema_ref": "synth/mock_seed/mongodb.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "connect",
      "find",
      "insert_one",
      "update_one",
      "delete_one",
      "aggregate"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
