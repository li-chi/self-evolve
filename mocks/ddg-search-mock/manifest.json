{
  "name": "ddg-search-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "DDG_SEARCH_MOCK_STATE_DIR": "{output_dir}/end_state/ddg_search"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/ddg_search/state.json",
    "short_name": "ddg_search",
    "schema_ref": "synth/mock_seed/ddg_search.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "fetch_content"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
