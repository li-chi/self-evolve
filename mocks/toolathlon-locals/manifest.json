{
  "name": "toolathlon-locals",
  "tier": "infrastructure",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "AGENT_WORKSPACE": "{workspace}"
    }
  },
  "tool_surface": {
    "prefixes": [
      "local-"
    ],
    "tool_names": []
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
