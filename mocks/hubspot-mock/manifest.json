{
  "name": "hubspot-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "HUBSPOT_MOCK_STATE_DIR": "{output_dir}/end_state/hubspot"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/hubspot/state.json",
    "short_name": "hubspot",
    "schema_ref": "synth/mock_seed/hubspot.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_contacts",
      "get_contact",
      "create_contact",
      "update_contact",
      "archive_contact",
      "search_contacts",
      "list_companies",
      "get_company",
      "create_company",
      "update_company",
      "list_deals",
      "get_deal",
      "create_deal",
      "update_deal",
      "create_note",
      "create_task",
      "create_email",
      "create_association",
      "list_pipelines",
      "get_pipeline"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
