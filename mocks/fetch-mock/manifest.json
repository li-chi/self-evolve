{
  "name": "fetch-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "FETCH_MOCK_STATE_DIR": "{output_dir}/end_state/fetch"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/fetch/state.json",
    "short_name": "fetch",
    "schema_ref": "synth/mock_seed/fetch.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "fetch_html",
      "fetch_json",
      "fetch_txt",
      "fetch_markdown"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
