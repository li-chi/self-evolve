{
  "name": "wikipedia-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "WIKIPEDIA_MOCK_STATE_DIR": "{output_dir}/end_state/wikipedia"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/wikipedia/state.json",
    "short_name": "wikipedia",
    "schema_ref": "synth/mock_seed/wikipedia.py"
  },
  "tool_surface": {
    "prefixes": [
      "wikipedia_",
      "mock_debug_"
    ],
    "tool_names": [
      "get_article",
      "get_summary",
      "get_sections",
      "get_links"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
