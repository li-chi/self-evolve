{
  "name": "rail-12306-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "RAIL12306_MOCK_STATE_DIR": "{output_dir}/end_state/rail_12306"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/rail_12306/state.json",
    "short_name": "rail_12306",
    "schema_ref": "synth/mock_seed/rail_12306.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "search_trains",
      "book_ticket"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
