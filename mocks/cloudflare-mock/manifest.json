{
  "name": "cloudflare-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "CLOUDFLARE_MOCK_STATE_DIR": "{output_dir}/end_state/cloudflare"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/cloudflare/state.json",
    "short_name": "cloudflare",
    "schema_ref": "synth/mock_seed/cloudflare.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "list_zones",
      "list_dns_records",
      "create_dns_record",
      "upload_worker_script"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
