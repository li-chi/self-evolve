{
  "name": "elevenlabs-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "ELEVENLABS_MOCK_STATE_DIR": "{output_dir}/end_state/elevenlabs"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/elevenlabs/state.json",
    "short_name": "elevenlabs",
    "schema_ref": "synth/mock_seed/elevenlabs.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "text_to_speech",
      "text_to_speech_stream",
      "speech_to_speech",
      "speech_to_text",
      "list_voices",
      "get_voice",
      "delete_voice",
      "edit_voice_settings",
      "add_voice",
      "list_models",
      "get_user",
      "get_user_subscription",
      "list_history_items",
      "get_history_item",
      "delete_history_item",
      "list_pronunciation_dictionaries",
      "get_pronunciation_dictionary"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
