{
  "name": "supabase-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "SUPABASE_MOCK_STATE_DIR": "{output_dir}/end_state/supabase"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/supabase/state.json",
    "short_name": "supabase",
    "schema_ref": "synth/mock_seed/supabase.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_projects",
      "get_project",
      "create_project",
      "list_organizations",
      "get_project_api_keys",
      "pause_project",
      "restore_project",
      "get_project_url",
      "list_tables",
      "execute_sql",
      "apply_migration",
      "list_migrations",
      "select_rows",
      "insert_rows",
      "update_rows",
      "delete_rows",
      "rpc_call",
      "auth_list_users",
      "auth_get_user",
      "auth_create_user",
      "auth_update_user",
      "auth_delete_user",
      "storage_list_buckets",
      "storage_create_bucket",
      "storage_get_bucket",
      "storage_delete_bucket",
      "storage_list_objects",
      "storage_upload_object",
      "storage_get_object",
      "storage_delete_object",
      "storage_get_public_url",
      "storage_get_signed_url",
      "list_functions",
      "get_function",
      "deploy_function",
      "delete_function",
      "invoke_function",
      "get_logs"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
