{
  "name": "yahoo-finance-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "YAHOO_FINANCE_MOCK_STATE_DIR": "{output_dir}/end_state/yahoo_finance"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/yahoo_finance/state.json",
    "short_name": "yahoo_finance",
    "schema_ref": "synth/mock_seed/yahoo_finance.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "get_historical_stock_prices",
      "get_stock_info",
      "get_financial_statement",
      "get_recommendations"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
