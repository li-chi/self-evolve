{
  "name": "brevo-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "BREVO_MOCK_STATE_DIR": "{output_dir}/end_state/brevo"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/brevo/state.json",
    "short_name": "brevo",
    "schema_ref": "synth/mock_seed/brevo.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "sendTransacEmail",
      "getContacts",
      "createContact",
      "getSmtpTemplate",
      "addContactToList"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
