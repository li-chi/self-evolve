{
  "name": "google-drive-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GDRIVE_MOCK_STATE_DIR": "{output_dir}/end_state/google_drive"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_drive/state.json",
    "short_name": "google_drive",
    "schema_ref": "synth/mock_seed/google_drive.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "list_files",
      "get_file",
      "create_file",
      "update_file",
      "delete_file",
      "copy_file",
      "export_file",
      "download_file",
      "list_permissions",
      "create_permission",
      "delete_permission",
      "list_drives",
      "get_about"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
