{
  "name": "google-maps-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "GOOGLE_MAPS_MOCK_STATE_DIR": "{output_dir}/end_state/google_maps"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/google_maps/state.json",
    "short_name": "google_maps",
    "schema_ref": "synth/mock_seed/google_maps.py"
  },
  "tool_surface": {
    "prefixes": [
      "mock_debug_"
    ],
    "tool_names": [
      "maps_geocode",
      "maps_place_details",
      "maps_directions",
      "maps_distance_matrix"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
