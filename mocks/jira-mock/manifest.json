{
  "name": "jira-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "JIRA_MOCK_STATE_DIR": "{output_dir}/end_state/jira"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/jira/state.json",
    "short_name": "jira",
    "schema_ref": "synth/mock_seed/jira.py"
  },
  "tool_surface": {
    "prefixes": [],
    "tool_names": [
      "getIssue",
      "createIssue",
      "editIssue",
      "deleteIssue",
      "searchForIssuesUsingJql",
      "getTransitions",
      "doTransition",
      "assignIssue",
      "getComments",
      "addComment",
      "getProject",
      "getAllProjects",
      "findUsers",
      "getUser",
      "getIssueAllTypes",
      "getStatuses",
      "getPriorities"
    ]
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
