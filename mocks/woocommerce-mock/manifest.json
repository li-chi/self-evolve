{
  "name": "woocommerce-mock",
  "tier": "state_json",
  "launch": {
    "command": "python",
    "args": [
      "{server_dir}/server.py"
    ],
    "env": {
      "WC_MOCK_STATE_DIR": "{output_dir}/end_state/woocommerce"
    }
  },
  "seed": {
    "kind": "state_json",
    "path": "{output_dir}/end_state/woocommerce/state.json",
    "short_name": "woocommerce",
    "schema_ref": "synth/mock_seed/woocommerce.py"
  },
  "tool_surface": {
    "prefixes": [
      "woo_"
    ],
    "tool_names": []
  },
  "ship": {
    "dockerfile": "Dockerfile",
    "central": true
  }
}
